                    if now - o.lostAt >= cfg.WantLossGrace * (1 + 4 * (o.flaps or 0)) then
                        keep = false
                    end
                end
            end
            if keep and FX.Enable.IdleRelease and o.idle and FH.IdleCheck(o, now) then
                o.sleepUntil = now + cfg.SleepTime
                keep = false
            end
            if not keep then
                FH.Release(o, "xong/không còn want/idle")
                o = nil
            end
        end
        local best
        for _, n in ipairs(FH.Order) do
            local e = FH.Reg[n]
            if e.on and not FH.CoRun(o, e) and not (e.sleepUntil and now < e.sleepUntil) then
                if (not e.want) or FH.CachedWant(e) then best = e break end
            end
        end
        if o then
            -- R18: SummonBoss → Tyrant handoff khi eyes all open (4/4)
            -- SummonBoss tier 7 < Tyrant tier 12, nên bình thường Tyrant không preempt được
            -- Force release SummonBoss khi eyes mở, sleep 30s để Tyrant grab owner
            if o.name == "SummonBoss" and FX.Enable and FX.Enable.TyrantMove then
                local eyeInfo = FX.ReadTyrantEyes and FX.ReadTyrantEyes() or nil
                if eyeInfo and eyeInfo.ok and eyeInfo.count >= 4 then
                    o.sleepUntil = now + 30
                    FH.Release(o, "tyrant-eyes-open-handoff")
                    o = nil
                end
            end
            if o then
                if best and best ~= o and best.tier < o.tier then
                    o.waitSince = o.waitSince or now
                    local hold = o.grantedAt and (now - o.grantedAt) or math.huge
                    local atomicHold = o.atomic and o.atomic() and (now - o.waitSince) < (o.atomicMax or cfg.AtomicTimeout)
                    if hold >= cfg.HoldMin and not atomicHold then
                        FH.Preempt(o, best)
                    end
                else
                    o.waitSince = nil
                end
            end
        elseif best then
            if not (best.saved and now - FH.ReleasedAt < cfg.GraceAfterDone) then
                FH.Grant(best)
            end
        end
        for _, n in ipairs(FH.Order) do
            local e = FH.Reg[n]
            local lingering = (e == FH.LastOwner) and (FH.Owner == nil) and (now - FH.ReleasedAt < cfg.GraceAfterDone)
            if e ~= FH.Owner and FH.ClassOf(e) == "exclusive" and not FH.CoRun(FH.Owner, e) and not lingering then
                FH.Mask(e)
            end
        end
    end
