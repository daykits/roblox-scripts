local MELEE_KEYWORDS = {
    "combat", "step", "karate", "dragon", "electric",
    "god", "claw", "superhuman", "death", "shark", "saber", "sword",
}

local MELEE_PRIORITY = {
    "godhuman",
    "sanguine art",
    "superhuman",
    "dragon talon",
    "electric claw",
    "sharkman karate",
    "death step",
    "combat",
    "dark step",
    "karate",
}

local function GetBestMelee()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return nil end

    local allTools = {}
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            table.insert(allTools, tool)
        end
    end
    if #allTools == 0 then return nil end

    for _, priorityName in ipairs(MELEE_PRIORITY) do
        for _, tool in ipairs(allTools) do
            if tool.Name:lower():find(priorityName, 1, true) then
                return tool
            end
        end
    end

    for _, tool in ipairs(allTools) do
        if tool.ToolTip == "Melee" then return tool end
    end

    for _, tool in ipairs(allTools) do
        local n = tool.Name:lower()
        for _, kw in ipairs(MELEE_KEYWORDS) do
            if n:find(kw, 1, true) then return tool end
        end
    end

    return allTools[1]
end

local function EquipWeapon()
    if not Config.AutoEquipWeapon then return end
    local char = GetCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        if currentTool.ToolTip == "Melee" then return end
        local n = currentTool.Name:lower()
        for _, kw in ipairs(MELEE_KEYWORDS) do
            if n:find(kw, 1, true) then return end
        end
    end

    local bestMelee = GetBestMelee()
    if not bestMelee then return end

    pcall(function() hum:EquipTool(bestMelee) end)
end

