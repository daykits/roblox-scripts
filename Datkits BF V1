local function FastAttackLoop()
    while task.wait(Config.AttackDelay) do
        if Config.FastAttack and (Config.AutoQuest or Config.AutoFarm) then
            pcall(DoFastAttack)
        end
    end
end

local function EquipLoop()
    while task.wait(0.5) do
        if Config.AutoQuest or Config.AutoFarm then
            pcall(EquipWeapon)
        end
    end
end

local function AutoQuestLoop()
    while task.wait(0.1) do
        if not Config.AutoQuest then
            if Move.Active then StopFly() end
            continue
        end
        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            local quest, qlv, mob, npcCF, spawnCF = GetQuestData()
            if not quest then return end

            if not HasQuest() then
                if npcCF then
                    local dist = (hrp.Position - npcCF.Position).Magnitude
                    if dist > 8 then
                        -- ✅ Chỉ SET TARGET, không tự bay
                        SetMoveTarget(npcCF * CFrame.new(0, 0, 2.5))
                    else
                        -- Đứng yên tại chỗ, GIỮ PlatformStand (không tắt)
                        Move.TargetCF = CFrame.new(hrp.Position)
                        for _ = 1, 5 do
                            pcall(function()
                                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest, qlv)
                            end)
                            task.wait(0.12)
                        end
                        task.wait(0.6)
                    end
                end
            else
                local hits = GetClosestEnemies(math.huge, mob)
                if #hits > 0 then
                    local target = hits[1]
                    local pos = target.hrp.Position
                    -- ✅ Set target mượt - Heartbeat sẽ xử lý movement
                    SetMoveTarget(CFrame.new(pos + Vector3.new(0, Config.FarmDistance, 0), pos))
                elseif spawnCF then
                    SetMoveTarget(spawnCF)
                end
            end
        end)
    end
end

local function AutoFarmLoop()
    while task.wait(0.1) do
        if not Config.AutoFarm then
            if Move.Active and not Config.AutoQuest then StopFly() end
            continue
        end
        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hits = GetClosestEnemies(math.huge)
            if #hits > 0 then
                local target = hits[1]
                local pos = target.hrp.Position
                SetMoveTarget(CFrame.new(pos + Vector3.new(0, Config.FarmDistance, 0), pos))
            end
        end)
    end
end

local function AutoChestLoop()
    while task.wait(0.15) do
        if not Config.AutoChest then continue end
        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart

            -- ✅ Tìm chest nhanh hơn: chỉ scan workspace con trực tiếp
            local chests = {}
            for _, v in ipairs(workspace:GetChildren()) do
                if v:IsA("Model") and v.Name:find("Chest") then
                    local part = v:FindFirstChildWhichIsA("BasePart", true)
                    if part and part:FindFirstChild("TouchInterest") then
                        table.insert(chests, part)
                    end
                elseif v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
                    table.insert(chests, v)
                end
            end

            if #chests == 0 then return end

            table.sort(chests, function(a, b)
                return (hrp.Position - a.Position).Magnitude
                     < (hrp.Position - b.Position).Magnitude
            end)

            local target = chests[1]
            SetMoveTarget(target.CFrame)

            if (hrp.Position - target.Position).Magnitude <= 7 and firetouchinterest then
                firetouchinterest(hrp, target, 0)
                task.wait(0.03)
                firetouchinterest(hrp, target, 1)
            end
        end)
    end
end

local function SeaTravelLoop()
    while task.wait(0.25) do
        if not Config.AutoSeaTravel then continue end
        pcall(function()
            local boat = GetBoat()
            if not boat then return end
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            local _, _, _, npcCF = GetQuestData()
            if not npcCF then return end
            local targetPos = npcCF.Position
            local dist = (hrp.Position - targetPos).Magnitude
            if dist < 200 then
                StopSail()
                return
            end
            SailTo(targetPos, Config.SailSpeed)
        end)
    end
end

