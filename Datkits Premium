-- Kiểm tra có Quest chưa
local function HasQuest()
    local player = game.Players.LocalPlayer
    if player and player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("Main") then
        local questGui = player.PlayerGui.Main:FindFirstChild("Quest")
        if questGui and questGui.Visible then
            return true
        end
    end
    return false
end

-- Tự cầm Võ an toàn
local function EquipMeleeWeapon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then return currentTool end

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == "Melee" 
            or tool:FindFirstChild("Combat") 
            or tool.Name:find("Combat") 
            or tool.Name:find("Step") 
            or tool.Name:find("Karate") 
            or tool.Name:find("Dragon") 
            or tool.Name:find("Electric") 
            or tool.Name:find("God") 
            or tool.Name:find("Claw") then
                char.Humanoid:EquipTool(tool)
                return tool
            end
        end
    end
    
    local anyTool = player.Backpack:FindFirstChildOfClass("Tool")
    if anyTool then
        char.Humanoid:EquipTool(anyTool)
        return anyTool
    end
end

-- HỆ THỐNG DI CHUYỂN TWEEN MƯỢT (FIX TRIỆT ĐỂ LỖI ĐỨNG IM)
local TweenService = game:GetService("TweenService")
local currentTween = nil
local currentTweenTarget = nil

local function StopTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    currentTweenTarget = nil
end

local function TweenTo(targetCFrame, speed)
    speed = speed or 250
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Bật Noclip và PlatformStand để tránh kẹt vật lý
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    hum.PlatformStand = true

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    -- Nếu đã ở gần (< 15 studs), dừng Tween và khóa vị trí trên đầu
    if distance <= 15 then
        StopTween()
        hrp.CFrame = targetCFrame

        local bv = hrp:FindFirstChild("FarmFlyBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FarmFlyBV"
            bv.Parent = hrp
        end
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        return
    end

    -- Khi đang bay di chuyển, tắt MaxForce của BodyVelocity để KHÔNG BỊ KHỰNG
    local bv = hrp:FindFirstChild("FarmFlyBV")
    if bv then
        bv.MaxForce = Vector3.new(0, 0, 0)
    end

    -- Chỉ tạo Tween mới khi chưa có Tween hoặc mục tiêu dịch chuyển > 15 studs
    if not currentTween or not currentTweenTarget or (currentTweenTarget - targetCFrame.Position).Magnitude > 15 then
        StopTween()
        currentTweenTarget = targetCFrame.Position
        local duration = distance / speed
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        currentTween:Play()
    end
end

-- Dọn dẹp trạng thái khi tắt Farm
local function ResetPlayerPhysics()
    StopTween()
    local player = game.Players.LocalPlayer
    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("FarmFlyBV")
            if bv then bv:Destroy() end
        end
    end
end

-- Tìm quái gần nhất có lọc theo tên
local function GetNearestEnemy(mobNameFilter)
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local hrp = char.HumanoidRootPart
    local nearest = nil
    local minDist = math.huge

    if workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
            if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                if not mobNameFilter or string.find(enemy.Name:lower(), mobNameFilter:lower()) then
                    local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = enemy
                    end
                end
            end
        end
    end
    return nearest
end

-- VÒNG LẶP FAST ATTACK (ĐÁNH SIÊU NHANH)
task.spawn(function()
    while true do
        task.wait(_G.FastAttack and 0.05 or 0.2)
        if _G.AutoFarm or _G.AutoQuest then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                local tool = char:FindFirstChildOfClass("Tool")
                if tool and tool:IsA("Tool") then
                    tool:Activate()

                    local rep = game:GetService("ReplicatedStorage")
                    local net = rep:FindFirstChild("Modules") and rep.Modules:FindFirstChild("Net")
                    if net then
                        local regAttack = net:FindFirstChild("RE/RegisterAttack")
                        local regHit = net:FindFirstChild("RE/RegisterHit")
                        
                        if regAttack then regAttack:FireServer(0) end
                        
                        if regHit and workspace:FindFirstChild("Enemies") then
                            for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                                if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                    local dist = (char.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                                    if dist <= 50 then
                                        regHit:FireServer(enemy.HumanoidRootPart, {enemy})
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- TÍNH NĂNG AUTO QUEST SEA 1
MainTab:CreateToggle({
   Name = "Bật Auto Quest Sea 1 (Đã Sửa Lỗi Khựng)",
   CurrentValue = false,
   Flag = "ToggleAutoQuest",
   Callback = function(Value)
      _G.AutoQuest = Value

      if not Value then
          ResetPlayerPhysics()
      end

      -- Luồng trang bị võ
      task.spawn(function()
          while _G.AutoQuest do
              task.wait(0.5)
              pcall(function()
                  EquipMeleeWeapon()
              end)
          end
      end)

      -- Luồng Auto Quest
      task.spawn(function()
          local lockedTarget = nil

          while _G.AutoQuest do
              task.wait(0.05)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character
                  if not character then return end
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  if not hrp then return end

                  local questName, questLevel, mobName, npcCFrame, mobCFrame = GetSea1QuestData()

                  -- BƯỚC 1: Nếu chưa có Quest -> Bay đến NPC nhận Quest
                  if not HasQuest() then
                      lockedTarget = nil
                      if npcCFrame then
                          local distToNPC = (hrp.Position - npcCFrame.Position).Magnitude
                          if distToNPC > 12 then
                              TweenTo(npcCFrame, 250)
                          else
                              StopTween()
                              hrp.CFrame = npcCFrame
                              game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                              task.wait(0.5)
                          end
                      end
                  -- BƯỚC 2: Đã có Quest -> Bay tới quái và tiêu diệt
                  else
                      -- Tìm quái mới nếu quái cũ đã chết
                      if not (lockedTarget and lockedTarget.Parent and lockedTarget:FindFirstChild("Humanoid") and lockedTarget.Humanoid.Health > 0 and lockedTarget:FindFirstChild("HumanoidRootPart")) then
                          lockedTarget = GetNearestEnemy(mobName)
                      end

                      if lockedTarget and lockedTarget:FindFirstChild("HumanoidRootPart") then
                          local mobHRP = lockedTarget.HumanoidRootPart
                          local mobPos = mobHRP.Position
                          local height = _G.FarmDistance or 5
                          local targetCFrame = CFrame.new(mobPos + Vector3.new(0, height, 0), mobPos)
                          local distToMob = (hrp.Position - mobPos).Magnitude

                          if distToMob > 15 then
                              TweenTo(targetCFrame, 250)
                          else
                              StopTween()
                              hrp.CFrame = targetCFrame

                              local bv = hrp:FindFirstChild("FarmFlyBV")
                              if not bv then
                                  bv = Instance.new("BodyVelocity")
                                  bv.Name = "FarmFlyBV"
                                  bv.Parent = hrp
                              end
                              bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                              bv.Velocity = Vector3.new(0, 0, 0)

                              mobHRP.CanCollide = false
                              mobHRP.Velocity = Vector3.new(0, 0, 0)
                          end
                      else
                          -- Nếu quái chưa hồi -> Bay tới bãi quái nằm chờ
                          if mobCFrame then
                              TweenTo(mobCFrame, 250)
                          end
                      end
                  end
              end)
          end
      end)
   end,
})

