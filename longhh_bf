            end
            if not isSkillEffect(effect) then return end
            local st = fxd.MobDodge
            if not st then return end
            st.handled = st.handled or setmetatable({ }, { __mode = "k" })
            if st.handled[effect] then return end

            local mob = owningMob(effect)
            if not isAliveMob(mob) then return end
