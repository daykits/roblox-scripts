--====================================================================
local farm = {
	selected = nil, target = nil, mover = createMover(), maid = createMaid(),
	elapsed = 0, lastAttack = 0, warnedNoCombat = false,
}
local HOLD_RADIUS = 4 -- inside this distance the character lerps instead of tweening
local RETARGET_DISTANCE = 10 -- tween destination is refreshed only if the enemy moved this far

--[[ >>> CONNECT YOUR COMBAT SYSTEM HERE <<<
	Called repeatedly (every CONFIG.AttackInterval) while the character hovers above `target` (a Model).
	Return true if an attack was actually performed. Do not invent RemoteEvent names:
	use whatever your existing combat code really exposes (a Tool:Activate(), an existing
	RemoteEvent you already own, etc.). Left as a safe no-op until you connect it.
]]
local function attackTarget(target)
	return false
end

local function isEnemyAlive(model)
	if not model or not model.Parent or not model:IsDescendantOf(Workspace) then
		return false
	end
	if Players:GetPlayerFromCharacter(model) then
		return false
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function getEnemySource()
	if next(enemyRegistry.tagged) ~= nil then
		return enemyRegistry.tagged
	end
	bindEnemyFolder()
	return enemyRegistry.folderSet
end

local function getEnemyTypeNames()
	local names, seen = {}, {}
	for model in pairs(getEnemySource()) do
		if model.Parent and model:FindFirstChildOfClass("Humanoid") and not seen[model.Name] then
			seen[model.Name] = true
			table.insert(names, model.Name)
		end
	end
	table.sort(names)
	return names
end

local function findNearestEnemy(typeName, position)
	local best, bestDistance = nil, math.huge
	for model in pairs(getEnemySource()) do
		if model.Name == typeName and isEnemyAlive(model) then
			local distance = (model:GetPivot().Position - position).Magnitude
			if distance < bestDistance then
				best, bestDistance = model, distance
			end
		end
	end
	return best
end

local function attackIfReady(target)
	local now = os.clock()
	if now - farm.lastAttack < CONFIG.AttackInterval then return end
	farm.lastAttack = now
	local attacked = invokeHook("attackTarget", attackTarget, target)
	if not attacked and not farm.warnedNoCombat then
		farm.warnedNoCombat = true
		notify("attackTarget() is not connected to a combat system yet.", "warning")
	end
end

local function followEnemy(root, target)
	local targetPosition = target:GetPivot().Position
	local hoverPosition = targetPosition + Vector3.new(0, CONFIG.EnemyHoverHeight, 0)
	local goalCFrame = faceFrom(hoverPosition, targetPosition, root.CFrame.LookVector)
	holdStill(root)
	if farm.mover.isMoving() then
		if (farm.mover.goal.Position - hoverPosition).Magnitude > RETARGET_DISTANCE then
			farm.mover.moveTo(root, goalCFrame)
		end
	elseif (root.Position - hoverPosition).Magnitude > HOLD_RADIUS then
		farm.mover.moveTo(root, goalCFrame)
	else
		root.CFrame = root.CFrame:Lerp(goalCFrame, CONFIG.FollowLerpAlpha)
		attackIfReady(target)
	end
	setStatus("AutoFarm", "Farming " .. target.Name)
end

local function farmStep(dt)
	local root, humanoid = getRoot(), getHumanoid()
	if not root or not isAlive(humanoid) then
		farm.mover.cancel()
		setStatus("AutoFarm", "Waiting for respawn")
		return
	end
	if not farm.selected then
		setStatus("AutoFarm", "Select an enemy type")
		return
	end
	farm.elapsed += dt
	if not isEnemyAlive(farm.target) then
		farm.mover.cancel()
		farm.target = nil
		if farm.elapsed >= CONFIG.SearchInterval then
			farm.elapsed = 0
			farm.target = findNearestEnemy(farm.selected, root.Position)
		end
		if not farm.target then
			setStatus("AutoFarm", "Waiting for enemy to spawn")
			return
		end
	end
	followEnemy(root, farm.target)
end

