-- =========================
-- FIND ENEMY
-- =========================
local function FindMob(mobName)
    local char = GetChar()
    if not char then return nil end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local enemies = workspace:FindFirstChild("Enemies")

    if not hrp or not enemies then
        return nil
    end

    local closest = nil
    local shortest = math.huge
    local wanted = string.lower(mobName)

    for _, enemy in ipairs(enemies:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        local ehrp = enemy:FindFirstChild("HumanoidRootPart")

        if hum and ehrp and hum.Health > 0 then
            local name = string.lower(enemy.Name)

            if string.find(name, wanted, 1, true) then
                local dist = (hrp.Position - ehrp.Position).Magnitude

                if dist < shortest then
                    shortest = dist
                    closest = enemy
                end
            end
        end
    end

    return closest
end

-- =========================
-- QUEST START
-- =========================
local function StartQuest(info)
    if not info then return false end

    local now = os.clock()

    -- Không spam remote.
    if now - lastQuestAttempt < 1.2 then
        return false
    end

    lastQuestAttempt = now

    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local comm = remotes and remotes:FindFirstChild("CommF_")

    if not comm then
        warn("Không tìm thấy ReplicatedStorage.Remotes.CommF_")
        return false
    end

    local ok, result = pcall(function()
        return comm:InvokeServer("StartQuest", info.Name, info.Level)
    end)

    if ok then
        task.wait(0.35)
        return HasQuest()
    end

    warn("StartQuest error:", result)
    return false
end

-- =========================
-- VERIFY QUEST / QUEST RESET
-- =========================
local function EnsureQuest(info)
    if HasQuest() then
        return true
    end

    local char = GetChar()
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local npcCF = info.NPC * CFrame.new(0, 0, 4)
    local distance = (hrp.Position - npcCF.Position).Magnitude

    if distance > 9 then
        TweenTo(npcCF)
        return false
    end

    StopTween()
    StartQuest(info)

    return HasQuest()
end

-- =========================
-- MOVE TO FARM POSITION
-- =========================
local function GetFarmCFrame(mob)
    local ehrp = mob and mob:FindFirstChild("HumanoidRootPart")
    if not ehrp then return nil end

    local height = tonumber(getgenv().FarmHeight) or 7

    -- Giữ nhân vật ở phía trên quái và nhìn xuống quái.
    return CFrame.new(
        ehrp.Position + Vector3.new(0, height, 0),
        ehrp.Position
    )
end

