-------------------------------------------------
-- AUTO FARM LEVEL
-------------------------------------------------
Tabs.Main:AddSection("Auto Farm Level")
Tabs.Main:AddToggle("AutoQuest", {
    Title = "Auto Farm Level (Quest + Nearest)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        ToggleNoclip(Value)

        if not Value then
            ResetCharacterState()
            return
        end

        getgenv().AutoFruit = false

        task.spawn(function()
            local noMobTime = 0

            while getgenv().AutoQuest do
                task.wait(0.12)

                local success, err = pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart

                    local questName, questLevel, mobName, npcCF, areaCF = GetQuestData()

                    -- Chưa có nhiệm vụ
                    if not HasQuest() then
                        isGoingToFarmArea = false
                        noMobTime = 0

                        local dist = (hrp.Position - npcCF.Position).Magnitude
                        if dist > 10 then
                            TweenTo(npcCF * CFrame.new(0, 0, 2.5))
                        else
                            StopTween()
                            for i = 1, 5 do
                                pcall(function()
                                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                end)
                                task.wait(0.11)
                            end
                            task.wait(1.25)
                        end
                        return
                    end

                    -- Đã có nhiệm vụ → tìm mục tiêu
                    local target = FindBestTarget(hrp.Position, mobName, getgenv().TargetPrioritize, 5500)

                    if target then
                        isGoingToFarmArea = false
                        noMobTime = 0

                        local pos = target.hrp.Position
                        local height = getgenv().FarmDistance or 6
                        TweenTo(CFrame.new(pos + Vector3.new(0, height, 0), pos))

                        pcall(function()
                            target.hrp.CanCollide = false
                            target.hrp.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        noMobTime = noMobTime + 0.12
                        if noMobTime > 2.2 then
                            isGoingToFarmArea = true
                            TweenTo(areaCF)
                        end
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

