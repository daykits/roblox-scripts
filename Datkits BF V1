-- =========================
-- AUTO CHEST - SEA 1/2/3
-- =========================
local function GetSea()
    local ids = {
        [2753915549] = "Sea 1",
        [4442272183] = "Sea 2",
        [7449423635] = "Sea 3"
    }
    return ids[game.PlaceId] or "Unknown Sea"
end

local function IsChestObject(obj)
    if not obj then return false end
    local n = string.lower(obj.Name or "")
    return n == "chest1" or n == "chest2" or n == "chest3"
end

local function GetChestPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        if obj.PrimaryPart and obj.PrimaryPart:IsA("BasePart") then
            return obj.PrimaryPart
        end
        local named = obj:FindFirstChild("Chest")
        if named and named:IsA("BasePart") then return named end
        return obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function IsChestAvailable(obj)
    local part = GetChestPart(obj)
    if not part or not part.Parent then return false end
    pcall(function()
        if part.Transparency >= 1 then return false end
    end)
    return true
end

local function RebuildChestList()
    table.clear(chestScan)
    local seen = {}

    -- Blox Fruits thường đặt Chest1/2/3 trực tiếp dưới Workspace,
    -- nhưng một số map/phiên bản có thể lồng chúng trong Model/Folder.
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if IsChestObject(obj) and not seen[obj] and IsChestAvailable(obj) then
            seen[obj] = true
            table.insert(chestScan, obj)
        end
    end
    chestScanAt = os.clock()
end

local function FindNearestChest()
    local hrp = GetHRP()
    if not hrp then return nil end

    if os.clock() - chestScanAt > 0.8 or #chestScan == 0 then
        RebuildChestList()
    end

    local best, bestDist = nil, math.huge
    for i = #chestScan, 1, -1 do
        local chest = chestScan[i]
        if not IsChestAvailable(chest) then
            table.remove(chestScan, i)
        else
            local part = GetChestPart(chest)
            local d = part and (hrp.Position - part.Position).Magnitude
            if d and d < bestDist then
                best, bestDist = chest, d
            end
        end
    end
    return best, bestDist
end

local function CollectChest(chest)
    local hrp = GetHRP()
    local part = GetChestPart(chest)
    if not hrp or not part then return false end

    local d = (hrp.Position - part.Position).Magnitude
    if d > (tonumber(getgenv().ChestDistance) or 5) + 2 then
        return false
    end

    StopMove(false)
    pcall(function()
        hrp.CFrame = part.CFrame * CFrame.new(0, 0, 1.5)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)

    if typeof(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(hrp, part, 0)
            task.wait(0.05)
            firetouchinterest(hrp, part, 1)
        end)
    end

    task.wait(0.35)
    return not IsChestAvailable(chest)
end

local function RunAutoChest()
    chestToken += 1
    local token = chestToken

    task.spawn(function()
        while getgenv().AutoChest and token == chestToken do
            local ok, err = pcall(function()
                if not GetChar() then
                    StopMove(false)
                    task.wait(0.7)
                    return
                end

                SetNoclip(true)
                local chest, distance = FindNearestChest()
                if not chest then
                    StopMove(false)
                    task.wait(0.8)
                    return
                end

                local part = GetChestPart(chest)
                if not part then
                    task.wait(0.1)
                    return
                end

                if chestTarget ~= chest then
                    chestTarget = chest
                    StopMove(false)
                end

                local target = CFrame.new(part.Position + Vector3.new(0, 2.5, 0))
                if distance and distance <= (tonumber(getgenv().ChestDistance) or 5) + 2 then
                    local collected = CollectChest(chest)
                    if collected then
                        chestTarget = nil
                        table.clear(chestScan)
                    end
                else
                    MoveTo(target, 5, getgenv().ChestSpeed)
                end
            end)

            if not ok then
                warn("[Datkits AutoChest]", err)
                StopMove(false)
                task.wait(0.5)
            else
                task.wait(0.08)
            end
        end
    end)
end

-- =========================
-- AUTO FARM
-- =========================
local function RunAutoFarm()
    farmToken += 1
    local token = farmToken

    task.spawn(function()
        while getgenv().AutoFarm and token == farmToken do
            local ok, err = pcall(function()
                if getgenv().AutoChest then
                    StopMove(false)
                    task.wait(0.2)
                    return
                end

                local char = GetChar()
                if not char then
                    StopMove(false)
                    task.wait(0.7)
                    return
                end

                local info = GetQuestInfo()
                if not info then
                    task.wait(0.5)
                    return
                end

                local questKey = tostring(info.Name)..":"..tostring(info.Level)..":"..tostring(info.Mob)
                if lastQuestKey ~= questKey then
                    lastQuestKey = questKey
                    StopMove(false)
                end

                if not HasQuest() then
                    if not EnsureQuest(info) then
                        task.wait(0.25)
                        return
                    end
                    task.wait(0.3)
                    return
                end

                local mob = FindMob(info.Mob)
                if mob then
                    local hum = mob:FindFirstChildOfClass("Humanoid")
                    local ehrp = mob:FindFirstChild("HumanoidRootPart")
                    if hum and ehrp and hum.Health > 0 then
                        EquipTool()
                        pcall(function()
                            ehrp.CanCollide = false
                            ehrp.AssemblyLinearVelocity = Vector3.zero
                            ehrp.AssemblyAngularVelocity = Vector3.zero
                        end)

                        local farmCF = GetFarmCFrame(mob)
                        if farmCF then
                            MoveTo(farmCF, 5, getgenv().MoveSpeed)
                        end
                        task.wait(0.08)
                        return
                    end
                end

                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                MoveTo(info.MobArea, 10, getgenv().MoveSpeed)
                task.wait(0.15)
            end)

            if not ok then
                warn("[Datkits AutoFarm]", err)
                StopMove(false)
                task.wait(0.6)
            end
        end
    end)
end

