local function GetChar()
    local c = LocalPlayer.Character
    if not c then return nil end
    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        return c
    end
    return nil
end

local function GetHRP()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart") or nil
end

local function GetLevel()
    local level = 1
    pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        local lv = data and data:FindFirstChild("Level")
        level = tonumber(lv and lv.Value) or 1
    end)
    return level
end

local function SetNoclip(enabled)
    if noclipState == enabled then return end
    noclipState = enabled
    local char = LocalPlayer.Character
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if enabled then
                if savedCollision[part] == nil then
                    savedCollision[part] = part.CanCollide
                end
                part.CanCollide = false
            else
                local old = savedCollision[part]
                if old ~= nil then
                    part.CanCollide = old
                    savedCollision[part] = nil
                end
            end
        end
    end
end

local function StopMove(restoreNoclip)
    movement.active = false
    movement.target = nil
    movement.lastPos = nil
    movement.stuckTime = 0
    movement.token += 1
    if restoreNoclip then
        SetNoclip(false)
    end
end

-- Một controller duy nhất. Không Tween mỗi 0.1s.
-- Tốc độ được giới hạn để tránh các cú server-correction quá mạnh.
local function MoveTo(targetCF, tolerance, speed)
    local hrp = GetHRP()
    if not hrp or not targetCF then return false end

    local dist = (hrp.Position - targetCF.Position).Magnitude
    movement.tolerance = tolerance or 7
    movement.speed = math.clamp(tonumber(speed) or getgenv().MoveSpeed or 180, 80, 300)

    if dist <= movement.tolerance then
        StopMove(false)
        return true
    end

    SetNoclip(true)
    movement.target = targetCF
    movement.active = true
    movement.lastTick = os.clock()
    return false
end

RunService.Heartbeat:Connect(function(dt)
    if not movement.active or not movement.target then return end
    local hrp = GetHRP()
    if not hrp then
        StopMove(false)
        return
    end

    local target = movement.target
    local delta = target.Position - hrp.Position
    local dist = delta.Magnitude

    if dist <= movement.tolerance then
        local token = movement.token
        StopMove(false)
        if token == movement.token then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        return
    end

    local now = os.clock()
    local last = movement.lastPos
    if last then
        local moved = (hrp.Position - last).Magnitude
        if moved < 0.15 then
            movement.stuckTime += dt
        else
            movement.stuckTime = 0
        end
    end
    movement.lastPos = hrp.Position

    -- Nếu server vừa correction vị trí, tiếp tục từ vị trí hiện tại thay vì
    -- tạo một Tween mới. Điều này tránh vòng lặp Cancel/Create gây giật.
    if movement.stuckTime > 1.0 then
        movement.stuckTime = 0
        pcall(function()
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local step = math.min(dist, movement.speed * math.max(dt, 1/240))
    local dir = delta.Unit
    local nextPos = hrp.Position + dir * step

    -- CFrame.lookAt giúp hướng nhân vật ổn định; không đổi hướng ngẫu nhiên.
    pcall(function()
        hrp.CFrame = CFrame.lookAt(nextPos, target.Position)
    end)
end)

