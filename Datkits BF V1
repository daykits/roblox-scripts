Tabs.Main:AddToggle("AutoFarm", {
    Title = "Bật Auto Farm (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoFarm = Value
        if not Value then
            StopTween()
            local char = GetChar()
            if char and char.HumanoidRootPart:FindFirstChild("FlyBV") then
                char.HumanoidRootPart.FlyBV:Destroy()
            end
            Fluent:Notify({Title = "Auto Farm", Content = "Đã tắt", Duration = 3})
            return
        end

        Fluent:Notify({Title = "Auto Farm", Content = "Đã bật - Sea 1 & Sea 2", Duration = 4})

        -- Giữ vũ khí
        task.spawn(function()
            while getgenv().AutoFarm do
                EquipTool()
                task.wait(0.5)
            end
        end)

        -- Vòng lặp farm chính
        task.spawn(function()
            while getgenv().AutoFarm do
                pcall(function()
                    local char = GetChar()
                    if not char then task.wait(1) return end

                    local info = GetQuestInfo()

                    -- Ưu tiên tìm quái trước (đi thẳng đến XYZ quái)
                    local mob = FindMob(info.Mob)

                    if mob and mob:FindFirstChild("HumanoidRootPart") then
                        -- Có quái → bay đến đúng vị trí XYZ của quái
                        local pos = mob.HumanoidRootPart.Position
                        local height = getgenv().FarmHeight or 7
                        TweenTo(CFrame.new(pos + Vector3.new(0, height, 0), pos))

                        -- Khóa quái
                        pcall(function()
                            mob.HumanoidRootPart.CanCollide = false
                            mob.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        -- Không thấy quái → nhận nhiệm vụ hoặc bay về khu vực
                        if not HasQuest() then
                            local dist = (char.HumanoidRootPart.Position - info.NPC.Position).Magnitude
                            if dist > 12 then
                                TweenTo(info.NPC * CFrame.new(0, 0, 3))
                            else
                                StopTween()
                                for i = 1, 5 do
                                    pcall(function()
                                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", info.Name, info.Level)
                                    end)
                                    task.wait(0.1)
                                end
                                task.wait(0.8)
                            end
                        else
                            -- Có quest nhưng không thấy mob → bay về MobArea
                            TweenTo(info.MobArea)
                        end
                    end
                end)
                task.wait(0.12)
            end
        end)
    end
})

