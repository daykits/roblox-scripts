    SQ.Want = function()
        local now = os.clock()
        if now - SQ.EvalT >= 0.5 then
            SQ.EvalT = now
            SQ.Act = SQ.Pick()
        end
        return SQ.Act ~= nil
    end
    SQ.Card = function(e)
        local fh = FX.FH
        if not fh or not fh.FarmData then return end
        local now = os.clock()
        if now - (SQ.tCard or -1e9) < 0.5 then return end
        SQ.tCard = now
        local ok = SQ.Status == "OK"
        pcall(fh.FarmData, "SecretQuest", {
            Title = e.name,
            Content = (e.island .. "  ·  " .. tostring(SQ.Step)),
            Value = ok and (tostring(SQ.Done) .. "/" .. tostring(#SQ.List)) or nil,
            Unit = "secret",
            Left = e.island,
            Right = ok and (tostring(#SQ.List - SQ.Done) .. " left") or "",
            Progress = ok and (SQ.Done / #SQ.List) or nil,
        })
    end
    SQ.Tick = function()
        local e = SQ.Pick()
        if not e then
            SQ.State = "IDLE"
            SQ.Cur = nil
            return
        end
        local now = os.clock()
        if SQ.Cur ~= e.name then
            SQ.Cur, SQ.CurSince, SQ.WaitSince, SQ.IslArr, SQ.Arrived, SQ.EA = e.name, now, nil, nil, nil, nil
            SQ.Note("start" .. e.name, "Secret Quest: " .. e.name .. " (" .. e.island .. ")", "green")
        end
        if now - SQ.CurSince > FX.Cfg.SQStallSec then
            SQ.Skipped[e.name] = now + 120
            SQ.Log("stall", e.name)
            SQ.Cur = nil
            return
        end
        local m = SQ.Moment(e.name)
        if not m then
            local pos = SQ.IslandPos(e.island)
            if not pos then
                SQ.State = "BLOCKED"
                SQ.Step = "khong doc duoc vi tri dao (Definitions.Map)"
                SQ.Skipped[e.name] = now + (e.retry or 420)
                SQ.Cur = nil
                return
            end
            SQ.State = "TRAVEL"
            SQ.Step = "Travel to " .. e.island
            SQ.Card(e)
            if SQ.Go(pos, 150) then
                SQ.IslArr = SQ.IslArr or now
                if now - SQ.IslArr > FX.Cfg.SQIslandWait then
                    SQ.IslArr = nil
                    SQ.Explore[e.name] = now + (e.retry or 420)
                    SQ.Cur = nil
                    SQ.Step = e.name .. " is not happening on " .. e.island
                    SQ.Note("nothappen" .. e.name, SQ.Step, "yellow")
                end
            else
                SQ.IslArr = nil
            end
            return
        end
        SQ.IslArr = nil
        SQ.State = "STEP"
        local ok, step, waiting = pcall(SQ.Run[e.name], m)
        if not ok then
            SQ.Log("run", e.name .. ": " .. tostring(step))
            SQ.Skipped[e.name] = now + 60
            SQ.Cur = nil
            SQ.State = "ERROR"
            SQ.Step = "loi: " .. tostring(step)
            SQ.Note("err" .. e.name, "Secret Quest loi: " .. e.name, "red")
            return
        end
        SQ.Step = tostring(step or "Working")
        SQ.Card(e)
        if waiting then
            SQ.WaitSince = SQ.WaitSince or now
            if now - SQ.WaitSince > 6 then
                SQ.Skipped[e.name] = now + (e.retry or 420)
                SQ.Cur, SQ.WaitSince = nil, nil
                SQ.Note("wait" .. e.name, e.name .. ": " .. SQ.Step .. ", chuyen quest khac", "yellow")
            end
        else
            SQ.WaitSince = nil
        end
    end
    SQ.Label = nil
    SQ.Refresh = function()
