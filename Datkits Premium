        task.spawn(function()
            while getgenv().AutoFarm do
                task.wait(0.1)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end

                    local target = FindBestMob("", 400) -- tìm mob gần nhất bất kỳ
                    -- Vì FindBestMob cần tên, ta viết lại nhanh cho nearest
                    local nearest = nil
                    local minDist = 400
                    local hrp = char.HumanoidRootPart

                    if workspace:FindFirstChild("Enemies") then
                        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                            if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                local d = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                                if d < minDist then
                                    minDist = d
                                    nearest = enemy
                                end
                            end
                        end
                    end

                    if nearest then
                        local pos = nearest.HumanoidRootPart.Position
                        local height = getgenv().FarmDistance or 6
                        TweenTo(CFrame.new(pos + Vector3.new(0, height, 0), pos), 255)
                        pcall(function()
                            nearest.HumanoidRootPart.CanCollide = false
                            nearest.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                        end)
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

