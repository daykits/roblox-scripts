Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Quest (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        ToggleNoclip(Value)
        
        if not Value then
            ResetCharacterState()
            return
        end
        
        getgenv().AutoFarm = false
        getgenv().AutoChest = false

        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(1)
            end
        end)

        task.spawn(function()
            while getgenv().AutoQuest do
                task.wait(0.05)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart
                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()

                    if not HasQuest() then
                        if npcCFrame then
                            local dist = (hrp.Position - npcCFrame.Position).Magnitude
                            if dist > 8 then
                                TweenTo(npcCFrame * CFrame.new(0, 0, 2.5), 260)
                            else
                                StopTween()
                                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                task.wait(0.5)
                            end
                        end
                    else
                        local target = nil
                        local minDist = math.huge
                        local enemies = workspace:FindFirstChild("Enemies")
                        
                        if enemies then
                            for _, enemy in ipairs(enemies:GetChildren()) do
                                local hum = enemy:FindFirstChild("Humanoid")
                                local ehrp = enemy:FindFirstChild("HumanoidRootPart")
                                if hum and hum.Health > 0 and ehrp and string.find(enemy.Name, mobName) then
                                    local d = (hrp.Position - ehrp.Position).Magnitude
                                    if d < minDist then
                                        minDist = d
                                        target = enemy
                                    end
                                end
                            end
                        end

                        if target then
                            local pos = target.HumanoidRootPart.Position
                            local cf = CFrame.new(pos + Vector3.new(0, getgenv().FarmDistance, 0), pos)
                            TweenTo(cf, 260)
                            
                            target.HumanoidRootPart.CanCollide = false
                            target.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                        elseif mobCFrame then
                            TweenTo(mobCFrame, 260)
                        end
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

