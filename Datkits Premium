MainTab:CreateSection("Auto Quest (Sea 1 + Sea 2)")

MainTab:CreateToggle({
   Name = "Bật Auto Quest (Tự nhận diện Sea)",
   CurrentValue = false,
   Flag = "ToggleAutoQuest",
   Callback = function(Value)
      _G.AutoQuest = Value
      if not Value then
          ResetCharacterState()
          return
      end

      task.spawn(function()
          while _G.AutoQuest do
              pcall(EquipMeleeWeapon)
              task.wait(0.55)
          end
      end)

      task.spawn(function()
          while _G.AutoQuest do
              task.wait(0.08)
              pcall(function()
                  local char = GetCharacter()
                  if not char then return end
                  local hrp = char.HumanoidRootPart

                  local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()

                  if not HasQuest() then
                      if npcCFrame then
                          local dist = (hrp.Position - npcCFrame.Position).Magnitude
                          if dist > 14 then
                              TweenTo(npcCFrame, 240)
                          else
                              StopTween()
                              pcall(function()
                                  game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                              end)
                              randomWait(0.35, 0.65)
                          end
                      end
                  else
                      local targetMob = nil
                      local minDist = math.huge

                      if workspace:FindFirstChild("Enemies") then
                          for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                              if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                  if string.find(enemy.Name, mobName) then
                                      local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                                      if dist < minDist then
                                          minDist = dist
                                          targetMob = enemy
                                      end
                                  end
                              end
                          end
                      end

                      if targetMob then
                          local mobPos = targetMob.HumanoidRootPart.Position
                          local height = _G.FarmDistance or 6
                          local targetCF = CFrame.new(mobPos + Vector3.new(0, height, 0), mobPos)
                          TweenTo(targetCF, 245)
                          pcall(function()
                              targetMob.HumanoidRootPart.CanCollide = false
                              targetMob.HumanoidRootPart.Velocity = Vector3.zero
                          end)
                      elseif mobCFrame then
                          TweenTo(mobCFrame, 245)
                      end
                  end
              end)
          end
          ResetCharacterState()
      end)
   end,
})

