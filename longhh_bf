    local function inCharacter(d)
        local p = d.Parent
        while p and p ~= workspace do
            if p:IsA("Model") and p:FindFirstChildOfClass("Humanoid") then return true end
            p = p.Parent
        end
        return false
    end
    local function reduceOne(d)
        local k = KIND[d.ClassName]
        if not k then return end
        if not G[k[3]] then return end
        if k[4] and inCharacter(d) then return end
        if G.orig[d] then return end
        local ok, old = pcall(function() return d[k[1]] end)
        if not ok then return end
        G.orig[d] = { k[1], old }
        pcall(function() d[k[1]] = k[2] end)
    end
    local function restoreGroup(group)
        for d, rec in pairs(G.orig) do
            local k = KIND[d.ClassName]
            if k and k[3] == group then
                if d.Parent then
                    pcall(function() d[rec[1]] = rec[2] end)
                end
                G.orig[d] = nil
            end
        end
    end
    local function lightingEffects(on)
        local l = game:GetService("Lighting")
        if on then
            for _, e in ipairs(l:GetDescendants()) do
                if (e:IsA("BlurEffect") or e:IsA("DepthOfFieldEffect")) and e.Enabled then
                    G.fx[e] = true
                    e.Enabled = false
                end
            end
        else
            for e in pairs(G.fx) do
                if e.Parent then
                    pcall(function() e.Enabled = true end)
                end
                G.fx[e] = nil
            end
        end
    end
    local function water(on)
        local t = workspace:FindFirstChildOfClass("Terrain")
        if not t then return end
        if on then
            if not G.water then
                G.water = { t.WaterWaveSize, t.WaterWaveSpeed }
            end
            t.WaterWaveSize, t.WaterWaveSpeed = 0, 0
        elseif G.water then
            t.WaterWaveSize, t.WaterWaveSpeed = G.water[1], G.water[2]
            G.water = nil
        end
    end
    local function sweep()
        G.token = G.token + 1
        local tok = G.token
        task.spawn(function()
            local ok, err = pcall(function()
                local all = workspace:GetDescendants()
                for i = 1, #all do
                    if G.token ~= tok then return end
                    reduceOne(all[i])
                    if i % 1500 == 0 then
                        task.wait()
                    end
                end
            end)
            if not ok then FX.Log("gfx-sweep", err) end
        end)
    end
    local function syncConn()
        if (G.lg or G.rm) and not G.conn then
            G.conn = workspace.DescendantAdded:Connect(reduceOne)
