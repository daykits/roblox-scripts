-- Vòng lặp chính xử lý Auto Farm
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.25)
        
        if getgenv().AutoFarm then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                local homeCFrame = rootPart.CFrame
                
                for _, targetPos in ipairs(eggPositions) do
                    if not getgenv().AutoFarm then break end
                    
                    pcall(function()
                        -- 1. Bay đến vị trí trứng
                        for i = 1, 4 do
                            safeTeleport(CFrame.new(targetPos + Vector3.new(0, 2, 0)))
                            task.wait(0.04)
                        end
                        task.wait(0.25)
                        
                        -- 2. Nhặt trứng
                        holdEPickup()
                        task.wait(0.4)
                        
                        -- 3. Chờ kiểm tra đã có trứng trên tay (tối đa 2.5s)
                        local hasEgg = false
                        local checkTimer = tick()
                        while (tick() - checkTimer) < 2.5 do
                            if equipEggTool() then
                                hasEgg = true
                                break
                            end
                            -- thử nhặt lại 1 lần nữa nếu chưa có
                            if (tick() - checkTimer) > 0.8 then
                                holdEPickup()
                            end
                            task.wait(0.15)
                        end
                        
                        -- 4. Nếu đã nhặt thành công → về nhà
                        if hasEgg then
                            task.wait(0.2)
                            for i = 1, 4 do
                                safeTeleport(homeCFrame)
                                task.wait(0.04)
                            end
                            task.wait(1.8) -- chờ game xử lý cất trứng
                        else
                            -- chưa nhặt được → về nhà chờ rồi tiếp
                            safeTeleport(homeCFrame)
                            task.wait(0.8)
                        end
                    end)
                end
            end
        end
    end
end)
