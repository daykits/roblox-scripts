-- ====================== HÀM HỖ TRỢ ======================
local function randomWait(min, max)
    task.wait(min + math.random() * (max - min))
end

local function GetCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        return char
    end
    return nil
end

local function GetLevel()
    local level = 1
    pcall(function()
        level = LocalPlayer.Data.Level.Value
    end)
    return level
end

local function GetCurrentSea()
    local level = GetLevel()
    if level >= 1500 then
        return 3
    elseif level >= 700 then
        return 2
    else
        return 1
    end
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") or v.Name == "FarmFlyBV" then
                v:Destroy()
            end
        end
    end
end

local function TweenTo(targetCFrame, speed)
    speed = speed or _G.TweenSpeed or 260
    local char = GetCharacter()
    if not char then return end
    local hrp = char.HumanoidRootPart

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local bv = hrp:FindFirstChild("FarmFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmFlyBV"
        bv.MaxForce = Vector3.new(400000, 400000, 400000)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance <= 3.5 then
        StopTween()
        hrp.CFrame = targetCFrame
        return
    end

    if not currentTween or not lastTargetPos or (lastTargetPos - targetCFrame.Position).Magnitude > 4 then
        lastTargetPos = targetCFrame.Position
        if currentTween then pcall(function() currentTween:Cancel() end) end

        local duration = math.clamp(distance / speed, 0.12, 7)
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        currentTween:Play()
    end
end

local function EquipMeleeWeapon()
    local char = GetCharacter()
    if not char then return end
    if char:FindFirstChildOfClass("Tool") then return end

    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            if tool.ToolTip == "Melee" 
            or name:find("combat") or name:find("step") or name:find("karate")
            or name:find("dragon") or name:find("electric") or name:find("god")
            or name:find("claw") or name:find("superhuman") or name:find("death")
            or name:find("shark") or name:find("water") then
                char.Humanoid:EquipTool(tool)
                return
            end
        end
    end

    local any = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    if any then
        char.Humanoid:EquipTool(any)
    end
end

local function HasQuest()
    local success, result = pcall(function()
        local gui = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if gui and gui:FindFirstChild("Quest") then
            return gui.Quest.Visible
        end
        return false
    end)
    return success and result
end

