-- ====================== HÀM CƠ BẢN ======================
local function GetCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        return char
    end
    return nil
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function GetCurrentSea()
    local lv = GetLevel()
    if lv >= 1500 then return 3
    elseif lv >= 700 then return 2
    else return 1 end
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") or v.Name == "FarmFlyBV" then
                v:Destroy()
            end
        end
    end
end

local function TweenTo(cf, speed)
    speed = speed or getgenv().TweenSpeed
    local char = GetCharacter()
    if not char then return end
    local hrp = char.HumanoidRootPart

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    local bv = hrp:FindFirstChild("FarmFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmFlyBV"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local dist = (hrp.Position - cf.Position).Magnitude
    if dist <= 4 then
        StopTween()
        hrp.CFrame = cf
        return
    end

    if not currentTween or not lastTargetPos or (lastTargetPos - cf.Position).Magnitude > 5 then
        lastTargetPos = cf.Position
        if currentTween then pcall(function() currentTween:Cancel() end) end
        local duration = math.clamp(dist / speed, 0.1, 6)
        currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = cf})
        currentTween:Play()
    end
end

local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            char.Humanoid:EquipTool(tool)
            return
        end
    end
end

local function HasQuest()
    local success, result = pcall(function()
        local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if main and main:FindFirstChild("Quest") then
            return main.Quest.Visible
        end
        return false
    end)
    return success and result
end

-- ====================== TÌM MOB MẠNH HƠN ======================
local function FindTargetMob(mobName)
    local char = GetCharacter()
    if not char then return nil end
    local hrp = char.HumanoidRootPart
    local best = nil
    local shortest = 9999

    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    local keywords = {
        raider = {"raider", "kẻ tập kích", "tap kich"},
        mercenary = {"mercenary", "lính đánh thuê", "danh thue"},
        ["swan pirate"] = {"swan", "pirate"},
        ["factory staff"] = {"factory", "staff"},
        ["marine lieutenant"] = {"lieutenant", "trung úy"},
        ["marine captain"] = {"captain", "đại úy"},
        zombie = {"zombie"},
        vampire = {"vampire"},
        bandit = {"bandit"},
        monkey = {"monkey"},
        gorilla = {"gorilla"},
        pirate = {"pirate"},
        brute = {"brute"},
    }

    local searchList = keywords[mobName:lower()] or {mobName:lower()}

    for _, enemy in pairs(folder:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            local name = enemy.Name:lower()
            local matched = false

            for _, key in pairs(searchList) do
                if name:find(key) then
                    matched = true
                    break
                end
            end

            if matched then
                local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    best = enemy
                end
            end
        end
    end
    return best
end

-- ====================== QUEST DATA ======================
local function GetQuestData()
    local level = GetLevel()
    local sea = GetCurrentSea()

    if sea == 2 then
        if level < 725 then
            return "Area1Quest", 1, "Raider", CFrame.new(-429.54, 71.77, 1836.18), CFrame.new(-750, 55, 2300)
        elseif level < 775 then
            return "Area1Quest", 2, "Mercenary", CFrame.new(-429.54, 71.77, 1836.18), CFrame.new(-950, 80, 1500)
        elseif level < 800 then
            return "Area2Quest", 1, "Swan Pirate", CFrame.new(638.44, 71.77, 918.28), CFrame.new(1000, 140, 1300)
        elseif level < 875 then
            return "Area2Quest", 2, "Factory Staff", CFrame.new(638.44, 71.77, 918.28), CFrame.new(800, 110, 0)
        elseif level < 900 then
            return "MarineQuest3", 1, "Marine Lieutenant", CFrame.new(-2440.79, 71.71, -3216.07), CFrame.new(-2600, 100, -3100)
        elseif level < 950 then
            return "MarineQuest3", 2, "Marine Captain", CFrame.new(-2440.79, 71.71, -3216.07), CFrame.new(-2600, 100, -3100)
        else
            return "ZombieQuest", 1, "Zombie", CFrame.new(-5494.34, 48.52, -795.16), CFrame.new(-5600, 50, -800)
        end
    end

    -- Sea 1 fallback đơn giản
    return "BanditQuest", 1, "Bandit", CFrame.new(1059, 16, 1549), CFrame.new(1145, 17, 1634)
end

-- ====================== FAST ATTACK ======================
task.spawn(function()
    while true do
        task.wait(getgenv().FastAttack and 0.04 or 0.15)
        if (getgenv().AutoQuest or getgenv().AutoFarm) and getgenv().FastAttack then
            pcall(function()
                local char = GetCharacter()
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
                    if net then
                        local regAttack = net:FindFirstChild("RE/RegisterAttack")
                        local regHit = net:FindFirstChild("RE/RegisterHit")
                        if regAttack then regAttack:FireServer(0.05) end
                        if regHit then
                            for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                                if enemy:FindFirstChild("HumanoidRootPart") and enemy.Humanoid.Health > 0 then
                                    local dist = (char.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                                    if dist < 50 then
                                        pcall(function()
                                            regHit:FireServer(enemy.HumanoidRootPart, {{enemy, enemy.HumanoidRootPart}})
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

