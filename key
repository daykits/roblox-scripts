    verifyText.TextSize = 14; verifyText.Font = Enum.Font.GothamBold
    verifyText.ZIndex = 7; verifyText.Parent = verifyBtn

    verifyBtn.MouseEnter:Connect(function()
        Tween(verifyBtn, {Size = UDim2.new(0.87, 0, 0, 46), Position = UDim2.new(0.065, 0, 0, 179)}, 0.15, Enum.EasingStyle.Back)
    end)
    verifyBtn.MouseLeave:Connect(function()
        Tween(verifyBtn, {Size = UDim2.new(0.85, 0, 0, 44), Position = UDim2.new(0.075, 0, 0, 180)}, 0.15)
    end)

    local hint = Instance.new("TextLabel")
    hint.Size = UDim2.new(0.85, 0, 0, 30)
    hint.Position = UDim2.new(0.075, 0, 0, 235)
