        function TT.runScene(door, sw, tok)
            local h0, swCf = getRoot(), pivotOf(sw)
            if not (h0 and swCf) then return end
            local oldPos = h0.Position
            local pressTarget = sw:FindFirstChildWhichIsA("ProximityPrompt", true) and sw or door
            for _ = 1, TT.SCENE_RETRY do
                if not TT.fightValid(tok) then return end
                local teleported = false
                local t0, arrived = tick(), nil
                local lastE, lastScreen, lastOpt = 0, 0, 0
                local stand
                while TT.fightValid(tok) do
                    task.wait()
                    TT.pulse()
                    local exit = false
                    repeat
                        local h, cf = getRoot(), pivotOf(sw)
                        if not h then exit = true break end
                        if TT.inRealm() or (h.Position - oldPos).Magnitude > TT.SCENE_FAR then
                            teleported, exit = true, true
                            break
                        end
                        if not cf then exit = true break end
                        local gate = TT.findHellfireGas()
                        if TT.alive(gate) then
                            TT.fight(gate, tok, nil, true)
                            t0, arrived = tick(), nil
                            break
                        end
                        local mob = TT.findMob()
                        if mob then
                            TT.fight(mob, tok)
                            t0, arrived = tick(), nil
                            break
                        end
                        if not stand then
                            local dir = h.Position - cf.Position
                            dir = Vector3.new(dir.X, 0, dir.Z)
                            dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.new(0, 0, 1)
                            stand = CFrame.lookAt(cf.Position + dir * 3, cf.Position)
                        end
                        pcall(_tp, stand)
                        local _, o1 = getDialogue()
                        if o1 then
                            if os.clock() - lastOpt >= TT.CLICK then
                                lastOpt = os.clock()
                                pcall(clickGui, o1)
                            end
                        else
                            local fr = getDialogueFrame()
                            if fr and os.clock() - lastScreen >= TT.CLICK then
                                lastScreen = os.clock()
                                pcall(clickGui, fr)
                            end
                        end
                        if (h.Position - stand.Position).Magnitude <= 8 then
                            arrived = arrived or os.clock()
                            if TT.busyAt >= arrived then
                                exit = true
                                break
                            end
                            if os.clock() - lastE >= TT.CLICK and promptShown(pressTarget) then
                                lastE = os.clock()
                                task.spawn(pcall, pressE, pressTarget)
                            end
                            if os.clock() - arrived > TT.SCENE_KNOCK then
                                exit = true
                                break
                            end
                        elseif tick() - t0 > 40 then
                            exit = true
                        end
                    until true
                    if exit then break end
                end
                if teleported then
                    TT.sceneFight(oldPos, tok)
                    TT.sceneSkip[door] = tick() + TT.REVISIT
                    return
                end
                if not pivotOf(sw) then return end
                TT.flyBack(oldPos, tok)
            end
            TT.sceneSkip[door] = tick() + TT.REVISIT
        end

        -- cua thuong: bay toi, dung huong tot nhat, bam E, chon option1; ban / im lang 3s thi doi huong
        function TT.visitDoor(door, tok)
            local list, idx, switches, arrived, goneAt
            local sawDialogue = false
            local lastE, lastClick, lastScreen = 0, 0, 0
            local startT = os.clock()
            while TT.valid(tok) and os.clock() - startT < 60 do
                task.wait()
                TT.pulse()
                local h, cf = getRoot(), pivotOf(door)
                if not (h and cf) then return end
                local mob = TT.findMob()
                if mob then
                    TT.fight(mob, tok)
                    arrived, startT = nil, os.clock()
                else
                    if not list then list, idx, switches = TT.standDirs(door, cf, h), 1, 0 end
                    local stand = CFrame.lookAt(cf.Position + list[idx] * TT.STAND, cf.Position)
                    local sc, opt = getDialogue()
                    if not opt and os.clock() - lastScreen >= TT.CLICK then
                        local fr = getDialogueFrame()
                        if fr then
                            lastScreen = os.clock()
                            pcall(clickGui, fr)
                        end
                    end
                    if sc then
                        sawDialogue, goneAt = true, nil
                        pcall(_tp, stand)
                        if opt and os.clock() - lastClick >= TT.CLICK then
                            lastClick = os.clock()
                            pcall(clickGui, opt)
                        end
                    elseif sawDialogue then
                        goneAt = goneAt or os.clock()
                        if os.clock() - goneAt > 1.5 then
                            local w0 = os.clock()
                            while TT.valid(tok) and os.clock() - w0 < 3 and not door:FindFirstChild("SceneWindow") do
                                task.wait(0.1)
                            end
                            return
                        end
                    else
                        pcall(_tp, stand)
                        if (h.Position - stand.Position).Magnitude <= 8 then
                            arrived = arrived or os.clock()
                            if TT.busyAt >= arrived then return end
                            if os.clock() - lastE >= TT.CLICK and promptShown(door) then
                                lastE = os.clock()
                                task.spawn(pcall, pressE, door)
                            end
                            if os.clock() - arrived > TT.SIDE_SWITCH then
                                switches = switches + 1
                                if switches >= #list then
                                    return
                                end
                                idx = idx % #list + 1
                                arrived = nil
                            end
                        else
                            arrived = nil
                        end
                    end
                end
            end
        end

        function TT.ghost(tok)
            local function items()
                local list = { }
                local root = workspace:FindFirstChild("GhostChase")
                if root then
