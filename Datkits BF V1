local function GetQuestInfo()
    local info = {
        HasQuest = false,
        QuestName = nil,
        Progress = 0,
        Required = 0,
        MobName = nil,
    }
    pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        if not data then return end
        local quest = data:FindFirstChild("Quest")
        if quest then
            local qName = quest:FindFirstChild("QuestName")
            if qName and typeof(qName.Value) == "string" and qName.Value ~= "" then
                info.QuestName = qName.Value
                info.HasQuest = true
            end
            local qMob = quest:FindFirstChild("MobName")
            if qMob then info.MobName = qMob.Value end
        end
        local prog = data:FindFirstChild("QuestProgress")
        local req = data:FindFirstChild("QuestRequirement")
        if prog then info.Progress = tonumber(prog.Value) or 0 end
        if req then info.Required = tonumber(req.Value) or 0 end
    end)
    return info
end

local function HasQuest()
    local info = GetQuestInfo()
    if not info.HasQuest then return false end
    if info.Required > 0 and info.Progress >= info.Required then
        return false
    end
    return true
end

