local function formatNumber(number)
    local str = tostring(number)
    repeat
        local replaced, count = str:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        str = replaced
    until count == 0
    return str
end

local function getFruitStock()
    local resultStr = "Advance Fruit Stock\n"
    local success, advanceFruits = pcall(function()
        return ReplicatedStorage.Remotes.CommF_:InvokeServer("GetFruits", true)
    end)
    if success and advanceFruits then
        local hasFruit = false
        for _, fruit in pairs(advanceFruits) do
            if fruit.OnSale then
                hasFruit = true
                resultStr = resultStr .. fruit.Name .. " - $" .. formatNumber(fruit.Price) .. "\n"
            end
        end
        if not hasFruit then resultStr = resultStr .. "- No fruit.\n" end
    else
        resultStr = resultStr .. "- Error.\n"
    end
    return resultStr
end

