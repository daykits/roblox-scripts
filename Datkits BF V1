-- ==================== HÀM CƠ BẢN ====================
local function GetChar()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
        return c
    end
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
end

local function TweenTo(cf)
    local char = GetChar()
    if not char then return end
    local hrp = char.HumanoidRootPart

    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            v.CanCollide = false
        end
    end

    local bv = hrp:FindFirstChild("FlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FlyBV"
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local dist = (hrp.Position - cf.Position).Magnitude
    if dist < 5 then
        StopTween()
        hrp.CFrame = cf
        return
    end

    local time = math.clamp(dist / (getgenv().TweenSpeed or 320), 0.05, 3.2)
    if currentTween then pcall(function() currentTween:Cancel() end) end

    currentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = cf})
    currentTween:Play()
end

local function EquipTool()
    local char = GetChar()
    if not char or char:FindFirstChildOfClass("Tool") then return end
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() char.Humanoid:EquipTool(tool) end)
            break
        end
    end
end

local function HasQuest()
    local ok, result = pcall(function()
        local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
        return main and main:FindFirstChild("Quest") and main.Quest.Visible
    end)
    return ok and result
end

