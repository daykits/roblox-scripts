--====================================================================
-- TARGET REGISTRIES (CollectionService + events, no per-frame scans)
--====================================================================
local lootRegistry = { sets = {}, maid = createMaid() }

local function trackTaggedEnemies()
	local function add(instance)
		if instance:IsA("Model") then
			enemyRegistry.tagged[instance] = true
		end
	end
	for _, instance in ipairs(CollectionService:GetTagged(CONFIG.EnemyTag)) do
		add(instance)
	end
	enemyRegistry.maid.give(CollectionService:GetInstanceAddedSignal(CONFIG.EnemyTag):Connect(add))
	enemyRegistry.maid.give(CollectionService:GetInstanceRemovedSignal(CONFIG.EnemyTag):Connect(function(instance)
		enemyRegistry.tagged[instance] = nil
	end))
end

local function bindEnemyFolder()
	if enemyRegistry.folder then return end
	local folder = findByPath(Workspace, CONFIG.FallbackEnemyFolderPath)
	if not folder then return end
	enemyRegistry.folder = folder
	for _, descendant in ipairs(folder:GetDescendants()) do
		if descendant:IsA("Model") then
			enemyRegistry.folderSet[descendant] = true
		end
	end
	enemyRegistry.maid.give(folder.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("Model") then
			enemyRegistry.folderSet[descendant] = true
		end
	end))
	enemyRegistry.maid.give(folder.DescendantRemoving:Connect(function(descendant)
		enemyRegistry.folderSet[descendant] = nil
	end))
end

local function trackLootTags()
	for _, tag in ipairs(CONFIG.LootTags) do
		local set = weakTable()
		lootRegistry.sets[tag] = set
		for _, instance in ipairs(CollectionService:GetTagged(tag)) do
			set[instance] = true
		end
		lootRegistry.maid.give(CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance)
			set[instance] = true
		end))
		lootRegistry.maid.give(CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
			set[instance] = nil
		end))
	end
end

--====================================================================
-- MOVEMENT HELPER (one tween at a time, always cancellable)
--====================================================================
local function createMover()
	local mover = { tween = nil, goal = nil, completed = nil }
	function mover.cancel()
		if mover.completed then
			mover.completed:Disconnect()
			mover.completed = nil
		end
		if mover.tween then
			mover.tween:Cancel()
			mover.tween:Destroy()
			mover.tween = nil
		end
		mover.goal = nil
	end
	function mover.isMoving()
		return mover.tween ~= nil
	end
	function mover.moveTo(root, goalCFrame)
		mover.cancel()
		local distance = (root.Position - goalCFrame.Position).Magnitude
		local duration = math.max(distance / CONFIG.TweenSpeed, 0.05)
		local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goalCFrame })
		mover.tween = tween
		mover.goal = goalCFrame
		mover.completed = tween.Completed:Connect(mover.cancel)
		tween:Play()
	end
	return mover
end

local function faceFrom(position, lookAtPosition, fallbackLook)
	local flat = Vector3.new(lookAtPosition.X - position.X, 0, lookAtPosition.Z - position.Z)
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(fallbackLook.X, 0, fallbackLook.Z)
	end
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(position, position + flat.Unit)
end

local function holdStill(root)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

