-- Anti-AFK (Chống văng game)
game:GetService("Players").LocalPlayer.Idled:Connect(function()
    game:GetService("VirtualUser"):Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    task.wait(1)
    game:GetService("VirtualUser"):Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
end)

local MainTab = Window:CreateTab("Auto Farm", 4483345998)

MainTab:CreateSection("Tự Động Cày Quái Bằng Võ (Melee)")

_G.AutoFarm = false

MainTab:CreateToggle({
   Name = "Bật Auto Farm bằng Võ (Melee)",
   CurrentValue = false,
   Flag = "ToggleFarmMelee",
   Callback = function(Value)
      _G.AutoFarm = Value
      task.spawn(function()
          while _G.AutoFarm do
              task.wait()
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character or player.CharacterAdded:Wait()
                  
                  -- Lọc và chỉ cầm vũ khí Võ (Melee)
                  local currentTool = character:FindFirstChildOfClass("Tool")
                  if not currentTool or currentTool.ToolTip ~= "Melee" then
                      for _, tool in pairs(player.Backpack:GetChildren()) do
                          if tool:IsA("Tool") and tool.ToolTip == "Melee" then
                              character.Humanoid:EquipTool(tool)
                              break
                          end
                      end
                  end
                  
                  -- Tìm quái gần nhất
                  local nearestMob = nil
                  local minDistance = math.huge
                  
                  if workspace:FindFirstChild("Enemies") then
                      for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                          if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                              local dist = (character.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                              if dist < minDistance then
                                  minDistance = dist
                                  nearestMob = enemy
                              end
                          end
                      end
                  end
                  
                  -- Đánh quái
                  if nearestMob then
                      repeat
                          task.wait()
                          if not _G.AutoFarm or not nearestMob or not nearestMob:FindFirstChild("Humanoid") or nearestMob.Humanoid.Health <= 0 then break end
                          character.HumanoidRootPart.CFrame = nearestMob.HumanoidRootPart.CFrame * CFrame.new(0, 5, 0) * CFrame.Angles(math.rad(-90), 0, 0)
                          game:GetService("VirtualUser"):CaptureController()
                          game:GetService("VirtualUser"):ClickButton1(Vector2.new(500, 500))
                      until not _G.AutoFarm or not nearestMob or nearestMob.Humanoid.Health <= 0
                  end
              end)
          end
      end)
   end,
})

MainTab:CreateSection("Tự Động Nhặt Rương")

_G.AutoChest = false

MainTab:CreateToggle({
   Name = "Bật Auto Chest (Gom Rương Beli)",
   CurrentValue = false,
   Flag = "ToggleChest",
   Callback = function(Value)
      _G.AutoChest = Value
      task.spawn(function()
          while _G.AutoChest do
              task.wait(0.1)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character or player.CharacterAdded:Wait()
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  
                  if hrp then
                      for _, v in pairs(workspace:GetDescendants()) do
                          if not _G.AutoChest then break end
                          if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
                              repeat
                                  task.wait(0.05)
                                  if not _G.AutoChest or not v or not v.Parent or not v:FindFirstChild("TouchInterest") then break end
                                  hrp.CFrame = v.CFrame
                                  if firetouchinterest then
                                      firetouchinterest(hrp, v, 0)
                                      task.wait(0.05)
                                      firetouchinterest(hrp, v, 1)
                                  end
                              until not v or not v.Parent or not v:FindFirstChild("TouchInterest") or not _G.AutoChest
                          end
                      end
                  end
              end)
          end
      end)
   end,
})

