local function GetChar()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
        return c
    end
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    currentTargetPos = nil
    
    local char = GetChar()
    if char and char:FindFirstChild("HumanoidRootPart") then
        local bv = char.HumanoidRootPart:FindFirstChild("FlyBV")
        if bv then bv:Destroy() end
    end
end

