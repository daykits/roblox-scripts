local KavoLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = KavoLib.CreateLib("datdaykits Premium Hub", "DarkTheme")

_G.AutoSteal = false
_G.TweenSpeed = 80
local LocalPlayer = game:GetService("Players").LocalPlayer

-- Thuật toán cướp trứng siêu tốc dựa vào TouchInterest (Vùng chạm vật phẩm)
local function startEggStealer()
    local TweenService = game:GetService("TweenService")
    
    task.spawn(function()
        while _G.AutoSteal do
            local Character = LocalPlayer.Character
            local RootPart = Character and Character:FindFirstChild("HumanoidRootPart")
            
            if RootPart then
                -- Quét sâu vào hệ thống để tìm mọi thứ người chơi có thể chạm vào nhặt
                for _, obj in pairs(workspace:GetDescendants()) do
                    if not _G.AutoSteal then break end
                    
                    -- Nếu vật thể có chức năng "TouchInterest" (Vùng chạm để nhặt trứng/vật phẩm)
                    if obj:IsA("TouchTransmitter") or obj.Name == "TouchInterest" then
                        local eggPart = obj.Parent
                        
                        if eggPart homework and eggPart:IsA("BasePart") then
                            local distance = (RootPart.Position - eggPart.Position).Magnitude
                            
                            -- Khoảng cách an toàn để cướp trứng mượt mà
                            if distance > 2 and distance < 1500 then
                                local duration = distance / _G.TweenSpeed
                                local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(RootPart, tweenInfo, {CFrame = eggPart.CFrame})
                                tween:Play()
                                tween.Completed:Wait()
                                task.wait(0.05) -- Tốc độ nhặt cực nhanh
                            end
                        end
                    end
                end
            end
            task.wait(0.3)
        end
    end)
end

-- ==================== KHỞI TẠO MENU GIAO DIỆN ====================
local MainTab = Window:NewTab("Main Features")
local MainSection = MainTab:NewSection("Egg Automation")

-- Công tắc cướp trứng
MainSection:NewToggle("Auto Steal Eggs", "Tự động bay đến nhặt mọi loại trứng trên bản đồ", function(state)
    _G.AutoSteal = state
    if state then
        startEggStealer()
    end
end)

-- Thanh chỉnh tốc độ cướp trứng
MainSection:NewSlider("Steal Speed", "Tốc độ di chuyển", 150, 20, function(v)
    _G.TweenSpeed = v
end)

local PlayerTab = Window:NewTab("Player Options")
local PlayerSection = PlayerTab:NewSection("Character Hacks")

-- Chạy nhanh
PlayerSection:NewSlider("WalkSpeed (Tốc độ chạy)", "Thay đổi tốc độ chạy", 200, 16, function(v)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = v
    end
end)

-- Nhảy cao
PlayerSection:NewSlider("JumpPower (Lực nhảy)", "Thay đổi lực nhảy", 300, 50, function(v)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.JumpPower = v
    end
end)
