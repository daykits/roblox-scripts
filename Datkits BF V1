local function GetNet()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    if not modules then return nil end
    local net = modules:FindFirstChild("Net")
    if not net then return nil end
    return net:FindFirstChild("RE/RegisterAttack"), net:FindFirstChild("RE/RegisterHit")
end

local function DoFastAttackAlways()
    local char = GetCharacter()
    if not char then return end

    -- ✅ FIX: Không block loop khi equip
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool and Config.FastAttackAutoEquip then
        task.spawn(function()
            pcall(EquipWeapon)
        end)
    end

    -- ✅ Fire RegisterAttack
    local regAttack, regHit = GetNet()
    if regAttack then
        pcall(function() regAttack:FireServer(0.1) end)
    end

    -- ✅ Activate tool (nếu có config)
    if tool and Config.FastAttackUseToolAct then
        pcall(function() tool:Activate() end)
    end

    -- ✅ Tìm mục tiêu
    local hits = {}
    local useRange = math.max(Config.AlwaysAttackRange, Config.HitboxRange)

    if Config.AutoBoss then
        local bosses
        if Config.BossSelected then
            bosses = FindAllBossesInRange(useRange, Config.BossSelected)
        else
            bosses = FindAllBossesInRange(useRange)
        end
        for _, b in ipairs(bosses) do
            table.insert(hits, { enemy = b.boss, hrp = b.hrp, dist = b.dist })
        end
    end

    if #hits == 0 then
        local enemies = GetClosestEnemies(useRange)
        for _, e in ipairs(enemies) do
            table.insert(hits, { enemy = e.enemy, hrp = e.hrp, dist = e.dist })
        end
    end

    if #hits == 0 and Config.AutoBoss then
        local bosses = FindAllBossesInRange(useRange)
        for _, b in ipairs(bosses) do
            table.insert(hits, { enemy = b.boss, hrp = b.hrp, dist = b.dist })
        end
    end

    -- ✅ Fire LeftClickRemote (nếu có config + có tool)
    local hrp = char.HumanoidRootPart
    if tool and Config.FastAttackUseRemote then
        local lcRemote = tool:FindFirstChild("LeftClickRemote")
            or tool:FindFirstChild("Remote")
            or tool:FindFirstChildWhichIsA("RemoteEvent")

        if lcRemote then
            local dir = (#hits > 0)
                and (hits[1].hrp.Position - hrp.Position).Unit
                or Vector3.new(0, -1, 0)
            pcall(function() lcRemote:FireServer(dir, 1) end)
        end
    end

    -- ✅ Fire RegisterHit (multi-hit hoặc single target)
    if regHit and #hits > 0 and Config.FastAttackUseRegHit then
        if Config.FastAttackMultiHit then
            for _, data in ipairs(hits) do
                pcall(function()
                    regHit:FireServer(data.hrp, { data.enemy })
                end)
            end
        else
            pcall(function()
                regHit:FireServer(hits[1].hrp, { hits[1].enemy })
            end)
        end
    end
end

