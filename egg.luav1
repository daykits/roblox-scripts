local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Tạo RemoteEvent kết nối Client-Server
local autoEvent = ReplicatedStorage:FindFirstChild("AutoCollectEvent") or Instance.new("RemoteEvent", ReplicatedStorage)
autoEvent.Name = "AutoCollectEvent"

-- Bảng lưu trạng thái Bật/Tắt của từng người chơi
local activePlayers = {}

autoEvent.OnServerEvent:Connect(function(player, state)
    activePlayers[player.UserId] = state

    if state then
        task.spawn(function()
            while activePlayers[player.UserId] do
                local character = player.Character
                local hrp = character and character:FindFirstChild("HumanoidRootPart")
                
                -- Tìm khu vực Base của người chơi (Ví dụ: Thư mục Bases chứa tên Player)
                local playerBase = workspace:FindFirstChild("Bases") and workspace.Bases:FindFirstChild(player.Name)
                local basePart = playerBase and playerBase:FindFirstChild("SpawnPart")

                if hrp and basePart then
                    local eggFolder = workspace:FindFirstChild("Eggs")
                    if eggFolder then
                        for _, egg in pairs(eggFolder:GetChildren()) do
                            if not activePlayers[player.UserId] then break end

                            local eggPart = egg:IsA("BasePart") and egg or egg.PrimaryPart
                            if eggPart then
                                -- 1. Dịch chuyển đến vị trí quả trứng
                                hrp.CFrame = eggPart.CFrame + Vector3.new(0, 2, 0)
                                task.wait(0.1) -- Dừng ngắn để nhận diện nhặt trứng

                                -- 2. Dịch chuyển lập tức về lại Base của người chơi
                                hrp.CFrame = basePart.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.3) -- Nghỉ trước khi nhặt quả tiếp theo
                            end
                        end
                    end
                end
                task.wait(0.5)
            end
        end)
    end
end)

-- Xóa dữ liệu khi người chơi thoát game
game.Players.PlayerRemoving:Connect(function(player)
    activePlayers[player.UserId] = nil
end)
