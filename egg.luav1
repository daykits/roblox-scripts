local KavoLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = KavoLib.CreateLib("datdaykits Premium Hub", "DarkTheme")

local MainTab = Window:NewTab("Main")
local MainSection = MainTab:NewSection("Auto Steal Eggs")

getgenv().AutoSteal = false
getgenv().TweenSpeed = 70
local LocalPlayer = game:GetService("Players").LocalPlayer

local function startEggStealer()
    local TweenService = game:GetService("TweenService")
    
    task.spawn(function()
        while getgenv().AutoSteal do
            local Character = LocalPlayer.Character
            local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

            if HumanoidRootPart then
                -- Quét toàn bộ workspace để tìm bất kỳ vật thể nào có tên chứa chữ "Egg"
                for _, obj in pairs(workspace:GetDescendants()) do
                    if not getgenv().AutoSteal then break end

                    -- Kiểm tra xem tên vật thể có chữ Egg (không phân biệt hoa thường)
                    if string.find(string.lower(obj.Name), "egg") then
                        local targetPart = nil

                        if obj:IsA("BasePart") then
                            targetPart = obj
                        elseif obj:IsA("Model") and obj.PrimaryPart then
                            targetPart = obj.PrimaryPart
                        elseif obj:IsA("Model") then
                            targetPart = obj:FindFirstChildWhichIsA("BasePart")
                        end

                        if targetPart then
                            local distance = (HumanoidRootPart.Position - targetPart.Position).Magnitude
                            
                            -- Giới hạn khoảng cách hợp lý để tránh bị lỗi nhảy vị trí quá xa
                            if distance > 2 and distance < 2000 then
                                local tweenInfo = TweenInfo.new(distance / getgenv().TweenSpeed, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetPart.CFrame})

                                tween:Play()
                                tween.Completed:Wait()
                                task.wait(0.2) -- Thời gian dừng lại 0.2s để game nhận diện đã nhặt trứng
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

MainSection:NewToggle("Auto Steal", "Tự động nhặt trứng", function(state)
    getgenv().AutoSteal = state
    if state then
        startEggStealer()
    end
end)

MainSection:NewKeybind("e", "g", Enum.KeyCode.RightControl, function()
    KavoLib:ToggleUI()
end)
local TweenService = game:GetService("TweenService")

local function moveToTarget(character, targetPart)
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart or not targetPart then return end

    local distance = (humanoidRootPart.Position - targetPart.Position).Magnitude
    local speed = 16 -- Tốc độ di chuyển
    local duration = distance / speed

    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(humanoidRootPart, tweenInfo, {
        CFrame = targetPart.CFrame + Vector3.new(0, 2, 0) -- Nâng vị trí đích lên một chút để tránh kẹt đất
    })

    tween:Play()
end
-- Cơ chế xử lý tương tác khi nhân vật đến gần vật thể trong Roblox Studio
local ProximityPrompt = script.Parent -- Gắn script vào ProximityPrompt của vật thể

-- Sự kiện kích hoạt khi người chơi hoàn thành tương tác (giữ phím E)
ProximityPrompt.Triggered:Connect(function(player)
    print(player.Name .. " đã tương tác thành công với vật thể!")
    -- Thêm logic xử lý (ví dụ: cộng điểm, mở cửa, nhặt đồ...)
end)
-- Cơ chế lưu và quay trở lại vị trí ban đầu trong Roblox Studio
local function moveAndReturn(character, targetPart)
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart or not targetPart then return end

    -- 1. Lưu lại vị trí ban đầu của nhân vật
    local originalCFrame = humanoidRootPart.CFrame

    -- 2. Dịch chuyển nhân vật đến vị trí mục tiêu
    humanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
    
    -- Tạm dừng một khoảng ngắn để xử lý logic (ví dụ: nhặt item, kiểm tra sự kiện)
    task.wait(0.5)

    -- 3. Trở về vị trí ban đầu
    humanoidRootPart.CFrame = originalCFrame
end
