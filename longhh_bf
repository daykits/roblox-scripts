    local function processRequest(text, chatAtStart)
        local c = string.sub(text, 1, 1)
        local ok, err
        local w1 = string.lower(asc(words(text)[1] or ""))
        if c == "/" or c == "$" or c == ">" then
            ok, err = pcall(LX.Exec, string.sub(text, 2))
        elseif SHELLW[w1] and (#words(text) <= 3 or w1 == "help" or w1 == "ls") and not (w1 == "on" or w1 == "off" or w1 == "set") then
            ok, err = pcall(LX.Exec, text)
        elseif (w1 == "on" or w1 == "off" or w1 == "set" or w1 == "sel" or w1 == "press") and #words(text) >= 2 then
            ok, err = pcall(LX.Exec, text)
        else
            ok, err = pcall(LX.Ask, text)
        end
        if not ok then
            LX.Out("err", tostring(err))
            LX.Say("Có lỗi. Chán thật.", "annoyed")
        elseif LX.ChatVer == chatAtStart then
            LX.Say("Đã xử lý lệnh.", LX.Face)
        end
    end

    local function runQueue()
        while #LX.Queue > 0 and LX.Enabled do
            local text = table.remove(LX.Queue, 1)
            LX.Busy = #LX.Queue + 1
            LX.Thinking = true
            LX.SetMood("think", 0)
            if LX.OnThinking then
                pcall(LX.OnThinking, true)
            end
            task.wait(3)
            if not LX.Enabled then
                LX.Thinking = false
                break
            end
            LX.Thinking = false
            if LX.OnThinking then
                pcall(LX.OnThinking, false)
            end
            local chatAtStart = LX.ChatVer
            local ok, err = pcall(processRequest, text, chatAtStart)
            if not ok then
                LX.Out("err", tostring(err))
                LX.Say("Có lỗi khi xử lý. Thử lại sau.", "annoyed")
            end
            LX.Busy = #LX.Queue
        end
        LX.Thinking = false
        LX.Busy = 0
        if LX.OnThinking then
            pcall(LX.OnThinking, false)
        end
    end

    local queueRunning = false
    function LX.Handle(text)
        text = tostring(text or "")
        text = string.gsub(text, "^%s+", "")
        text = string.gsub(text, "%s+$", "")
        if text == "" or not LX.Enabled then
            return false
        end
        if #text > 240 then
            text = string.sub(text, 1, 240)
        end
        if #LX.Queue >= 5 then
            LX.Out("warn", "command queue full; wait for the current request")
            return false, "queue-full"
        end
        LX.User(text)
        table.insert(LX.Queue, text)
        LX.Busy = #LX.Queue + (queueRunning and 1 or 0)
        if not queueRunning then
            queueRunning = true
            task.spawn(function()
                runQueue()
                queueRunning = false
            end)
        end
        return true
    end

    function LX.Suggestions(query)
        local q = norm(query or "")
        local items = { }
        local function add(title, detail, command, category, base)
            local hay = norm(title .. " " .. detail .. " " .. command .. " " .. category)
            local score = base or 1
            if q ~= "" then
                if string.find(hay, q, 1, true) then
                    score = score + 100
                else
                    local matched, total = 0, 0
                    for token in string.gmatch(q, "%S+") do
                        total = total + 1
                        if string.find(hay, token, 1, true) then
                            matched = matched + 1
                        end
                    end
                    if total == 0 or matched == 0 then return end
                    score = score + matched / total * 20
                end
            end
            items[#items + 1] = {
