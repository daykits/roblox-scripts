Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Quest (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value

        if not Value then
            ResetCharacterState()
            Fluent:Notify({Title = "Auto Quest", Content = "Đã TẮT", Duration = 3})
            return
        end

        Fluent:Notify({Title = "Auto Quest", Content = "Đã BẬT", Duration = 3})

        -- Giữ vũ khí
        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(0.55)
            end
        end)

        -- Luồng chính
        task.spawn(function()
            while getgenv().AutoQuest do
                task.wait(0.1)

                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart

                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()

                    if not HasQuest() then
                        -- Chưa có quest → đi nhận
                        if npcCFrame then
                            local dist = (hrp.Position - npcCFrame.Position).Magnitude
                            if dist > 9 then
                                TweenTo(npcCFrame * CFrame.new(0, 0, 2), 240)
                            else
                                StopTween()
                                for i = 1, 6 do
                                    pcall(function()
                                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                    end)
                                    task.wait(0.1)
                                end
                                task.wait(0.7)
                            end
                        end
                    else
                        -- Đã có quest → farm bằng hàm tối ưu
                        local target = FindBestMob(mobName, 350)

                        if target and target:FindFirstChild("HumanoidRootPart") then
                            local pos = target.HumanoidRootPart.Position
                            local height = getgenv().FarmDistance or 6
                            local farmCF = CFrame.new(pos + Vector3.new(0, height, 0), pos)
                            TweenTo(farmCF, 255)

                            pcall(function()
                                target.HumanoidRootPart.CanCollide = false
                                target.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                                target.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
                            end)
                        else
                            if mobCFrame then
                                TweenTo(mobCFrame, 250)
                            end
                        end
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

