-- Vòng lặp duy trì Tốc độ 300
task.spawn(function()
    local player = game.Players.LocalPlayer
    while true do
        task.wait(0.1)
        if getgenv().FastSpeed then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.WalkSpeed ~= 300 then
                humanoid.WalkSpeed = 300
            end
        end
    end
end)

-- Vòng lặp chính xử lý Auto Farm
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.3)
        
        if getgenv().AutoFarm then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                local homeCFrame = rootPart.CFrame
                
                for _, targetPos in ipairs(eggPositions) do
                    if not getgenv().AutoFarm then break end
                    
                    pcall(function()
                        -- 1. Bay đến vị trí trứng
                        for i = 1, 3 do
                            safeTeleport(CFrame.new(targetPos + Vector3.new(0, 1.5, 0)))
                            task.wait(0.05)
                        end
                        task.wait(0.3)
                        
                        -- 2. Đứng im và giữ nút E trong 3.5 giây để nhặt
                        holdEPickup()
                        
                        -- 3. Vòng lặp chờ tối đa 3 giây để xác nhận đã có trứng trên tay
                        local hasEgg = false
                        local checkTimer = tick()
                        while (tick() - checkTimer) < 3 do
                            if equipEggTool() then
                                hasEgg = true
                                break
                            end
                            task.wait(0.2)
                        end
                        
                        -- 4. Nếu đã nhặt thành công trứng -> Bay về nhà
                        if hasEgg then
                            task.wait(0.3)
                            for i = 1, 3 do
                                safeTeleport(homeCFrame)
                                task.wait(0.05)
                            end
                            
                            -- Chờ 2 giây tại nhà để game xử lý cất trứng
                            task.wait(2)
                        else
                            -- Nếu chưa nhặt được (ví dụ trứng chưa hồi), bay về nhà chờ rồi tiếp tục
                            safeTeleport(homeCFrame)
                            task.wait(1)
                        end
                    end)
                end
            end
        end
    end
end)
