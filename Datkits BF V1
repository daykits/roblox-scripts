-- ==================== AUTO CHEST ====================
local chestCache = {}
local lastChestScan = 0

local function IsChestObject(obj)
    if not obj then return false end
    local n = string.lower(obj.Name or "")
    return n == "chest1" or n == "chest2" or n == "chest3"
end

local function GetChestPart(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        local p = obj.PrimaryPart
        if p and p:IsA("BasePart") then return p end
        local child = obj:FindFirstChild("Chest")
        if child and child:IsA("BasePart") then return child end
        for _, d in ipairs(obj:GetDescendants()) do
            if d:IsA("BasePart") then return d end
        end
    end
    return nil
end

local function ChestAvailable(part)
    if not part or not part.Parent then return false end
    local transparent = false
    pcall(function() transparent = part.Transparency >= 1 end)
    return not transparent
end

local function RefreshChests()
    table.clear(chestCache)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if IsChestObject(obj) then
            local part = GetChestPart(obj)
            if ChestAvailable(part) then
                table.insert(chestCache, part)
            end
        end
    end
    lastChestScan = os.clock()
end

local function FindNearestChest()
    local char, _, hrp = GetCharacter()
    if not char or not hrp then return nil end
    if os.clock() - lastChestScan > 1.2 or #chestCache == 0 then
        RefreshChests()
    end

    local best, dist = nil, math.huge
    for i = #chestCache, 1, -1 do
        local part = chestCache[i]
        if not ChestAvailable(part) then
            table.remove(chestCache, i)
        else
            local d = (part.Position - hrp.Position).Magnitude
            if d < dist then
                dist = d
                best = part
            end
        end
    end
    return best
end

local function CollectChest(part)
    if not part then return end
    local char, _, hrp = GetCharacter()
    if not char or not hrp then return end

    local dist = (part.Position - hrp.Position).Magnitude
    if dist > (tonumber(getgenv().ChestDistance) or 6) + 1 then return end

    pcall(function()
        if firetouchinterest then
            firetouchinterest(hrp, part, 0)
            task.wait(0.05)
            firetouchinterest(hrp, part, 1)
        end
    end)
    pcall(function()
        if part:FindFirstChildOfClass("ClickDetector") and fireclickdetector then
            fireclickdetector(part:FindFirstChildOfClass("ClickDetector"))
        end
    end)
    pcall(function()
        local prompt = part:FindFirstChildOfClass("ProximityPrompt")
        if prompt and fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end)
end

-- ==================== MAIN FARM LOOP ====================
local farmThread = 0
local chestThread = 0

local function StartAutoFarm()
    farmThread += 1
    local myThread = farmThread

    task.spawn(function()
        while getgenv().AutoFarm and myThread == farmThread do
            local ok, err = pcall(function()
                if getgenv().AutoChest then
                    task.wait(0.15)
                    return
                end

                local char = GetCharacter()
                local info = GetQuestInfo()
                if not char or not info then
                    StopMovement()
                    task.wait(0.5)
                    return
                end

                if not HasQuest() then
                    EnsureQuest(info)
                else
                    local mob = FindBestMob(info)
                    if mob then
                        local hum = mob:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health > 0 then
                            local target = GetFarmTarget(mob)
                            if target then
                                MoveTo(target, 5, getgenv().MoveSpeed, "farm")
                                pcall(function()
                                    local root = mob:FindFirstChild("HumanoidRootPart")
                                    if root then
                                        root.CanCollide = false
                                        root.AssemblyLinearVelocity = Vector3.zero
                                    end
                                end)
                            end
                        end
                    else
                        -- Stay near the correct farm area instead of moving to a wrong global point.
                        local target = info.MobCFrame * CFrame.new(0, getgenv().FarmHeight or 8, 0)
                        MoveTo(target, 10, getgenv().MoveSpeed, "farm-area")
                    end
                end
            end)

            if not ok then
                warn("[Datkits V4] Farm error:", err)
                StopMovement()
            end
            task.wait(0.12)
        end
        StopMovement()
    end)
end

local function StartAutoChest()
    chestThread += 1
    local myThread = chestThread

    task.spawn(function()
        while getgenv().AutoChest and myThread == chestThread do
            local ok, err = pcall(function()
                local chest = FindNearestChest()
                if not chest then
                    StopMovement()
                    task.wait(0.5)
                    return
                end

                local offset = math.max(3, tonumber(getgenv().ChestDistance) or 6)
                local targetPos = chest.Position + Vector3.new(0, 0, offset)
                local target = CFrame.lookAt(targetPos, chest.Position)
                local char, _, hrp = GetCharacter()
                if char and hrp then
                    local dist = (chest.Position - hrp.Position).Magnitude
                    if dist > offset + 1.5 then
                        MoveTo(target, offset + 1, getgenv().ChestSpeed, "chest")
                    else
                        StopMovement()
                        CollectChest(chest)
                        task.wait(0.2)
                    end
                end
            end)

            if not ok then
                warn("[Datkits V4] Chest error:", err)
                StopMovement()
            end
            task.wait(0.15)
        end
    end)
end

