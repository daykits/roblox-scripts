        end
        local function djCollectCandy(valid)
            local visited = setmetatable({ }, { __mode = "k" })
            local t0 = tick()
            while valid() and tick() - t0 < 10 and #djCandyItems() == 0 do
                djHold()
                task.wait(0.1)
            end
            local startT, lastSeen = tick(), tick()
