-- Kiểm tra có Quest trong UI chưa
local function HasQuest()
    local player = game.Players.LocalPlayer
    if player and player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("Main") then
        local questGui = player.PlayerGui.Main:FindFirstChild("Quest")
        if questGui and questGui.Visible then
            return true
        end
    end
    return false
end

-- Tự cầm Võ / Vũ khí trên tay
local function EquipMeleeWeapon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then return currentTool end

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            char.Humanoid:EquipTool(tool)
            return tool
        end
    end
end

-- HỆ THỐNG DI CHUYỂN TWEEN MƯỢT TUYỆT ĐỐI (KHÔNG KHỰNG)
local currentTween = nil
local currentTweenTarget = nil

local function StopTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    currentTweenTarget = nil
end

local function TweenTo(targetCFrame, speed)
    speed = speed or 250
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    -- Bật Noclip và PlatformStand tránh kẹt địa hình
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    hum.PlatformStand = true

    local distance = (hrp.Position - targetCFrame.Position).Magnitude

    -- Đã đến rất gần mục tiêu (< 10 studs)
    if distance <= 10 then
        StopTween()
        hrp.CFrame = targetCFrame

        local bv = hrp:FindFirstChild("FarmFlyBV")
        if not bv then
            bv = Instance.new("BodyVelocity")
            bv.Name = "FarmFlyBV"
            bv.Parent = hrp
        end
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        return
    end

    -- Khi đang bay đường dài: Tắt MaxForce để không bị khựng giật
    local bv = hrp:FindFirstChild("FarmFlyBV")
    if bv then
        bv.MaxForce = Vector3.new(0, 0, 0)
    end

    -- Nếu đang có Tween chạy và vị trí đích chưa đổi xa -> Giữ nguyên Tween (Không reset liên tục)
    if currentTween and currentTweenTarget and (currentTweenTarget - targetCFrame.Position).Magnitude < 12 then
        return
    end

    StopTween()
    currentTweenTarget = targetCFrame.Position
    local duration = distance / speed
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
    currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    currentTween:Play()
end

-- Reset trạng thái vật lý nhân vật
local function ResetPlayerPhysics()
    StopTween()
    local player = game.Players.LocalPlayer
    if player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
        
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("FarmFlyBV")
            if bv then bv:Destroy() end
        end
    end
end

-- Lấy Quái gần nhất thuộc nhiệm vụ
local function GetNearestEnemy(mobNameFilter)
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end

    local hrp = char.HumanoidRootPart
    local nearest = nil
    local minDist = math.huge

    if workspace:FindFirstChild("Enemies") then
        for _, enemy in pairs(workspace.Enemies:GetChildren()) do
            if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                if not mobNameFilter or string.find(enemy.Name:lower(), mobNameFilter:lower()) then
                    local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                    if dist < minDist then
                        minDist = dist
                        nearest = enemy
                    end
                end
            end
        end
    end
    return nearest
end

-- VÒNG LẶP ĐÁNH QUÁI (TỰ VUNG TAY + CLICK CHUỘT THỰC TẾ)
task.spawn(function()
    while true do
        task.wait(_G.FastAttack and 0.05 or 0.2)
        if _G.AutoFarm or _G.AutoQuest then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                local tool = char:FindFirstChildOfClass("Tool")
                if tool and tool:IsA("Tool") then
                    -- 1. Kích hoạt vũ khí vung tay
                    tool:Activate()
                    
                    -- 2. Giả lập Click chuột trái thực tế (Chắc chắn gây sát thương)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)

                    -- 3. Gửi thêm Remote Server Blox Fruits
                    local rep = game:GetService("ReplicatedStorage")
                    local net = rep:FindFirstChild("Modules") and rep.Modules:FindFirstChild("Net")
                    if net then
                        local regAttack = net:FindFirstChild("RE/RegisterAttack")
                        local regHit = net:FindFirstChild("RE/RegisterHit")
                        
                        if regAttack then regAttack:FireServer(0) end
                        
                        if regHit and workspace:FindFirstChild("Enemies") then
                            for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                                if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                    local dist = (char.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                                    if dist <= 45 then
                                        regHit:FireServer(enemy.HumanoidRootPart, {enemy})
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- TÍNH NĂNG AUTO QUEST SEA 1
MainTab:CreateToggle({
   Name = "Bật Auto Quest Sea 1 (Sửa Lỗi Đánh Quái)",
   CurrentValue = false,
   Flag = "ToggleAutoQuest",
   Callback = function(Value)
      _G.AutoQuest = Value

      if not Value then
          ResetPlayerPhysics()
      end

      -- Luồng giữ vũ khí
      task.spawn(function()
          while _G.AutoQuest do
              task.wait(0.5)
              pcall(function()
                  EquipMeleeWeapon()
              end)
          end
      end)

      -- Luồng xử lý Nhiệm Vụ & Đánh Quái
      task.spawn(function()
          local currentTargetMob = nil

          while _G.AutoQuest do
              task.wait(0.05)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character
                  if not character then return end
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  if not hrp then return end

                  local questName, questLevel, mobName, npcCFrame, mobCFrame = GetSea1QuestData()

                  -- BƯỚC 1: Nếu chưa có Quest -> Bay tới NPC nhận Quest
                  if not HasQuest() then
                      currentTargetMob = nil
                      if npcCFrame then
                          local distToNPC = (hrp.Position - npcCFrame.Position).Magnitude
                          if distToNPC > 10 then
                              TweenTo(npcCFrame, 250)
                          else
                              StopTween()
                              hrp.CFrame = npcCFrame
                              game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                              task.wait(0.8)
                          end
                      end
                  -- BƯỚC 2: Đã nhận Quest -> Bay đến và đánh đúng quái Quest
                  else
                      -- Tìm quái mới nếu quái hiện tại đã chết/mất
                      if not (currentTargetMob and currentTargetMob.Parent and currentTargetMob:FindFirstChild("Humanoid") and currentTargetMob.Humanoid.Health > 0 and currentTargetMob:FindFirstChild("HumanoidRootPart")) then
                          currentTargetMob = GetNearestEnemy(mobName)
                      end

                      if currentTargetMob and currentTargetMob:FindFirstChild("HumanoidRootPart") then
                          local mobHRP = currentTargetMob.HumanoidRootPart
                          local mobPos = mobHRP.Position
                          local height = _G.FarmDistance or 5
                          local targetCFrame = CFrame.new(mobPos + Vector3.new(0, height, 0), mobPos)
                          local distToMob = (hrp.Position - mobPos).Magnitude

                          if distToMob > 10 then
                              TweenTo(targetCFrame, 250)
                          else
                              StopTween()
                              hrp.CFrame = targetCFrame

                              local bv = hrp:FindFirstChild("FarmFlyBV")
                              if not bv then
                                  bv = Instance.new("BodyVelocity")
                                  bv.Name = "FarmFlyBV"
                                  bv.Parent = hrp
                              end
                              bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                              bv.Velocity = Vector3.new(0, 0, 0)

                              mobHRP.CanCollide = false
                              mobHRP.Velocity = Vector3.new(0, 0, 0)
                          end
                      else
                          -- Quái chưa hồi -> Bay đến Bãi Quái nằm chờ
                          if mobCFrame then
                              TweenTo(mobCFrame, 250)
                          end
                      end
                  end
              end)
          end
      end)
   end,
})

-- TÍNH NĂNG AUTO GOM RƯƠNG (DI CHUYỂN TỪNG RƯƠNG MƯỢT MÀ)
local function GetSortedChests()
    local chests = {}
    local player = game.Players.LocalPlayer
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return chests end

    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and (v.Name:find("Chest") or v.Name:find("Rương")) and v:FindFirstChild("TouchInterest") then
            table.insert(chests, v)
        end
    end

    table.sort(chests, function(a, b)
        return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
    end)

    return chests
end

