Tabs.Main:AddToggle("AutoFarm", {
    Title = "Bật Auto Farm (Sea 1 + Sea 2)",
    Default = false,

    Callback = function(value)
        getgenv().AutoFarm = value
        farmToken = farmToken + 1

        local myToken = farmToken

        if not value then
            StopTween()
            SetNoclip(false)

            local char = GetChar()
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end

            lastTarget = nil

            Fluent:Notify({
                Title = "Auto Farm",
                Content = "Đã tắt Auto Farm",
                Duration = 3
            })

            return
        end

        Fluent:Notify({
            Title = "Auto Farm",
            Content = "Đã bật - Đang kiểm tra Quest...",
            Duration = 4
        })

        task.spawn(function()
            while getgenv().AutoFarm and myToken == farmToken do
                local ok, err = pcall(function()
                    local char = GetChar()

                    if not char then
                        StopTween()
                        task.wait(0.8)
                        return
                    end

                    local info = GetQuestInfo()
                    if not info then
                        task.wait(0.5)
                        return
                    end

                    local questKey =
                        tostring(info.Name) .. ":" ..
                        tostring(info.Level) .. ":" ..
                        tostring(info.Mob)

                    -- Nếu level/quest target thay đổi thì reset target.
                    if lastQuestKey ~= questKey then
                        lastQuestKey = questKey
                        lastTarget = nil
                        StopTween()
                    end

                    -- =================================================
                    -- BƯỚC 1: PHẢI CÓ QUEST
                    -- =================================================
                    if not HasQuest() then
                        lastTarget = nil

                        local gotQuest = EnsureQuest(info)

                        if not gotQuest then
                            task.wait(0.25)
                            return
                        end

                        task.wait(0.25)
                        return
                    end

                    -- =================================================
                    -- BƯỚC 2: ĐÃ CÓ QUEST -> TÌM ĐÚNG QUÁI
                    -- =================================================
                    local mob = FindMob(info.Mob)

                    if mob then
                        local hum = mob:FindFirstChildOfClass("Humanoid")
                        local ehrp = mob:FindFirstChild("HumanoidRootPart")

                        if hum and ehrp and hum.Health > 0 then
                            lastTarget = mob

                            pcall(function()
                                ehrp.CanCollide = false
                                ehrp.AssemblyLinearVelocity = Vector3.zero
                                ehrp.AssemblyAngularVelocity = Vector3.zero
                            end)

                            EquipTool()

                            local farmCF = GetFarmCFrame(mob)

                            if farmCF then
                                -- Chỉ cập nhật khi đổi quái hoặc vị trí đổi đáng kể.
                                local needMove = true

                                if currentTarget then
                                    local d =
                                        (currentTarget.Position - farmCF.Position).Magnitude

                                    if d < 5 and currentTween then
                                        needMove = false
                                    end
                                end

                                if needMove then
                                    TweenTo(farmCF)
                                end
                            end

                            task.wait(0.08)
                            return
                        end
                    end

                    -- =================================================
                    -- BƯỚC 3: CÓ QUEST NHƯNG CHƯA CÓ QUÁI
                    -- -> ĐI ĐÚNG BÃI CỦA QUEST
                    -- =================================================
                    lastTarget = nil

                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if not hrp then
                        task.wait(0.3)
                        return
                    end

                    local areaCF = info.MobArea
                    local distance = (hrp.Position - areaCF.Position).Magnitude

                    if distance > 10 then
                        TweenTo(areaCF)
                    else
                        StopTween()
                    end

                    task.wait(0.18)
                end)

                if not ok then
                    warn("[Datkits AutoFarm] Error:", err)
                    StopTween()
                    task.wait(0.6)
                end
            end
        end)
    end
})

