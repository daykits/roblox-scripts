-- TAB MAIN
MainTab:AddSection({"Auto Farm Level"})

MainTab:AddToggle({
    Name = "Auto Farm Level (1 -> 2550)",
    Default = false,
    Callback = function(Value)
        _G.AutoFarm = Value
        if not Value then StopFly() end

        task.spawn(function()
            local targetMob = nil
            while _G.AutoFarm do
                task.wait(0.05)
                pcall(function()
                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()
                    if not questName then return end

                    local char = LocalPlayer.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                    local hrp = char.HumanoidRootPart

                    if not HasQuest() then
                        targetMob = nil
                        if (hrp.Position - npcCFrame.Position).Magnitude > 12 then
                            FlyTo(npcCFrame)
                        else
                            StopFly()
                            hrp.CFrame = npcCFrame
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                            task.wait(0.5)
                        end
                    else
                        if not (targetMob and targetMob.Parent and targetMob:FindFirstChild("Humanoid") and targetMob.Humanoid.Health > 0) then
                            targetMob = GetNearestEnemy(mobName)
                        end

                        if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                            local mobPos = targetMob.HumanoidRootPart.Position
                            local targetCFrame = CFrame.new(mobPos + Vector3.new(0, _G.FarmDistance, 0), mobPos)

                            BringMobs(mobName, mobPos)

                            if (hrp.Position - mobPos).Magnitude > 12 then
                                FlyTo(targetCFrame)
                            else
                                StopFly()
                                hrp.CFrame = targetCFrame
                            end
                        else
                            if mobCFrame then FlyTo(mobCFrame) end
                        end
                    end
                end)
            end
        end)
    end
})

