-- Vòng lặp duy trì Tốc độ 300 liên tục (Chống game reset về 16)
task.spawn(function()
    local player = game.Players.LocalPlayer
    while true do
        task.wait(0.1)
        if getgenv().FastSpeed then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.WalkSpeed ~= 300 then
                humanoid.WalkSpeed = 300
            end
        end
    end
end)

-- Vòng lặp chính xử lý Auto Farm
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.3)
        
        if getgenv().AutoFarm then
            local success, err = pcall(function()
                local character = player.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                
                if rootPart then
                    local homeCFrame = rootPart.CFrame
                    local prompt, eggCF = getTargetPrompt(homeCFrame.Position)
                    
                    if prompt and eggCF then
                        for i = 1, 3 do
                            safeTeleport(eggCF * CFrame.new(0, 3, 0))
                            task.wait(0.05)
                        end
                        task.wait(0.3)
                        
                        if fireproximityprompt then
                            fireproximityprompt(prompt, 0, true)
                            fireproximityprompt(prompt)
                        else
                            prompt:InputHoldBegin()
                            task.wait(prompt.HoldDuration + 0.1)
                            prompt:InputHoldEnd()
                        end
                        task.wait(0.8)
                        
                        equipTool()
                        task.wait(0.2)
                        
                        for i = 1, 3 do
                            safeTeleport(homeCFrame)
                            task.wait(0.05)
                        end
                        
                        task.wait(3)
                    else
                        Rayfield:Notify({
                            Title = "Đang tìm trứng...",
                            Content = "Không tìm thấy nút nhặt trứng nào ở xa nhà!",
                            Duration = 2,
                            Image = 4483362458
                        })
                        task.wait(2)
                    end
                end
            end)
            
            if not success then
                warn("[AutoFarm Error]: " .. tostring(err))
            end
        end
    end
end)
