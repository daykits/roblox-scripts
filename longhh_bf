    local OldGetQuestPoint = GetQuestPoint
    local PosQResolved = { }
    local function QuestKeyOf(mob)
        for r, qset in pairs(Quests) do
            if type(qset) == "table" then
                for _, qd in pairs(qset) do
                    if type(qd) == "table" and type(qd.Task) == "table" and qd.Task[mob] ~= nil then
                        return r
                    end
                end
            end
        end
        return nil
    end
    local function ResolveBadPosQ(mobName, ent, maxGap)
        local okOld, oldCF = pcall(OldGetQuestPoint)
        if okOld and typeof(oldCF) == "CFrame" and (oldCF.Position - ent.PosM.Position).Magnitude <= maxGap then
            return oldCF, "vanta-LastClosestNPC"
        end
        local key = QuestKeyOf(mobName)
        local qset = key and Quests[key]
        if type(qset) == "table" then
            for _, qd in pairs(qset) do
                if type(qd) == "table" and type(qd.Task) == "table" then
                    for other in pairs(qd.Task) do
                        local e2 = other ~= mobName and MobQuestPositions[other] or nil
                        if e2 and (e2.PosQ.Position - e2.PosM.Position).Magnitude <= maxGap then
                            return e2.PosQ, "cung-quest:" .. tostring(other)
                        end
                    end
                end
            end
        end
        return nil, "khong-co-diem-hop-le"
    end
    GetQuestPoint = function(mobName)
        if mobName and MobQuestPositions[mobName] then
            local ent = MobQuestPositions[mobName]
            local fxq = _G.FARMX
            if fxq and fxq.Enable and fxq.Enable.QuestPosGuard == false then
                return ent.PosQ
            end
            local maxGap = (fxq and fxq.Cfg and fxq.Cfg.QuestPosMaxGap) or 2000
            if (ent.PosQ.Position - ent.PosM.Position).Magnitude <= maxGap then
                return ent.PosQ
            end
            local r = PosQResolved[mobName]
            local now = os.clock()
            if not r or now - r.t > 5 then
                local cf, why = ResolveBadPosQ(mobName, ent, maxGap)
                r = { t = now, cf = cf, why = why }
                PosQResolved[mobName] = r
                if fxq and fxq.Log then
                    fxq.Log("questpos-guard", tostring(mobName) .. " PosQ lech > " .. tostring(maxGap) .. " stud -> " .. why)
                end
            end
            return r.cf
        end
        return OldGetQuestPoint()
    end
    GetMobFarmPosition = function(mobName)
        if mobName and MobQuestPositions[mobName] then
            return MobQuestPositions[mobName].PosM
        end
        return nil
    end
