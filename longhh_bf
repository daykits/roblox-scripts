    LX.Registry = buildReg
    local function hasTok(P, w)
        if P[w] then
            return true
        end
        if #w >= 4 then
            for p in pairs(P) do
                if #p >= 4 and (string.find(p, w, 1, true) or string.find(w, p, 1, true)) then
                    return true
                end
            end
        end
        return false
    end
    local function cover(toks, P)
        local n = #toks
        if n == 0 then
            return 0, 0
        end
        local m = 0
        for _, w in ipairs(toks) do
            if hasTok(P, w) then
                m = m + 1
            end
        end
        local s = m / n
        if m == n then
            s = s + 0.25 + 0.12 * math.min(m, 4)
        elseif m > 0 then
            s = s - 0.05
        end
        return s, m
    end
    local function scoreItem(it, phrase, P)
        local s1 = cover(it.toks, P)
        local s2 = cover(it.itoks, P)
        local best = math.max(s1, s2 * 0.9)
        if #it.nt >= 3 and string.find(phrase, it.nt, 1, true) then
            best = best + 0.3
        end
        return best
    end
    local function resolve(phrase, want)
        local P = { }
        for _, w in ipairs(words(phrase)) do
            if not FILL[w] and not tonumber(w) then
                P[w] = true
            end
        end
        local list = { }
        for _, it in ipairs(buildReg()) do
            if not want or want[it.type] then
                local s = scoreItem(it, phrase, P)
                if s >= 0.6 then
                    list[#list + 1] = { it = it, s = s }
                end
            end
        end
        table.sort(list, function(a, b)
            if a.s ~= b.s then
                return a.s > b.s
            end
            return #a.it.nt > #b.it.nt
        end)
        if #list == 0 then
            return nil, list
        end
        local gap = list[2] and (list[1].s - list[2].s) or 1
        if gap >= 0.12 then
            return list[1].it, list
        end
        return nil, list
    end

