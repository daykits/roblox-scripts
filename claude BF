local esp = { entries = {}, maid = createMaid(), folder = nil, elapsed = 0 }

local function isTeammate(player)
	return localPlayer.Team ~= nil and player.Team == localPlayer.Team
end

local function shouldShowESP(player)
	if player == localPlayer then return false end
	return not (CONFIG.ESP.HideTeammates and isTeammate(player))
end

local function createBillboard(adornee)
	local gui = Instance.new("BillboardGui")
	gui.Name = "UtilityMenuESP"
	gui.Adornee = adornee
	gui.AlwaysOnTop = true
	gui.Size = UDim2.fromOffset(150, 36)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.ResetOnSpawn = false
	gui.Parent = esp.folder

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, 22)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Parent = gui

	local barBack = Instance.new("Frame")
	barBack.Position = UDim2.new(0.1, 0, 0, 26)
	barBack.Size = UDim2.new(0.8, 0, 0, 5)
	barBack.BackgroundColor3 = Color3.new(0, 0, 0)
	barBack.BackgroundTransparency = 0.3
	barBack.BorderSizePixel = 0
	barBack.Parent = gui

	local barFill = Instance.new("Frame")
	barFill.Size = UDim2.fromScale(1, 1)
	barFill.BorderSizePixel = 0
	barFill.Parent = barBack
	return gui, label, barBack, barFill
end

local function destroyEntryObjects(entry)
	for _, object in ipairs({ entry.highlight, entry.billboard }) do
		object:Destroy()
	end
	entry.highlight, entry.billboard, entry.label, entry.barBack, entry.barFill = nil, nil, nil, nil, nil
end

local function setEntryVisible(entry, visible)
	if entry.highlight then entry.highlight.Enabled = visible end
	if entry.billboard then entry.billboard.Enabled = visible end
end

local function buildEntryObjects(entry, character)
	local head = character:WaitForChild("Head", 5)
	if not head or esp.entries[entry.player] ~= entry or entry.player.Character ~= character then return end
	if entry.highlight then destroyEntryObjects(entry) end
	local highlight = Instance.new("Highlight")
	highlight.Name = "UtilityMenuESP"
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = CONFIG.ESP.FillTransparency
	highlight.OutlineTransparency = CONFIG.ESP.OutlineTransparency
	highlight.Parent = character
	entry.highlight = highlight
	entry.billboard, entry.label, entry.barBack, entry.barFill = createBillboard(head)
end

local function buildLabelText(player, humanoid, distance)
	local parts = {}
	if CONFIG.ESP.ShowNames then table.insert(parts, player.DisplayName) end
	if CONFIG.ESP.ShowDistance then table.insert(parts, string.format("%d studs", math.floor(distance + 0.5))) end
	if CONFIG.ESP.ShowHealth then
		table.insert(parts, string.format("HP %d/%d", math.floor(humanoid.Health + 0.5), math.floor(humanoid.MaxHealth + 0.5)))
	end
	return table.concat(parts, " | ")
end

local function refreshEntry(entry)
	if not entry.highlight then return end
	local character = entry.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local localRoot = getRoot()
	if not (humanoid and root and localRoot) or humanoid.Health <= 0 or not shouldShowESP(entry.player) then
		setEntryVisible(entry, false)
		return
	end
	setEntryVisible(entry, true)
	local color = isTeammate(entry.player) and CONFIG.ESP.TeamColor or CONFIG.ESP.EnemyColor
	entry.highlight.FillColor = color
	entry.highlight.OutlineColor = color
	local distance = (root.Position - localRoot.Position).Magnitude
	entry.label.Text = buildLabelText(entry.player, humanoid, distance)
	entry.label.TextColor3 = color
	local ratio = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
	entry.barBack.Visible = CONFIG.ESP.ShowHealth
	entry.barFill.Size = UDim2.fromScale(ratio, 1)
	entry.barFill.BackgroundColor3 = CONFIG.ESP.HealthLow:Lerp(CONFIG.ESP.HealthHigh, ratio)
end

local function refreshAllESP()
	for _, entry in pairs(esp.entries) do
		refreshEntry(entry)
	end
end

local function bindPlayerESP(player)
	if player == localPlayer or esp.entries[player] then return end
	local entry = { player = player, maid = createMaid() }
	esp.entries[player] = entry
	entry.maid.give(player.CharacterAdded:Connect(function(character)
		buildEntryObjects(entry, character)
		refreshEntry(entry)
	end))
	entry.maid.give(player.CharacterRemoving:Connect(function()
		if entry.highlight then destroyEntryObjects(entry) end
	end))
	entry.maid.give(player:GetPropertyChangedSignal("Team"):Connect(function()
		refreshEntry(entry)
	end))
	if player.Character then
		task.spawn(buildEntryObjects, entry, player.Character)
	end
end

local function unbindPlayerESP(player)
	local entry = esp.entries[player]
	if not entry then return end
	esp.entries[player] = nil
	entry.maid.clean()
	if entry.highlight then destroyEntryObjects(entry) end
end

local function espStep(dt)
	esp.elapsed += dt
	if esp.elapsed >= CONFIG.ESP.UpdateInterval then
		esp.elapsed = 0
		refreshAllESP()
	end
end

local function startESP()
	esp.folder = esp.maid.give(Instance.new("Folder"))
	esp.folder.Name = "UtilityMenuESPFolder"
	esp.folder.Parent = playerGui
	for _, player in ipairs(Players:GetPlayers()) do
		bindPlayerESP(player)
	end
	esp.maid.give(Players.PlayerAdded:Connect(bindPlayerESP))
	esp.maid.give(Players.PlayerRemoving:Connect(unbindPlayerESP))
	esp.maid.give(localPlayer:GetPropertyChangedSignal("Team"):Connect(refreshAllESP))
	esp.maid.give(RunService.Heartbeat:Connect(espStep))
end

local function stopESP()
	esp.maid.clean()
	for player in pairs(esp.entries) do
		unbindPlayerESP(player)
	end
	esp.folder = nil
end

features.PlayerESP = { display = "Player ESP", enabled = false, start = startESP, stop = stopESP }

--====================================================================
-- FEATURE MANAGER
--====================================================================
local function refreshToggle(name)
	local toggle = ui.toggles[name]
	if toggle then toggle.set(features[name].enabled) end
end

local function runFeatureHook(feature, hookName)
	local ok, err = pcall(feature[hookName])
	if not ok then
		warn(string.format("[UtilityMenu] %s.%s failed: %s", feature.display, hookName, tostring(err)))
		notify(feature.display .. " error (see output)", "error")
	end
	return ok
end

local function setFeature(name, enabled)
	local feature = features[name]
	if feature.enabled == enabled then return end
	if enabled then
		local other = EXCLUSIVE[name]
		if other and features[other].enabled then
			features[other].enabled = false
			runFeatureHook(features[other], "stop")
			refreshToggle(other)
		end
		if feature.canStart then
			local ok, reason = feature.canStart()
			if not ok then
				notify(reason, "error")
				refreshToggle(name)
				return
			end
		end
		feature.enabled = true
		if not runFeatureHook(feature, "start") then
			feature.enabled = false
			runFeatureHook(feature, "stop")
		end
	else
		feature.enabled = false
		runFeatureHook(feature, "stop")
	end
	refreshToggle(name)
	notify(feature.display .. (feature.enabled and " enabled" or " disabled"), feature.enabled and "success" or "info")
end

--====================================================================
-- UI HELPERS
--====================================================================
local THEME = {
	Background = Color3.fromRGB(24, 26, 33), Panel = Color3.fromRGB(38, 41, 52),
	Accent = Color3.fromRGB(88, 140, 255), Text = Color3.fromRGB(235, 238, 245),
	Muted = Color3.fromRGB(150, 156, 170), Success = Color3.fromRGB(60, 170, 100),
	Error = Color3.fromRGB(200, 70, 70), Warning = Color3.fromRGB(210, 150, 50),
	Info = Color3.fromRGB(70, 110, 190),
}
local FONT = Enum.Font.Gotham
local TITLE_HEIGHT = 32
local orderCounter = 0

local function nextOrder()
	orderCounter += 1
	return orderCounter
end

local function create(className, properties, parent)
	local instance = Instance.new(className)
	for property, value in pairs(properties) do
		instance[property] = value
	end
	instance.Parent = parent
	return instance
end

local function addCorner(instance, radius)
	create("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, instance)
end

local function getViewport()
	local camera = Workspace.CurrentCamera
	return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

local function snapValue(value)
	return math.floor(value * 10 + 0.5) / 10
end

local function isPointerInput(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function isMoveInput(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
end

local function createNotifications(gui)
	local container = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
	}, gui)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }, container)
	local threads = {}
	runtime.maid.give(function()
		for thread in pairs(threads) do
			if coroutine.status(thread) ~= "dead" then task.cancel(thread) end
		end
	end)
	local colors = { success = THEME.Success, error = THEME.Error, warning = THEME.Warning, info = THEME.Info }
	notify = function(text, kind)
		if runtime.destroyed or not container.Parent then return end
		local children = container:GetChildren()
		if #children > 5 then children[2]:Destroy() end -- [1] is the UIListLayout
		local label = create("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = colors[kind] or THEME.Info, TextColor3 = Color3.new(1, 1, 1),
			Font = FONT, TextSize = 13, Text = text, LayoutOrder = nextOrder(),
		}, container)
		addCorner(label, 6)
		local thread
		thread = task.delay(CONFIG.NotificationSeconds, function()
			threads[thread] = nil
			if label.Parent then label:Destroy() end
		end)
		threads[thread] = true
	end
end

local function makeDraggable(handle, target)
	local dragging, dragStart, startPosition, dragInput = false, nil, nil, nil
	handle.InputBegan:Connect(function(input)
		if isPointerInput(input) then
			dragging, dragStart, startPosition = true, input.Position, target.AbsolutePosition
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if isMoveInput(input) then dragInput = input end
	end)
	runtime.maid.give(UserInputService.InputChanged:Connect(function(input)
		if dragging and input == dragInput then
			local delta = input.Position - dragStart
			local viewport = getViewport()
			local x = math.clamp(startPosition.X + delta.X, 0, math.max(viewport.X - target.AbsoluteSize.X, 0))
			local y = math.clamp(startPosition.Y + delta.Y, 0, math.max(viewport.Y - TITLE_HEIGHT, 0))
			target.Position = UDim2.fromOffset(x, y)
		end
	end))
end

