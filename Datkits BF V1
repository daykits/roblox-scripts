-- Bay qua các khu vực Sea 3 để đánh quái tự động
-------------------------------------------------
local Sea3State = {
    CurrentIndex = 1,
    LastTargetPos = nil,
    StuckCounter = 0,
    LastCheckTime = 0,
}

local function AutoSea3FarmLoop()
    while task.wait(0.3) do
        if not Config.AutoSea3Farm then
            if Sea3State.LastTargetPos then
                Sea3State.LastTargetPos = nil
            end
            continue
        end

        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            if not hrp then return end

            -- ✅ Ưu tiên 1: Tìm quái trong bán kính Sea3FarmRange
            local hits = GetClosestEnemies(Config.Sea3FarmRange)
            if #hits > 0 then
                local target = hits[1]
                local pos = target.hrp.Position
                local targetCF = CFrame.new(
                    pos + Vector3.new(0, Config.FarmDistance, 0),
                    pos
                )
                SetMoveTarget(targetCF)

                -- Reset stuck counter khi tìm thấy quái
                Sea3State.StuckCounter = 0
                Sea3State.LastTargetPos = pos
                return
            end

            -- ✅ Ưu tiên 2: Không có quái gần → bay tới khu vực tiếp theo
            local currentPos = hrp.Position

            -- Nếu đã tới vị trí target cũ mà vẫn không có quái → chuyển khu vực
            if Sea3State.LastTargetPos then
                local distToLast = (currentPos - Sea3State.LastTargetPos).Magnitude
                if distToLast < 30 then
                    Sea3State.StuckCounter = Sea3State.StuckCounter + 1
                    if Sea3State.StuckCounter >= 3 then
                        -- Chuyển sang khu vực tiếp theo
                        Sea3State.CurrentIndex = Sea3State.CurrentIndex + 1
                        if Sea3State.CurrentIndex > #Sea3Enemies then
                            Sea3State.CurrentIndex = 1
                        end
                        Sea3State.StuckCounter = 0
                    end
                end
            end

            -- Bay tới khu vực hiện tại
            local areaData = Sea3Enemies[Sea3State.CurrentIndex]
            if areaData then
                local targetPos = areaData.pos + Vector3.new(0, Config.FarmDistance, 0)
                local targetCF = CFrame.new(targetPos)
                SetMoveTarget(targetCF)
                Sea3State.LastTargetPos = areaData.pos
            end
        end)
    end
end

