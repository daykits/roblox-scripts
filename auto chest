-- Hàm lấy nhân vật
local function GetCharacter()
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	char:WaitForChild("HumanoidRootPart", 10)
	return char
end

-- Hàm quét rương
local function ScanChests()
	ChestCache = {}

	-- Ưu tiên dùng tag _ChestTagged của Blox Fruits
	local tagged = CollectionService:GetTagged("_ChestTagged")
	for _, chest in ipairs(tagged) do
		if chest:IsA("BasePart") and chest:FindFirstChild("TouchInterest") then
			table.insert(ChestCache, chest)
		end
	end

	-- Fallback: quét theo tên chứa "Chest"
	if #ChestCache == 0 then
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("BasePart")
				and obj.Name:find("Chest")
				and obj:FindFirstChild("TouchInterest") then
				table.insert(ChestCache, obj)
			end
		end
	end
end

-- Vòng lặp nhặt rương
task.spawn(function()
	while task.wait(0.1) do
		if not AutoChestEnabled then continue end

		local char = LocalPlayer.Character
		if not char then continue end

		local root = char:FindFirstChild("HumanoidRootPart")
		if not root then continue end

		-- Bật no-clip khi đang farm rương
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end

		-- Quét lại rương nếu cần
		if ChestRescan then
			ScanChests()
			ChestRescan = false
		end

		-- Sắp xếp theo khoảng cách gần nhất
		table.sort(ChestCache, function(a, b)
			return (root.Position - a.Position).Magnitude
				< (root.Position - b.Position).Magnitude
		end)

		-- Teleport đến rương gần nhất
		local nearest = ChestCache[1]
		if nearest and (root.Position - nearest.Position).Magnitude < 5000 then
			root.CFrame = nearest.CFrame
		end

		-- Nếu hết rương thì đánh dấu quét lại
		if #ChestCache == 0 then
			ChestRescan = true
			task.wait(1)
		end
	end
end)

