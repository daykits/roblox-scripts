    function LX.DoMusic(action, query)
        local mx = Library.MusicX
        if not (mx and mx.n and mx.track) then
            LX.Out("err", "music player unavailable")
            return false, "unavailable"
        end
        local count = tonumber(mx.n()) or 0
        if action == "open" then
            return LX.DoOpenTab("music")
        end
        if count <= 0 then
            LX.Out("err", "music playlist is empty")
            return false, "empty"
        end
        action = norm(action or "play")
        local current, playing
        if mx.cur then
            current, playing = mx.cur()
        end
        if action == "play" or action == "resume" then
            local resumed = false
            if mx.pause then
                local ok, result = pcall(mx.pause, false)
                resumed = ok and result == true
            end
            if not resumed then
                pcall(mx.play, current or 1)
            end
        elseif action == "pause" then
            if not (mx.pause and mx.pause(true)) then
                LX.Out("warn", "no active music to pause")
                return false, "notplaying"
            end
        elseif action == "stop" then
            pcall(mx.stop)
        elseif action == "next" then
            pcall(mx.next)
        elseif action == "prev" or action == "previous" then
            pcall(mx.prev)
        elseif action == "random" or action == "shuffle" then
            if mx.rand then
                pcall(mx.rand)
            else
                pcall(mx.next)
            end
        elseif action == "volume" then
            local amount = tonumber(query)
            if not (amount and mx.vol) then
                LX.Out("err", "music volume requires a number from 0 to 100")
                return false, "volume"
            end
            pcall(mx.vol, amount)
        elseif action == "find" or action == "search" or action == "select" then
            local q = norm(query or "")
            if q == "" then
                LX.Out("err", "song name required")
                return false, "query"
            end
            local best, bestScore = nil, 0
            for i = 1, count do
                local track = mx.track(i)
                local hay = norm(table.concat({
                    tostring(track and track.name or ""),
                    tostring(track and track.artist or ""),
                    tostring(track and track.label or "")
                }, " "))
                local score = 0
                if hay == q then
                    score = 100
                elseif string.find(hay, q, 1, true) then
                    score = 80
                else
                    for token in string.gmatch(q, "%S+") do
                        if string.find(hay, token, 1, true) then
                            score = score + 10
                        end
                    end
                end
                if score > bestScore then
                    best, bestScore = i, score
                end
            end
            if not best or bestScore <= 0 then
                LX.Out("err", "song not found: " .. asc(query))
                return false, "notfound"
            end
            pcall(mx.play, best)
            current = best
        else
            LX.Out("err", "unknown music action: " .. asc(action))
            return false, "action"
        end
        LX.Out("cmd", "music " .. action)
        if current and mx.track then
            local track = mx.track(current)
            if track then
                LX.Out("out", tostring(track.name or "Track") .. " — " .. tostring(track.artist or ""))
            end
        end
        LX.Out("ok", "music command sent")
        return true, current
    end
