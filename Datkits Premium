-------------------------------------------------
-- CLASS CHARACTER (CHUYỂN ĐỔI TỪ PYTHON SANG LUA)
-------------------------------------------------
local CharacterClass = {}
CharacterClass.__index = CharacterClass

function CharacterClass.new(x, y, z, speed)
    local self = setmetatable({}, CharacterClass)
    self.x = x or 0
    self.y = y or 0
    self.z = z or 0
    self.speed = speed or 3
    self.currentQuest = nil
    self.moving = false
    return self
end

function CharacterClass:AcceptQuest(quest)
    self.currentQuest = quest
    quest.isActive = true
    self.moving = true
    print("Đã nhận nhiệm vụ: " .. tostring(quest.name))
end

function CharacterClass:Update()
    if self.moving and self.currentQuest then
        local targetX, targetY, targetZ = self.currentQuest.targetPos.X, self.currentQuest.targetPos.Y, self.currentQuest.targetPos.Z
        local dx = targetX - self.x
        local dy = targetY - self.y
        local dz = targetZ - self.z
        
        -- Tương đương math.hypot trong Python (Khoảng cách Vector 3D)
        local distance = math.sqrt(dx * dx + dy * dy + dz * dz)

        if distance > 2 then -- Chưa tới nơi
            dx, dy, dz = dx / distance, dy / distance, dz / distance -- Chuẩn hóa Vector
            self.x = self.x + (dx * self.speed)
            self.y = self.y + (dy * self.speed)
            self.z = self.z + (dz * self.speed)
        else
            self.moving = false
            self:OnArrived()
        end
    end
end

function CharacterClass:OnArrived()
    print("Đã đến nơi có quái! Bắt đầu chiến đấu...")
    if self.currentQuest then
        self.currentQuest.isCompleted = true
    end
end

