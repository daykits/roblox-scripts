--------------------------------------------------------------------------------
-- DI CHUYỂN BẰNG BODYVELOCITY (KHÔNG KHÓA PHÍM)
--------------------------------------------------------------------------------
local function StopFly()
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("RedzFly") then
            hrp.RedzFly:Destroy()
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function FlyTo(targetCFrame)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.PlatformStand = false end

    local dist = (hrp.Position - targetCFrame.Position).Magnitude

    if dist <= 10 then
        StopFly()
        hrp.CFrame = targetCFrame
        return
    end

    local bv = hrp:FindFirstChild("RedzFly")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "RedzFly"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Parent = hrp
    end

    bv.Velocity = (targetCFrame.Position - hrp.Position).Unit * 260
    hrp.CFrame = CFrame.new(hrp.Position, targetCFrame.Position)
end

