-- HOP BOSS SYSTEM
-------------------------------------------------
local HopState = {
    IsHopping = false,
    LastHopTime = 0,
    HopCount = 0,
    ServerList = {},
    LastServerFetch = 0,
    JustHoppedTime = 0,
    NoBossTimer = 0,
    JoinedServerList = {},
}

local function FetchServerList()
    if tick() - HopState.LastServerFetch < 20 and #HopState.ServerList > 0 then
        return HopState.ServerList
    end

    local servers = {}
    local placeId = game.PlaceId
    local jobId = game.JobId

    local ok, result = pcall(function()
        local url
        if Config.HopMethod == "Queue" then
            url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
                placeId
            )
        elseif Config.HopMethod == "Descending" then
            url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100",
                placeId
            )
        else
            url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?limit=100",
                placeId
            )
        end
        return HttpService:JSONDecode(game:HttpGet(url))
    end)

    if ok and result and result.data then
        for _, server in ipairs(result.data) do
            if server.id and server.id ~= jobId and server.playing < server.maxPlayers then
                if not HopState.JoinedServerList[server.id] then
                    if Config.HopSameServer or server.id ~= jobId then
                        table.insert(servers, {
                            id = server.id,
                            playing = server.playing or 0,
                            maxPlayers = server.maxPlayers or 12,
                        })
                    end
                end
            end
        end
    end

    table.sort(servers, function(a, b) return a.playing < b.playing end)

    HopState.ServerList = servers
    HopState.LastServerFetch = tick()

    return servers
end

local function HopToNextServer()
    if HopState.IsHopping then return end

    if tick() - HopState.LastHopTime < Config.HopCooldown then
        return
    end

    HopState.IsHopping = true
    HopState.LastHopTime = tick()
    HopState.HopCount = HopState.HopCount + 1

    local servers = FetchServerList()

    if #servers == 0 then
        Fluent:Notify({
            Title    = "🌐 Hop Boss",
            Content  = "Không tìm thấy server nào! Thử lại sau.",
            Duration = 5,
        })
        HopState.IsHopping = false
        return
    end

    local targetServer = servers[1]

    Fluent:Notify({
        Title    = "🌐 Hop Boss",
        Content  = string.format("Đang hop (Hop #%d) → Server %d/%d người",
            HopState.HopCount, targetServer.playing, targetServer.maxPlayers),
        Duration = 4,
    })

    HopState.JoinedServerList[targetServer.id] = true

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(
            game.PlaceId,
            targetServer.id,
            LocalPlayer
        )
    end)

    if not ok then
        Fluent:Notify({
            Title    = "🌐 Hop Boss",
            Content  = "Lỗi teleport: " .. tostring(err),
            Duration = 5,
        })
        HopState.IsHopping = false
    end
end

local function AutoHopBossLoop()
    while task.wait(1) do
        if not Config.AutoHopBoss then
            HopState.NoBossTimer = 0
            continue
        end

        if HopState.IsHopping then continue end
        if not Config.BossSelected then continue end

        pcall(function()
            local char = GetCharacter()
            if not char then return end

            local found = FindBoss(Config.BossSelected)
            local hasBoss = #found > 0

            if hasBoss then
                HopState.NoBossTimer = 0
                return
            end

            HopState.NoBossTimer = HopState.NoBossTimer + 1

            if Config.HopAutoSpawnFirst and HopState.NoBossTimer == 3 then
                TrySpawnBoss(Config.BossSelected)
            end

            if HopState.NoBossTimer >= Config.HopAfterNoSpawn then
                HopState.NoBossTimer = 0

                Fluent:Notify({
                    Title    = "🌐 Hop Boss",
                    Content  = "Không có " .. Config.BossSelected .. " → Hop server khác",
                    Duration = 4,
                })

                HopToNextServer()
            end
        end)
    end
end

local function InitAfterHop()
    HopState.JustHoppedTime = tick()

    task.spawn(function()
        task.wait(Config.HopDelay)
        HopState.IsHopping = false
        HopState.NoBossTimer = 0

        local found = FindBoss(Config.BossSelected)
        if #found > 0 then
            Fluent:Notify({
                Title    = "🎯 Boss Found!",
                Content  = "Đã hop vào server có " .. (Config.BossSelected or "boss"),
                Duration = 4,
            })
        else
            Fluent:Notify({
                Title    = "🌐 Hop Boss",
                Content  = "Server mới không có boss → sẽ hop tiếp...",
                Duration = 4,
            })
        end
    end)
end

