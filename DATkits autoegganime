-- Vòng lặp chính xử lý Auto Farm (đã thêm anti-detection delays)
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        -- delay ngẫu nhiên giữa các vòng lặp chính
        randomWait(0.22, 0.45)
        
        if getgenv().AutoFarm then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                local homeCFrame = rootPart.CFrame
                
                for _, targetPos in ipairs(eggPositions) do
                    if not getgenv().AutoFarm then break end
                    
                    pcall(function()
                        -- 1. Bay đến vị trí trứng (có random delay)
                        for i = 1, 3 + math.random(0, 2) do
                            safeTeleport(CFrame.new(targetPos + Vector3.new(0, 1.8 + math.random() * 0.6, 0)))
                            randomWait(0.03, 0.07)
                        end
                        randomWait(0.18, 0.35) -- đứng im một chút trước khi nhặt
                        
                        -- 2. Nhặt trứng
                        holdEPickup()
                        randomWait(0.25, 0.5)
                        
                        -- 3. Chờ kiểm tra đã có trứng trên tay (tối đa ~2.8s, có random)
                        local hasEgg = false
                        local checkTimer = tick()
                        local maxCheckTime = 2.2 + math.random() * 0.8
                        
                        while (tick() - checkTimer) < maxCheckTime do
                            if equipEggTool() then
                                hasEgg = true
                                break
                            end
                            -- thử nhặt lại nếu chưa có
                            if (tick() - checkTimer) > (0.7 + math.random() * 0.4) then
                                holdEPickup()
                            end
                            randomWait(0.12, 0.22)
                        end
                        
                        -- 4. Nếu đã nhặt thành công → về nhà
                        if hasEgg then
                            randomWait(0.15, 0.35)
                            for i = 1, 3 + math.random(0, 2) do
                                safeTeleport(homeCFrame)
                                randomWait(0.03, 0.07)
                            end
                            -- chờ game xử lý cất trứng (random dài hơn)
                            randomWait(1.5, 2.4)
                        else
                            -- chưa nhặt được → về nhà chờ rồi tiếp
                            safeTeleport(homeCFrame)
                            randomWait(0.6, 1.1)
                        end
                    end)
                    
                    -- delay nhỏ giữa các vị trí trứng
                    if getgenv().AutoFarm then
                        randomWait(0.15, 0.4)
                    end
                end
            end
        end
    end
end)
