-- ✅ AUTO CHEST
-------------------------------------------------
local function FindAllChests()
    local chests = {}
    local found = {}

    local function scanContainer(container, depth)
        if depth > 3 then return end
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Model") and (obj.Name:find("Chest") or obj.Name == "Chest") then
                local part = obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)
                if part and part:FindFirstChild("TouchInterest") then
                    if not found[part] then
                        found[part] = true
                        table.insert(chests, part)
                    end
                end
            elseif obj:IsA("Part") and obj.Name:find("Chest") then
                if obj:FindFirstChild("TouchInterest") then
                    if not found[obj] then
                        found[obj] = true
                        table.insert(chests, obj)
                    end
                end
            elseif obj:IsA("MeshPart") and obj.Name:find("Chest") then
                if obj:FindFirstChild("TouchInterest") then
                    if not found[obj] then
                        found[obj] = true
                        table.insert(chests, obj)
                    end
                end
            end

            if obj:IsA("Folder") or obj:IsA("Model") then
                if obj.Name:find("Chest") or obj.Name:find("chest")
                    or obj.Name == "ChestFolder" or obj.Name == "Chests"
                    or depth < 2
                then
                    scanContainer(obj, depth + 1)
                end
            end
        end
    end

    scanContainer(workspace, 0)
    return chests
end

local function AutoChestLoop()
    while task.wait(0.2) do
        if not Config.AutoChest then continue end
        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            if not hrp then return end

            local chests = FindAllChests()
            if #chests == 0 then return end

            local validChests = {}
            for _, chest in ipairs(chests) do
                local dist = (hrp.Position - chest.Position).Magnitude
                if dist <= Config.ChestRange then
                    table.insert(validChests, { chest = chest, dist = dist })
                end
            end

            if #validChests == 0 then return end

            table.sort(validChests, function(a, b) return a.dist < b.dist end)
            local target = validChests[1].chest
            local targetDist = validChests[1].dist

            if targetDist > 8 then
                SetMoveTarget(target.CFrame)
            else
                SetMoveTarget(target.CFrame)
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(hrp, target, 0)
                        task.wait(0.03)
                        firetouchinterest(hrp, target, 1)
                    end)
                end
            end
        end)
    end
end

-------------------------------------------------
-- ✅ AUTO QUEST v4.1
-------------------------------------------------
local QuestState = {
    Phase = "idle",
    LastQuest = nil,
    LastQLv = nil,
    LastQuestTime = 0,
    JustTookQuest = false,
    JustTookTime = 0,
}

local function AutoQuestLoop()
    while task.wait(0.15) do
        if not Config.AutoQuest then
            if Move.Active then StopFly() end
            QuestState.Phase = "idle"
            QuestState.JustTookQuest = false
            continue
        end

        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            if not hrp then return end

            local entry = GetQuestData()
            if not entry then return end

            local quest = entry.quest
            local qlv = entry.lv
            local mob = entry.mob
            local npcCF = entry.npc
            local spawnCF = entry.spawn

            local hasQuest = HasQuest()
            if QuestState.JustTookQuest and (tick() - QuestState.JustTookTime) < 3 then
                hasQuest = true
            end

            -- PHASE 1: ĐÃ CÓ QUEST → BAY TỚI BÃI QUÁI
            if hasQuest then
                QuestState.Phase = "toMob"

                local hits = GetClosestEnemies(math.huge, mob)
                if #hits == 0 then
                    hits = GetClosestEnemies(1000)
                end

                if #hits > 0 then
                    local target = hits[1]
                    local pos = target.hrp.Position
                    local targetCF = CFrame.new(
                        pos + Vector3.new(0, Config.FarmDistance, 0),
                        pos
                    )
                    SetMoveTarget(targetCF)
                elseif spawnCF then
                    local distToSpawn = (hrp.Position - spawnCF.Position).Magnitude
                    if distToSpawn > 15 then
                        SetMoveTarget(spawnCF + Vector3.new(0, Config.FarmDistance, 0))
                    else
                        SetMoveTarget(CFrame.new(hrp.Position))
                    end
                end
                return
            end

            -- PHASE 2: CHƯA CÓ QUEST → ĐI TỚI NPC
            QuestState.Phase = "toNPC"
            if not npcCF then return end

            local distToNPC = (hrp.Position - npcCF.Position).Magnitude

            if distToNPC > 12 then
                SetMoveTarget(npcCF * CFrame.new(0, 0, 3))
                QuestState.Phase = "toNPC"
            else
                QuestState.Phase = "atNPC"
                SetMoveTarget(CFrame.new(hrp.Position))

                local now = tick()
                local needCall = (QuestState.LastQuest ~= quest)
                    or (QuestState.LastQLv ~= qlv)
                    or (now - QuestState.LastQuestTime > 5)

                if needCall then
                    QuestState.LastQuest = quest
                    QuestState.LastQLv = qlv
                    QuestState.LastQuestTime = now

                    pcall(function()
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest, qlv)
                    end)

                    QuestState.JustTookQuest = true
                    QuestState.JustTookTime = tick()
                end
            end
        end)
    end
end

