        -- ===== Auto Summon + Farm Boss Dapper Jack =====
        local DJ_BOSS, DJ_GATE = "Dapper Jack", "Hellfire Gas"
        local djTok = 0
        local function alive(m)
            if not m or not m.Parent then return false end
            local hum = m:FindFirstChildOfClass("Humanoid")
            return hum ~= nil and hum.Health > 0 and m:FindFirstChild("HumanoidRootPart") ~= nil
        end
        local function djIslandCF()
            if World1 then
                return CFrame.new(-703.16748, 9.55188751, 1575.1864)
            elseif World2 then
                return CFrame.new(-385.250916, 73.0458984, 297.388397)
            elseif World3 then
                return CFrame.new(-12548, 337, -7481)
            end
            return nil
        end
        local DJ_SEARCH_RADIUS = 6000
        local DJ_ARENA_PAD_XZ, DJ_ARENA_PAD_Y = 100, 180
        local DJ_INTERACT_RANGE = 16
        local djScanCache = setmetatable({ }, { __mode = "k" })
        local function djFindNested(root, name, maxDistance, requireAlive)
            if not root then return nil end
            local h = getRoot()
            local targetName = normName(name)
            local function inRange(obj)
                if not obj or (requireAlive and not alive(obj)) then return false end
                local cf = pivotOf(obj)
                if not cf then return false end
                if not h or not maxDistance then return true end
                return (cf.Position - h.Position).Magnitude <= maxDistance
            end
            local direct = root:FindFirstChild(name)
            if direct and inRange(direct) then return direct end
            for _, child in ipairs(root:GetChildren()) do
                if normName(child.Name) == targetName and inRange(child) then return child end
            end
            local now = os.clock()
            local perRoot = djScanCache[root]
            if not perRoot then
                perRoot = { }
                djScanCache[root] = perRoot
            end
            local state = perRoot[name]
            if state and now - state.at < 0.75 then
                local cached = state.object
                if cached and cached.Parent and inRange(cached) then return cached end
                return nil
            end
            local best, bestD
            for _, obj in ipairs(root:GetDescendants()) do
                if normName(obj.Name) == targetName and (obj:IsA("Model") or obj:IsA("BasePart")) and inRange(obj) then
                    local cf = pivotOf(obj)
                    local d = h and cf and (cf.Position - h.Position).Magnitude or 0
                    if not bestD or d < bestD then best, bestD = obj, d end
                end
            end
            perRoot[name] = { at = now, object = best }
            return best
        end
        local function djDirectNamed(root, name, requireAlive, maxDistance)
            if not root then return nil end
            local h = getRoot()
            local function valid(obj)
                if not obj or (requireAlive and not alive(obj)) then return false end
                local cf = pivotOf(obj)
                if not cf then return false end
                return not h or not maxDistance or (cf.Position - h.Position).Magnitude <= maxDistance
            end
            local direct = root:FindFirstChild(name)
            if valid(direct) then return direct end
            local target = normName(name)
            for _, child in ipairs(root:GetChildren()) do
                if normName(child.Name) == target and valid(child) then return child end
            end
            return nil
        end
        local function djFindNamed(name)
            local en = workspace:FindFirstChild("Enemies")
            local npcs = workspace:FindFirstChild("NPCs")
            local map = workspace:FindFirstChild("Map")
            local roots = { }
            if en then
                roots[#roots + 1] = en
            end
            if npcs then
                roots[#roots + 1] = npcs
            end
            if map then
                roots[#roots + 1] = map
            end
            roots[#roots + 1] = workspace
            -- First pass: direct children of the expected containers and workspace root.
            for _, root in ipairs(roots) do
                local direct = djDirectNamed(root, name, true, DJ_SEARCH_RADIUS)
                if direct then return direct end
            end
            local now = os.clock()
            local key = "named:" .. normName(name)
            local perRoot = djScanCache[workspace]
            if not perRoot then
                perRoot = { }
                djScanCache[workspace] = perRoot
            end
            local state = perRoot[key]
            if state and now - state.at < 0.5 then
                if state.object and alive(state.object) then
                    local r = state.object:FindFirstChild("HumanoidRootPart")
                    local h = getRoot()
                    if not h or (r and (r.Position - h.Position).Magnitude <= DJ_SEARCH_RADIUS) then
                        return state.object
                    end
                end
                return nil
            end
            local h = getRoot()
            local best, bestD
            local seen = setmetatable({ }, { __mode = "k" })
            -- Recursive fallback searches the event containers first, then the full workspace once.
            local deepRoots = { }
            if en then
                deepRoots[#deepRoots + 1] = en
            end
            if npcs then
                deepRoots[#deepRoots + 1] = npcs
            end
            if map then
                deepRoots[#deepRoots + 1] = map
            end
            deepRoots[#deepRoots + 1] = workspace
            for _, root in ipairs(deepRoots) do
                if root then
                    for _, obj in ipairs(root:GetDescendants()) do
                        if not seen[obj] then
                            seen[obj] = true
                            if obj:IsA("Model") and normName(obj.Name) == normName(name) and alive(obj) then
                                local r = obj:FindFirstChild("HumanoidRootPart")
                                local d = h and r and (r.Position - h.Position).Magnitude or 0
                                if not h or (r and d <= DJ_SEARCH_RADIUS) then
                                    if not bestD or d < bestD then best, bestD = obj, d end
                                end
                            end
                        end
                    end
                end
            end
            perRoot[key] = { at = now, object = best }
            return best
        end
        local function djFindGate()
            return djFindNamed(DJ_GATE)
        end
        local function djFindBoss()
            return djFindNamed(DJ_BOSS) or djFindNamed(DJ_GATE)
        end
        local function djHold()
            local h = getRoot()
            if h then
                pcall(_tp, h.CFrame)
            end
        end
        local function djWait(sec, valid)
            local t0 = tick()
            while tick() - t0 < sec and valid() do
                djHold()
                task.wait(0.1)
            end
            return valid()
        end
        local function djReachWitch(valid)
            local deadline = tick() + 180
            while valid() and tick() < deadline do
                task.wait(0.1)
                local h = getRoot()
                if not h then return false end
                local npcs = workspace:FindFirstChild("NPCs")
                local map = workspace:FindFirstChild("Map")
                local w = djDirectNamed(npcs, "Witch", false, DJ_SEARCH_RADIUS) or djDirectNamed(workspace, "Witch", false, DJ_SEARCH_RADIUS) or djDirectNamed(map, "Witch", false, DJ_SEARCH_RADIUS)
                local wcf = w and pivotOf(w)
                if not wcf then
                    w = djFindNested(workspace, "Witch", DJ_SEARCH_RADIUS, false)
                    wcf = w and pivotOf(w)
                end
                if wcf then
                    if (h.Position - wcf.Position).Magnitude <= DJ_INTERACT_RANGE then
                        djHold()
                        return true
                    end
                    pcall(_tp, CFrame.new(wcf.Position))
                else
                    local icf = djIslandCF()
                    if not icf then return false end
                    if (h.Position - icf.Position).Magnitude <= 40 then
                        djHold()
                    else
                        pcall(_tp, icf)
                    end
                end
            end
            return false
        end
        local function djSummon()
            return pcall(function()
                return game:GetService("ReplicatedStorage").Remotes.DapperJackRitual:InvokeServer("Summon")
