local function GetBoat()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and hum.SeatPart then
        local seat  = hum.SeatPart
        local model = seat:FindFirstAncestorOfClass("Model")
        if model then
            local vs = model:FindFirstChildWhichIsA("VehicleSeat", true)
            if vs and vs.Occupant == hum then return model, vs end
        end
    end
    return nil
end

local function SailTo(targetPos, speed)
    speed = speed or Config.SailSpeed
    local boat = GetBoat()
    if not boat then return false end
    local root = boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart")
    if not root then return false end

    if Config.InstantSail then
        local cf = root.CFrame
        local dir = targetPos - cf.Position
        if dir.Magnitude > 1 then
            root.CFrame = CFrame.new(targetPos, targetPos + dir.Unit)
        end
        return true
    end

    local bv = root:FindFirstChild("SailBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name     = "SailBV"
        bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        bv.Parent   = root
    end
    local bg = root:FindFirstChild("SailBG")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name      = "SailBG"
        bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        bg.P         = 3000
        bg.D         = 100
        bg.Parent    = root
    end

    local delta = targetPos - root.Position
    local dist  = delta.Magnitude
    if dist <= 8 then
        bv.Velocity = Vector3.zero
        bg.CFrame   = root.CFrame
        return true
    end
    bv.Velocity = delta.Unit * speed
    bg.CFrame   = CFrame.new(root.Position, targetPos)
    return true
end

local function StopSail()
    local boat = GetBoat()
    if not boat then return end
    local root = boat.PrimaryPart or boat:FindFirstChildWhichIsA("BasePart")
    if not root then return end
    for _, name in ipairs({ "SailBV", "SailBG" }) do
        local obj = root:FindFirstChild(name)
        if obj then obj:Destroy() end
    end
end

