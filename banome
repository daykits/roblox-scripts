--=============================================================
-- PHASE 5: MOVEMENT CONTROLLER (Priority System)
--=============================================================

local Move = {
    Active     = false,
    TargetCF   = nil,
    SmoothPos  = nil,
    BoundHRP   = nil,
    AlignPos   = nil,
    AlignOri   = nil,
    Attach     = nil,
    Priority   = 0,
    LockUntil  = 0,
    LastSetTime = 0,
}

local function CleanupMoveInstances()
    if Move.AlignPos then pcall(function() Move.AlignPos:Destroy() end) end
    if Move.AlignOri then pcall(function() Move.AlignOri:Destroy() end) end
    if Move.Attach   then pcall(function() Move.Attach:Destroy()   end) end
    Move.AlignPos = nil
    Move.AlignOri = nil
    Move.Attach   = nil
    Move.BoundHRP = nil
end

local function EnsureMoveInstances(hrp)
    if not hrp or not hrp.Parent then return false end
    if Move.BoundHRP == hrp and Move.AlignPos and Move.AlignPos.Parent then return true end
    
    CleanupMoveInstances()
    
    local att = Instance.new("Attachment")
    att.Name = "BananaAtt"
    att.Parent = hrp
    
    local ap = Instance.new("AlignPosition")
    ap.Name = "BananaAP"
    ap.Attachment0 = att
    ap.Mode = Enum.PositionAlignmentMode.OneAttachment
    ap.Position = hrp.Position
    ap.MaxForce = 60000
    ap.Responsiveness = 25
    ap.ApplyAtCenterOfMass = false
    ap.MaxVelocity = 250
    ap.Parent = hrp
    
    local ao = Instance.new("AlignOrientation")
    ao.Name = "BananaAO"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.CFrame = hrp.CFrame
    ao.MaxTorque = 60000
    ao.Responsiveness = 30
    ao.Parent = hrp
    
    Move.BoundHRP = hrp
    Move.AlignPos = ap
    Move.AlignOri = ao
    Move.Attach   = att
    return true
end

local function StartFly()
    local char = GetCharacter()
    if not char then return false end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end
    if not EnsureMoveInstances(hrp) then return false end
    
    pcall(function() hum.PlatformStand = true end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
    
    if not Move.Active then
        Move.SmoothPos = hrp.Position
        Move.Active = true
    end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    return true
end

local function StopFly()
    if not Move.Active then return end
    Move.Active = false
    Move.TargetCF = nil
    Move.SmoothPos = nil
    Move.Priority = 0
    
    local hum = GetHumanoid()
    if hum then
        pcall(function() hum.PlatformStand = false end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

-- SetMoveTarget với Priority - điểm mấu chốt
local function SetMoveTarget(targetCFrame, priority)
    if not targetCFrame then return end
    priority = priority or 5
    local now = tick()
    
    -- Nếu priority thấp hơn cái đang lock → bỏ qua
    if Move.Active and now < Move.LockUntil and priority < Move.Priority then
        return
    end
    
    if not StartFly() then return end
    
    Move.TargetCF = targetCFrame
    Move.Priority = priority
    Move.LastSetTime = now
    Move.LockUntil = now + 0.3
end

-- Heartbeat xử lý movement mượt mà
RunService.Heartbeat:Connect(function(dt)
    if not Move.Active then return end
    
    local hrp = GetHRP()
    if not hrp or not Move.TargetCF then return end
    
    -- Đảm bảo instances còn sống
    if not Move.AlignPos or not Move.AlignPos.Parent then
        if not EnsureMoveInstances(hrp) then return end
    end
    
    -- Force noclip
    local char = Hub.State.Character
    if char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
    
    -- Smooth movement (frame-rate independent)
    local targetPos = Move.TargetCF.Position
    local currentPos = hrp.Position
    local distance = (currentPos - targetPos).Magnitude
    
    if distance < 1.5 then
        Move.AlignPos.Position = targetPos
        return
    end
    
    local alpha = 1 - math.exp(-5 * dt)
    alpha = math.clamp(alpha, 0, 0.5)
    
    Move.SmoothPos = Move.SmoothPos:Lerp(targetPos, alpha)
    Move.AlignPos.Position = Move.SmoothPos
end)

-- Lưu vào Hub
