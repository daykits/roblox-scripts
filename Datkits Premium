-- TÍNH NĂNG AUTO QUEST SEA 1
MainTab:CreateToggle({
   Name = "Bật Auto Quest Sea 1 (Di Chuyển Bay + Đúng Quái)",
   CurrentValue = false,
   Flag = "ToggleAutoQuest",
   Callback = function(Value)
      _G.AutoQuest = Value

      if not Value then
          ResetCharacterState()
          return
      end

      -- Luồng giữ Võ
      task.spawn(function()
          while _G.AutoQuest do
              task.wait(0.5)
              pcall(EquipMeleeWeapon)
          end
      end)

      -- Luồng di chuyển nhận Quest & Bay mượt tới đánh quái
      task.spawn(function()
          while _G.AutoQuest do
              task.wait()
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character
                  if not character then return end
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  if not hrp then return end

                  local questName, questLevel, mobName, npcCFrame, mobCFrame = GetSea1QuestData()

                  if not HasQuest() then
                      if npcCFrame then
                          local distToNPC = (hrp.Position - npcCFrame.Position).Magnitude
                          if distToNPC > 10 then
                              TweenTo(npcCFrame, 250)
                          else
                              StopTween()
                              game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                              task.wait(0.5)
                          end
                      end
                  else
                      local targetMob = nil
                      local minDist = math.huge

                      if workspace:FindFirstChild("Enemies") then
                          for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                              if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                  if string.find(enemy.Name, mobName) then
                                      local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                                      if dist < minDist then
                                          minDist = dist
                                          targetMob = enemy
                                      end
                                  end
                              end
                          end
                      end

                      if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                          local mobPos = targetMob.HumanoidRootPart.Position
                          local height = _G.FarmDistance or 5
                          local targetCFrame = CFrame.new(mobPos + Vector3.new(0, height, 0), mobPos)

                          -- Di chuyển bay mượt tới quái (Không teleport)
                          TweenTo(targetCFrame, 250)

                          targetMob.HumanoidRootPart.CanCollide = false
                          targetMob.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                      else
                          if mobCFrame then
                              TweenTo(mobCFrame, 250)
                          end
                      end
                  end
              end)
          end
          ResetCharacterState()
      end)
   end,
})

