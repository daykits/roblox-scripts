                    if nearest then
                        local pos = nearest.HumanoidRootPart.Position
                        TweenTo(CFrame.new(pos + Vector3.new(0, getgenv().FarmDistance, 0), pos), 280)
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

