local MELEE_KEYWORDS = {
    "combat", "step", "karate", "dragon", "god",
    "superhuman", "death", "shark", "electric",
}

local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end

    -- Ưu tiên vũ khí Melee
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local name = tool.Name:lower()
            local isMelee = (tool.ToolTip == "Melee")

            if not isMelee then
                for _, keyword in ipairs(MELEE_KEYWORDS) do
                    if name:find(keyword) then
                        isMelee = true
                        break
                    end
                end
            end

            if isMelee then
                pcall(function() char.Humanoid:EquipTool(tool) end)
                return
            end
        end
    end

    -- Không có Melee -> equip tool bất kỳ
    local anyTool = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    if anyTool then
        pcall(function() char.Humanoid:EquipTool(anyTool) end)
    end
end

local function HasQuest()
    local ok, result = pcall(function()
        local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
        return main and main:FindFirstChild("Quest") and main.Quest.Visible
    end)
    return ok and result or false
end

