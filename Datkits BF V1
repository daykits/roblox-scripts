local function GetQuestData()
    local level = GetLevel()
    for _, data in ipairs(QuestData) do
        if level >= data.Min and level <= data.Max then
            return data.Quest, data.Level, data.Mob, data.NPC, data.Area
        end
    end
    return FALLBACK_QUEST.Quest, FALLBACK_QUEST.Level, FALLBACK_QUEST.Mob,
           FALLBACK_QUEST.NPC, FALLBACK_QUEST.Area
end

