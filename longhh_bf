    FX.CachedInvoke = function(key, ttl, ...)
        local now = os.clock()
        local c = FX.Cache[key]
        if c and now - c.t < ttl then return c.v end
        local args = table.pack(...)
        local ok, r = pcall(function()
            return replicated.Remotes.CommF_:InvokeServer(table.unpack(args, 1, args.n))
        end)
        if not ok then
            FX.Log("remote-" .. tostring(key), r)
            r = nil
        end
        FX.Cache[key] = { t = now, v = r }
        return r
    end
    FX.RStat = { calls = 0, hits = 0, stale = 0, waits = 0 }
    FX.Bucket = { }
    FX.Take = function(name, rate, burst)
        local now = os.clock()
        local b = FX.Bucket[name]
        if not b then
            b = { n = burst, t = now }
            FX.Bucket[name] = b
        end
        b.n = math.min(burst, b.n + (now - b.t) * rate)
        b.t = now
        if b.n >= 1 then
            b.n = b.n - 1
            return true
        end
        return false
    end
    FX.QRead = function(...)
        local args = table.pack(...)
        if not (FX.Enable and FX.Enable.RemoteLimit) then
            return replicated.Remotes.CommF_:InvokeServer(table.unpack(args, 1, args.n))
        end
        local parts = { }
        for i = 1, args.n do parts[i] = tostring(args[i]) end
        local key = "QR:" .. table.concat(parts, "|")
        local c = FX.Cache[key]
        if c and os.clock() - c.t < (FX.Cfg.QReadTTL or 0.5) then
            FX.RStat.hits = FX.RStat.hits + 1
            return c.v
        end
        local tries = 0
        while not FX.Take("remote", FX.Cfg.RemoteRate or 10, FX.Cfg.RemoteBurst or 15) do
            FX.RStat.waits = FX.RStat.waits + 1
            if c then
                FX.RStat.stale = FX.RStat.stale + 1
                return c.v
            end
            tries = tries + 1
            if tries > 20 then break end
            task.wait(0.1)
        end
        FX.RStat.calls = FX.RStat.calls + 1
        local r = replicated.Remotes.CommF_:InvokeServer(table.unpack(args, 1, args.n))
        FX.Cache[key] = { t = os.clock(), v = r }
        return r
    end
