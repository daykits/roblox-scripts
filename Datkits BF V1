local Move = {
    Active = false,
    TargetCF = nil,
    SmoothPos = nil,
    BoundHRP = nil,
    AlignPos = nil,
    AlignOri = nil,
    Attach = nil,
    Heartbeat = nil,
    Priority = 0,
    LockUntil = 0,
    LastSetTime = 0,
    Arrived = false,
    LastArriveCheck = 0,
    LastRotCF = nil,
}

local function CleanupMoveInstances()
    if Move.AlignPos then pcall(function() Move.AlignPos:Destroy() end) end
    if Move.AlignOri then pcall(function() Move.AlignOri:Destroy() end) end
    if Move.Attach   then pcall(function() Move.Attach:Destroy()   end) end
    Move.AlignPos = nil; Move.AlignOri = nil; Move.Attach = nil; Move.BoundHRP = nil
end

local function EnsureMoveInstances(hrp)
    if not hrp or not hrp.Parent then return false end
    if Move.BoundHRP == hrp and Move.AlignPos and Move.AlignPos.Parent then return true end
    CleanupMoveInstances()

    local att = Instance.new("Attachment")
    att.Name = "FarmAtt"; att.Parent = hrp

    local ap = Instance.new("AlignPosition")
    ap.Name = "FarmAP"
    ap.Attachment0 = att
    ap.Mode = Enum.PositionAlignmentMode.OneAttachment
    ap.Position = hrp.Position
    ap.MaxForce = Config.MoveMaxForce
    ap.Responsiveness = Config.MoveResponsiveness
    ap.ApplyAtCenterOfMass = false
    ap.MaxVelocity = Config.MoveMaxVelocity
    ap.Parent = hrp

    local ao = Instance.new("AlignOrientation")
    ao.Name = "FarmAO"
    ao.Attachment0 = att
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.CFrame = hrp.CFrame
    ao.MaxTorque = Config.MoveMaxForce
    ao.Responsiveness = 30
    ao.Parent = hrp

    Move.BoundHRP = hrp
    Move.AlignPos = ap
    Move.AlignOri = ao
    Move.Attach = att
    return true
end

local function StartFly()
    local char = GetCharacter()
    if not char then return false end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end
    if not EnsureMoveInstances(hrp) then return false end

    pcall(function() hum.PlatformStand = true end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false) end)

    if not Move.Active then
        Move.SmoothPos = hrp.Position
        Move.Active = true
        Move.Arrived = false
        Move.LastRotCF = nil
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end
    return true
end

local function StopFly()
    if not Move.Active then return end
    Move.Active = false
    Move.TargetCF = nil
    Move.SmoothPos = nil
    Move.Priority = 0
    Move.LockUntil = 0
    Move.Arrived = false
    Move.LastRotCF = nil

    local char = GetCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.PlatformStand = false end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function SetMoveTarget(targetCFrame, priority)
    if not targetCFrame then return end
    priority = priority or 5

    local now = tick()

    if Move.Active and now < Move.LockUntil and priority < Move.Priority then
        return
    end

    if Move.Active and priority == Move.Priority and (now - Move.LastSetTime) < 0.1 then
        return
    end

    if not StartFly() then return end

    if Move.TargetCF then
        local dist = (Move.TargetCF.Position - targetCFrame.Position).Magnitude
        if dist < 2 and priority <= Move.Priority then
            return
        end
    end

    Move.TargetCF = targetCFrame
    Move.Priority = priority
    Move.LastSetTime = now
    Move.LockUntil = now + Config.MovePriorityLock
    Move.Arrived = false
end

local function BindHeartbeat()
    if Move.Heartbeat then
        Move.Heartbeat:Disconnect()
        Move.Heartbeat = nil
    end
    Move.Heartbeat = RunService.Heartbeat:Connect(function(dt)
        if not Move.Active then return end
        local char = GetCharacter()
        if not char then Move.Active = false; return end
        local hrp = char.HumanoidRootPart
        if not hrp or not Move.TargetCF then return end

        if not Move.AlignPos or not Move.AlignPos.Parent then
            if not EnsureMoveInstances(hrp) then return end
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end

        local targetPos = Move.TargetCF.Position
        local currentPos = hrp.Position
        local distance = (currentPos - targetPos).Magnitude

        if distance < Config.MoveArriveDist then
            if not Move.Arrived then
                Move.SmoothPos = targetPos
                Move.AlignPos.Position = targetPos
                Move.Arrived = true
            end
            Move.AlignPos.Position = targetPos
            return
        else
            Move.Arrived = false
        end

        local k = Config.MoveSmoothSpeed
        local alpha = 1 - math.exp(-k * dt)
        alpha = math.clamp(alpha, 0, 0.5)

        if distance < 5 then
            alpha = alpha * 0.6
        end

        Move.SmoothPos = Move.SmoothPos:Lerp(targetPos, alpha)
        Move.AlignPos.Position = Move.SmoothPos

        local lookDir = targetPos - currentPos
        if lookDir.Magnitude > 1 then
            local currentLook = hrp.CFrame.LookVector
            local targetLook = lookDir.Unit
            local dotProduct = currentLook:Dot(targetLook)

            if dotProduct < 0.966 then
                local targetCFrame = CFrame.new(currentPos, currentPos + targetLook)
                local rotAlpha = 1 - math.exp(-8 * dt)
                Move.AlignOri.CFrame = Move.AlignOri.CFrame:Lerp(targetCFrame, rotAlpha)
                Move.LastRotCF = targetCFrame
            end
        end
    end)
end

BindHeartbeat()

local function ResetCharacterState()
    StopFly()
    CleanupMoveInstances()
end

