-- Hàm Teleport dùng PivotTo kết hợp gỡ Va chạm để vượt Anti-cheat
local function safeTeleport(targetCFrame)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if character and rootPart then
        -- Tắt va chạm tạm thời để tránh bị kẹt địa hình gây giật lùi
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        
        -- Triệt tiêu vận tốc cũ
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        
        -- Dịch chuyển toàn bộ Character Model
        character:PivotTo(targetCFrame)
        task.wait(0.1)
        rootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

-- Hàm lấy vị trí vật thể
local function getPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        return object:GetPivot().Position
    end
    return nil
end

-- Hàm tự động kích hoạt phím E
local function triggerProximityPrompts()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Parent then
            local promptPos = getPosition(prompt.Parent)
            if promptPos and (promptPos - targetPosition).Magnitude < 20 then
                task.spawn(function()
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.1)
                        prompt:InputHoldEnd()
                    end
                end)
            end
        end
    end
end

-- Hàm tự động tìm và cầm trứng lên tay từ Backpack
local function equipEgg()
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")
    
    if humanoid and backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                -- Kiểm tra tên vật phẩm (ưu tiên vật phẩm trứng hoặc tự cầm vật phẩm mới nhặt)
                local toolName = tool.Name:lower()
                if toolName:find("egg") or toolName:find("trứng") or toolName:find("valen") then
                    humanoid:EquipTool(tool)
                    break
                else
                    -- Nếu không tìm thấy theo tên cụ thể, tự trang bị tool trong balo
                    humanoid:EquipTool(tool)
                    break
                end
            end
        end
    end
end

