                      local mobPos = nearestMob.HumanoidRootPart.Position
                      local height = _G.FarmDistance or 6.5
                      
                      hrp.CFrame = CFrame.new(mobPos + Vector3.new(0, height, 0), mobPos)
                      nearestMob.HumanoidRootPart.CanCollide = false
