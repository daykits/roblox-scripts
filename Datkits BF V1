-- =========================
-- BASIC HELPERS
-- =========================
local function GetChar()
    local c = LocalPlayer.Character
    if not c then return nil end

    local hrp = c:FindFirstChild("HumanoidRootPart")
    local hum = c:FindFirstChildOfClass("Humanoid")

    if hrp and hum and hum.Health > 0 then
        return c
    end

    return nil
end

local function GetLevel()
    local level = 1

    pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        local lv = data and data:FindFirstChild("Level")
        if lv then
            level = tonumber(lv.Value) or 1
        end
    end)

    return level
end

local function StopTween()
    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)
    end

    currentTween = nil
    currentTarget = nil
end

local function SetNoclip(enabled)
    local char = GetChar()
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            pcall(function()
                part.CanCollide = not enabled
            end)
        end
    end
end

-- =========================
-- STABLE MOVEMENT
-- =========================
-- Không tạo tween mới liên tục.
-- Chỉ cập nhật khi target thay đổi đủ lớn hoặc tween đã kết thúc.
local function TweenTo(targetCF, force)
    local char = GetChar()
    if not char then return false end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    SetNoclip(true)

    local distance = (hrp.Position - targetCF.Position).Magnitude

    if distance <= 4.5 then
        StopTween()
        pcall(function()
            hrp.CFrame = targetCF
        end)
        return true
    end

    if not force and currentTarget then
        local targetDelta = (currentTarget.Position - targetCF.Position).Magnitude
        if targetDelta < 5 and currentTween then
            return false
        end
    end

    currentTarget = targetCF

    if currentTween then
        pcall(function()
            currentTween:Cancel()
        end)
        currentTween = nil
    end

    local speed = math.max(80, tonumber(getgenv().TweenSpeed) or 300)
    local duration = math.clamp(distance / speed, 0.12, 8)

    currentTween = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = targetCF}
    )

    currentTween:Play()

    task.spawn(function()
        local myTween = currentTween
        pcall(function()
            myTween.Completed:Wait()
        end)

        if currentTween == myTween then
            currentTween = nil
        end
    end)

    return false
end

-- =========================
-- EQUIP
-- =========================
local function EquipTool()
    if not getgenv().AutoEquip then return end

    local char = GetChar()
    if not char then return end

    if char:FindFirstChildOfClass("Tool") then
        return
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function()
                char:FindFirstChildOfClass("Humanoid"):EquipTool(tool)
            end)
            return
        end
    end
end

