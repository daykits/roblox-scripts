--====================================================================
-- AUTO LOOT
--====================================================================
local loot = {
	selected = {}, target = nil, mover = createMover(), maid = createMaid(), elapsed = 0,
	lastCollect = 0, attemptStart = weakTable(), ignoredUntil = weakTable(), hold = nil,
}

local function releaseHold()
	local hold = loot.hold
	if not hold then return end
	loot.hold = nil
	if hold.thread ~= coroutine.running() and coroutine.status(hold.thread) ~= "dead" then
		task.cancel(hold.thread)
	end
	hold.prompt:InputHoldEnd()
end

local function triggerPrompt(prompt)
	if loot.hold then return true end -- a press is already in progress
	prompt:InputHoldBegin()
	loot.hold = { prompt = prompt, thread = task.delay(prompt.HoldDuration + 0.1, releaseHold) }
	return true
end

--[[ >>> CONNECT YOUR LOOT SYSTEM HERE <<<
	`item` is a BasePart or Model (its pivot is used for positioning).
	Default behaviour: uses an existing ProximityPrompt inside the item through the official
	InputHoldBegin/InputHoldEnd API (the prompt must be enabled and within its activation
	distance). ClickDetectors cannot be fired by any official client API; if your game uses one,
	route it through your own legitimate interaction code here.
	Return true if an interaction was started. Do not invent RemoteEvent names.
]]
local function collectLoot(item)
	local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt and prompt.Enabled then
		return triggerPrompt(prompt)
	end
	return false
end

local function getLootPosition(item)
	if item:IsA("BasePart") then
		return item.Position
	elseif item:IsA("Model") then
		return item:GetPivot().Position -- honours PrimaryPart when set
	end
	return nil
end

local function isLootUsable(item)
	if not item or not item.Parent or not item:IsDescendantOf(Workspace) then
		return false
	end
	if not (item:IsA("BasePart") or item:IsA("Model")) then
		return false
	end
	local ignoredUntil = loot.ignoredUntil[item]
	return ignoredUntil == nil or os.clock() >= ignoredUntil
end

local function findNearestLoot(position)
	local best, bestDistance = nil, math.huge
	for tag in pairs(loot.selected) do
		for item in pairs(lootRegistry.sets[tag] or {}) do
			if isLootUsable(item) then
				local distance = (getLootPosition(item) - position).Magnitude
				if distance < bestDistance then
					best, bestDistance = item, distance
				end
			end
		end
	end
	return best
end

local function lootGoal(root, itemPosition)
	local offset = Vector3.new(root.Position.X - itemPosition.X, 0, root.Position.Z - itemPosition.Z)
	offset = offset.Magnitude > 0.05 and offset.Unit or Vector3.new(0, 0, 1)
	local goalPosition = itemPosition + offset * CONFIG.LootStopDistance + Vector3.new(0, CONFIG.LootHeightOffset, 0)
	return faceFrom(goalPosition, itemPosition, root.CFrame.LookVector)
end

local function collectStep(item)
	setStatus("AutoLoot", "Collecting " .. item.Name)
	local now = os.clock()
	loot.attemptStart[item] = loot.attemptStart[item] or now
	if now - loot.attemptStart[item] > CONFIG.LootCollectTimeout then
		loot.ignoredUntil[item] = now + CONFIG.LootIgnoreSeconds
		loot.attemptStart[item] = nil
		notifyThrottled("lootSkip", "Skipped " .. item.Name .. " (could not collect)", "warning", 5)
		return
	end
	if now - loot.lastCollect >= 0.5 then
		loot.lastCollect = now
		invokeHook("collectLoot", collectLoot, item)
	end
end

local function approachOrCollect(root, item)
	local itemPosition = getLootPosition(item)
	local arrival = math.sqrt(CONFIG.LootStopDistance ^ 2 + CONFIG.LootHeightOffset ^ 2) + 1.5
	holdStill(root)
	if (root.Position - itemPosition).Magnitude > arrival then
		if not loot.mover.isMoving() then
			loot.mover.moveTo(root, lootGoal(root, itemPosition))
		end
		setStatus("AutoLoot", "Moving to " .. item.Name)
		return
	end
	loot.mover.cancel()
	collectStep(item)
end

local function lootStep(dt)
	local root, humanoid = getRoot(), getHumanoid()
	if not root or not isAlive(humanoid) then
		loot.mover.cancel()
		setStatus("AutoLoot", "Waiting for respawn")
		return
	end
	if next(loot.selected) == nil then
		setStatus("AutoLoot", "Select a loot type")
		return
	end
	loot.elapsed += dt
	if not isLootUsable(loot.target) then
		loot.mover.cancel()
		loot.target = nil
		if loot.elapsed >= CONFIG.SearchInterval then
			loot.elapsed = 0
			loot.target = findNearestLoot(root.Position)
		end
		if not loot.target then
			setStatus("AutoLoot", "Waiting for loot to spawn")
			return
		end
	end
	approachOrCollect(root, loot.target)
end

features.AutoLoot = {
	display = "Auto Loot",
	enabled = false,
	canStart = function()
		if next(loot.selected) == nil then
			return false, "Select at least one loot type first"
		end
		return true
	end,
	start = function()
		loot.elapsed = CONFIG.SearchInterval
		loot.target = nil
		requestNoclip("AutoLoot")
		loot.maid.give(RunService.Heartbeat:Connect(lootStep))
		setStatus("AutoLoot", "Searching")
	end,
	stop = function()
		loot.maid.clean()
		loot.mover.cancel()
		releaseHold()
		loot.target = nil
		releaseNoclip("AutoLoot")
		setStatus("AutoLoot", "Off")
	end,
}

