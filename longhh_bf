                local toks, itoks = { }, { }
                for _, w in ipairs(words(nt)) do
                    if not STOP[w] then
                        toks[#toks + 1] = w
                    end
                end
                if #toks == 0 then
                    toks = words(nt)
                end
                for _, w in ipairs(words(norm(camel(id)))) do
                    if not STOP[w] then
                        itoks[#itoks + 1] = w
                    end
                end
                reg[#reg + 1] = {
                    id = id,
                    rec = rec,
                    type = t,
                    title = title,
                    nt = nt,
                    toks = toks,
                    itoks = itoks,
                    tab = rec.TabTitle
