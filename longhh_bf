    FH.Grant = function(e)
        local now = os.clock()
        FX.Epoch = FX.Epoch + 1
        local prevO = FH.Owner
        if prevO == nil and now - FH.ReleasedAt < 3 then
            prevO = FH.LastOwner
        end
        pcall(FX.Boost.Switch, e, prevO, "grant")
        FH.Owner = e
        e.grantedAt = now
        e.sleepUntil = nil
        e.lostAt = nil
        e.lastPos, e.lastMoveAt = nil, now
        if e.releasedAt and now - e.releasedAt < FX.Cfg.FlapWindow then
            e.flaps = math.min((e.flaps or 0) + 1, 6)
        else
            e.flaps = 0
        end
        FH.Mirror()
        FH.Restore(e)
        if e.saved then
            FH.ReturnHome(e)
        end
        FX.Log("grant", e.name)
    end
    FH.Release = function(o, why)
        FX.Epoch = FX.Epoch + 1
        if FH.Owner == o then
            FH.Owner = nil
        end
        FH.ReleasedAt = os.clock()
        FH.LastOwner = o
        o.releasedAt = FH.ReleasedAt
        o.grantedAt = nil
        o.lostAt = nil
        FH.Mirror()
        -- Cleanup full khi release owner: stop fly + stop mob dodge + destroy body clip
        pcall(function()
            if FX.FlyStop then
                FX.FlyStop()
            end
            if FX.StopMobDodge then
                FX.StopMobDodge()
            end
            if FX.MobDodgeCleanupBody then
                FX.MobDodgeCleanupBody()
            end
        end)
        FX.Log("release", o.name .. " (" .. tostring(why) .. ")")
    end
    FX.Boost = { Active = false }
    FX.Boost.Switch = function(e, prev, why)
        local B = FX.Boost
        if not FX.Enable.SwitchBoost or e == nil or prev == nil or prev == e then return end
        local nm = e.name
        if nm ~= "CakePrince" and nm ~= "Bone" and nm ~= "Tyrant" then return end
        local cur = Settings["Tween Speed"] or 180
        if not B.Active then B.orig = cur end
        local orig = B.orig or cur
        local boost = math.clamp(math.max(orig, FX.Cfg.SwitchSpeed), 100, math.min(FX.Cfg.FlyBoostSpeed, FX.SpeedCap and FX.SpeedCap() or FX.Cfg.FlyBoostSpeed))
        if orig >= boost then return end
        Settings["Tween Speed"] = boost
        B.Active, B.boosted, B.t0, B.to = true, boost, os.clock(), nm
        B.lastPos, B.stillSince = nil, nil
        FX.Log("boost", tostring(prev.name) .. " -> " .. nm .. " (" .. tostring(why) .. ") " .. tostring(orig) .. " -> " .. tostring(boost))
    end
    FX.Boost.End = function(why)
        local B = FX.Boost
        if not B.Active then return end
        B.Active = false
        if B.orig and Settings["Tween Speed"] == B.boosted then
            Settings["Tween Speed"] = B.orig
        end
        FX.Log("boost", "end " .. tostring(why) .. " -> " .. tostring(Settings["Tween Speed"]))
        B.orig, B.boosted = nil, nil
    end
    FX.Boost.Check = function()
        local B = FX.Boost
        if not B.Active then return end
        local now = os.clock()
        local o = FH.Owner
        if not FX.Enable.SwitchBoost or FH.Disabled or o == nil or o.name ~= B.to then
            FX.Boost.End("owner")
            return
        end
        if now - B.t0 >= FX.Cfg.SwitchBoostSec then
            FX.Boost.End("timeout")
            return
        end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            if B.lastPos and (hrp.Position - B.lastPos).Magnitude <= FX.Cfg.MoveEps then
                B.stillSince = B.stillSince or now
                if now - B.t0 >= 1.5 and now - B.stillSince >= 0.6 then
                    FX.Boost.End("arrived")
                    return
                end
            else
                B.stillSince = nil
            end
            B.lastPos = hrp.Position
        end
    end
