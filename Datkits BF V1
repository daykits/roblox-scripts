Tabs.Sail:AddToggle("InstantSailToggle", {
    Title       = "Instant Sail (Teleport)",
    Description = "Teleport thẳng tới đảo — nhanh nhưng dễ bị flag",
    Default     = false,
    Callback    = function(v) Config.InstantSail = v end,
})

Tabs.Sail:AddSection("📍 Đi tới đảo")

Tabs.Sail:AddButton({
    Title       = "Tới đảo gần nhất",
    Description = "Sail tới đảo gần bạn nhất",
    Callback    = function()
        local island = GetNearestIsland()
        if island then
            local hrp = GetHRP()
            if hrp and Config.InstantSail and not GetBoat() then
                hrp.CFrame = CFrame.new(island.pos + Vector3.new(0, 5, 0))
            else
                SailTo(island.pos, Config.SailSpeed)
            end
            Fluent:Notify({
                Title    = "Sea Travel",
                Content  = "Đang tới: " .. island.name,
                Duration = 3,
            })
        else
            Fluent:Notify({
                Title    = "Sea Travel",
                Content  = "Không tìm thấy đảo!",
                Duration = 3,
            })
        end
    end,
})

Tabs.Sail:AddDropdown("IslandSelect", {
    Title   = "Chọn đảo để tới",
    Values  = (function()
        local t = {}
        for sea, list in pairs(SeaIslands) do
            for _, isl in ipairs(list) do
                table.insert(t, string.format("Sea %d - %s", sea, isl.name))
            end
        end
        return t
    end)(),
    Multi   = false,
    Default = 1,
    Callback = function(selected)
        for sea, list in pairs(SeaIslands) do
            for _, isl in ipairs(list) do
                local label = string.format("Sea %d - %s", sea, isl.name)
                if label == selected then
                    if Config.InstantSail and not GetBoat() then
                        local hrp = GetHRP()
                        if hrp then
                            hrp.CFrame = CFrame.new(isl.pos + Vector3.new(0, 5, 0))
                        end
                    else
                        SailTo(isl.pos, Config.SailSpeed)
                    end
                    Fluent:Notify({
                        Title    = "Sea Travel",
                        Content  = "Đang tới: " .. isl.name,
                        Duration = 3,
                    })
                    return
                end
            end
        end
    end,
})

