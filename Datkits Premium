   Callback = function(Value)
      _G.AutoFarmLevel = Value
      if not Value then 
          ResetPhysics() 
      end

      task.spawn(function()
          local targetMob = nil
          while _G.AutoFarmLevel do
              task.wait(0.08)
              pcall(function()
                  EquipWeapon("Melee")
                  local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()

                  if not questName then return end

                  if not HasQuest() then
                      targetMob = nil
                      if (LocalPlayer.Character.HumanoidRootPart.Position - npcCFrame.Position).Magnitude > 12 then
                          TweenTo(npcCFrame, 250)
                      else
                          StopTween()
                          LocalPlayer.Character.HumanoidRootPart.CFrame = npcCFrame
                          game:GetService("ReplicatedStorage").Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                          task.wait(0.8)
                      end
                  else
                      if not (targetMob and targetMob.Parent and targetMob:FindFirstChild("Humanoid") and targetMob.Humanoid.Health > 0) then
                          targetMob = GetNearestEnemy(mobName)
                      end

                      if targetMob and targetMob:FindFirstChild("HumanoidRootPart") then
                          local mobPos = targetMob.HumanoidRootPart.Position
                          local targetCFrame = CFrame.new(mobPos + Vector3.new(0, _G.FarmDistance, 0), mobPos)

                          if (LocalPlayer.Character.HumanoidRootPart.Position - mobPos).Magnitude > 12 then
                              TweenTo(targetCFrame, 250)
                          else
                              StopTween()
                              LocalPlayer.Character.HumanoidRootPart.CFrame = targetCFrame
                              targetMob.HumanoidRootPart.CanCollide = false
                          end
                      else
                          if mobCFrame then TweenTo(mobCFrame, 250) end
                      end
                  end
              end)
          end
      end)
   end,
})
