-- Hàm Dịch chuyển an toàn
local function safeTeleport(cframe)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(cframe)
    end
end

-- Hàm tìm ProximityPrompt gần nhất (ưu tiên liên quan đến Egg)
local function getClosestPrompt(maxDist)
    local player = game.Players.LocalPlayer
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local closestPrompt = nil
    local closestDist = maxDist or 25

    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local parent = prompt.Parent
            if parent then
                local promptPos = parent:IsA("BasePart") and parent.Position 
                    or (parent:IsA("Model") and parent:GetPivot().Position) 
                    or nil

                if promptPos then
                    local dist = (promptPos - root.Position).Magnitude
                    if dist < closestDist then
                        -- Ưu tiên prompt có tên / text liên quan đến egg
                        local nameLower = string.lower(prompt.Name or "")
                        local actionLower = string.lower(prompt.ActionText or "")
                        local objectLower = string.lower(prompt.ObjectText or "")

                        local isEggRelated = nameLower:find("egg") or nameLower:find("carry") 
                            or actionLower:find("egg") or actionLower:find("carry") or actionLower:find("pick")
                            or objectLower:find("egg") or objectLower:find("carry")

                        if isEggRelated or dist < 12 then -- nếu rất gần thì lấy luôn
                            closestDist = dist
                            closestPrompt = prompt
                        end
                    end
                end
            end
        end
    end
    return closestPrompt
end

-- Hàm thực hiện nhặt trứng (đã sửa)
local function holdEPickup()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local prompt = getClosestPrompt(28)
    if not prompt then return false end

    -- Instant pickup: set HoldDuration = 0
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 30
    end)

    -- Fire nhiều lần cho chắc
    for i = 1, 6 do
        pcall(function()
            if fireproximityprompt then
                fireproximityprompt(prompt)
            end
        end)
        task.wait(0.05)
    end

    -- Backup: InputHoldBegin + End (phòng trường hợp fireproximityprompt bị chặn)
    pcall(function()
        prompt:InputHoldBegin()
    end)
    task.wait(0.35)
    pcall(function()
        prompt:InputHoldEnd()
        if fireproximityprompt then
            fireproximityprompt(prompt)
        end
    end)

    return true
end

-- Hàm kiểm tra và cầm trứng lên tay
local function equipEggTool()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")

    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                return true
            end
        end
    end

    if humanoid and backpack then
        local tool = backpack:FindFirstChildOfClass("Tool")
        if tool then
            humanoid:EquipTool(tool)
            return true
        end
    end
    return false
end

