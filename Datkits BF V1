local function GetCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        return char
    end
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
    isGoingToFarmArea = false

    local char = GetCharacter()
    if char then
        pcall(function()
            char.Humanoid.PlatformStand = false
            char.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            char.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

local function ToggleNoclip(state)
    if state then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = GetCharacter()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function TweenTo(cf, speed)
    speed = speed or getgenv().TweenSpeed or 270
    local char = GetCharacter()
    if not char then return end

    local hrp = char.HumanoidRootPart
    local hum = char.Humanoid
    hum.PlatformStand = true

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    hrp.AssemblyLinearVelocity = Vector3.zero

    local dist = (hrp.Position - cf.Position).Magnitude
    if dist <= 5 then
        StopTween()
        hrp.CFrame = cf
        return
    end

    if isGoingToFarmArea and lastTargetPos and (lastTargetPos - cf.Position).Magnitude < 12 then
        return
    end

    lastTargetPos = cf.Position

    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end

    local time = math.clamp(dist / speed, 0.08, 6.5)
    currentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {CFrame = cf})
    currentTween:Play()
end

local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end

    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if tool.ToolTip == "Melee" or n:find("combat") or n:find("step") or n:find("karate")
            or n:find("dragon") or n:find("god") or n:find("superhuman") or n:find("death")
            or n:find("shark") or n:find("electric") then
                pcall(function() char.Humanoid:EquipTool(tool) end)
                return
            end
        end
    end

    local any = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    if any then
        pcall(function() char.Humanoid:EquipTool(any) end)
    end
end

local function HasQuest()
    local success, result = pcall(function()
        local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
        return main and main:FindFirstChild("Quest") and main.Quest.Visible
    end)
    return success and result
end

