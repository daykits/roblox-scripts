    local function phStart()
        if PH.on then return end
        PH.on = true
        phCursor()

        PH.nc = game:GetService("RunService").Stepped:Connect(function()
            if not PH.on then return end
            local now = os.clock()
            if now - PH.lastScan >= 0.15 then
                PH.lastScan = now
                local fx = _G.FARMX
                local blocked = fx and fx.NotOwner and fx.NotOwner("HWPumpkinHunt")
                if not blocked then
                    PH.target, PH.tdist, PH.targetPos = phFindNearest()
                else
                    PH.target, PH.tdist, PH.targetPos = nil, nil, nil
                end
            end

            local camera = workspace.CurrentCamera
            if camera and PH.cur then
                local worldPos = PH.targetPos
                local viewport, visible = camera:WorldToViewportPoint(worldPos or (plr.Character and plr.Character:GetPivot().Position) or Vector3.zero)
                if PH.target and visible and viewport.Z > 0 then
                    PH.cur.Position = UDim2.fromOffset(viewport.X - 14, viewport.Y - 14)
                else
                    local size = camera.ViewportSize
                    PH.cur.Position = UDim2.fromOffset(size.X / 2 - 14, size.Y * 0.4 - 14)
                end
            end
        end)

        PH.ct = task.spawn(function()
            while PH.on and _G.AutoPumpkinHunt do
                local ok, err = pcall(function()
                    local fx = _G.FARMX
                    if fx and fx.NotOwner and fx.NotOwner("HWPumpkinHunt") then return end

                    local character = plr.Character
                    local hrp = character and character:FindFirstChild("HumanoidRootPart")
                    local target, targetPos = PH.target, PH.targetPos
                    if not (hrp and target and target.Parent and targetPos) then return end

                    phEquipSelectedWeapon()

                    local goal = targetPos + Vector3.new(0, 3, 0)
                    local distance = (goal - hrp.Position).Magnitude
                    if distance > PH_STOP and os.clock() - PH.lastMove >= PH_MOVE_GAP then
                        PH.lastMove = os.clock()
                        pcall(_tp, CFrame.new(goal))
                    end

                    local now = os.clock()
                    if distance <= PH_CLICK_RANGE and PH.cur and PH.cur.Parent and now - PH.lastClick >= 0.18 then
                        PH.lastClick = now
                        local position, size = PH.cur.AbsolutePosition, PH.cur.AbsoluteSize
                        local x, y = position.X + size.X / 2, position.Y + size.Y / 2
                        local input = game:GetService("VirtualInputManager")
                        input:SendMouseButtonEvent(x, y, 0, true, game, 0)
                        task.wait(0.01)
                        input:SendMouseButtonEvent(x, y, 0, false, game, 0)
                    end
                end)
                if not ok then warn("[PumpkinHunt] " .. tostring(err)) end
                task.wait(0.1)
            end
            if not _G.AutoPumpkinHunt then phStop() end
        end)
    end

