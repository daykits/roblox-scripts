    FH.DelegatorOn = function(e)
        for _, n in ipairs(FH.Order) do
            local d = FH.Reg[n]
            if d ~= e and d.tier >= 8 and not (d.deleg == false and FX.Enable.SQDelegGuard) and FH.UiOn(d) then
                return true
            end
        end
        local ui = FH.DelegatorUi
        for i = 1, #ui do
            local ok, v = pcall(FH.OptVal, ui[i])
            if ok and v then return true end
        end
        return false
    end
    FH.Intent = function(e)
        if FH.UiOn(e) then return true end
        for _, origin in pairs(e.masked) do
            if origin == "deleg" and FH.DelegatorOn(e) then return true end
        end
        for _, f in ipairs(e.flags) do
            if FH.GetFlag(f) then return true end
        end
        return false
    end
    FH.Mask = function(e)
        local origin
        for _, f in ipairs(e.flags) do
            if FH.GetFlag(f) then
                origin = origin or (FH.UiOn(e) and "ui" or "deleg")
                e.masked[f] = origin
                FH.SetFlag(f, false)
            end
        end
    end
    FH.Restore = function(e)
        if next(e.masked) == nil then return end
        local saved = e.masked
        e.masked = { }
        for f, origin in pairs(saved) do
            local ok = (origin == "ui" and FH.UiOn(e)) or (origin == "deleg" and FH.DelegatorOn(e))
            if ok and not FH.GetFlag(f) then
                FH.SetFlag(f, true)
            end
        end
    end
    FH.RestoreAll = function()
