            Name = "Area1Quest",
            Level = 1,
            Mob = "Raider",
            NPC = CFrame.new(-429.54, 71.77, 1836.18),
            MobArea = CFrame.new(-750, 55, 2300)
        }
    end
end

-------------------------------------------------
-- TÌM QUÁI
-------------------------------------------------
local function FindMob(mobName)
    local char = GetChar()
    if not char then return nil end

    local closest = nil
    local shortest = 9999
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    for _, enemy in pairs(folder:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            local name = enemy.Name:lower()
            if name:find(mobName:lower()) 
            or (mobName == "Raider" and (name:find("raider") or name:find("tập kích") or name:find("tap kich")))
            or (mobName == "Mercenary" and (name:find("mercenary") or name:find("đánh thuê"))) then

                local dist = (char.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = enemy
                end
            end
        end
    end
    return closest
end

