local MonsterClass = {}
MonsterClass.__index = MonsterClass

function MonsterClass.new(model)
    if not model or not model:FindFirstChild("Humanoid") or not model:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    local self = setmetatable({}, MonsterClass)
    self.model = model
    self.hrp = model.HumanoidRootPart
    self.humanoid = model.Humanoid
    self.name = model.Name
    self.level = model:GetAttribute("Level") or 1
    self.hp = model.Humanoid.Health
    self.maxHp = model.Humanoid.MaxHealth
    self.type = model.Name:find("Boss") and "boss" or "normal"
    return self
end

function MonsterClass:IsAlive()
    return self.humanoid and self.humanoid.Health > 0 and self.model.Parent ~= nil
end

-------------------------------------------------
-- 2. QUEST CLASS (ĐÃ CẢI THIỆN MATCHING)
-------------------------------------------------
local QuestClass = {}
QuestClass.__index = QuestClass

function QuestClass.new(name, targetName, targetType, minLevel, maxLevel)
    local self = setmetatable({}, QuestClass)
    self.name = name
    self.targetName = targetName
    self.targetType = targetType
    self.minLevel = minLevel
    self.maxLevel = maxLevel
    return self
end

function QuestClass:Matches(monster)
    if not monster or not monster:IsAlive() then return false end

    if self.targetName then
        local mName = string.lower(monster.name)
        local tName = string.lower(self.targetName)
        if not string.find(mName, tName, 1, true) then
            return false
        end
    end

    if self.targetType and monster.type ~= self.targetType then return false end
    if self.minLevel and monster.level < self.minLevel then return false end
    if self.maxLevel and monster.level > self.maxLevel then return false end
    return true
end

-------------------------------------------------
-- 3. SPATIAL GRID
-------------------------------------------------
local SpatialGridClass = {}
SpatialGridClass.__index = SpatialGridClass

function SpatialGridClass.new(cellSize)
    local self = setmetatable({}, SpatialGridClass)
    self.cellSize = cellSize or 150
    self.grid = {}
    return self
end

function SpatialGridClass:GetKey(pos)
    local cx = math.floor(pos.X / self.cellSize)
    local cz = math.floor(pos.Z / self.cellSize)
    return cx .. "_" .. cz
end

function SpatialGridClass:Rebuild(monsterList)
    self.grid = {}
    for _, monster in ipairs(monsterList) do
        if monster and monster:IsAlive() then
            local key = self:GetKey(monster.hrp.Position)
            if not self.grid[key] then self.grid[key] = {} end
            table.insert(self.grid[key], monster)
        end
    end
end

function SpatialGridClass:QueryNearby(pos, radius)
    local result = {}
    local cellRange = math.ceil(radius / self.cellSize)
    local cx = math.floor(pos.X / self.cellSize)
    local cz = math.floor(pos.Z / self.cellSize)

    for dx = -cellRange, cellRange do
        for dz = -cellRange, cellRange do
            local key = (cx + dx) .. "_" .. (cz + dz)
            if self.grid[key] then
                for _, monster in ipairs(self.grid[key]) do
                    if (monster.hrp.Position - pos).Magnitude <= radius then
                        table.insert(result, monster)
                    end
                end
            end
        end
    end
    return result
end

-------------------------------------------------
-- 4. MONSTER FINDER
-------------------------------------------------
local MonsterFinderClass = {}
MonsterFinderClass.__index = MonsterFinderClass

function MonsterFinderClass.new(spatialGrid)
    local self = setmetatable({}, MonsterFinderClass)
    self.grid = spatialGrid
    return self
end

function MonsterFinderClass:FindBestTarget(charPos, quest, radius, prioritize)
    radius = radius or 5000
    prioritize = prioritize or getgenv().TargetPrioritize

    local candidates = self.grid:QueryNearby(charPos, radius)
    local valid = {}

    for _, monster in ipairs(candidates) do
        if quest then
            if quest:Matches(monster) then
                table.insert(valid, monster)
            end
        else
            if monster:IsAlive() then
                table.insert(valid, monster)
            end
        end
    end

    if #valid == 0 then return nil end

    table.sort(valid, function(a, b)
        if prioritize == "weakest" then
            return a.hp < b.hp
        elseif prioritize == "highest_level" then
            return a.level > b.level
        else
            return (a.hrp.Position - charPos).Magnitude < (b.hrp.Position - charPos).Magnitude
        end
    end)

    return valid[1]
end

