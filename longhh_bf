checkQuesta = function()
    local checkArgs = {
        [1] = { ["Context"] = "Check" }
    }
    local questResult = nil
    pcall(function()
        local requestArgs = {
            [1] = { ["Context"] = "RequestQuest" }
        }
        game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/DragonHunter"):InvokeServer(unpack(requestArgs))
    end)
    local ok, err = pcall(function()
        questResult = game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RF/DragonHunter"):InvokeServer(unpack(checkArgs))
    end)
    local hasQuest = false
    local targetCount
    local targetMob
    local questKind
    if questResult then
        if questResult.Text then
            hasQuest = true
            local questText = questResult.Text
            if string.find(tostring(questText), "Defeat") then
                questKind = 1
                targetCount = string.sub(tostring(questText), 8, 9)
                targetCount = tonumber(targetCount)
                local mobCandidates = { "Hydra Enforcer", "Venomous Assailant" }
                for _, mobName in pairs(mobCandidates) do
                    if string.find(questText, mobName) then
                        targetMob = mobName
                        break
                    end
                end
            elseif string.find(tostring(questText), "Destroy") then
                targetCount = 10
                questKind = 2
                targetMob = nil
            end
        end
    end
    return hasQuest, targetMob, targetCount, questKind
end
