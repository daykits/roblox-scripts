            local visited = { }
            if type(isfile) == "function" and type(readfile) == "function" then
                pcall(function()
                    if isfile(FILE) then
                        local d = HS:JSONDecode(readfile(FILE))
                        if type(d) == "table" then
                            for id, t in pairs(d) do
                                if type(t) == "number" and os.time() - t < TTL then
                                    visited[id] = t
                                end
                            end
                        end
                    end
                end)
            end
            local function save()
                if type(writefile) == "function" then
                    pcall(writefile, FILE, HS:JSONEncode(visited))
