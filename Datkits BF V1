-------------------------------------------------
-- AUTO FARM LEVEL
-------------------------------------------------
Tabs.Main:AddSection("Auto Farm Level")
Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Farm Level (Quest + Nearest)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        ToggleNoclip(Value)

        if not Value then
            isGoingToFarmArea = false
            ResetCharacterState()
            return
        end

        getgenv().AutoFruit = false

        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(0.7)
            end
        end)

        task.spawn(function()
            local noMobTimer = 0

            while getgenv().AutoQuest do
                task.wait(0.12)

                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart

                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()

                    if not HasQuest() then
                        isGoingToFarmArea = false
                        noMobTimer = 0

                        if npcCFrame then
                            local dist = (hrp.Position - npcCFrame.Position).Magnitude
                            if dist > 10 then
                                TweenTo(npcCFrame * CFrame.new(0, 0, 2.5))
                            else
                                StopTween()
                                for i = 1, 5 do
                                    pcall(function()
                                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                    end)
                                    task.wait(0.12)
                                end
                                task.wait(1.3)
                            end
                        end
                        return
                    end

                    local target = FindBestTarget(hrp.Position, mobName, getgenv().TargetPrioritize, 5000)

                    if target then
                        isGoingToFarmArea = false
                        noMobTimer = 0

                        local pos = target.hrp.Position
                        local height = getgenv().FarmDistance or 6
                        local farmCF = CFrame.new(pos + Vector3.new(0, height, 0), pos)
                        TweenTo(farmCF)

                        pcall(function()
                            target.hrp.CanCollide = false
                            target.hrp.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        noMobTimer = noMobTimer + 0.12
                        if noMobTimer > 2.5 and mobCFrame then
                            isGoingToFarmArea = true
                            TweenTo(mobCFrame)
                        end
                    end
                end)
            end

            isGoingToFarmArea = false
            ResetCharacterState()
        end)
    end
})

