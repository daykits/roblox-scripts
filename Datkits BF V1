Tabs.Main:AddToggle("AutoFarm", {
    Title = "Bật Auto Farm (Nhận nhiệm vụ + Đánh quái)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoFarm = Value

        if not Value then
            StopTween()
            local char = GetChar()
            if char and char:FindFirstChild("HumanoidRootPart") then
                local bv = char.HumanoidRootPart:FindFirstChild("FlyBV")
                if bv then bv:Destroy() end
            end
            Fluent:Notify({Title = "Auto Farm", Content = "Đã tắt", Duration = 3})
            return
        end

        Fluent:Notify({Title = "Auto Farm", Content = "Đã bật - Đang chạy...", Duration = 4})

        -- Giữ vũ khí
        task.spawn(function()
            while getgenv().AutoFarm do
                EquipTool()
                task.wait(0.8)
            end
        end)

        -- Vòng lặp chính
        task.spawn(function()
            while getgenv().AutoFarm do
                task.wait(0.2)

                local char = GetChar()
                if not char then
                    task.wait(1)
                    continue
                end

                local info = GetQuestInfo()

                -- Chưa có nhiệm vụ → đi nhận
                if not HasQuest() then
                    local dist = (char.HumanoidRootPart.Position - info.NPC.Position).Magnitude
                    if dist > 15 then
                        TweenTo(info.NPC * CFrame.new(0, 0, 4))
                    else
                        StopTween()
                        -- Nhận nhiệm vụ
                        for i = 1, 6 do
                            pcall(function()
                                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", info.Name, info.Level)
                            end)
                            task.wait(0.12)
                        end
                        task.wait(1.5)
                    end
                else
                    -- Đã có nhiệm vụ → đi đánh quái
                    local mob = FindMob(info.Mob)

                    if mob and mob:FindFirstChild("HumanoidRootPart") then
                        local pos = mob.HumanoidRootPart.Position
                        local height = getgenv().FarmHeight or 7
                        local farmPos = CFrame.new(pos + Vector3.new(0, height, 0), pos)
                        TweenTo(farmPos)

                        -- Khóa mob
                        pcall(function()
                            mob.HumanoidRootPart.CanCollide = false
                            mob.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        -- Không thấy mob → bay về khu vực quái
                        TweenTo(info.MobArea)
                    end
                end
            end
        end)
    end
})

