    FX.Dwell.Tick = function(mode, aliveCount)
        local now = os.clock()
        local need = (FX.Cfg and FX.Cfg.MobDwellSec) or 5.25
        local st = FX.Dwell.T[mode]
        if st and now - st.last > 2 then
            st = nil
        end
        if not st then
            st = { t0 = nil, last = now, left = false }
            FX.Dwell.T[mode] = st
        end
        st.last = now
        local bossName = (mode == "CakePrince" and FX.Names.CakeBoss) or (mode == "Tyrant" and FX.Names.TyrantBoss) or nil
        local bossAlive = false
        if bossName then
            pcall(function()
                local en = workspace:FindFirstChild("Enemies")
                local b = en and en:FindFirstChild(bossName)
                bossAlive = b ~= nil and FX.AliveMob(b)
            end)
        end
        if (aliveCount or 0) > 0 or bossAlive then
            st.t0 = nil
            st.left = false
            return false, need
        end
        if not st.t0 then
            st.t0 = now
            if FX.TraceAdd then
                FX.TraceAdd("DWELL_START", mode, need)
            end
        end
        local el = now - st.t0
        if el >= need then
            if not st.left then
                st.left = true
                if FX.TraceAdd then
                    FX.TraceAdd("DWELL_LEAVE", mode, el)
                end
            end
            return true, 0
        end
        return false, need - el
    end
    -- R05/R06: Centralized Tyrant eye reader — dùng cho IH.Probe, tyEyes, tySpam, FH.Tick handoff
    -- Trả { count, ok, list } — ok=false khi hierarchy lỗi (UNKNOWN state)
    FX.ReadTyrantEyes = function()
        local info = {
            count = 0,
            ok = false,
            list = { }
        }
        local okRead = pcall(function()
            local model = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("TikiOutpost") and workspace.Map.TikiOutpost:FindFirstChild("IslandModel")
            if not model then return end
            local eye1 = model:FindFirstChild("Eye1")
            local eye2 = model:FindFirstChild("Eye2")
            local chunks = model:FindFirstChild("IslandChunks")
            local chunkE = chunks and chunks:FindFirstChild("E")
            local eye3 = chunkE and chunkE:FindFirstChild("Eye3")
            local eye4 = chunkE and chunkE:FindFirstChild("Eye4")
            local eyes = { eye1, eye2, eye3, eye4 }
            for i = 1, #eyes do
                local eye = eyes[i]
                if eye and eye:IsA("BasePart") and eye.Transparency ~= 1 then
                    info.count = info.count + 1
                    info.list[i] = true
                end
            end
            info.ok = true
        end)
        if not okRead then info.ok = false end
        return info
    end
    FX.KillWatch = function(mob, since, dt)
        if (dt or 0) >= 0.05 then return os.clock() end
        if os.clock() - since < 2.5 then return since end
        pcall(function()
            mob:SetAttribute("Locked", nil)
            local mh = mob:FindFirstChild("HumanoidRootPart")
            local hr = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            local dd = (mh and hr) and (hr.Position - mh.Position).Magnitude or -1
            if FX.TraceAdd then
                FX.TraceAdd("KILL_STALL", mob.Name, dd)
            end
            if mh and dd > 60 then
                _tp(mh.CFrame * CFrame.new(0, 20, 0))
            end
        end)
        return os.clock()
    end
    FX._SH = { }
    FX.SpawnHold = function(mode, fallbackCF, rotate)
        local arrived = false
        pcall(function()
            local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            local now = os.clock()
            local st = FX._SH[mode]
            if not st or now - st.t > 15 then
                local list = { }
                local names = FX.Area.Mobs(mode)
                local wo = workspace:FindFirstChild("_WorldOrigin")
                local sps = wo and wo:FindFirstChild("EnemySpawns")
                if sps then
                    for _, sp in ipairs(sps:GetChildren()) do
                        if sp:IsA("BasePart") then
                            for _, n in ipairs(names) do
                                if string.find(sp.Name, n, 1, true) then
                                    list[#list + 1] = sp.CFrame
                                    break
                                end
                            end
                        end
                    end
                end
                table.sort(list, function(a, b)
                    return (a.Position - hrp.Position).Magnitude < (b.Position - hrp.Position).Magnitude
                end)
                st = { list = list, t = now, idx = 1 }
                FX._SH[mode] = st
            end
            if rotate and #st.list > 1 then
                st.idx = (st.idx % #st.list) + 1
            end
            local dest = (#st.list > 0) and (st.list[st.idx] * CFrame.new(0, 25, 0)) or fallbackCF
            if not dest then return end
            if (hrp.Position - dest.Position).Magnitude > 40 then
                _tp(dest)
            else
                arrived = true
            end
        end)
        return arrived
    end
    FX.IslandState = function(mode)
        local bossName
        if mode == "CakePrince" then
            bossName = "Cake Prince"
        elseif mode == "Tyrant" then
            bossName = "Tyrant of the Skies"
        end
        if bossName then
            local enemies = workspace:FindFirstChild("Enemies")
            if enemies then
                local b = enemies:FindFirstChild(bossName)
                if b and FX.AliveMob(b) then return "BOSS_ALIVE" end
            end
        end
        if FX.Nav and FX.Nav.IsActive then
            local ok, active = pcall(FX.Nav.IsActive)
            if ok and active then return "TRAVEL_NPC" end
        end
        -- R15: Tyrant dùng eye count + _TyrantKillLast thay vì _CakeKillLast
        if mode == "Tyrant" then
            local eyeInfo = FX.ReadTyrantEyes and FX.ReadTyrantEyes() or { count = 0, ok = false }
