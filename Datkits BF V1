-- AUTO FARM LEVEL
-------------------------------------------------
Tabs.Main:AddSection("Auto Farm Level")

Tabs.Main:AddToggle("AutoQuest", {
    Title = "Auto Farm Level (Quest + Nearest)",
    Default = false,
    Callback = function(value)
        Config.AutoQuest = value
        ToggleNoclip(value)

        if not value then
            ResetCharacterState()
            return
        end
        Config.AutoFruit = false

        task.spawn(function()
            local noMobTime = 0

            while Config.AutoQuest do
                task.wait(0.12)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end

                    local hrp = char.HumanoidRootPart
                    local questName, questLevel, mobName, npcCF, areaCF = GetQuestData()

                    -- Chưa có nhiệm vụ -> bay tới NPC nhận
                    if not HasQuest() then
                        isGoingToFarmArea = false
                        noMobTime = 0

                        if (hrp.Position - npcCF.Position).Magnitude > 10 then
                            TweenTo(npcCF * CFrame.new(0, 0, 2.5))
                        else
                            StopTween()
                            for _ = 1, 5 do
                                pcall(function()
                                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                end)
                                task.wait(0.11)
                            end
                            task.wait(1.25)
                        end
                        return
                    end

                    -- Có nhiệm vụ -> tìm quái
                    local target = FindBestTarget(hrp.Position, mobName, Config.TargetPrioritize, 5500)

                    if target then
                        isGoingToFarmArea = false
                        noMobTime = 0

                        local pos = target.hrp.Position
                        TweenTo(CFrame.new(pos + Vector3.new(0, Config.FarmDistance, 0), pos))

                        pcall(function()
                            target.hrp.CanCollide = false
                            target.hrp.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        -- Không thấy quái quá lâu -> bay về bãi farm
                        noMobTime = noMobTime + 0.12
                        if noMobTime > 2.2 then
                            isGoingToFarmArea = true
                            TweenTo(areaCF)
                        end
                    end
                end)
            end

            ResetCharacterState()
        end)
    end,
})

