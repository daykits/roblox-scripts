task.spawn(function()
    pcall(function()
        require(game.ReplicatedStorage.Util.CameraShaker):Stop()
    end)

    local controller
    for _, v in pairs(getreg()) do
        if typeof(v) == "function" then
            local env = getfenv(v)
            if env and env.script == LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework") then
                for _, up in pairs(debug.getupvalues(v)) do
                    if typeof(up) == "table" and up.activeController then
                        controller = up
                        break
                    end
                end
            end
        end
        if controller then break end
    end

    RunService.RenderStepped:Connect(function()
        if not getgenv().FastAttack then return end
        pcall(function()
            if controller and controller.activeController then
                local ac = controller.activeController
                ac.timeToNextAttack = -math.huge
                ac.attacking = false
                ac.increment = 4
                ac.blocking = false
                ac.hitboxMagnitude = 130
            end
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new())
        end)
    end)
end)

