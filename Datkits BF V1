local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    local hum = GetHumanoid()
    if not hum then return end

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == "Melee" then
                hum:EquipTool(tool)
                return
            end
            local n = tool.Name:lower()
            for _, kw in ipairs(MELEE_KEYWORDS) do
                if n:find(kw, 1, true) then
                    hum:EquipTool(tool)
                    return
                end
            end
        end
    end
    local any = backpack:FindFirstChildOfClass("Tool")
    if any then hum:EquipTool(any) end
end

