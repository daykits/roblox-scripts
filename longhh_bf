                if cur ~= "" then
                    url = url .. "&cursor=" .. cur
                end
                local okh, body = pcall(function() return game:HttpGet(url) end)
                if not okh or type(body) ~= "string" then break end
                local okd, data = pcall(function() return HS:JSONDecode(body) end)
                if not okd or type(data) ~= "table" or type(data.data) ~= "table" then break end
                for _, s in ipairs(data.data) do
                    if type(s) == "table" and s.id and not seen[s.id] then
                        seen[s.id] = true
                        list[#list + 1] = {
                            id = s.id,
                            n = tonumber(s.playing) or 0,
                            max = tonumber(s.maxPlayers) or 0,
                            r = math.random()
                        }
                    end
                end
                if type(data.nextPageCursor) ~= "string" or data.nextPageCursor == "" then break end
                cur = data.nextPageCursor
                task.wait(0.3)
            end
            if #list == 0 then
                local br0 = RS:FindFirstChild("__ServerBrowser")
                if br0 then
                    for page = 1, 8 do
                        local okr, rem = pcall(function() return br0:InvokeServer(page) end)
                        if okr and type(rem) == "table" then
                            for id, v in pairs(rem) do
                                local c = type(v) == "table" and tonumber(v.Count) or nil
                                if c and c < 12 and not seen[id] then
                                    seen[id] = true
                                    list[#list + 1] = { id = id, n = c, max = 0, r = math.random() }
                                end
                            end
                        end
                        task.wait(0.2)
                    end
                end
            end
            local cand = { }
            for _, s in ipairs(list) do
                if s.id ~= game.JobId and not visited[s.id] and (s.max == 0 or s.max - s.n >= 2) then
                    cand[#cand + 1] = s
                end
            end
            table.sort(cand, function(a, b)
                if a.n ~= b.n then return a.n < b.n end
                return a.r < b.r
            end)
