-- ============================================
-- XỬ LÝ NHẬP KEY
-- ============================================
local function checkKey()
    local input = KeyBox.Text

    if input == SECRET_KEY then
        ErrorLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        ErrorLabel.Text = "✅ Key hợp lệ! Đang mở menu..."

        task.wait(0.6)

        KeyFrame.Visible = false
        MenuFrame.Visible = true
    else
        ErrorLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        ErrorLabel.Text = "❌ Key không đúng! Vui lòng thử lại."
        KeyBox.Text = ""
    end
end

ConfirmBtn.MouseButton1Click:Connect(checkKey)

-- Nhấn Enter để xác nhận
KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
    end
end)

