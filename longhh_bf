        -- mob quanh cua: Hellfire Gas uu tien (khong gioi han tam), bo Jack o' Lantern / Pumpkin Snowman (farm rieng)
        function TT.findHellfireGas()
            local now = tick()
            local cached = TT.GAS_CACHE
            if now - (TT.GAS_CACHE_AT or -1e9) < 0.75 then
                if cached and TT.alive(cached) then return cached end
                return nil
            end
            TT.GAS_CACHE, TT.GAS_CACHE_AT = nil, now
            local en = workspace:FindFirstChild("Enemies")
            local map = workspace:FindFirstChild("Map")
            local roots = { }
            if en then
                roots[#roots + 1] = en
            end
            roots[#roots + 1] = workspace
            if map then
                roots[#roots + 1] = map
            end
            local function direct(root)
                if not root then return nil end
                local exact = root:FindFirstChild("Hellfire Gas")
                if TT.alive(exact) then return exact end
                for _, child in ipairs(root:GetChildren()) do
                    if normName(child.Name) == "hellfiregas" and TT.alive(child) then
                        return child
                    end
                end
                return nil
            end
            -- Direct folders/children first for fast event detection.
            for _, root in ipairs(roots) do
                local found = direct(root)
                if found then
                    TT.GAS_CACHE = found
                    return found
                end
            end
            -- Fallback: nested model scan with normalized names and deduplication.
            local best, bestD
            local h = getRoot()
            local seen = setmetatable({ }, { __mode = "k" })
            local deepRoots = { }
            if en then
                deepRoots[#deepRoots + 1] = en
            end
            if map then
                deepRoots[#deepRoots + 1] = map
            end
            deepRoots[#deepRoots + 1] = workspace
            for _, root in ipairs(deepRoots) do
                if root then
                    for _, obj in ipairs(root:GetDescendants()) do
                        if not seen[obj] then
                            seen[obj] = true
                            if obj:IsA("Model") and normName(obj.Name) == "hellfiregas" and TT.alive(obj) then
                                local r = obj:FindFirstChild("HumanoidRootPart")
                                local d = h and r and (r.Position - h.Position).Magnitude or 0
                                if not h or (r and d <= 6000) then
                                    if not bestD or d < bestD then best, bestD = obj, d end
                                end
                            end
                        end
                    end
                end
            end
            TT.GAS_CACHE = best
            return best
        end
        function TT.findMob()
            if not _G.SelectWeapon then return nil end
            local h = getRoot()
            local en = workspace:FindFirstChild("Enemies")
            if not h then TT.MOB_CACHE = nil return nil end
            local now = tick()
            if TT.MOB_CACHE and now - TT.MOB_CACHE_AT < 0.2 and TT.alive(TT.MOB_CACHE) then
                local cachedRoot = TT.MOB_CACHE:FindFirstChild("HumanoidRootPart")
                local cachedName = normName(TT.MOB_CACHE.Name)
                local notIgnored = (TT.ignore[TT.MOB_CACHE] or 0) < now
                if cachedRoot and notIgnored and cachedName ~= "jackolantern" and cachedName ~= "pumpkinsnowman"
                    and (cachedName == "hellfiregas" or (cachedRoot.Position - h.Position).Magnitude <= TT.MOB_RANGE) then
                    return TT.MOB_CACHE
                end
            end
            TT.MOB_CACHE, TT.MOB_CACHE_AT = nil, now
            local gas = TT.findHellfireGas()
            if TT.alive(gas) then
                TT.MOB_CACHE = gas
                return gas
            end
            if not en then return nil end
            local best, bd = nil, TT.MOB_RANGE
            local seen = setmetatable({ }, { __mode = "k" })
            local function consider(m)
                if not m or seen[m] or not m:IsA("Model") then return end
                seen[m] = true
                local n = normName(m.Name)
                if (TT.ignore[m] or 0) >= now or n == "jackolantern" or n == "pumpkinsnowman" or not TT.alive(m) then
                    return
                end
                local root = m:FindFirstChild("HumanoidRootPart")
                local d = root and (root.Position - h.Position).Magnitude
                if d and d <= bd then
                    best, bd = m, d
                end
            end
            for _, m in ipairs(en:GetChildren()) do consider(m) end
            if not best then
                for _, m in ipairs(en:GetDescendants()) do
                    if m:IsA("Model") then
                        consider(m)
                    end
                end
            end
            TT.MOB_CACHE = best
            return best
        end

