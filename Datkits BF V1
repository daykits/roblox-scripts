local function GetNet()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    if not modules then return nil end
    local net = modules:FindFirstChild("Net")
    if not net then return nil end
    return net:FindFirstChild("RE/RegisterAttack"), net:FindFirstChild("RE/RegisterHit")
end

local function DoFastAttack()
    local char = GetCharacter()
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    pcall(function() tool:Activate() end)

    local regAttack, regHit = GetNet()
    if not regAttack then return end
    pcall(function() regAttack:FireServer(0.1) end)

    local lcRemote = tool:FindFirstChild("LeftClickRemote")
    local hits = GetClosestEnemies(Config.HitboxRange)
    local hrp = char.HumanoidRootPart

    if lcRemote then
        local dir = #hits > 0
            and (hits[1].hrp.Position - hrp.Position).Unit
            or Vector3.new(0, -1, 0)
        pcall(function() lcRemote:FireServer(dir, 1) end)
    end

    if regHit and #hits > 0 then
        for _, data in ipairs(hits) do
            pcall(function()
                regHit:FireServer(data.hrp, { data.enemy })
            end)
        end
    end
end

