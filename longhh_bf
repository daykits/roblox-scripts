        -- 4 huong quanh cua, xep theo raycast: it tran + khong bi chan truoc
        function TT.standDirs(door, cf, h)
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { lp.Character, door }
            params.IgnoreWater = true
            local raw = { cf.LookVector, -cf.LookVector, cf.RightVector, -cf.RightVector }
            local cands = { }
            for _, v in ipairs(raw) do
                local d = Vector3.new(v.X, 0, v.Z)
                if d.Magnitude > 0.1 then
                    d = d.Unit
                    local dup = false
                    for _, c in ipairs(cands) do
                        if c.dir:Dot(d) > 0.99 then
                            dup = true
                            break
                        end
                    end
                    if not dup then
                        local pos = cf.Position + d * TT.STAND
                        local score = 0
                        pcall(function()
                            local up = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, 60, 0), params)
                            if up and up.Instance.Transparency < 1 then
                                score = score + 2
                            end
                            if workspace:Raycast(pos, (cf.Position - pos) * 0.8, params) then
                                score = score + 3
                            end
                        end)
                        score = score + (h.Position - pos).Magnitude * 0.001
                        cands[#cands + 1] = { dir = d, score = score }
                    end
                end
            end
            table.sort(cands, function(a, b) return a.score < b.score end)
            local out = { }
            for _, c in ipairs(cands) do out[#out + 1] = c.dir end
            if #out == 0 then
                out[1] = Vector3.new(0, 0, 1)
            end
            return out
        end

        -- nhan vat co nam trong khung bao cua obj (Model:GetBoundingBox hoac gop BasePart) khong
        function TT.boxHas(obj)
            local h = getRoot()
            if not (h and obj) then return false end
            local ok, inside = pcall(function()
                local cf, size
                if obj:IsA("Model") then
                    cf, size = obj:GetBoundingBox()
                else
                    local mn, mx
                    for _, d in ipairs(obj:GetDescendants()) do
                        if d:IsA("BasePart") then
                            local lo, hi = d.Position - d.Size / 2, d.Position + d.Size / 2
                            mn = mn and Vector3.new(math.min(mn.X, lo.X), math.min(mn.Y, lo.Y), math.min(mn.Z, lo.Z)) or lo
                            mx = mx and Vector3.new(math.max(mx.X, hi.X), math.max(mx.Y, hi.Y), math.max(mx.Z, hi.Z)) or hi
                        end
                    end
                    if not mn then return false end
                    cf, size = CFrame.new((mn + mx) / 2), mx - mn
                end
                local rel = cf:PointToObjectSpace(h.Position)
                return math.abs(rel.X) <= size.X / 2 + 100 and math.abs(rel.Y) <= size.Y / 2 + 180 and math.abs(rel.Z) <= size.Z / 2 + 100
            end)
            return ok and inside == true
        end
