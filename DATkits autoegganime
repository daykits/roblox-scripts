-- Tạo Tab chính (Sửa lỗi thiếu Tab trong Rayfield)
local MainTab = Window:CreateTab("Chính", 4483362458)

-- CẤU HÌNH TỌA ĐỘ
local targetPosition = Vector3.new(1154.266, 15.681, -484.52)
_G.AutoFarm = false

-- Hàm lấy vị trí an toàn cho cả Model và BasePart (Tránh lỗi văng Script)
local function getPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        return object:GetPivot().Position
    end
    return nil
end

-- Hàm tự động kích hoạt phím E
local function triggerProximityPrompts()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Parent then
            local promptPos = getPosition(prompt.Parent)
            if promptPos and (promptPos - targetPosition).Magnitude < 15 then
                task.spawn(function()
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.1)
                        prompt:InputHoldEnd()
                    end
                end)
            end
        end
    end
end

-- Tạo nút Bật/Tắt (Toggle) đúng chuẩn Rayfield
local FarmToggle = MainTab:CreateToggle({
   Name = "Tự Động Gom Trứng",
   CurrentValue = false,
   Flag = "AutoFarmToggle",
   Callback = function(Value)
      _G.AutoFarm = Value
   end,
})

-- Vòng lặp chính xử lý Teleport và Nhặt trứng
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                -- 1. Lưu vị trí ban đầu
                local originalPosition = rootPart.CFrame
                
                -- 2. Dịch chuyển đến vị trí mục tiêu
                rootPart.CFrame = CFrame.new(targetPosition)
                task.wait(0.5)
                
                -- Kích hoạt giữ phím E
                triggerProximityPrompts()
                task.wait(1.5)
                
                -- 3. Dịch chuyển quay trở lại vị trí ban đầu
                rootPart.CFrame = originalPosition
                
                -- 4. Thời gian nghỉ (5 giây)
                task.wait(5)
            end
        end
    end
end)

