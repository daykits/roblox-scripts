-- Hàm Dịch chuyển an toàn
local function safeTeleport(cframe)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(cframe)
    end
end

-- Hàm kích hoạt nút nhặt xung quanh tọa độ
local function triggerPromptAt(targetPos)
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local parent = prompt.Parent
            if parent then
                local cf = parent:IsA("BasePart") and parent.CFrame or (parent:IsA("Model") and parent:GetPivot() or nil)
                if cf and (cf.Position - targetPos).Magnitude < 25 then
                    if fireproximityprompt then
                        fireproximityprompt(prompt, 0, true)
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.1)
                        prompt:InputHoldEnd()
                    end
                    break
                end
            end
        end
    end
end

-- Hàm cầm trứng lên tay
local function equipTool()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")
    
    if humanoid and backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                humanoid:EquipTool(tool)
                break
            end
        end
    end
end

