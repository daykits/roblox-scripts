                            TextColor3 = Color3.fromRGB(135, 151, 187),
                            TextXAlignment = Enum.TextXAlignment.Left,
                            TextTruncate = Enum.TextTruncate.AtEnd,
                            Position = UDim2.fromOffset(11, 23),
                            Size = UDim2.new(1, -22, 0, 12),
