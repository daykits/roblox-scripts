-- HIGH JUMP
--====================================================================
local jumpState = {
	values = { JumpPower = CONFIG.JumpPower.Default, JumpHeight = CONFIG.JumpHeight.Default },
	originals = weakTable(),
}

local function getJumpProperty(humanoid)
	return humanoid.UseJumpPower and "JumpPower" or "JumpHeight"
end

local function applyJump()
	local humanoid = getHumanoid()
	if not humanoid then return end
	local property = getJumpProperty(humanoid)
	if jumpState.originals[humanoid] == nil then
		jumpState.originals[humanoid] = { property = property, value = humanoid[property] }
	end
	humanoid[property] = jumpState.values[property]
end

local function restoreJump()
	local humanoid = getHumanoid()
	if not humanoid then return end
	local original = jumpState.originals[humanoid]
	if original then
		humanoid[original.property] = original.value
		jumpState.originals[humanoid] = nil
	else
		local property = getJumpProperty(humanoid)
		humanoid[property] = CONFIG[property].Default
	end
end

local function refreshJumpSlider()
	if not ui.jumpSlider then return end
	local humanoid = getHumanoid()
	local property = humanoid and getJumpProperty(humanoid) or "JumpPower"
	local range = CONFIG[property]
	local label = property == "JumpPower" and "Jump Power" or "Jump Height"
	ui.jumpSlider.setRange(range.Min, range.Max, jumpState.values[property], label)
end

features.HighJump = {
	display = "High Jump",
	enabled = false,
	start = function()
		refreshJumpSlider()
		applyJump()
	end,
	stop = restoreJump,
}

--====================================================================
-- FIX LAG
--====================================================================
local LAG_EFFECTS = {
	ParticleEmitter = "Enabled", Trail = "Enabled", Beam = "Enabled", Smoke = "Enabled",
	Fire = "Enabled", Sparkles = "Enabled", PointLight = "Enabled", SpotLight = "Enabled",
	SurfaceLight = "Enabled",
}
local LAG_POST_EFFECTS = {
	BloomEffect = "Enabled", BlurEffect = "Enabled", SunRaysEffect = "Enabled",
	ColorCorrectionEffect = "Enabled", DepthOfFieldEffect = "Enabled",
}
local lagState = { store = weakTable(), maid = createMaid(), protectedCache = weakTable() }

local function hasGameplayTag(instance)
	if CollectionService:HasTag(instance, CONFIG.EnemyTag) then
		return true
	end
	for _, tag in ipairs(CONFIG.LootTags) do
		if CollectionService:HasTag(instance, tag) then
			return true
		end
	end
	return false
end

local function isProtectedAncestor(ancestor, enemyFolder)
	local cached = lagState.protectedCache[ancestor]
	if cached ~= nil then return cached end
	local result = hasGameplayTag(ancestor)
		or ancestor == enemyFolder
		or (ancestor:IsA("Model") and ancestor:FindFirstChildOfClass("Humanoid") ~= nil)
	lagState.protectedCache[ancestor] = result
	return result
end

local enemyRegistry = { tagged = weakTable(), folderSet = weakTable(), folder = nil, maid = createMaid() }

-- Never touches NPCs, characters, tagged enemies/loot or anything inside the enemy folder.
local function isProtected(instance)
	if hasGameplayTag(instance) then return true end
	local ancestor = instance.Parent
	while ancestor and ancestor ~= Workspace do
		if isProtectedAncestor(ancestor, enemyRegistry.folder) then
			return true
		end
		ancestor = ancestor.Parent
	end
	return false
end

local function simplifyPart(part)
	local store = lagState.store
	overrideProperty(store, part, "CastShadow", false)
	if part.Reflectance > 0 then
		overrideProperty(store, part, "Reflectance", 0)
	end
	if part:IsA("MeshPart") then
		overrideProperty(store, part, "RenderFidelity", Enum.RenderFidelity.Performance)
	end
	-- Only non-colliding (decorative) parts change material, so walking friction is unaffected.
	if not part.CanCollide and part.Material ~= Enum.Material.SmoothPlastic then
		overrideProperty(store, part, "Material", Enum.Material.SmoothPlastic)
		if part.MaterialVariant ~= "" then
			overrideProperty(store, part, "MaterialVariant", "")
		end
	end
end

local function processLagInstance(instance)
	if runtime.destroyed then return end
	local effectProperty = LAG_EFFECTS[instance.ClassName]
	if effectProperty then
		if not isProtected(instance) then
			overrideProperty(lagState.store, instance, effectProperty, false)
		end
	elseif instance:IsA("BasePart") then
		if not instance:IsA("Terrain") and not isProtected(instance) then
			simplifyPart(instance)
		end
	elseif instance:IsA("Decal") then -- includes Texture
		if not isProtected(instance) then
			overrideProperty(lagState.store, instance, "Transparency", 1)
		end
	end
end

local function processEnvironmentInstance(instance)
	local postProperty = LAG_POST_EFFECTS[instance.ClassName]
	if postProperty then
		overrideProperty(lagState.store, instance, postProperty, false)
	elseif instance:IsA("Atmosphere") then
		overrideProperty(lagState.store, instance, "Density", 0)
		overrideProperty(lagState.store, instance, "Haze", 0)
	end
end

local function processTerrain()
	local terrain = Workspace.Terrain
	overrideProperty(lagState.store, terrain, "Decoration", false)
	overrideProperty(lagState.store, terrain, "WaterWaveSize", 0)
	overrideProperty(lagState.store, terrain, "WaterReflectance", 0)
end

local function scanWorkspaceInChunks()
	local processed = 0
	for _, instance in ipairs(Workspace:GetDescendants()) do
		processLagInstance(instance)
		processed += 1
		if processed % 400 == 0 then
			task.wait()
		end
	end
	notify("Fix Lag: initial scan complete", "info")
end

local function startFixLag()
	lagState.protectedCache = weakTable()
	setLightingOverride("FixLag", { GlobalShadows = false, FogEnd = CONFIG.FixLag.FogEnd })
	for _, instance in ipairs(Lighting:GetDescendants()) do
		processEnvironmentInstance(instance)
	end
	local camera = Workspace.CurrentCamera
	if camera then
		for _, instance in ipairs(camera:GetChildren()) do
			processEnvironmentInstance(instance)
		end
		lagState.maid.give(camera.ChildAdded:Connect(processEnvironmentInstance))
	end
	processTerrain()
	lagState.maid.give(Lighting.DescendantAdded:Connect(processEnvironmentInstance))
	lagState.maid.give(Workspace.DescendantAdded:Connect(processLagInstance))
	lagState.maid.give(task.spawn(scanWorkspaceInChunks))
end

local function stopFixLag()
	lagState.maid.clean()
	restoreStore(lagState.store)
	setLightingOverride("FixLag", nil)
end

features.FixLag = { display = "Fix Lag", enabled = false, start = startFixLag, stop = stopFixLag }

