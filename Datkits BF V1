Tabs.Main:AddSection("Auto Farm")
Tabs.Main:AddToggle("AutoFarm", {
    Title = "Bật Auto Farm (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoFarm = Value

        if not Value then
            StopTween()
            Fluent:Notify({Title="Auto Farm", Content="Đã tắt", Duration=3})
            return
        end

        Fluent:Notify({Title="Auto Farm", Content="Đã bật - Đang tự động farm", Duration=4})

        -- VÒNG LẶP FARM CHÍNH
        task.spawn(function()
            if farmBusy then return end
            farmBusy = true

            while getgenv().AutoFarm do
                local ok = pcall(function()
                    local char = GetChar()
                    if not char then
                        StopTween()
                        task.wait(1)
                        return
                    end

                    local info = GetQuestInfo()
                    if not info then
                        task.wait(0.5)
                        return
                    end

                    -- Equip thưa hơn để tránh spam Humanoid:EquipTool.
                    if getgenv().AutoEquip and (os.clock() - lastEquip) > 1 then
                        EquipTool()
                        lastEquip = os.clock()
                    end

                    -- 1) Chưa có quest -> tới NPC rồi mới gọi StartQuest.
                    if not HasQuest() then
                        StopTween()

                        local distNPC = (char.HumanoidRootPart.Position - info.NPC.Position).Magnitude
                        if distNPC > 10 then
                            TweenTo(info.NPC * CFrame.new(0, 0, 3))
                        elseif (os.clock() - lastQuestTry) > 1 then
                            lastQuestTry = os.clock()
                            pcall(function()
                                ReplicatedStorage.Remotes.CommF_:InvokeServer(
                                    "StartQuest", info.Name, info.Level
                                )
                            end)
                        end
                    else
                        -- 2) Có quest -> tìm đúng mob.
                        local mob = FindMob(info.Mob)

                        if mob then
                            local hum = mob:FindFirstChildOfClass("Humanoid")
                            local root = mob:FindFirstChild("HumanoidRootPart")

                            if hum and root and hum.Health > 0 then
                                local pos = root.Position
                                local height = getgenv().FarmHeight or 7
                                local farmCF = CFrame.new(
                                    pos + Vector3.new(0, height, 0),
                                    pos
                                )

                                TweenTo(farmCF)

                                pcall(function()
                                    root.CanCollide = false
                                    root.AssemblyLinearVelocity = Vector3.zero
                                    root.AssemblyAngularVelocity = Vector3.zero
                                end)

                                -- Đảm bảo nhân vật còn hướng về mob khi đã ở gần.
                                if (char.HumanoidRootPart.Position - pos).Magnitude <= 12 then
                                    char.HumanoidRootPart.CFrame = farmCF
                                end
                            end
                        else
                            -- Chưa spawn mob -> tới bãi farm, không spam tạo tween.
                            TweenTo(info.MobArea)
                        end
                    end
                end)

                if not ok then
                    StopTween()
                end

                task.wait(0.15)
            end

            StopTween()
            farmBusy = false
        end
})

