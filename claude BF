-- CHARACTER TRACKING
--====================================================================
local characterMaid = createMaid()
local characterParts = weakTable()

local function trackCharacterParts(character)
	characterMaid.clean()
	characterParts = weakTable()
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			characterParts[descendant] = true
		end
	end
	characterMaid.give(character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then
			characterParts[descendant] = true
		end
	end))
	characterMaid.give(character.DescendantRemoving:Connect(function(descendant)
		characterParts[descendant] = nil
	end))
end

--====================================================================
-- NOCLIP (reference-counted requests)
--====================================================================
local noclip = { requests = {}, originals = weakTable(), connection = nil }

local function applyNoclipStep()
	for part in pairs(characterParts) do
		if part.Parent and part.CanCollide then
			noclip.originals[part] = true -- only parts that were colliding are recorded
			part.CanCollide = false
		end
	end
end

local function refreshNoclip()
	local needed = next(noclip.requests) ~= nil
	if needed and not noclip.connection then
		noclip.connection = RunService.Stepped:Connect(applyNoclipStep)
	elseif not needed and noclip.connection then
		noclip.connection:Disconnect()
		noclip.connection = nil
		for part in pairs(noclip.originals) do
			if part.Parent then
				part.CanCollide = true
			end
			noclip.originals[part] = nil
		end
	end
end

local function requestNoclip(source)
	noclip.requests[source] = true
	refreshNoclip()
end

local function releaseNoclip(source)
	noclip.requests[source] = nil
	refreshNoclip()
end

features.Noclip = {
	display = "Noclip",
	enabled = false,
	start = function() requestNoclip("Manual") end,
	stop = function() releaseNoclip("Manual") end,
}

--====================================================================
-- SPEED WALK
--====================================================================
local speedState = { value = CONFIG.WalkSpeed.Default, originals = weakTable(), warnedAt = 0 }
local speedMaid = createMaid()

local function applySpeed()
	local humanoid = getHumanoid()
	if not humanoid then return end
	if speedState.originals[humanoid] == nil then
		speedState.originals[humanoid] = humanoid.WalkSpeed
	end
	humanoid.WalkSpeed = speedState.value
end

local function bindSpeedWatcher()
	speedMaid.clean()
	local humanoid = getHumanoid()
	if not humanoid then return end
	speedMaid.give(humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		local overridden = math.abs(humanoid.WalkSpeed - speedState.value) > 0.01
		if features.SpeedWalk.enabled and overridden and os.clock() - speedState.warnedAt > 5 then
			speedState.warnedAt = os.clock()
			notify("The game is overriding WalkSpeed (server-controlled).", "warning")
		end
	end))
end

local function restoreSpeed()
	local humanoid = getHumanoid()
	if not humanoid then return end
	humanoid.WalkSpeed = speedState.originals[humanoid] or CONFIG.WalkSpeed.Default
	speedState.originals[humanoid] = nil
end

features.SpeedWalk = {
	display = "Speed Walk",
	enabled = false,
	start = function()
		applySpeed()
		bindSpeedWatcher()
	end,
	stop = function()
		speedMaid.clean()
		restoreSpeed()
	end,
}

