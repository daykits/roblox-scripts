local Move = {
    Active     = false,
    TargetCF   = nil,
    SmoothPos  = nil,
    BoundHRP   = nil,
    AlignPos   = nil,
    AlignOri   = nil,
    Attach     = nil,
    Heartbeat  = nil,
}

local function CleanupMoveInstances()
    if Move.AlignPos then pcall(function() Move.AlignPos:Destroy() end) end
    if Move.AlignOri then pcall(function() Move.AlignOri:Destroy() end) end
    if Move.Attach   then pcall(function() Move.Attach:Destroy()   end) end
    Move.AlignPos = nil
    Move.AlignOri = nil
    Move.Attach   = nil
    Move.BoundHRP = nil
end

local function EnsureMoveInstances(hrp)
    if not hrp or not hrp.Parent then return false end
    if Move.BoundHRP == hrp and Move.AlignPos and Move.AlignPos.Parent then
        return true
    end
    CleanupMoveInstances()

    local att = Instance.new("Attachment")
    att.Name   = "FarmAtt"
    att.Parent = hrp

    local ap = Instance.new("AlignPosition")
    ap.Name                = "FarmAP"
    ap.Attachment0         = att
    ap.Mode                = Enum.PositionAlignmentMode.OneAttachment
    ap.Position            = hrp.Position
    ap.MaxForce            = 125000
    ap.Responsiveness      = 80
    ap.ApplyAtCenterOfMass = false
    ap.Parent              = hrp

    local ao = Instance.new("AlignOrientation")
    ao.Name           = "FarmAO"
    ao.Attachment0    = att
    ao.Mode           = Enum.OrientationAlignmentMode.OneAttachment
    ao.CFrame         = hrp.CFrame
    ao.MaxTorque      = 125000
    ao.Responsiveness = 80
    ao.Parent         = hrp

    Move.BoundHRP = hrp
    Move.AlignPos = ap
    Move.AlignOri = ao
    Move.Attach   = att
    return true
end

local function StartFly()
    local char = GetCharacter()
    if not char then return false end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if not EnsureMoveInstances(hrp) then return false end

    pcall(function() hum.PlatformStand = true end)
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end)
    pcall(function() hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end)

    if not Move.Active then
        Move.SmoothPos = hrp.Position
        Move.Active = true
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
    return true
end

local function StopFly()
    if not Move.Active then return end
    Move.Active   = false
    Move.TargetCF = nil
    Move.SmoothPos = nil

    local char = GetCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.PlatformStand = false end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
end

local function SetMoveTarget(targetCFrame)
    if not targetCFrame then return end
    if not StartFly() then return end
    Move.TargetCF = targetCFrame
end

local function BindHeartbeat()
    if Move.Heartbeat then
        Move.Heartbeat:Disconnect()
        Move.Heartbeat = nil
    end
    Move.Heartbeat = RunService.Heartbeat:Connect(function(dt)
        if not Move.Active then return end
        local char = GetCharacter()
        if not char then
            Move.Active = false
            return
        end
        local hrp = char.HumanoidRootPart
        if not hrp or not Move.TargetCF then return end

        if not Move.AlignPos or not Move.AlignPos.Parent then
            if not EnsureMoveInstances(hrp) then return end
        end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end

        local alpha = math.clamp(dt * 18, 0, 1)
        Move.SmoothPos = Move.SmoothPos:Lerp(Move.TargetCF.Position, alpha)

        Move.AlignPos.Position = Move.SmoothPos
        if (hrp.Position - Move.TargetCF.Position).Magnitude > 0.5 then
            Move.AlignOri.CFrame = CFrame.new(hrp.Position, Move.TargetCF.Position)
        end
    end)
end

BindHeartbeat()

local function ResetCharacterState()
    StopFly()
    CleanupMoveInstances()
end

