local function questForLevel(level)
    for _, q in ipairs(QUESTS) do
        if level >= q.min and level <= q.max then return q end
    end
    return QUESTS[#QUESTS]
end

local function getQuestGui()
    local main = LocalPlayer:FindFirstChild('PlayerGui') and LocalPlayer.PlayerGui:FindFirstChild('Main')
    local quest = main and main:FindFirstChild('Quest')
    return quest
end

local function hasQuest()
    local q = getQuestGui()
    if not q then return false end
    if q:IsA('GuiObject') and q.Visible then return true end
    local title = q:FindFirstChild('Container') and q.Container:FindFirstChild('QuestTitle')
    local t = title and title:FindFirstChild('Title')
    return t and type(t.Text) == 'string' and t.Text ~= ''
end

local function getQuestTitle()
    local q = getQuestGui()
    if not q then return '' end
    local c = q:FindFirstChild('Container')
    local title = c and c:FindFirstChild('QuestTitle')
    local t = title and title:FindFirstChild('Title')
    return (t and t.Text) or ''
end

local function resolveQuestNPC(info)
    local best, dist = nil, math.huge
    local targetName = info.quest
    local npcs = workspace:FindFirstChild('NPCs')
    if npcs then
        for _, npc in ipairs(npcs:GetChildren()) do
            local root = npc:FindFirstChild('HumanoidRootPart') or npc:FindFirstChild('Head') or npc:FindFirstChildWhichIsA('BasePart')
            if root and npc:IsA('Model') then
                local name = string.lower(npc.Name)
                local wanted = string.lower(targetName:gsub(' Quest',''))
                if string.find(name, wanted, 1, true) or (root.Position - info.npc).Magnitude < 80 then
                    local d = (getRoot() and (getRoot().Position-root.Position).Magnitude) or 0
                    if d < dist then best, dist = npc, d end
                end
            end
        end
    end
    return best
end

local function questPosition(info)
    local npc = resolveQuestNPC(info)
    if npc then
        local root = npc:FindFirstChild('HumanoidRootPart') or npc:FindFirstChild('Head') or npc:FindFirstChildWhichIsA('BasePart')
        if root then return root.Position end
    end
    return info.npc
end

local function invokeStartQuest(info)
    local now = os.clock()
    if now - state.lastQuestCall < 1.4 then return false end
    state.lastQuestCall = now
    local remotes = ReplicatedStorage:FindFirstChild('Remotes')
    local comm = remotes and remotes:FindFirstChild('CommF_')
    if not comm then return false end
    local ok = pcall(function()
        comm:InvokeServer('StartQuest', info.quest, info.qn)
    end)
    return ok
end

local movement = { tween = nil, target = nil, token = 0, lastTargetUpdate = 0 }

local function stopMove()
    movement.token += 1
    if movement.tween then
        pcall(function() movement.tween:Cancel() end)
        movement.tween = nil
    end
    movement.target = nil
    state.lastMovePoint = nil
end

local function moveToPoint(pos)
    local h = getHumanoid()
    local r = getRoot()
    if not h or not r or h.Health <= 0 then return false end

    local target = Vector3.new(pos.X, pos.Y, pos.Z)
    local distance = (r.Position - target).Magnitude
    if distance <= 6 then
        stopMove()
        return true
    end

    local sameTarget = movement.target and (movement.target - target).Magnitude < 10
    if not CFG.StableTween then
        if not state.lastMovePoint or (state.lastMovePoint-target).Magnitude > 5 or os.clock()-state.lastMoveTime > 1.0 then
            state.lastMovePoint = target
            state.lastMoveTime = os.clock()
            pcall(function() h:MoveTo(target) end)
        end
        return false
    end
    if CFG.StableTween and sameTarget and movement.tween then
        return false
    end

    -- Keep exactly one active tween. A moving mob is only retargeted when it
    -- has moved a meaningful distance, preventing cancel/recreate jitter.
    if movement.tween then
        pcall(function() movement.tween:Cancel() end)
        movement.tween = nil
    end

    movement.token += 1
    local myToken = movement.token
    movement.target = target
    state.lastMovePoint = target
    state.lastMoveTime = os.clock()

    local speed = math.clamp(tonumber(CFG.MoveSpeed) or 145, 80, 260)
    local duration = math.clamp(distance / speed, 0.18, 6)
    local goal = CFrame.lookAt(target + Vector3.new(0, 0.01, 0), target + Vector3.new(0, 0.01, -1))

    local tween = TweenService:Create(r, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = goal})
    movement.tween = tween
    tween:Play()

    task.spawn(function()
        local ok = pcall(function() tween.Completed:Wait() end)
        if ok and myToken == movement.token and movement.tween == tween then
            movement.tween = nil
        end
    end)

    return false
end

local function setNoClip(enabled)
    if not CFG.Noclip then enabled = false end
    local c = char()
    if not c then return end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA('BasePart') and p.Name ~= 'HumanoidRootPart' then
            if enabled then
                if state.collisionCache[p] == nil then state.collisionCache[p] = p.CanCollide end
                p.CanCollide = false
            else
                local old = state.collisionCache[p]
                if old ~= nil then p.CanCollide = old end
            end
        end
    end
    if not enabled then table.clear(state.collisionCache) end
end

local function equipTool()
    if not CFG.AutoEquip then return end
    if os.clock() - state.lastEquip < 0.35 then return end
    state.lastEquip = os.clock()
    local c = char()
    if not c or c:FindFirstChildOfClass('Tool') then return end
    local backpack = LocalPlayer:FindFirstChildOfClass('Backpack')
    local h = getHumanoid()
    if not backpack or not h then return end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA('Tool') then
            pcall(function() h:EquipTool(tool) end)
            break
        end
    end
end

local function validEnemy(enemy, wanted)
    if not enemy:IsA('Model') then return false end
    local hum = enemy:FindFirstChildOfClass('Humanoid')
    local root = enemy:FindFirstChild('HumanoidRootPart')
    if not hum or hum.Health <= 0 or not root then return false end
    return string.find(string.lower(enemy.Name), string.lower(wanted), 1, true) ~= nil
end

local function findNearestMob(wanted)
    local r = getRoot()
    local enemies = workspace:FindFirstChild('Enemies')
    if not r or not enemies then return nil end
    local best, dist = nil, math.huge
    for _, enemy in ipairs(enemies:GetChildren()) do
        if validEnemy(enemy, wanted) then
            local er = enemy.HumanoidRootPart
            local d = (r.Position-er.Position).Magnitude
            if d < dist then best, dist = enemy, d end
        end
    end
    return best
end

local function setFarmTarget(enemy)
    state.target = enemy
end

local function attackTarget()
    if not CFG.FastAttack then return end
    if not state.target or not state.target.Parent then return end
    local h = state.target:FindFirstChildOfClass('Humanoid')
    local er = state.target:FindFirstChild('HumanoidRootPart')
    local r = getRoot()
    if not h or h.Health <= 0 or not er or not r then return end
    if (r.Position-er.Position).Magnitude > CFG.AttackRange + 8 then return end
    pcall(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton1(Vector2.new())
    end)
end

-- Locate CombatFramework controller without crashing if executor APIs are absent.
task.spawn(function()
    task.wait(2)
    pcall(function()
        if not getreg or not getfenv or not debug then return end
        local framework = LocalPlayer:FindFirstChild('PlayerScripts') and LocalPlayer.PlayerScripts:FindFirstChild('CombatFramework')
        if not framework then return end
        for _, fn in ipairs(getreg()) do
            if typeof(fn) == 'function' then
                local env = getfenv(fn)
                if env and env.script == framework then
                    for _, up in pairs(debug.getupvalues(fn)) do
                        if type(up) == 'table' and up.activeController then
                            state.controller = up
                            return
                        end
                    end
                end
            end
        end
    end)
end)

RunService.RenderStepped:Connect(function()
    if not CFG.FastAttack then return end
    pcall(function()
        local controller = state.controller
        if controller and controller.activeController then
            local ac = controller.activeController
            ac.timeToNextAttack = 0
            ac.attacking = false
            ac.blocking = false
            ac.increment = 3
            ac.hitboxMagnitude = math.max(ac.hitboxMagnitude or 60, 100)
        end
    end)
    attackTarget()
end)

local function runFarmStep()
    if not isAlive() then return end
    equipTool()
    setNoClip(CFG.Noclip)

    local info = questForLevel(getLevel())
    state.questInfo = info

    if CFG.AutoQuest and not hasQuest() then
        state.phase = 'Quest'
        state.target = nil
        local qpos = questPosition(info)
        if moveToPoint(qpos) then
            invokeStartQuest(info)
        end
        return
    end

    if CFG.AutoQuest and getQuestTitle() ~= '' then
        local title = string.lower(getQuestTitle())
        if not string.find(title, string.lower(info.mob), 1, true) and not string.find(title, string.lower(info.quest:gsub(' Quest','')), 1, true) then
            -- Wrong quest: do not wander to another area. Return only to the currently selected NPC.
            state.phase = 'Correcting quest'
            state.target = nil
            local qpos = questPosition(info)
            moveToPoint(qpos)
            return
        end
    end

    local target = state.target
    if not target or not validEnemy(target, info.mob) then
        target = findNearestMob(info.mob)
        setFarmTarget(target)
    end

    if target and target.Parent then
        state.phase = 'Farming '..info.mob
        local er = target:FindFirstChild('HumanoidRootPart')
        if er then
            local p = er.Position + Vector3.new(0, CFG.FarmHeight, 0)
            moveToPoint(p)
        end
        return
    end

    state.phase = 'Searching mob'
    moveToPoint(info.area)
end

-- One and only one main AutoFarm loop.
task.spawn(function()
    while true do
        if CFG.AutoFarm then
            local ok, err = pcall(runFarmStep)
            if not ok then warn('[Datkits V5] Farm:', err) end
            task.wait(0.12)
        else
            state.phase = 'Idle'
            state.target = nil
            stopMove()
            setNoClip(false)
            task.wait(0.25)
        end
    end
end)

