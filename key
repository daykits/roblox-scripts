        btn.TextSize = 13
        btn.Font = Enum.Font.GothamBold
        btn.AutoButtonColor = false
        btn.ZIndex = 3
        btn.Parent = main
        Corner(btn, 8)
        Stroke(btn, Color3.fromRGB(52, 52, 78), 1, 0.5)
        btn.MouseEnter:Connect(function() Tween(btn, {BackgroundColor3 = Color3.fromRGB(40, 40, 66)}, 0.15) end)
        btn.MouseLeave:Connect(function() Tween(btn, {BackgroundColor3 = color or Color3.fromRGB(24, 24, 42)}, 0.15) end)
        return btn
    end

