-------------------------------------------------
-- HELPER: TWEEN / MOVEMENT
-------------------------------------------------
local function StopTween()
    if State.currentTween then
        pcall(function() State.currentTween:Cancel() end)
        State.currentTween = nil
    end
    State.lastTargetPos = nil
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in ipairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") or v.Name == "FarmFlyBV" then
                v:Destroy()
            end
        end
    end
end

local function TweenTo(targetCFrame, speed)
    speed = speed or Config.TweenSpeed
    local char = GetCharacter()
    if not char then return end

    local hrp = char.HumanoidRootPart

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local bv = hrp:FindFirstChild("FarmFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name      = "FarmFlyBV"
        bv.MaxForce  = Vector3.new(4e5, 4e5, 4e5)
        bv.Velocity  = Vector3.zero
        bv.Parent    = hrp
    end

    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    if dist <= 3.5 then
        StopTween()
        hrp.CFrame = targetCFrame
        return
    end

    local needNewTween = not State.currentTween
        or not State.lastTargetPos
        or (State.lastTargetPos - targetCFrame.Position).Magnitude > 4

    if needNewTween then
        State.lastTargetPos = targetCFrame.Position
        if State.currentTween then
            pcall(function() State.currentTween:Cancel() end)
        end

        local duration = math.clamp(dist / speed, 0.12, 7)
        State.currentTween = TweenService:Create(
            hrp,
            TweenInfo.new(duration, Enum.EasingStyle.Linear),
            { CFrame = targetCFrame }
        )
        State.currentTween:Play()
    end
end

