repeat task.wait() until game:IsLoaded()

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "sleal egg | Anime",
   LoadingTitle = "egg!",
   LoadingSubtitle = "Fix Teleport",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

local MainTab = Window:CreateTab("Chính", 4483362458)
local targetPosition = Vector3.new(1154.266, 15.681, -484.52)
_G.AutoFarm = false

-- Hàm Teleport An Toàn (Chống Rubberband / Kéo ngược)
local function safeTeleport(targetCFrame)
    local player = game.Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if rootPart then
        -- Xóa vận tốc di chuyển cũ để tránh bị game kéo lại
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
        
        -- Cập nhật tọa độ
        rootPart.CFrame = targetCFrame
        task.wait(0.05)
        rootPart.AssemblyLinearVelocity = Vector3.zero
    end
end

-- Hàm lấy vị trí vật thể
local function getPosition(object)
    if object:IsA("BasePart") then
        return object.Position
    elseif object:IsA("Model") then
        return object:GetPivot().Position
    end
    return nil
end

-- Hàm tự động kích hoạt phím E
local function triggerProximityPrompts()
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Parent then
            local promptPos = getPosition(prompt.Parent)
            if promptPos and (promptPos - targetPosition).Magnitude < 15 then
                task.spawn(function()
                    if fireproximityprompt then
                        fireproximityprompt(prompt)
                    else
                        prompt:InputHoldBegin()
                        task.wait(prompt.HoldDuration + 0.1)
                        prompt:InputHoldEnd()
                    end
                end)
            end
        end
    end
end

-- Nút Bật/Tắt
MainTab:CreateToggle({
   Name = "Tự Động Gom Trứng",
   CurrentValue = false,
   Flag = "AutoFarmToggle",
   Callback = function(Value)
      _G.AutoFarm = Value
   end,
})

-- Vòng lặp xử lý chính
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.1)
        if _G.AutoFarm then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                -- 1. Lưu vị trí ban đầu
                local originalCFrame = rootPart.CFrame
                
                -- 2. Teleport đến vị trí mục tiêu
                safeTeleport(CFrame.new(targetPosition))
                task.wait(0.5)
                
                -- 3. Kích hoạt nhặt trứng
                triggerProximityPrompts()
                task.wait(1.2)
                
                -- 4. Teleport quay về vị trí ban đầu
                safeTeleport(originalCFrame)
                
                -- 5. Chờ 5 giây trước lần tiếp theo
                task.wait(5)
            end
        end
    end
end)

