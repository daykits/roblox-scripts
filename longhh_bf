    function LX.Ask(text)
        local p = norm(text)
        if p == "" then
            return
        end
        local mood = LX.Face

        -- quyen
        if has(p, "quyen") or has(p, "permission") then
            local k = permKey(p)
            local on, off = hasAny(p, { "bat", "mo", "cho phep", "on" }), hasAny(p, { "tat", "cam", "off" })
            if k and (on or off) then
                LX.Out("cmd", "perm " .. string.lower(k))
                LX.SetPerm(k, on and not off)
                local opened = (on and not off) and true or false
                LX.Say((opened and "Mở quyền " or "Khóa quyền ") .. (PERM_LABEL[k] or k) .. ".", "deadpan")
            else
                LX.Out("cmd", "perm")
                LX.Out("out", LX.PermText())
                LX.Say("Quyền hiện tại: " .. LX.PermText(), "deadpan", 3)
            end
            return
        end
        -- huong dan / danh sach
        if hasAny(p, { "help", "huong dan", "lam duoc gi", "co gi", "giup" }) and not resolve(p, nil) then
            LX.Out("cmd", "help")
            LX.Out("out", #buildReg() .. " controls registered")
            LX.Out("out", "bat|tat <ten>  dat <ten> = n  chon <ten> <gt>  bam <ten>")
            LX.Say("Tôi bật/tắt, đặt số, chọn dropdown, bấm nút mọi thứ trong UI (" .. #buildReg() .. " mục). Gõ 'help' để xem lệnh shell.", "deadpan", 3.5)
            return
        end
        if hasAny(p, { "dang bat", "dang chay", "trang thai chung", "ps" }) then
            LX.Exec("ps")
            LX.Say("Danh sách đang bật nằm ở shell đấy.", mood)
            return
        end
        -- tab navigation and music player
        local openVerb = hasAny(p, { "mo tab", "vao tab", "open tab", "chuyen tab", "goi tab" }) or (hasAny(p, { "mo", "open", "vao" }) and hasAny(p, {
            "farm",
            "farm lv",
            "farming",
            "nhac",
            "am nhac",
            "music",
            "quest",
            "setting",
            "settings",
            "sea event",
            "teleport"
        }))
        if openVerb then
            local target
            if hasAny(p, { "nhac", "am nhac", "music" }) then
                target = "music"
            elseif hasAny(p, { "farm lv", "farm level", "farming", "farm" }) then
                target = "farming"
            elseif hasAny(p, { "quest", "item" }) then
                target = "quest"
            elseif hasAny(p, { "setting", "settings", "cai dat" }) then
                target = "setting"
            elseif hasAny(p, { "sea event", "sea" }) then
                target = "sea event"
            elseif hasAny(p, { "travel", "teleport" }) then
                target = "teleport"
            elseif hasAny(p, { "race", "mirage" }) then
                target = "race"
            elseif hasAny(p, { "raid", "dungeon" }) then
                target = "raid"
            elseif hasAny(p, { "shop", "shopping" }) then
                target = "shopping"
            elseif hasAny(p, { "prehistoric", "volcano" }) then
                target = "prehistoric"
            elseif hasAny(p, { "halloween" }) then
                target = "halloween"
            elseif hasAny(p, { "esp", "stats" }) then
                target = "esp"
            elseif hasAny(p, { "combat", "local player" }) then
                target = "combat"
            elseif hasAny(p, { "misc", "miscellaneous" }) then
                target = "misc"
            elseif hasAny(p, { "info", "status", "overview" }) then
                target = "info"
            end
            if target then
                local ok = LX.DoOpenTab(target)
                LX.Say(ok and ("Đã mở tab " .. target .. ".") or "Không mở được tab đó.", ok and mood or "annoyed")
            else
                LX.Out("out", "tabs: " .. "Farming, Music Player, Quest And Item, Setting, Sea Event, Teleport")
                LX.Say("Bạn muốn mở tab nào?", "listen", 3)
            end
            return
        end

        if hasAny(p, { "bat nhac", "phat nhac", "play music", "resume music", "tiep tuc nhac" }) then
            local act = hasAny(p, { "tiep tuc", "resume" }) and "resume" or "play"
            local ok = LX.DoMusic(act)
            LX.Say(ok and "Được. Nhạc chạy rồi." or "Không phát được nhạc.", ok and mood or "annoyed")
            return
        end
        if hasAny(p, { "phat bai", "tim bai", "play song", "play track" }) then
            local query = p
            for _, prefixText in ipairs({ "phat bai", "tim bai", "play song", "play track" }) do
                local at = string.find(query, prefixText, 1, true)
                if at then
                    query = string.sub(query, at + #prefixText)
                    break
                end
            end
            query = string.gsub(query, "^%s+", "")
            local ok = LX.DoMusic("find", query)
            LX.Say(ok and "Đã chọn bài phù hợp." or "Không tìm thấy bài đó.", ok and mood or "annoyed")
            return
        end
        if hasAny(p, { "am luong nhac", "music volume" }) then
            local n = lastNumber(p)
            local ok = n and LX.DoMusic("volume", tostring(n))
            LX.Say(ok and ("Âm lượng nhạc " .. tostring(math.clamp(n, 0, 100)) .. "%.") or "Cần một mức âm lượng từ 0 đến 100.", ok and mood or "annoyed")
            return
        end
        if hasAny(p, { "tam dung nhac", "pause music" }) then
            local ok = LX.DoMusic("pause")
            LX.Say(ok and "Đã tạm dừng nhạc." or "Không có nhạc đang chạy.", ok and mood or "annoyed")
            return
        end
        if hasAny(p, { "dung nhac", "stop music" }) then
            local ok = LX.DoMusic("stop")
            LX.Say(ok and "Đã dừng nhạc." or "Không dừng được nhạc.", ok and mood or "annoyed")
            return
        end
        if hasAny(p, { "bai tiep theo", "next song", "next track", "chuyen bai" }) then
            local ok = LX.DoMusic("next")
            LX.Say(ok and "Chuyển bài." or "Không chuyển được bài.", ok and mood or "annoyed")
            return
        end
        if hasAny(p, { "bai truoc", "previous song", "prev track" }) then
            local ok = LX.DoMusic("prev")
            LX.Say(ok and "Quay lại bài trước." or "Không chuyển được bài.", ok and mood or "annoyed")
            return
        end
        if has(p, "mo nhac") or has(p, "open music") then
            local ok = LX.DoOpenTab("music")
            LX.Say(ok and "Mở Music Player." or "Không mở được Music Player.", ok and mood or "annoyed")
            return
        end

        -- timer / stopwatch
        if has(p, "hen gio") or has(p, "timer") or (has(p, "dem nguoc")) then
            local n = lastNumber(p)
            if hasAny(p, { "tat", "dung", "huy", "stop" }) then
                LX.DoWatch("stoptimer")
                say("ok", mood)
            else
                local min = n or 5
                if has(p, "giay") or has(p, "s") then
                    min = min / 60
                end
                LX.DoTimer(min)
                say("ok", mood)
            end
            return
        end
        if has(p, "bam gio") or has(p, "stopwatch") then
            LX.DoWatch(has(p, "reset") and "reset" or (has(p, "lap") and "lap" or "toggle"))
            say("ok", mood)
            return
        end
        -- theme
        if has(p, "theme") or has(p, "giao dien") or has(p, "che do") then
            local list = LX.ThemeList()
            local hit
            for _, th in ipairs(list) do
                if has(p, norm(th)) then
                    hit = th
                end
            end
            if not hit and (has(p, "toi") or has(p, "dark")) then
                hit = "Dark"
            elseif not hit and (has(p, "sang") or has(p, "light")) then
                hit = "Light"
            end
            if hit then
                local ok = LX.DoTheme(hit)
                if ok then
                    say("ok", mood)
                else
                    say("perm", "annoyed")
                end
                return
            end
        end
        -- nhan vat
        if has(p, "nhay") or has(p, "jump") then
            if LX.DoJump() then
                say("ok", mood)
            else
                say("perm", "annoyed")
            end
            return
        end
        if has(p, "xoay") or has(p, "spin") then
            if LX.DoSpin() then
                say("ok", mood)
            else
                say("perm", "annoyed")
            end
            return
        end
        -- tat het / bat het
        if (has(p, "het") or has(p, "tat ca") or has(p, "all")) and hasAny(p, V_OFF) then
            local n = LX.DoAll(false)
            LX.Say("Tắt " .. n .. " cái. Yên tĩnh rồi.", "deadpan")
            return
        end
        -- pending (cau hoi lam ro)
        if LX.Pending then
            local pend = LX.Pending
            LX.Pending = nil
            if not (hasAny(p, V_PRESS) or hasAny(p, V_SEL) or hasAny(p, V_OFF) or hasAny(p, V_ON) or hasAny(p, V_SET)) then
                local it = resolve(p, nil)
                if it then
                    p = pend.verb .. " " .. it.nt
                end
            end
        end
        -- dieu khien element
        local verb, kinds
        if hasAny(p, V_PRESS) then
            verb, kinds = "press", { Button = true }
        elseif hasAny(p, V_SEL) then
            verb, kinds = "sel", { Dropdown = true }
        elseif hasAny(p, V_OFF) then
            verb, kinds = "off", { Toggle = true }
        elseif hasAny(p, V_ON) then
            verb, kinds = "on", { Toggle = true }
        elseif hasAny(p, V_SET) and lastNumber(p) then
            verb, kinds = "set", { Slider = true, Input = true }
        end
        if verb then
            local it, list = resolve(p, kinds)
            if not it and verb ~= "set" and verb ~= "sel" then
                it, list = resolve(p, nil)
            end
            if not it and #list > 1 then
                local names = ambiguous(list)
                LX.Out("cmd", verb .. " ?")
                LX.Out("warn", "ambiguous: " .. string.lower(asc(table.concat(names, " | "))))
                LX.Pending = { verb = verb }
