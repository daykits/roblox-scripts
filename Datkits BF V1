-- ✅ CENTRALIZED MOVEMENT CONTROLLER
-- 1 thread duy nhất xử lý movement - KHÔNG khựng
-------------------------------------------------
local Move = {
    Active     = false,   -- Có đang bay không
    TargetCF   = nil,     -- Target CFrame cuối cùng
    SmoothPos  = nil,     -- Vị trí target đã làm mượt
    BoundHRP   = nil,     -- HRP đã gắn instances
    AlignPos   = nil,
    AlignOri   = nil,
    Attach     = nil,
}

-- Cleanup instances cũ
local function CleanupMoveInstances()
    if Move.AlignPos then pcall(function() Move.AlignPos:Destroy() end) end
    if Move.AlignOri then pcall(function() Move.AlignOri:Destroy() end) end
    if Move.Attach   then pcall(function() Move.Attach:Destroy()   end) end
    Move.AlignPos = nil
    Move.AlignOri = nil
    Move.Attach   = nil
    Move.BoundHRP = nil
end

-- Tạo instances gắn vào HRP (chỉ 1 lần)
local function EnsureMoveInstances(hrp)
    if Move.BoundHRP == hrp and Move.AlignPos and Move.AlignPos.Parent then
        return true
    end
    CleanupMoveInstances()

    local att = Instance.new("Attachment")
    att.Name   = "FarmAtt"
    att.Parent = hrp

    local ap = Instance.new("AlignPosition")
    ap.Name                = "FarmAP"
    ap.Attachment0         = att
    ap.Mode                = Enum.PositionAlignmentMode.OneAttachment
    ap.Position            = hrp.Position
    ap.MaxForce            = 100000      -- ✅ Vừa đủ, không overshoot
    ap.Responsiveness      = 70          -- ✅ Mượt
    ap.ApplyAtCenterOfMass = true
    ap.Parent              = hrp

    local ao = Instance.new("AlignOrientation")
    ao.Name           = "FarmAO"
    ao.Attachment0    = att
    ao.Mode           = Enum.OrientationAlignmentMode.OneAttachment
    ao.CFrame         = hrp.CFrame
    ao.MaxTorque      = 100000
    ao.Responsiveness = 70
    ao.Parent         = hrp

    Move.BoundHRP = hrp
    Move.AlignPos = ap
    Move.AlignOri = ao
    Move.Attach   = att
    return true
end

-- Bắt đầu bay (PlatformStand ON - giữ nguyên suốt)
local function StartFly()
    local char = GetCharacter()
    if not char then return false end
    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if not EnsureMoveInstances(hrp) then return false end

    if not Move.Active then
        -- Chỉ set 1 lần khi bắt đầu
        hum.PlatformStand = true
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        Move.SmoothPos = hrp.Position
        Move.Active = true
    end
    return true
end

-- Dừng bay (trả lại trạng thái bình thường)
local function StopFly()
    if not Move.Active then return end
    Move.Active   = false
    Move.TargetCF = nil
    Move.SmoothPos = nil

    local char = GetCharacter()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum.PlatformStand = false end)
    end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
end

-- ✅ Loops CHỈ set target - KHÔNG tự di chuyển
local function SetMoveTarget(targetCFrame)
    if not StartFly() then return end
    Move.TargetCF = targetCFrame
end

-- ✅ HEARTBEAT - 1 thread duy nhất xử lý toàn bộ movement
RunService.Heartbeat:Connect(function(dt)
    if not Move.Active then return end
    local char = GetCharacter()
    if not char then
        Move.Active = false
        return
    end
    local hrp = char.HumanoidRootPart
    if not hrp or not Move.TargetCF then return end

    -- Đảm bảo instances còn sống
    if not Move.AlignPos or not Move.AlignPos.Parent then
        if not EnsureMoveInstances(hrp) then return end
    end

    -- ✅ Làm mượt target position (loại bỏ micro-jitter khi enemy bobbing)
    local alpha = math.clamp(dt * 15, 0, 1)
    Move.SmoothPos = Move.SmoothPos:Lerp(Move.TargetCF.Position, alpha)

    -- Cập nhật AlignPosition (mượt)
    Move.AlignPos.Position = Move.SmoothPos
    -- Cập nhật hướng nhìn về target
    if (hrp.Position - Move.TargetCF.Position).Magnitude > 0.5 then
        Move.AlignOri.CFrame = CFrame.new(hrp.Position, Move.TargetCF.Position)
    end
end)

-- Reset khi cần
local function ResetCharacterState()
    StopFly()
    CleanupMoveInstances()
    local char = GetCharacter()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
end

