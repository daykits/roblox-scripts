                                Text = "",
                                TextSize = 8,
                                TextColor3 = Color3.fromRGB(152, 166, 205),
                                TextXAlignment = Enum.TextXAlignment.Left,
                                TextTruncate = Enum.TextTruncate.AtEnd,
                                Position = UDim2.fromOffset(9, 17),
