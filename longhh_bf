        local function djReachCompass(valid)
            local t0 = tick()
            while valid() and tick() - t0 < 60 do
                task.wait(0.1)
                local h = getRoot()
                if not h then return nil end
                local c = djFindNested(workspace, "GreatPumpkinCompass", DJ_SEARCH_RADIUS, false)
                local cf = c and pivotOf(c)
                if cf then
                    if (h.Position - cf.Position).Magnitude <= DJ_INTERACT_RANGE then
                        djHold()
                        return c
                    end
                    pcall(_tp, CFrame.new(cf.Position))
                else
                    djHold()
                    if tick() - t0 > 10 then return nil end
                end
            end
            return nil
        end
        local function djHoldE(obj, valid)
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            local hold = prompt and prompt.HoldDuration or 0
            local dur = math.max(1, hold + 0.1)
            local vim = game:GetService("VirtualInputManager")
            if prompt then
                pcall(function() prompt.RequiresLineOfSight = false end)
                if fireproximityprompt and prompt.Enabled then
                    pcall(fireproximityprompt, prompt, dur)
                end
                pcall(function() prompt:InputHoldBegin() end)
            end
            vim:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            local t0 = tick()
            while tick() - t0 < dur and valid() do
                djHold()
                task.wait(0.1)
            end
            vim:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            if prompt then
                pcall(function() prompt:InputHoldEnd() end)
            end
        end
        local function djFarmBoss(boss, valid)
