                            b.hrp.Position
                        ), 10)
                    elseif info.spawnPos then
                        SetMoveTarget(CFrame.new(
                            info.spawnPos + Vector3.new(0, Config.FarmDistance, 0)
                        ), 10)
                    end
                end
