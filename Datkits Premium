MainTab:CreateToggle({
   Name = "Bật Auto Chest (Gom Rương Beli)",
   CurrentValue = false,
   Flag = "ToggleChest",
   Callback = function(Value)
      _G.AutoChest = Value
      task.spawn(function()
          while _G.AutoChest do
              task.wait(0.1)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character or player.CharacterAdded:Wait()
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  
                  if hrp then
                      for _, v in pairs(workspace:GetDescendants()) do
                          if not _G.AutoChest then break end
                          if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
                              repeat
                                  task.wait(0.05)
                                  if not _G.AutoChest or not v or not v.Parent or not v:FindFirstChild("TouchInterest") then break end
                                  hrp.CFrame = v.CFrame
                                  if firetouchinterest then
                                      firetouchinterest(hrp, v, 0)
                                      task.wait(0.05)
                                      firetouchinterest(hrp, v, 1)
                                  end
                              until not v or not v.Parent or not v:FindFirstChild("TouchInterest") or not _G.AutoChest
                          end
                      end
                  end
              end)
          end
      end)
   end,
})

