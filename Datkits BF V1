-- HỆ THỐNG NHẬN DIỆN MỤC TIÊU
-------------------------------------------------
local function GetAllAliveMonsters()
    local list = {}
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return list end

    for _, enemy in ipairs(enemies:GetChildren()) do
        local hum = enemy:FindFirstChild("Humanoid")
        local hrp = enemy:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then
            table.insert(list, {
                model = enemy,
                hrp = hrp,
                humanoid = hum,
                name = enemy.Name,
                lowerName = string.lower(enemy.Name),
                hp = hum.Health,
                level = enemy:GetAttribute("Level") or 1
            })
        end
    end
    return list
end

local function IsQuestMonster(monster, questMobName)
    if not questMobName or questMobName == "" then return false end
    return string.find(monster.lowerName, string.lower(questMobName), 1, true) ~= nil
end

local function FindBestTarget(charPos, questMobName, prioritize, maxDistance)
    prioritize = prioritize or getgenv().TargetPrioritize or "nearest"
    maxDistance = maxDistance or 5000

    local allMonsters = GetAllAliveMonsters()
    if #allMonsters == 0 then return nil end

    local questTargets = {}
    local nearestTargets = {}

    for _, mon in ipairs(allMonsters) do
        local dist = (mon.hrp.Position - charPos).Magnitude
        if dist <= maxDistance then
            if IsQuestMonster(mon, questMobName) then
                table.insert(questTargets, mon)
            end
            table.insert(nearestTargets, mon)
        end
    end

    local candidates = #questTargets > 0 and questTargets or nearestTargets
    if #candidates == 0 then return nil end

    table.sort(candidates, function(a, b)
        if prioritize == "weakest" then
            return a.hp < b.hp
        elseif prioritize == "highest_level" then
            return a.level > b.level
        else
            return (a.hrp.Position - charPos).Magnitude < (b.hrp.Position - charPos).Magnitude
        end
    end)

    return candidates[1]
end

