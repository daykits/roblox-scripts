        -- AnimationPlayed supplements BodyMover detection; length/loop checks and per-ID
        -- cooldown suppress idle loops and repeated notifications for the same attack animation.
        local animConn, animMob, animFx
        local animLastById = { }
        local function hookMobAnimations(mob)
            local fxd = _G.FARMX
            animFx = fxd
            if animConn then
                pcall(function() animConn:Disconnect() end)
                animConn = nil
            end
            animMob = mob
            table.clear(animLastById)
            if not isAliveMob(mob) then return end
            local hum = mob:FindFirstChildOfClass("Humanoid")
            local animator = hum and hum:FindFirstChildOfClass("Animator")
            if not animator then return end

            local boss = isBossDodgeMob(mob)
            local function considerTrack(track)
                if not track then return end
                task.spawn(function()
                    task.wait(0.05)
                    local ok, looped, length, speed, playing, animationId = pcall(function()
                        return track.Looped, track.Length, track.Speed, track.IsPlaying, track.Animation and track.Animation.AnimationId or ""
                    end)
                    if not ok or looped or not playing then return end
                    local minLength = boss and 0.6 or 0.9
                    local cfgLength = fxd and fxd.Cfg and (boss and fxd.Cfg.MobDodgeBossAnimMinLength or fxd.Cfg.MobDodgeAnimMinLength)
                    if type(cfgLength) == "number" then
                        minLength = cfgLength
                    end
                    if type(length) ~= "number" or length < minLength then return end

                    animationId = tostring(animationId or "")
                    if animationId == "" then return end
                    local now = os.clock()
                    local cooldown = boss and 0.65 or 0.9
                    if now - (animLastById[animationId] or 0) < cooldown then return end
                    animLastById[animationId] = now
                    task.wait(0.05)
                    local stillOk, stillPlaying = pcall(function() return track.IsPlaying end)
                    if not stillOk or not stillPlaying then return end

                    local fxdNow = _G.FARMX
                    if not (fxdNow and fxdNow.Enable and fxdNow.Enable.MobDodge and fxdNow.MobDodgeTrigger)
                        or fxdNow.AttackingMob ~= mob or not isAliveMob(mob) then
                        return
                    end
                    local playback = math.max(math.abs(tonumber(speed) or 1), 0.1)
                    local activeFor = math.clamp(length / playback + 0.25, 0.6, 2.5)
                    fxdNow.MobDodgeTrigger(activeFor, boss, mob) -- AnimationPlayed cooldown is per ID; allow cached tracks to trigger again on a later swing.
                end)
            end

            animConn = animator.AnimationPlayed:Connect(considerTrack)
            local okTracks, tracks = pcall(function() return animator:GetPlayingAnimationTracks() end)
            if okTracks and type(tracks) == "table" then
                for _, track in ipairs(tracks) do considerTrack(track) end
            end
        end

        task.spawn(function()
            while getgenv().__MaruMobDodgeWatchToken == watcherToken and task.wait(0.2) do
                local fxd = _G.FARMX
                local target = fxd and fxd.Enable and fxd.Enable.MobDodge and fxd.AttackingMob or nil
                local hum = target and target:FindFirstChildOfClass("Humanoid")
                local animatorReady = hum and hum:FindFirstChildOfClass("Animator") ~= nil
                if target ~= animMob or fxd ~= animFx or (target and not animConn and animatorReady) then
                    pcall(hookMobAnimations, target)
                end
            end
            if animConn then
                pcall(function() animConn:Disconnect() end)
                animConn = nil
            end
        end)
    end
