   end,
})

MainTab:CreateSection("Tự Động Nhặt Rương (Di Chuyển Mượt)")

_G.AutoChest = false

local function GetChests()
    local chests = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
            table.insert(chests, v)
        end
    end
    return chests
end

MainTab:CreateToggle({
   Name = "Bật Auto Chest (Di Chuyển Bay Gom Rương)",
   CurrentValue = false,
   Flag = "ToggleChest",
   Callback = function(Value)
      _G.AutoChest = Value
      
      task.spawn(function()
          while _G.AutoChest do
              task.wait(0.1)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character or player.CharacterAdded:Wait()
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  
                  if not hrp then return end

                  local chests = GetChests()

                  if #chests > 0 then
                      -- Sắp xếp rương từ gần nhất đến xa nhất
                      table.sort(chests, function(a, b)
                          return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
                      end)

                      local targetChest = chests[1]

                      if targetChest and targetChest:FindFirstChild("TouchInterest") then
                          local speed = 300 -- Tốc độ bay di chuyển (studs/giây)
                          local distance = (hrp.Position - targetChest.Position).Magnitude
                          local duration = distance / speed

                          -- Tạo hiệu ứng di chuyển mượt (Tween)
                          local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                          local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = targetChest.CFrame})
                          
                          -- Tạo BodyVelocity giữ nhân vật không bị rơi bởi trọng lực khi di chuyển
                          local bv = Instance.new("BodyVelocity")
                          bv.Name = "ChestFlyBV"
                          bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                          bv.Velocity = Vector3.new(0, 0, 0)
                          bv.Parent = hrp

                          tween:Play()

                          -- Vòng lặp chờ trong lúc di chuyển đến rương
                          local elapsed = 0
                          repeat
                              task.wait(0.05)
                              elapsed = elapsed + 0.05
                              
                              -- Bật Noclip xuyên vật cản trong quá trình di chuyển
                              if character then
                                  for _, part in pairs(character:GetChildren()) do
                                      if part:IsA("BasePart") then
                                          part.CanCollide = false
                                      end
                                  end
                              end
                          until elapsed >= duration or not _G.AutoChest or not targetChest or not targetChest.Parent or not targetChest:FindFirstChild("TouchInterest")

                          -- Dừng Tween & Xóa BodyVelocity sau khi đến rương
                          if tween then tween:Cancel() end
                          if bv then bv:Destroy() end

                          -- Nhặt rương khi đã tiếp cận
                          if _G.AutoChest and targetChest and targetChest:FindFirstChild("TouchInterest") then
                              hrp.CFrame = targetChest.CFrame
                              if firetouchinterest then
                                  firetouchinterest(hrp, targetChest, 0)
                                  task.wait(0.02)
                                  firetouchinterest(hrp, targetChest, 1)
                              end
                              task.wait(0.1)
                          end
                      end
                  else
                      task.wait(2)
                  end
              end)
          end

          -- Dọn dẹp BodyVelocity nếu tắt tính năng Auto Chest
          if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
              local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
              for _, v in pairs(hrp:GetChildren()) do
                  if v.Name == "ChestFlyBV" then
                      v:Destroy()
                  end
              end
          end
      end)
   end,
})

