do
    local FX = _G.FARMX
    FX.Sel = {
        name = nil,
        list = nil,
        idx = 0,
        goal = nil,
        issued = 0,
        eta = 0,
        since = nil
    }
    FX.SelReset = function()
        local s = FX.Sel
        s.list, s.idx, s.goal, s.issued, s.eta, s.since = nil, 0, nil, 0, 0, nil
    end
    FX.SelectedName = function()
        local n = getgenv().SelectMob
        if type(n) == "string" and n ~= "" then return n end
        local opts = Library and Library.Options
        if opts then
            for _, id in ipairs({ "Main_SelectMob", "Main_SelectMob2", "Main_SelectMob3" }) do
                local o = opts[id]
                if o and type(o.Value) == "string" and o.Value ~= "" then return o.Value end
            end
        end
        return nil
    end
    FX.NearestMob = function(name, origin)
        local folder = workspace:FindFirstChild("Enemies")
        if not folder then return nil end
        local best, bestD = nil, math.huge
        for _, e in ipairs(folder:GetChildren()) do
            if e.Name == name then
                local hum = e:FindFirstChildOfClass("Humanoid")
                local root = e:FindFirstChild("HumanoidRootPart")
                if hum and root and hum.Health > 0 then
                    local d = (root.Position - origin).Magnitude
                    if d < bestD then
                        best, bestD = e, d
                    end
                end
            end
        end
        return best
    end
    FX.SpawnCandidates = function(name, origin)
        local out = { }
        local data = getgenv().WorldSpawnData and getgenv().WorldSpawnData[name]
        if type(data) == "table" then
            for _, cf in ipairs(data) do
                if typeof(cf) == "CFrame" then
                    out[#out + 1] = cf
                end
            end
        end
        if #out == 0 and GetMobFarmPosition then
            local ok, cf = pcall(GetMobFarmPosition, name)
            if ok and typeof(cf) == "CFrame" then
                out[#out + 1] = cf
            end
        end
        if #out == 0 and PosMsList and typeof(PosMsList[name]) == "CFrame" then
            out[#out + 1] = PosMsList[name]
        end
        table.sort(out, function(a, b)
            return (a.Position - origin).Magnitude < (b.Position - origin).Magnitude
        end)
        return out
    end
    FX.SelectedMobStep = function()
        local cfg = FX.Cfg
        local s = FX.Sel
        if not FX.IsTop("SelectedMob") then
            task.wait(cfg.ReconcileInterval)
            return
        end
        if PFS_ShouldYieldBoss and PFS_ShouldYieldBoss() then
            task.wait(1)
            return
        end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then
            FX.SelReset()
            task.wait(0.5)
            return
        end
        if not _G.SelectWeapon then
            FX.Log("sel-weapon", "chưa chọn vũ khí (_G.SelectWeapon), Auto Kill Mob đứng chờ")
            task.wait(1)
            return
        end
        local want = FX.SelectedName()
        if not want then
            FX.Log("sel-name", "chưa chọn quái trong dropdown Select Mob")
            task.wait(1)
            return
        end
        if s.name ~= want then
            s.name = want
            FX.SelReset()
        end
        local target = FX.NearestMob(want, hrp.Position)
        if target then
            FX.SelReset()
            local fast = 0
            repeat
                game:GetService("RunService").Heartbeat:Wait()
                local t0 = os.clock()
                Attack.Kill(target, _G.AutoKillMob)
                if os.clock() - t0 < 0.05 then
                    fast = fast + 1
                else
                    fast = 0
                end
            until not _G.AutoKillMob or not target.Parent or not Attack.Alive(target) or not FX.IsTop("SelectedMob")
                or not plr.Character or not _G.SelectWeapon or fast >= 30
            if fast >= 30 then
                FX.Log("sel-spin", "Attack.Kill thoát liên tục khi mục tiêu còn sống, nghỉ 1s")
                task.wait(1)
            end
            return
        end
        local now = os.clock()
        if not s.list then
            s.list = FX.SpawnCandidates(want, hrp.Position)
            s.idx = 1
            s.goal = nil
        end
        if #s.list == 0 then
            FX.Log("sel-nospawn", "không có điểm spawn cho " .. want)
            s.list = nil
            task.wait(1)
            return
        end
        s.goal = s.goal or s.list[s.idx]
        local dist = (s.goal.Position - hrp.Position).Magnitude
        if dist > cfg.ArriveRadius then
            s.since = nil
            if now - s.issued > s.eta then
                local speed = Settings["Tween Speed"] or 180
                s.issued = now
                s.eta = dist / speed + cfg.WalkTimeoutPad
                _tp(s.goal)
            end
            task.wait(0.5)
            return
        end
        s.since = s.since or now
        if now - s.since >= cfg.SpawnWaitTimeout then
            FX.Log("sel-respawn", "hết " .. cfg.SpawnWaitTimeout .. "s chờ " .. want .. ", sang điểm spawn kế")
            s.idx = (s.idx % #s.list) + 1
            s.goal, s.since, s.issued, s.eta = nil, nil, 0, 0
        end
        task.wait(cfg.SpawnPoll)
    end
end
