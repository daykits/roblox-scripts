local FloatingUI = {
    ScreenGui = nil,
    MenuOpen  = true,
    IsDragging = false,
}

local function ToggleMenu()
    FloatingUI.MenuOpen = not FloatingUI.MenuOpen
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui.Name:lower():find("fluent") then
                gui.Enabled = FloatingUI.MenuOpen
            end
        end
    end
end

local function CreateFloatingButton()
    local sg = Instance.new("ScreenGui")
    sg.Name = "BananaHubFloating"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.DisplayOrder = 999999
    pcall(function() sg.Parent = LocalPlayer:WaitForChild("PlayerGui", 5) end)
    if not sg.Parent then
        pcall(function() sg.Parent = game:GetService("CoreGui") end)
    end
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(50, 50)
    btn.Position = UDim2.new(0, 20, 0.5, -25)
    btn.BackgroundColor3 = Color3.fromRGB(255, 200, 50)  -- Màu vàng chuối
    btn.Text = "🍌"
    btn.TextSize = 24
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = sg
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn
    
    -- Drag
    local dragging, dragStart, startPos
    
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(
                startPos.X.Scale,
                startPos.X.Offset + delta.X,
                startPos.Y.Scale,
                startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                local delta = input.Position - dragStart
                if delta.Magnitude < 5 then
                    ToggleMenu()
                end
            end
        end
    end)
    
    FloatingUI.ScreenGui = sg
end

CreateFloatingButton()

