task.spawn(function()
    while true do
        task.wait(getgenv().FastAttack and 0.04 or 0.2)
        if getgenv().AutoQuest and getgenv().FastAttack then
            pcall(function()
                local char = GetCharacter()
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                    local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
                    if net then
                        local regAttack = net:FindFirstChild("RE/RegisterAttack")
                        local regHit = net:FindFirstChild("RE/RegisterHit")
                        if regAttack then regAttack:FireServer(0.05) end
                        if regHit then
                            for _, e in pairs(workspace.Enemies:GetChildren()) do
                                if e:FindFirstChild("HumanoidRootPart") and e.Humanoid.Health > 0 then
                                    if (char.HumanoidRootPart.Position - e.HumanoidRootPart.Position).Magnitude < 50 then
                                        pcall(function()
                                            regHit:FireServer(e.HumanoidRootPart, {{e, e.HumanoidRootPart}})
                                        end)
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

