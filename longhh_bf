        end

        local function isSkillEffect(obj)
            if not obj then return false end
            local name = string.lower(tostring(obj.Name or ""))
            if name == "kiblastfireshort" or name:find("kiblast", 1, true) ~= nil or name:find("skill", 1, true) ~= nil
                or name:find("attack", 1, true) ~= nil or name:find("charge", 1, true) ~= nil then
                return true
            end
            -- Preserve Claude's BodyGyro/BodyPosition signal classes. BodyVelocity
            -- is accepted only when it carries a meaningful impulse, to avoid treating
            -- a mob's idle movement controller as an attack cue.
            if obj:IsA("BodyGyro") or obj:IsA("BodyPosition") then return true end
            if obj:IsA("BodyVelocity") then
                local ok, velocity, force = pcall(function()
