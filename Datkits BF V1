local function FindMob(mobName)
    local char = GetCharacter()
    if not char then return nil end

    local hrp = char.HumanoidRootPart
    local closest = nil
    local shortest = 450

    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    local lowerMob = tostring(mobName):lower()

    local keywords = {
        ["raider"] = {"raider", "kẻ tập kích", "tap kich", "tapkich"},
        ["mercenary"] = {"mercenary", "lính đánh thuê", "danh thue", "linh danh thue"},
        ["swan pirate"] = {"swan", "pirate"},
        ["factory staff"] = {"factory", "staff"},
        ["marine lieutenant"] = {"lieutenant", "trung úy", "trung uy"},
        ["marine captain"] = {"captain", "đại úy", "dai uy"},
        ["zombie"] = {"zombie"},
        ["vampire"] = {"vampire"},
        ["bandit"] = {"bandit"},
        ["monkey"] = {"monkey"},
        ["gorilla"] = {"gorilla"},
        ["pirate"] = {"pirate"},
        ["brute"] = {"brute"},
        ["desert bandit"] = {"desert", "bandit"},
        ["snow bandit"] = {"snow", "bandit"},
        ["chief petty officer"] = {"chief", "petty", "officer"},
        ["sky bandit"] = {"sky", "bandit"},
        ["prisoner"] = {"prisoner"},
        ["toga warrior"] = {"toga", "warrior"},
        ["military soldier"] = {"military", "soldier"},
        ["fishman warrior"] = {"fishman", "warrior"},
        ["god's guard"] = {"god", "guard"},
        ["shandian"] = {"shandian", "shanda"},
        ["galley pirate"] = {"galley", "pirate"},
    }

    local searchList = keywords[lowerMob] or {lowerMob}

    for _, enemy in pairs(folder:GetChildren()) do
        if enemy:IsA("Model")
        and enemy:FindFirstChild("Humanoid")
        and enemy.Humanoid.Health > 0
        and enemy:FindFirstChild("HumanoidRootPart") then

            local enemyName = enemy.Name:lower()
            local matched = false

            for _, key in pairs(searchList) do
                if enemyName:find(key) then
                    matched = true
                    break
                end
            end

            if matched then
                local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = enemy
                end
            end
        end
    end

    return closest
end

