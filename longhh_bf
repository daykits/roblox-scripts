        if not g then return false end
        if g:IsA("LayerCollector") then return g.Enabled end
        if g:IsA("GuiObject") then return g.Visible end
        return false
    end
    local function isCardish(name)
        return name:find("card", 1, true) ~= nil or name:find("buff", 1, true) ~= nil or name:find("option", 1, true) ~= nil
    end
    local function clickObject(o)
        if not (VirtualInputManager and VirtualInputManager.SendMouseButtonEvent) then
            return
        end
        local x = o.AbsolutePosition.X + o.AbsoluteSize.X / 2
        local y = o.AbsolutePosition.Y + o.AbsoluteSize.Y / 2 + 58
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
        task.wait(0.08)
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
    end
    local function findGui(pg, now)
        local g = cs.gui
        if g and g.Parent and shown(g) then return g end
        g = nil
        for _, n in ipairs(known) do
            local c = pg:FindFirstChild(n)
            if shown(c) then
                g = c
                break
            end
        end
        if not g and now - cs.scanT >= FX.Cfg.CardRescan then
            cs.scanT = now
            for _, gui in ipairs(pg:GetChildren()) do
                if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "Main" then
                    for _, o in ipairs(gui:GetDescendants()) do
                        local nm = o.Name:lower()
                        if nm:find("card", 1, true) or nm:find("buff", 1, true) then
                            g = gui
                            break
                        end
                    end
                end
                if g then break end
            end
        end
        cs.gui = g
        return g
    end
    FX.CardStep = function()
        if not (FX.Enable.Cards and _G.AutoSelectCard and inDungeonPlace()) then
            cs.gui, cs.since = nil, nil
            return
