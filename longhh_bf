    }
    local PH_STOP = 3
    local PH_MOVE_GAP = 0.22
    local PH_CLICK_RANGE = 45

    local function phCursor()
        if PH.cur and PH.cur.Parent then return PH.cur end
        local g = Instance.new("ScreenGui")
        g.Name = "MaruPumpkinCursor"
        g.ResetOnSpawn = false
        g.DisplayOrder = 50
        g.IgnoreGuiInset = true
        pcall(function() g.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
        if not g.Parent then g.Parent = plr:WaitForChild("PlayerGui") end
        local c = Instance.new("ImageLabel")
        c.Name = "Cursor"
        c.Size = UDim2.fromOffset(28, 28)
        c.Position = UDim2.new(0.5, -14, 0.4, -14)
        c.BackgroundTransparency = 1
        c.Image = "rbxassetid://100054563"
        c.Active = false
        c.ZIndex = 10
        c.Parent = g
        PH.gui, PH.cur = g, c
        return c
    end

    local function phPivot(instance)
        if not instance or not instance.Parent then return nil end
        local ok, cf = pcall(function()
            if instance:IsA("Model") or instance:IsA("BasePart") then
                return instance:GetPivot()
            end
            local part = instance:FindFirstChildWhichIsA("BasePart", true)
            return part and part.CFrame or nil
        end)
        return ok and cf or nil
    end

    local function phGetPumpkinFolder()
        local root = workspace:FindFirstChild("PumpkinHunt")
        return root and root:FindFirstChild("Pumpkin") or nil, root
    end

    local function phPumpkinState(target, root)
        local node = target
        while node and node ~= root do
            local state = node:GetAttribute("PumpkinState")
            if state ~= nil then return state end
            node = node.Parent
        end
        return nil
    end

    local function phCollectIdlePumpkins()
        local pumpkinFolder, root = phGetPumpkinFolder()
        local list, seen = { }, setmetatable({ }, { __mode = "k" })
        if not (pumpkinFolder and root) then
            PH.idleCount = 0
            getgenv().__MaruPumpkinIdleCount = 0
            return list
        end

        -- The SimpleSpy path supplied by the user ends at Pumpkin/pumpkinv2.012.
        -- Keep that exact instance as the RemoteEvent argument; never substitute its parent.
        local function addTarget(instance)
            if not instance or seen[instance] then return end
            if not string.lower(instance.Name):match("^pumpkinv2%.") then return end
            seen[instance] = true

            local state = phPumpkinState(instance, root)
            if state ~= nil and state ~= "Idle" then return end

            local cf = phPivot(instance)
            if not cf then return end
            list[#list + 1] = { instance = instance, position = cf.Position }
        end

        local exact = pumpkinFolder:FindFirstChild("pumpkinv2.012", true)
        if exact then
            addTarget(exact)
        end
        for _, descendant in ipairs(pumpkinFolder:GetDescendants()) do
            addTarget(descendant)
        end

        PH.idleCount = #list
        getgenv().__MaruPumpkinIdleCount = #list
        return list
    end

    local function phFindNearest()
        local hrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil, nil, nil end
        local best, bestD, bestPos
        for _, entry in ipairs(phCollectIdlePumpkins()) do
            local distance = (entry.position - hrp.Position).Magnitude
            if not bestD or distance < bestD then
                best, bestD, bestPos = entry.instance, distance, entry.position
            end
        end
        return best, bestD, bestPos
    end

    local function phStop()
        PH.on = false
        if PH.nc then
            PH.nc:Disconnect()
            PH.nc = nil
        end
        if PH.bv then
            pcall(function() PH.bv:Destroy() end)
            PH.bv = nil
        end
        if PH.bg then
            pcall(function() PH.bg:Destroy() end)
            PH.bg = nil
        end
        if PH.gui then
            PH.gui:Destroy()
            PH.gui, PH.cur = nil, nil
        end
        PH.target, PH.tdist, PH.targetPos = nil, nil, nil
        PH.idleCount = 0
        getgenv().__MaruPumpkinIdleCount = 0

        -- Cleanup from an older PH controller execution, without leaving PlatformStand set.
        local character = plr.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.PlatformStand then
            humanoid.PlatformStand = false
        end
    end

    local function phEquipSelectedWeapon()
        local character = plr.Character
        local backpack = plr:FindFirstChild("Backpack")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if not (character and backpack and humanoid and humanoid.Health > 0) then return end

        local wanted = _G.SelectWeapon or "Melee"
        local held = character:FindFirstChildOfClass("Tool")
        if held and (held.ToolTip == wanted or held.Name == wanted) then return end

        for _, container in ipairs({ character, backpack }) do
            for _, tool in ipairs(container:GetChildren()) do
                if tool:IsA("Tool") and (tool.ToolTip == wanted or tool.Name == wanted) then
                    if tool.Parent == backpack then
                        humanoid:EquipTool(tool)
                    end
                    return
                end
            end
        end
