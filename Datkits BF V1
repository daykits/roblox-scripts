local function GetNearestIsland()
    local hrp = GetHRP()
    if not hrp then return nil end
    local sea  = GetCurrentSea()
    local list = SeaIslands[sea] or SeaIslands[1]
    local nearest, minDist = nil, math.huge
    for _, island in ipairs(list) do
        local d = (hrp.Position - island.pos).Magnitude
        if d < minDist then
            minDist = d
            nearest = island
        end
    end
    return nearest, minDist
end

