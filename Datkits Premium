    return lv
end

local function GetCurrentSea()
    local lv = GetLevel()
    if lv >= 1500 then return 3
    elseif lv >= 700 then return 2
    else return 1 end
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
    isGoingToFarmArea = false

    local char = GetCharacter()
    if char then
        if char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local bv = hrp:FindFirstChild("FarmFlyBV")
            if bv then bv:Destroy() end
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
end

local function ToggleNoclip(enable)
    if enable then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = GetCharacter()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- HÀM TWEEN ĐÃ SỬA (ổn định, không bị hủy lung tung)
local function TweenTo(cf, speed)
    speed = speed or getgenv().TweenSpeed or 260
    local char = GetCharacter()
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end

    hum.PlatformStand = true

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    local startPos = hrp.Position
    local targetPos = cf.Position
    local dist = (startPos - targetPos).Magnitude

    if dist <= 5 then
        StopTween()
        hrp.CFrame = cf
        isGoingToFarmArea = false
        return
    end

    -- Chống hủy tween khi đang bay đến bãi farm
    if isGoingToFarmArea and lastTargetPos and (lastTargetPos - targetPos).Magnitude < 15 then
        return
    end

    lastTargetPos = targetPos

    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end

    local duration = math.clamp(dist / speed, 0.1, 8)
    currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = cf})
    currentTween:Play()
end

local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end

    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if tool.ToolTip == "Melee" or n:find("combat") or n:find("step") or n:find("karate")
            or n:find("dragon") or n:find("electric") or n:find("god") or n:find("claw")
            or n:find("superhuman") or n:find("death") or n:find("shark") then
                char.Humanoid:EquipTool(tool)
                return
            end
        end
    end
    local any = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    if any then char.Humanoid:EquipTool(any) end
end

local function HasQuest()
    local ok, res = pcall(function()
        local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if not main then return false end
        local quest = main:FindFirstChild("Quest")
        if not quest then return false end
        return quest.Visible
    end)
    return ok and res
end

