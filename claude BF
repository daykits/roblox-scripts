local function createSlider(parent, scrollFrame, labelText, range, initial, onChanged)
	local slider = { min = range.Min, max = range.Max, value = initial }
	local row = create("Frame", { Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, parent)
	local label = create("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 20), BackgroundTransparency = 1, Text = labelText, TextColor3 = THEME.Text,
		Font = FONT, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local box = create("TextBox", {
		AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.3, 0, 0, 20),
		BackgroundColor3 = THEME.Panel, TextColor3 = THEME.Text, Font = FONT, TextSize = 13, ClearTextOnFocus = false, Text = "",
	}, row)
	addCorner(box, 4)
	local track = create("Frame", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 14), BackgroundColor3 = THEME.Panel }, row)
	addCorner(track, 7)
	local fill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Accent }, track)
	addCorner(fill, 7)
	local knob = create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(18, 18),
		BackgroundColor3 = Color3.new(1, 1, 1),
	}, track)
	addCorner(knob, 9)

	local function render()
		local ratio = (slider.value - slider.min) / math.max(slider.max - slider.min, 0.001)
		fill.Size = UDim2.fromScale(ratio, 1)
		knob.Position = UDim2.fromScale(ratio, 0.5)
		box.Text = tostring(slider.value)
	end
	local function setValue(raw, silent)
		slider.value = snapValue(math.clamp(raw, slider.min, slider.max))
		render()
		if not silent then onChanged(slider.value) end
	end
	function slider.setRange(min, max, value, newLabel)
		slider.min, slider.max = min, max
		if newLabel then label.Text = newLabel end
		setValue(value, true)
	end
	local function updateFromX(x)
		local ratio = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		setValue(slider.min + ratio * (slider.max - slider.min))
	end
	local dragging = false
	track.InputBegan:Connect(function(input)
		if isPointerInput(input) then
			dragging = true
			scrollFrame.ScrollingEnabled = false
			updateFromX(input.Position.X)
		end
	end)
	runtime.maid.give(UserInputService.InputChanged:Connect(function(input)
		if dragging and isMoveInput(input) then updateFromX(input.Position.X) end
	end))
	runtime.maid.give(UserInputService.InputEnded:Connect(function(input)
		if dragging and isPointerInput(input) then
			dragging = false
			scrollFrame.ScrollingEnabled = true
		end
	end))
	box.FocusLost:Connect(function()
		local typed = tonumber(box.Text)
		if not typed or typed ~= typed then
			notify("Enter a valid number", "error")
			render()
			return
		end
		if typed < slider.min or typed > slider.max then
			notify(string.format("Allowed range: %s to %s", slider.min, slider.max), "warning")
		end
		setValue(typed)
	end)
	setValue(initial, true)
	return slider
end

local function createDropdown(parent, title, multi, getOptions, onChanged)
	local dropdown = { selected = {} }
	local container = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(),
	}, parent)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, container)
	local header = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = THEME.Panel, TextColor3 = THEME.Text, Font = FONT, TextSize = 12,
		Text = "", LayoutOrder = 1,
	}, container)
	addCorner(header, 6)
	local panel = create("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = THEME.Panel,
		Visible = false, LayoutOrder = 2,
	}, container)
	addCorner(panel, 6)
	create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, panel)
	local search = create("TextBox", {
		Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = THEME.Background, TextColor3 = THEME.Text, PlaceholderText = "Search...",
		PlaceholderColor3 = THEME.Muted, Font = FONT, TextSize = 12, ClearTextOnFocus = false, Text = "", LayoutOrder = 1,
	}, panel)
	addCorner(search, 4)
	local list = create("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 110), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
	}, panel)
	create("UIListLayout", { Padding = UDim.new(0, 2) }, list)

	local function updateHeader()
		local names = {}
		for name in pairs(dropdown.selected) do table.insert(names, name) end
		table.sort(names)
		local summary = #names == 0 and "None" or table.concat(names, ", ")
		header.Text = title .. ": " .. summary .. "  v"
	end
	local function choose(name)
		if multi then
			dropdown.selected[name] = not dropdown.selected[name] or nil
		elseif dropdown.selected[name] then
			dropdown.selected = {}
		else
			dropdown.selected = { [name] = true }
			panel.Visible = false
		end
		updateHeader()
		onChanged(dropdown.selected)
	end
	function dropdown.refresh()
		for _, child in ipairs(list:GetChildren()) do
			if child:IsA("TextButton") then child:Destroy() end
		end
		local query = string.lower(search.Text)
		for _, name in ipairs(getOptions()) do
			if query == "" or string.find(string.lower(name), query, 1, true) then
				local mark = dropdown.selected[name] and "[x] " or "[  ] "
				local option = create("TextButton", {
					Size = UDim2.new(1, -6, 0, 24), BackgroundColor3 = THEME.Background, TextColor3 = THEME.Text, Font = FONT,
					TextSize = 12, Text = mark .. name, TextXAlignment = Enum.TextXAlignment.Left,
				}, list)
				addCorner(option, 4)
				option.Activated:Connect(function()
					choose(name)
					dropdown.refresh()
				end)
			end
		end
	end
	header.Activated:Connect(function()
		panel.Visible = not panel.Visible
		if panel.Visible then dropdown.refresh() end
	end)
	search:GetPropertyChangedSignal("Text"):Connect(dropdown.refresh)
	updateHeader()
	return dropdown
end

