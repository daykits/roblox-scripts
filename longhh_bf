do
    local FX = _G.FARMX
    local state, since, ownsRaiding, lastTimer = "IDLE", os.clock(), false, 0
    FX.RaidState = state
    local function setState(s)
        if s ~= state then
            FX.Log("raid-fsm", state .. " -> " .. s)
        end
        state, since, FX.RaidState = s, os.clock(), s
    end
    local function labCF()
        if World2 then return CFrame.new(-6438.73535, 250.645355, -4501.50684) end
        if World3 then return CFrame.new(-5017.40869, 314.844055, -2823.0127) end
        return nil
    end
    local function summonButton()
        local map = workspace.Map:FindFirstChild(World2 and "CircleIsland" or "Boat Castle")
        local s = map and map:FindFirstChild("RaidSummon2")
        local b = s and s:FindFirstChild("Button")
        return b and b:FindFirstChild("Main")
    end
    local function stopRaiding()
        if ownsRaiding then
            _G.Raiding = false
            ownsRaiding = false
        end
    end
    UIX.Toggle(Tabs.Raids, "Raids_AutoRaidFSM", {
        Title = "Auto Raid (State Machine)",
        Description = "Mua chip (Beli) -> tới lab -> bấm nút -> đánh raid (worker Next Island) -> xong -> nghỉ. Không bật chung Auto Start Raid",
        Default = false,
        Callback = function(Value)
            _G.AutoRaidFSM = Value
            if not Value then
                stopRaiding()
                setState("IDLE")
            end
        end
    })
    local function step()
        local timer = FX.RaidTimerVisible()
        if timer then
            lastTimer = os.clock()
        end
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if state == "IDLE" then
            if timer then
                setState("ACTIVE")
            elseif not GetBP("Special Microchip") then
                setState("BUY_CHIP")
            else
                setState("LAB")
            end
        elseif state == "BUY_CHIP" then
            if GetBP("Special Microchip") then
                setState("LAB")
            elseif os.clock() - since > FX.Cfg.RaidBuyTimeout then
                FX.Log("raid-fsm", "hết thời gian chờ chip")
                setState("COOLDOWN")
            elseif FX.Gate("raid-fsm-buy", FX.Cfg.RemoteGap) then
                replicated.Remotes.CommF_:InvokeServer("RaidsNpc", "Select", _G.SelectChip or "Ice")
            end
        elseif state == "LAB" then
            local cf = labCF()
            if timer then
                setState("ACTIVE")
            elseif not GetBP("Special Microchip") then
                setState("BUY_CHIP")
            elseif not cf or not root then
                setState("COOLDOWN")
            elseif (root.Position - cf.Position).Magnitude <= 25 then
                setState("JOIN")
            elseif os.clock() - since > FX.Cfg.RaidLabTimeout then
                FX.Log("raid-fsm", "hết thời gian tới lab")
                setState("COOLDOWN")
            else
                _tp(cf)
            end
        elseif state == "JOIN" then
            if timer then
                setState("ACTIVE")
            elseif os.clock() - since > FX.Cfg.RaidJoinTimeout then
                FX.Log("raid-fsm", "hết thời gian bấm nút")
                setState("COOLDOWN")
            elseif FX.Gate("raid-fsm-click", FX.Cfg.RaidClickGap) then
                local b = summonButton()
                local cd = b and b:FindFirstChild("ClickDetector")
                if cd and typeof(fireclickdetector) == "function" then
                    fireclickdetector(cd)
                end
            end
        elseif state == "ACTIVE" then
            if not _G.Raiding then
                _G.Raiding = true
                ownsRaiding = true
            end
            if not timer and os.clock() - lastTimer > FX.Cfg.RaidEndDebounce then
                setState("COMPLETE")
            end
        elseif state == "COMPLETE" then
            stopRaiding()
            setState("CLEANUP")
        elseif state == "CLEANUP" then
            stopRaiding()
            if os.clock() - since > 1 then
                setState("COOLDOWN")
            end
        elseif state == "COOLDOWN" then
            if os.clock() - since > FX.Cfg.RaidCooldown then
                setState("IDLE")
            end
        end
    end
    task.spawn(function()
        while task.wait(0.5) do
            if not _G.AutoRaidFSM or not FX.Enable.RaidFSM then
                if ownsRaiding then
                    stopRaiding()
                end
                continue
            end
            if not (World2 or World3) then continue end
            local ok, err = pcall(step)
            if not ok then
                FX.Log("raid-fsm", err)
                setState("COOLDOWN")
            end
        end
    end)
end
