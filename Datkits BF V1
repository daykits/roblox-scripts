local function GetCharacter()
    local char = LocalPlayer.Character
    if char
        and char:FindFirstChild("HumanoidRootPart")
        and char:FindFirstChild("Humanoid")
        and char.Humanoid.Health > 0
    then
        return char
    end
    return nil
end

local function GetLevel()
    local level = 1
    pcall(function()
        level = LocalPlayer.Data.Level.Value
    end)
    return level
end

local function SetCollide(char, state)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = state
        end
    end
end

-------------------------------------------------
-- TWEEN & NOCLIP
-------------------------------------------------
local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
    isGoingToFarmArea = false

    local char = GetCharacter()
    if char then
        pcall(function()
            char.Humanoid.PlatformStand = false
            char.HumanoidRootPart.AssemblyLinearVelocity  = Vector3.zero
            char.HumanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        end)
    end
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if char then
        SetCollide(char, true)
    end
end

local function ToggleNoclip(state)
    if state then
        if noclipConnection then return end
        noclipConnection = RunService.Stepped:Connect(function()
            local char = GetCharacter()
            if char then
                SetCollide(char, false)
            end
        end)
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function TweenTo(cf, speed)
    speed = speed or Config.TweenSpeed
    local char = GetCharacter()
    if not char then return end

    local hrp = char.HumanoidRootPart
    char.Humanoid.PlatformStand = true
    SetCollide(char, false)
    hrp.AssemblyLinearVelocity = Vector3.zero

    local dist = (hrp.Position - cf.Position).Magnitude

    -- Đã tới nơi -> dừng hẳn
    if dist <= 5 then
        StopTween()
        hrp.CFrame = cf
        return
    end

    -- Tránh tạo tween trùng lặp khi đang bay về bãi farm
    if isGoingToFarmArea and lastTargetPos
        and (lastTargetPos - cf.Position).Magnitude < 12 then
        return
    end
    lastTargetPos = cf.Position

    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end

    local duration = math.clamp(dist / speed, 0.08, 6.5)
    currentTween = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        { CFrame = cf }
    )
    currentTween:Play()
end

