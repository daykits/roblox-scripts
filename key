    local function DoVerify()
        if cooldown then
            statusLabel.Text = "⏳ Poczekaj przed kolejną próbą..."
            statusLabel.TextColor3 = Color3.fromRGB(254, 231, 92)
            return
        end

        local inputKey = keyInput.Text
        if inputKey == "" then
            statusLabel.Text = "❌ Wpisz klucz!"
            Tween(statusLabel, {TextColor3 = Color3.fromRGB(237, 66, 69)}, 0.2)
            for _, offset in ipairs({8, -8, 4, -4, 0}) do
                Tween(inputContainer, {Position = UDim2.new(0.075, offset, 0, 198)}, 0.04)
                task.wait(0.04)
            end
            return
        end

        local role = VerifyKey(inputKey)
        if role then
            UserRole = role; KeyVerified = true
            if rememberState then SaveKey(inputKey) end

            statusLabel.Text = "✅ Klucz prawidłowy! Rola: " .. role:upper()
            statusLabel.TextColor3 = Color3.fromRGB(87, 242, 135)
            Tween(inputContainer, {BackgroundColor3 = Color3.fromRGB(20, 60, 30)}, 0.3)
            lockIcon.Text = "🔓"
            Tween(lockDiamond, {BackgroundColor3 = Color3.fromRGB(87, 242, 135)}, 0.3)
            verifyText.Text = "✅ ZWERYFIKOWANO • " .. role:upper()
            Tween(verifyBtn, {BackgroundColor3 = Color3.fromRGB(87, 242, 135)}, 0.3)

            task.wait(1.2)

            local flash = Instance.new("Frame")
            flash.Size = UDim2.new(1, 0, 1, 0)
            flash.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
            flash.BackgroundTransparency = 1; flash.ZIndex = 250
            flash.Parent = keyBg
            Tween(flash, {BackgroundTransparency = 0.5}, 0.2)
            task.wait(0.2)
            Tween(flash, {BackgroundTransparency = 1}, 0.3)
            Tween(keyCard, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            Tween(keyBg, {BackgroundTransparency = 1}, 0.6)

            for _, child in pairs(particleHolder:GetChildren()) do
                if child:IsA("Frame") then Tween(child, {BackgroundTransparency = 1}, 0.4) end
            end

            task.wait(0.7)
            KeyGui:Destroy()
            callback()
        else
            attempts = attempts + 1
            attemptsLabel.Text = "Próby: " .. attempts .. "/" .. maxAttempts

            if attempts >= maxAttempts then
                statusLabel.Text = "🚫 Zbyt wiele prób! Zablokowano na 30s"
                statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
                cooldown = true; verifyBtn.Active = false
                verifyText.Text = "🔒 ZABLOKOWANE"
                Tween(verifyBtn, {BackgroundColor3 = Color3.fromRGB(60, 20, 20)}, 0.3)

                spawn(function()
                    for i = 30, 0, -1 do
                        if not keyCard or not keyCard.Parent then return end
                        statusLabel.Text = "🚫 Zablokowano! Odczekaj: " .. i .. "s"
                        task.wait(1)
                    end
                    cooldown = false; attempts = 0
                    attemptsLabel.Text = "Próby: 0/" .. maxAttempts                    statusLabel.Text = "Spróbuj ponownie"
                    statusLabel.TextColor3 = Color3.fromRGB(148, 155, 170)
                    verifyBtn.Active = true
                    verifyText.Text = "🔓 WERYFIKUJ KLUCZ"
                    Tween(verifyBtn, {BackgroundColor3 = Color3.fromRGB(88, 101, 242)}, 0.3)
                end)
            else
                statusLabel.Text = "❌ Nieprawidłowy klucz! (" .. (maxAttempts - attempts) .. " prób)"
                statusLabel.TextColor3 = Color3.fromRGB(237, 66, 69)
                for _, offset in ipairs({10, -10, 6, -6, 3, -3, 0}) do
                    Tween(inputContainer, {Position = UDim2.new(0.075, offset, 0, 198)}, 0.04)
                    task.wait(0.04)
                end
                local iStroke = inputContainer:FindFirstChildOfClass("UIStroke")
                if iStroke then
                    Tween(iStroke, {Color = Color3.fromRGB(237, 66, 69), Transparency = 0}, 0.1)
                    task.wait(0.5)
                    Tween(iStroke, {Color = Color3.fromRGB(52, 52, 78), Transparency = 0.3}, 0.3)
                end
                cooldown = true; task.wait(1.5); cooldown = false
            end
        end
    end

    verifyBtn.MouseButton1Click:Connect(function()
        RippleEffect(verifyBtn, Mouse.X, Mouse.Y)
        DoVerify()
    end)

    keyInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then DoVerify() end
    end)
end

