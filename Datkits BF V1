local Noclip = {
    Connection = nil,
    ForceLoop  = nil,
}

local function EnableNoclip()
    if Noclip.Connection then Noclip.Connection:Disconnect() end
    Noclip.Connection = RunService.Stepped:Connect(function()
        local char = GetCharacter()
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end)

    if Noclip.ForceLoop then
        pcall(task.cancel, Noclip.ForceLoop)
    end
    Noclip.ForceLoop = task.spawn(function()
        while Config.NoclipEnabled do
            task.wait(0.05)
            local char = GetCharacter()
            if not char then continue end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if part.CanCollide then part.CanCollide = false end
                    if part.CanTouch  then part.CanTouch  = false end
                end
            end
        end
    end)
end

local function DisableNoclip()
    if Noclip.Connection then
        Noclip.Connection:Disconnect()
        Noclip.Connection = nil
    end
    if Noclip.ForceLoop then
        pcall(task.cancel, Noclip.ForceLoop)
        Noclip.ForceLoop = nil
    end
    local char = GetCharacter()
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
            part.CanTouch  = true
        end
    end
end

