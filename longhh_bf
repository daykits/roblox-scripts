            LX.Out("ok", "perm " .. string.lower(k) .. " = " .. (on and "on" or "off"))
        end
    end
    function LX.PermText()
        local parts = { }
        for _, k in ipairs({ "Control", "Shell", "Character", "Interface", "Trigger" }) do
            parts[#parts + 1] = string.lower(k) .. "=" .. (LX.Perm[k] and "on" or "off")
        end
        return table.concat(parts, "  ")
    end
    local function permKey(p)
        for k, names in pairs(PERM_NAMES) do
            for _, n in ipairs(names) do
                if has(p, n) then
                    return k
                end
            end
        end
        return nil
    end

