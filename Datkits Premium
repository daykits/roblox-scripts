local function GetCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        return char
    end
    return nil
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function GetCurrentSea()
    local lv = GetLevel()
    if lv >= 1500 then return 3
    elseif lv >= 700 then return 2
    else return 1 end
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bv = hrp:FindFirstChild("FarmFlyBV")
        if bv then bv:Destroy() end
        hrp.AssemblyLinearVelocity = Vector3.zero
    end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

local function ToggleNoclip(enable)
    if enable then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                local char = GetCharacter()
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

-- HÀM BAY AN TOÀN TÍCH HỢP TỰ ĐỘNG NÂNG ĐỘ CAO (BYPASS ĐẢO / VẬT CẢN)
local function TweenTo(cf, speed)
    speed = speed or getgenv().TweenSpeed
    local char = GetCharacter()
    if not char then return end
    local hrp = char.HumanoidRootPart

    local bv = hrp:FindFirstChild("FarmFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmFlyBV"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local startPos = hrp.Position
    local targetPos = cf.Position
    local dist = (startPos - targetPos).Magnitude

    if dist <= 4 then
        StopTween()
        hrp.CFrame = cf
        return
    end

    -- Nếu khoảng cách > 1000 studs: Tự động kích hoạt ĐƯỜNG BAY BAYPASS trên cao
    if dist > 1000 then
        local highY = math.max(startPos.Y, targetPos.Y) + 300
        local waypoints = {
            CFrame.new(startPos.X, highY, startPos.Z),
            CFrame.new(targetPos.X, highY, targetPos.Z),
            cf
        }

        for _, wayCF in ipairs(waypoints) do
            if not (getgenv().AutoQuest or getgenv().AutoFarm or getgenv().AutoChest) then 
                StopTween()
                break 
            end

            local legDist = (hrp.Position - wayCF.Position).Magnitude
            local legDuration = legDist / speed

            if currentTween then pcall(function() currentTween:Cancel() end) end
            currentTween = TweenService:Create(hrp, TweenInfo.new(legDuration, Enum.EasingStyle.Linear), {CFrame = wayCF})
            currentTween:Play()
            task.wait(legDuration)
        end
    else
        -- Bay bình thường khoảng cách ngắn
        if not currentTween or not lastTargetPos or (lastTargetPos - targetPos).Magnitude > 3 then
            lastTargetPos = targetPos
            if currentTween then pcall(function() currentTween:Cancel() end) end
            
            local duration = dist / speed
            currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = cf})
            currentTween:Play()
        end
    end
end

local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end
    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if tool.ToolTip == "Melee" or n:find("combat") or n:find("step") or n:find("karate")
            or n:find("dragon") or n:find("electric") or n:find("god") or n:find("claw")
            or n:find("superhuman") or n:find("death") or n:find("shark") then
                char.Humanoid:EquipTool(tool)
                return
            end
        end
    end
    local any = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    if any then char.Humanoid:EquipTool(any) end
end

local function HasQuest()
    local ok, res = pcall(function()
        local gui = LocalPlayer.PlayerGui:FindFirstChild("Main")
        return gui and gui:FindFirstChild("Quest") and gui.Quest.Visible
    end)
    return ok and res
end

