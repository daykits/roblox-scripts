local function createTitleBar(main, openButtonToggle, body, size)
	local bar = create("Frame", { Size = UDim2.new(1, 0, 0, TITLE_HEIGHT), BackgroundColor3 = THEME.Panel }, main)
	addCorner(bar, 8)
	create("TextLabel", {
		Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = "Utility Menu",
		TextColor3 = THEME.Text, Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
	}, bar)
	local function makeButton(text, offset)
		local button = create("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, offset, 0.5, 0), Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = THEME.Background, TextColor3 = THEME.Text, Font = Enum.Font.GothamBold, TextSize = 14, Text = text,
		}, bar)
		addCorner(button, 6)
		return button
	end
	local minimized = false
	makeButton("-", -34).Activated:Connect(function()
		minimized = not minimized
		body.Visible = not minimized
		main.Size = minimized and UDim2.fromOffset(size.X, TITLE_HEIGHT) or UDim2.fromOffset(size.X, size.Y)
	end)
	makeButton("x", -6).Activated:Connect(openButtonToggle)
	makeDraggable(bar, main)
end

local function buildMovementSection(body)
	createSection(body, "Movement")
	ui.toggles.SpeedWalk = createToggle(body, "Speed Walk", function(v) setFeature("SpeedWalk", v) end)
	createSlider(body, body, "Walk Speed", CONFIG.WalkSpeed, CONFIG.WalkSpeed.Default, function(value)
		speedState.value = value
		if features.SpeedWalk.enabled then applySpeed() end
	end)
	ui.toggles.HighJump = createToggle(body, "High Jump", function(v) setFeature("HighJump", v) end)
	ui.jumpSlider = createSlider(body, body, "Jump Power", CONFIG.JumpPower, CONFIG.JumpPower.Default, function(value)
		local humanoid = getHumanoid()
		local property = humanoid and getJumpProperty(humanoid) or "JumpPower"
		jumpState.values[property] = value
		if features.HighJump.enabled then applyJump() end
	end)
	ui.toggles.Noclip = createToggle(body, "Noclip", function(v) setFeature("Noclip", v) end)
end

local function buildVisualSection(body)
	createSection(body, "Visual")
	ui.toggles.FixLag = createToggle(body, "Fix Lag", function(v) setFeature("FixLag", v) end)
	ui.toggles.FullBright = createToggle(body, "Full Bright", function(v) setFeature("FullBright", v) end)
	ui.toggles.PlayerESP = createToggle(body, "Player ESP", function(v) setFeature("PlayerESP", v) end)
	local teamToggle
	teamToggle = createToggle(body, "ESP: opposing teams only", function(v)
		CONFIG.ESP.HideTeammates = v
		teamToggle.set(v)
		refreshAllESP()
	end)
	teamToggle.set(CONFIG.ESP.HideTeammates)
end

local function buildAutoSection(body)
	createSection(body, "Automation")
	createStatus(body, "AutoFarm", "Auto Farm")
	createStatus(body, "AutoLoot", "Auto Loot")
	ui.toggles.AutoFarm = createToggle(body, "Auto Farm", function(v) setFeature("AutoFarm", v) end)
	createDropdown(body, "Enemy", false, getEnemyTypeNames, function(selected)
		farm.selected = next(selected)
		farm.target = nil
		farm.mover.cancel()
	end)
	ui.toggles.AutoLoot = createToggle(body, "Auto Loot", function(v) setFeature("AutoLoot", v) end)
	createDropdown(body, "Loot", true, function() return CONFIG.LootTags end, function(selected)
		loot.selected = table.clone(selected)
		loot.target = nil
		loot.mover.cancel()
	end)
end

local function buildMenu(gui)
	local viewport = getViewport()
	local size = Vector2.new(math.min(CONFIG.MenuWidth, viewport.X - 20), math.min(CONFIG.MenuHeight, viewport.Y * 0.75))
	local main = create("Frame", {
		Name = "Main", Position = UDim2.fromOffset(16, 90), Size = UDim2.fromOffset(size.X, size.Y),
		BackgroundColor3 = THEME.Background, Active = true,
	}, gui)
	addCorner(main, 8)
	local body = create("ScrollingFrame", {
		Position = UDim2.fromOffset(8, TITLE_HEIGHT + 6), Size = UDim2.new(1, -16, 1, -(TITLE_HEIGHT + 12)),
		BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, main)
	create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	create("UIPadding", { PaddingRight = UDim.new(0, 6) }, body)

	local openButton = create("TextButton", {
		Name = "OpenButton", Position = UDim2.fromOffset(8, 60), Size = UDim2.fromOffset(34, 34),
		BackgroundColor3 = THEME.Accent, TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 18, Text = "=",
	}, gui)
	addCorner(openButton, 17)
	local function toggleMenu() main.Visible = not main.Visible end
	openButton.Activated:Connect(toggleMenu)
	runtime.maid.give(UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == CONFIG.MenuToggleKey then toggleMenu() end
	end))

	createTitleBar(main, toggleMenu, body, size)
	buildMovementSection(body)
	buildVisualSection(body)
	buildAutoSection(body)
end

--====================================================================
-- LIFECYCLE
--====================================================================
local function shutdown()
	if runtime.destroyed then return end
	runtime.destroyed = true
	for _, feature in pairs(features) do
		if feature.enabled then
			feature.enabled = false
			runFeatureHook(feature, "stop")
		end
	end
	releaseHold()
	noclip.requests = {}
	refreshNoclip()
	characterMaid.clean()
	enemyRegistry.maid.clean()
	lootRegistry.maid.clean()
	runtime.maid.clean()
end

local function onCharacterAdded(character)
	trackCharacterParts(character)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if runtime.destroyed or not humanoid or localPlayer.Character ~= character then return end
	if features.SpeedWalk.enabled then
		applySpeed()
		bindSpeedWatcher()
	end
	if features.HighJump.enabled then applyJump() end
	refreshJumpSlider()
end

local function removeExistingMenu()
	local existing = playerGui:FindFirstChild(GUI_NAME)
	if existing then
		existing:Destroy()
		task.wait() -- lets the old instance finish its cleanup (Destroying may be deferred)
	end
end

local function initialize()
	removeExistingMenu()
	local gui = create("ScreenGui", {
		Name = GUI_NAME, ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 50,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	}, playerGui)
	gui.Destroying:Connect(shutdown)
	createNotifications(gui)
	setStatus = function(key, text)
		local entry = ui.statusLabels[key]
		local full = entry and (entry.title .. ": " .. text)
		if entry and entry.label.Text ~= full then entry.label.Text = full end
	end
	buildMenu(gui)
	trackTaggedEnemies()
	bindEnemyFolder()
	trackLootTags()
	runtime.maid.give(localPlayer.CharacterAdded:Connect(onCharacterAdded))
	if localPlayer.Character then
		task.spawn(onCharacterAdded, localPlayer.Character)
	end
	notify("Utility Menu loaded (" .. CONFIG.MenuToggleKey.Name .. " toggles it)", "info")
end

initialize()
