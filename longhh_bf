    FH.UiOn = function(e)
        if e.mode and _G.SelectedFarmMode == e.mode then return true end
        local ui = e.ui
        for i = 1, #ui do
            local ok, v = pcall(FH.OptVal, ui[i])
            if ok and v then return true end
        end
        return false
