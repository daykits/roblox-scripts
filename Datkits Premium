Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Quest (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        if not Value then
            ResetCharacterState()
            Fluent:Notify({Title = "Auto Quest", Content = "Đã TẮT", Duration = 3})
            return
        end

        Fluent:Notify({Title = "Auto Quest", Content = "Đã BẬT - Đang tìm nhiệm vụ...", Duration = 4})

        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(0.6)
            end
        end)

        task.spawn(function()
            while getgenv().AutoQuest do
                task.wait(0.12)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart

                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()

                    if not HasQuest() then
                        -- Nhận nhiệm vụ
                        if npcCFrame then
                            local dist = (hrp.Position - npcCFrame.Position).Magnitude
                            if dist > 10 then
                                TweenTo(npcCFrame * CFrame.new(0, 0, 3), 250)
                            else
                                StopTween()
                                for i = 1, 8 do
                                    pcall(function()
                                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                    end)
                                    task.wait(0.08)
                                end
                                task.wait(1)
                            end
                        end
                    else
                        -- ĐÃ CÓ NHIỆM VỤ → ĐI ĐÁNH QUÁI (PHẦN QUAN TRỌNG)
                        local target = FindTargetMob(mobName)

                        if target then
                            local pos = target.HumanoidRootPart.Position
                            local height = getgenv().FarmDistance
                            local farmPos = CFrame.new(pos + Vector3.new(0, height, 0), pos)
                            TweenTo(farmPos, 280)

                            pcall(function()
                                target.HumanoidRootPart.CanCollide = false
                                target.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                            end)
                        else
                            -- Không tìm thấy mob → bay về khu vực spawn
                            if mobCFrame then
                                TweenTo(mobCFrame, 260)
                            end
                        end
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

