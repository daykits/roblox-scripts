-- ✅ AUTO QUEST v4.3 - HỖ TRỢ SEA 1 + 2 + 3
-------------------------------------------------
local QuestState = {
    Phase = "idle",
    LastQuest = nil,
    LastQLv = nil,
    LastQuestTime = 0,
    QuestAccepted = false,
    QuestAcceptedTime = 0,
    LastKillTime = 0,
    LastEnemyCount = 0,
    QuestCompleted = false,
}

local function AutoQuestLoop()
    while task.wait(0.15) do
        if not Config.AutoQuest then
            if Move.Active then StopFly() end
            QuestState.Phase = "idle"
            QuestState.QuestAccepted = false
            QuestState.QuestCompleted = false
            continue
        end

        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            if not hrp then return end

            local entry = GetQuestData()
            if not entry then return end

            local quest = entry.quest
            local qlv = entry.lv
            local mob = entry.mob
            local npcCF = entry.npc
            local spawnCF = entry.spawn

            local qInfo = GetQuestInfo()
            local now = tick()

            -- Đổi quest → reset
            if qInfo.QuestName and qInfo.QuestName ~= QuestState.LastQuest then
                QuestState.QuestAccepted = false
                QuestState.QuestCompleted = false
            end

            -- Cập nhật quest state
            if qInfo.HasQuest and not qInfo.IsComplete then
                if not QuestState.QuestAccepted then
                    QuestState.QuestAccepted = true
                    QuestState.QuestAcceptedTime = now
                end
                QuestState.QuestCompleted = false
            end

            if qInfo.IsComplete then
                QuestState.QuestCompleted = true
            end

            -- Quyết định farm hay không
            local shouldFarm = false
            if qInfo.HasQuest and not qInfo.IsComplete then
                shouldFarm = true
            elseif QuestState.QuestAccepted and not QuestState.QuestCompleted then
                shouldFarm = true
            end

            -- Vừa kill → giữ farm
            if not shouldFarm and (now - QuestState.LastKillTime) < 3 then
                shouldFarm = true
            end

            ---------------------------------------------------
            -- PHASE 1: ĐI ĐÁNH QUÁI
            ---------------------------------------------------
            if shouldFarm then
                QuestState.Phase = "toMob"

                local hits = GetClosestEnemies(math.huge, mob)
                if #hits == 0 then
                    hits = GetClosestEnemies(2000)
                end

                if #hits == 0 then
                    local withinQuestGrace = QuestState.QuestAccepted
                        and (now - QuestState.QuestAcceptedTime) < Config.QuestGracePeriod

                    if spawnCF then
                        local distToSpawn = (hrp.Position - spawnCF.Position).Magnitude
                        if distToSpawn > 15 then
                            SetMoveTarget(spawnCF + Vector3.new(0, Config.FarmDistance, 0))
                        else
                            SetMoveTarget(CFrame.new(hrp.Position))
                        end
                    end
                    return
                end

                local target = hits[1]
                local pos = target.hrp.Position
                local targetCF = CFrame.new(
                    pos + Vector3.new(0, Config.FarmDistance, 0),
                    pos
                )
                SetMoveTarget(targetCF)

                if #hits < QuestState.LastEnemyCount then
                    QuestState.LastKillTime = now
                end
                QuestState.LastEnemyCount = #hits

                return
            end

            ---------------------------------------------------
            -- PHASE 2: ĐI TỚI NPC
            ---------------------------------------------------
            QuestState.Phase = "toNPC"
            QuestState.LastEnemyCount = 0

            if not npcCF then return end

            local distToNPC = (hrp.Position - npcCF.Position).Magnitude

            if distToNPC > 12 then
                SetMoveTarget(npcCF * CFrame.new(0, 0, 3))
                QuestState.Phase = "toNPC"
            else
                QuestState.Phase = "atNPC"
                SetMoveTarget(CFrame.new(hrp.Position))

                local needCall = (QuestState.LastQuest ~= quest)
                    or (QuestState.LastQLv ~= qlv)
                    or (now - QuestState.LastQuestTime > 5)

                if needCall then
                    QuestState.LastQuest = quest
                    QuestState.LastQLv = qlv
                    QuestState.LastQuestTime = now

                    QuestState.QuestCompleted = false
                    QuestState.QuestAccepted = false

                    pcall(function()
                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest, qlv)
                    end)

                    QuestState.QuestAccepted = true
                    QuestState.QuestAcceptedTime = now
                end
            end
        end)
    end
end

