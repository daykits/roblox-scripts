local BossState = {
    LastKillTime = 0,
    LastKillName = nil,
    KillCount = 0,
    LastSearchTime = 0,
    NoBossTime = 0,
    DebugLastPrint = 0,
}

local function TrySpawnBoss(bossName)
    local spawned = false
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BossSpawn", bossName)
    end)
    pcall(function()
        if ReplicatedStorage.Remotes:FindFirstChild("CommE_") then
            ReplicatedStorage.Remotes.CommE_:InvokeServer("BossSpawn", bossName)
        end
    end)
    pcall(function()
        local questNpc = workspace:FindFirstChild(bossName .. "Quest", true)
        if questNpc then
            local remote = questNpc:FindFirstChildWhichIsA("RemoteEvent")
                or questNpc:FindFirstChildWhichIsA("RemoteFunction")
            if remote then
                if remote:IsA("RemoteEvent") then
                    remote:FireServer("Spawn")
                else
                    remote:InvokeServer("Spawn")
                end
                spawned = true
            end
        end
    end)
    return spawned
end

local function AutoBossLoop()
    while task.wait(0.2) do
        if not Config.AutoBoss then
            BossState.NoBossTime = 0
            continue
        end

        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            if not hrp then return end

            local targetBoss = nil
            local targetInfo = nil

            if Config.BossSelected then
                local allList = GetAllBossList()
                for _, info in ipairs(allList) do
                    if info.name == Config.BossSelected then
                        targetInfo = info
                        break
                    end
                end
                if targetInfo then
                    local found = FindBoss(targetInfo.name)
                    if #found > 0 then
                        local nearest = found[1]
                        local minDist = (hrp.Position - nearest.hrp.Position).Magnitude
                        for _, b in ipairs(found) do
                            local d = (hrp.Position - b.hrp.Position).Magnitude
                            if d < minDist then minDist = d; nearest = b end
                        end
                        targetBoss = nearest
                    end
                end
            else
                local allBosses = FindAllBossesInRange(Config.BossFarmRange)
                if #allBosses > 0 then
                    targetBoss = allBosses[1]
                    targetInfo = allBosses[1].info
                end
            end

            if not targetBoss then
                BossState.NoBossTime = BossState.NoBossTime + 0.2
                if Config.AutoSpawnBoss and targetInfo then
                    if BossState.NoBossTime > 2 then
                        if tick() - BossState.LastSearchTime > 3 then
                            BossState.LastSearchTime = tick()
                            TrySpawnBoss(targetInfo.name)
                        end
                    end
                    if targetInfo.spawnPos then
                        local distToSpawn = (hrp.Position - targetInfo.spawnPos).Magnitude
                        if distToSpawn > 20 then
                            SetMoveTarget(CFrame.new(
                                targetInfo.spawnPos + Vector3.new(0, Config.FarmDistance, 0)
                            ), 10)
                        else
                            SetMoveTarget(CFrame.new(hrp.Position), 10)
                        end
                    end
                end
                return
            end

            BossState.NoBossTime = 0

            local bossPos = targetBoss.hrp.Position
            local bossHum = targetBoss.hum

            local myPos = hrp.Position
            local dist = (myPos - bossPos).Magnitude

            if dist > Config.BossDistance then
                local dest = bossPos + Vector3.new(0, Config.BossDistance, 0)
                SetMoveTarget(CFrame.new(dest, bossPos), 10)
            else
                SetMoveTarget(CFrame.new(myPos, bossPos), 10)
            end

            if tick() - BossState.DebugLastPrint > 3 then
                BossState.DebugLastPrint = tick()
                print(string.format(
                    "[Datkits Boss] Boss: %s | HP: %d | Dist: %.1f | InRange: %s",
                    targetBoss.boss.Name,
                    bossHum.Health,
                    dist,
                    tostring(dist <= Config.HitboxRange)
                ))
            end

            if bossHum.Health <= 0 then
                if BossState.LastKillName ~= targetBoss.boss.Name 
                    or (tick() - BossState.LastKillTime) > 5 
                then
                    BossState.LastKillTime = tick()
                    BossState.LastKillName = targetBoss.boss.Name
                    BossState.KillCount = BossState.KillCount + 1

                    if targetInfo then
                        Fluent:Notify({
                            Title    = "🐲 Boss Killed",
                            Content  = targetInfo.displayName .. " (Total: " .. BossState.KillCount .. ")",
                            Duration = 3,
                        })
                    end
                end
            end
        end)
    end
end

