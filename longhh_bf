    FX.FlyStop = function()
        local F = FX.Fly
        local hadSaved = F.saved
        FX.FlyOn = false
        pcall(function() getgenv().SHX_ShouldFly = false end)
        if F.lv then
            pcall(function() F.lv.VectorVelocity = Vector3.zero end)
        end
        if F.vf then
            pcall(function() F.vf.Force = Vector3.zero end)
        end
        FX.FlyDestroy()
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hadSaved then
            pcall(function()
                hum.WalkSpeed = hadSaved.ws or 16
                hum.JumpPower = hadSaved.jp or 50
            end)
        end
        F.saved = nil
        do
            local c0 = plr.Character
            local h0 = c0 and c0:FindFirstChild("HumanoidRootPart")
            local clip = h0 and h0:FindFirstChild("BodyClip")
            if clip and clip:IsA("BodyVelocity") then
                pcall(function() clip.MaxForce = Vector3.new(100000, 100000, 100000) end)
            end
        end
    end
    FX.FlyEnsure = function()
        local F = FX.Fly
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        if F.lv and F.vf and F.att and F.lv.Parent == hrp and F.vf.Parent == hrp then
            return hrp
        end
        FX.FlyDestroy()
        local att = Instance.new("Attachment")
        att.Name = "NXV_MoveAtt"
        att.Parent = hrp
        local lv = Instance.new("LinearVelocity")
        lv.Name = "NXV_LinearVelocity"
        lv.Attachment0 = att
        lv.RelativeTo = Enum.ActuatorRelativeTo.World
        lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        lv.MaxForce = FX.Cfg.FlyMaxForce
        lv.VectorVelocity = Vector3.zero
        lv.Parent = hrp
        local vf = Instance.new("VectorForce")
        vf.Name = "NXV_VectorForce"
        vf.Attachment0 = att
        vf.RelativeTo = Enum.ActuatorRelativeTo.World
        vf.ApplyAtCenterOfMass = true
        vf.Force = Vector3.zero
        vf.Parent = hrp
        F.att, F.lv, F.vf = att, lv, vf
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and not F.saved then
            F.saved = { ws = hum.WalkSpeed, jp = hum.JumpPower }
        end
        return hrp
    end
    FX.FlyLoop = function()
        local F = FX.Fly
        if F.hb then return end
        local my = F.serial
        F.hb = game:GetService("RunService").Heartbeat:Connect(function(dt)
            if F.serial ~= my then return end
            dt = math.clamp(dt or 0.016, 0.001, 0.05)
            local ok = pcall(function()
                if not shouldTween or not FX.Enable.LinearVelocityFly or not F.target then
                    FX.FlyStop()
                    return
                end
                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if not hrp or not hum or hum.Health <= 0 then FX.FlyStop() return end
                if not F.lv or not F.vf or F.lv.Parent ~= hrp then
                    local keepT, keepS = F.target, F.speed
                    if not FX.FlyEnsure() then return end
                    F.target, F.speed = keepT, keepS
                    FX.FlyLoop()
                    return
                end
                F.vf.Force = Vector3.new(0, hrp.AssemblyMass * workspace.Gravity, 0)
                hum.WalkSpeed = 0
                hum.JumpPower = 0
                hrp.AssemblyAngularVelocity = Vector3.zero
                local clip = hrp:FindFirstChild("BodyClip")
                if clip and clip:IsA("BodyVelocity") and clip.MaxForce ~= Vector3.zero then
                    clip.MaxForce = Vector3.zero
                end
                local delta = F.target.Position - hrp.Position
                local d = delta.Magnitude
                if d <= FX.Cfg.FlyArriveDist then
                    F.smVel = Vector3.zero
                    F.lv.VectorVelocity = Vector3.zero
                    hrp.CFrame = CFrame.new(F.target.Position) * (hrp.CFrame - hrp.CFrame.Position)
                    return
                end
                local spd = d <= 10 and 210 or 200
                F.smVel = F.smVel:Lerp(delta.Unit * spd, math.clamp(dt * FX.Cfg.FlySmooth, 0, 1))
                F.lv.VectorVelocity = F.smVel
            end)
