-- 1. CLASS CHARACTER
local CharacterClass = {}
CharacterClass.__index = CharacterClass

function CharacterClass.new(x, y, z, speed)
    local self = setmetatable({}, CharacterClass)
    self.x, self.y, self.z = x or 0, y or 0, z or 0
    self.speed = speed or 3
    self.currentQuest = nil
    self.moving = false
    return self
end

function CharacterClass:AcceptQuest(quest)
    self.currentQuest = quest
    quest.isActive = true
    self.moving = true
end

-- 2. CLASS MONSTER (ĐÃ CHUYỂN ĐỔI TỪ PYTHON SANG LUA)
local MonsterClass = {}
MonsterClass.__index = MonsterClass

function MonsterClass.new(model)
    if not model or not model:FindFirstChild("Humanoid") or not model:FindFirstChild("HumanoidRootPart") then
        return nil
    end
    local self = setmetatable({}, MonsterClass)
    self.model = model
    self.hrp = model.HumanoidRootPart
    self.humanoid = model.Humanoid
    self.name = model.Name
    self.hp = model.Humanoid.Health
    self.maxHp = model.Humanoid.MaxHealth
    self.level = model:getAttribute("Level") or 1
    self.type = model.Name:find("Boss") and "boss" or "normal" -- "normal", "elite", "boss"
    self.alive = self.hp > 0
    return self
end

function MonsterClass:TakeDamage(dmg)
    if self.humanoid then
        self.humanoid.Health = math.max(0, self.humanoid.Health - dmg)
        self.hp = self.humanoid.Health
        if self.hp <= 0 then self.alive = false end
    end
end

function MonsterClass:IsAlive()
    return self.humanoid and self.humanoid.Health > 0
end

-- 3. CLASS QUEST (ĐÃ CHUYỂN ĐỔI TỪ PYTHON SANG LUA)
local QuestClass = {}
QuestClass.__index = QuestClass

function QuestClass.new(name, targetName, targetType, minLevel, maxLevel, countRequired)
    local self = setmetatable({}, QuestClass)
    self.name = name
    self.targetName = targetName
    self.targetType = targetType
    self.minLevel = minLevel
    self.maxLevel = maxLevel
    self.countRequired = countRequired or 1
    self.countDone = 0
    self.isActive = false
    return self
end

function QuestClass:Matches(monster)
    if not monster or not monster:IsAlive() then return false end
    if self.targetName and not string.find(monster.name, self.targetName) then return false end
    if self.targetType and monster.type ~= self.targetType then return false end
    if self.minLevel and monster.level < self.minLevel then return false end
    if self.maxLevel and monster.level > self.maxLevel then return false end
    return true
end

function QuestClass:IsCompleted()
    return self.countDone >= self.countRequired
end

