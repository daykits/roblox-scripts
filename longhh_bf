    FX.HarpoonAngles = function(harpoonFolder, targetPos)
        local seat = harpoonFolder:FindFirstChild("Seat")
        local baseCFrame
        if seat and seat:FindFirstChild("BoatWeld") and seat.BoatWeld.Part0 then
            baseCFrame = seat.BoatWeld.Part0.CFrame
        elseif seat and seat:IsA("BasePart") then
            baseCFrame = seat.CFrame
        else
            baseCFrame = harpoonFolder:GetPivot()
        end
        local l = baseCFrame:PointToObjectSpace(targetPos)
        local yaw = math.atan2(l.X, -l.Z)
        local x = math.sqrt(l.X ^ 2 + l.Z ^ 2)
        local y = l.Y
        local v, g = 400, workspace.Gravity
        local root = v ^ 4 - g * (g * x ^ 2 + 2 * y * v ^ 2)
        local pitch
        if root >= 0 then
            pitch = math.atan2(v ^ 2 - math.sqrt(root), g * x)
        else
            pitch = math.atan2(y, x)
        end
        return math.clamp(pitch, -0.17453292519943295, 0.7853981633974483), math.clamp(yaw, -1.1344640137963142, 1.1344640137963142)
    end
