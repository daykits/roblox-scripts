Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Quest (Cả 3 Sea)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        if not Value then
            ResetState()
            Fluent:Notify({Title = "Auto Quest", Content = "Đã tắt", Duration = 3})
            return
        end

        Fluent:Notify({Title = "Auto Quest", Content = "Đã bật", Duration = 4})

        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(0.7)
            end
        end)

        task.spawn(function()
            while getgenv().AutoQuest do
                task.wait(0.2)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart
                    local quest = GetCurrentQuest()

                    if not HasQuest() then
                        local dist = (hrp.Position - quest.NPC.Position).Magnitude
                        if dist > 12 then
                            TweenTo(quest.NPC * CFrame.new(0, 0, 3))
                        else
                            StopTween()
                            for i = 1, 6 do
                                pcall(function()
                                    ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", quest.Name, quest.Level)
                                end)
                                task.wait(0.1)
                            end
                            task.wait(1.2)
                        end
                    else
                        local mob = FindMob(quest.Mob)
                        if mob and mob:FindFirstChild("HumanoidRootPart") then
                            local pos = mob.HumanoidRootPart.Position
                            local height = getgenv().FarmDistance or 7
                            TweenTo(CFrame.new(pos + Vector3.new(0, height, 0), pos))
                            pcall(function()
                                mob.HumanoidRootPart.CanCollide = false
                                mob.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                            end)
                        else
                            TweenTo(quest.MobPos)
                        end
                    end
                end)
            end
            ResetState()
        end)
    end
})

