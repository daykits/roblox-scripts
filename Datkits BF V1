Tabs.Main:AddToggle("AutoFarm", {
    Title = "Bật Auto Farm (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoFarm = Value

        if not Value then
            StopTween()
            local char = GetChar()
            if char and char:FindFirstChild("HumanoidRootPart") then
                local bv = char.HumanoidRootPart:FindFirstChild("FlyBV")
                if bv then bv:Destroy() end
            end
            Fluent:Notify({Title="Auto Farm", Content="Đã tắt", Duration=3})
            return
        end

        Fluent:Notify({Title="Auto Farm", Content="Đã bật - Đang farm ổn định", Duration=4})

        -- VÒNG LẶP FARM CHÍNH
        task.spawn(function()
            while getgenv().AutoFarm do
                local success, err = pcall(function()
                    local char = GetChar()
                    if not char then
                        task.wait(1)
                        return
                    end

                    local info = GetQuestInfo()
                    local mob = FindMob(info.Mob)

                    if mob and mob:FindFirstChild("HumanoidRootPart") and mob.Humanoid.Health > 0 then
                        -- Có quái → bay thẳng đến XYZ của quái
                        local pos = mob.HumanoidRootPart.Position
                        local height = getgenv().FarmHeight or 7
                        local farmCF = CFrame.new(pos + Vector3.new(0, height, 0), pos)
                        TweenTo(farmCF)

                        -- Khóa quái
                        pcall(function()
                            mob.HumanoidRootPart.CanCollide = false
                            mob.HumanoidRootPart.AssemblyLinearVelocity = Vector3.zero
                        end)
                    else
                        -- Không có quái
                        if not HasQuest() then
                            -- Chưa có nhiệm vụ → đi nhận
                            local dist = (char.HumanoidRootPart.Position - info.NPC.Position).Magnitude
                            if dist > 10 then
                                TweenTo(info.NPC * CFrame.new(0, 0, 3))
                            else
                                StopTween()
                                for i = 1, 5 do
                                    pcall(function()
                                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", info.Name, info.Level)
                                    end)
                                    task.wait(0.12)
                                end
                                task.wait(1)
                            end
                        else
                            -- Có nhiệm vụ nhưng chưa thấy quái → bay về bãi farm
                            TweenTo(info.MobArea)
                        end
                    end
                end)

                if not success then
                    warn("Farm error:", err)
                end

                task.wait(0.13)
            end
        end)
    end
})

