local function EquipMeleeWeapon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        if currentTool.ToolTip == "Melee" 
        or currentTool:FindFirstChild("Combat") 
        or currentTool.Name:find("Combat") 
        or currentTool.Name:find("Step") 
        or currentTool.Name:find("Karate") 
        or currentTool.Name:find("Dragon") 
        or currentTool.Name:find("Electric") 
        or currentTool.Name:find("God") 
        or currentTool.Name:find("Claw") then
            return currentTool
        end
    end

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == "Melee" 
            or tool:FindFirstChild("Combat") 
            or tool.Name:find("Combat") 
            or tool.Name:find("Step") 
            or tool.Name:find("Karate") 
            or tool.Name:find("Dragon") 
            or tool.Name:find("Electric") 
            or tool.Name:find("God") 
            or tool.Name:find("Claw") then
                char.Humanoid:EquipTool(tool)
                task.wait(0.1)
                return tool
            end
        end
    end

    local firstTool = player.Backpack:FindFirstChildOfClass("Tool")
    if firstTool then
        char.Humanoid:EquipTool(firstTool)
        task.wait(0.1)
        return firstTool
    end
end

local VIM = game:GetService("VirtualInputManager")
local VirtualUser = game:GetService("VirtualUser")

local function ExecuteAttack()
    pcall(function()
        local char = game.Players.LocalPlayer.Character
        if not char then return end
        
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
            VIM:SendMouseButtonEvent(500, 500, 0, true, game, 1)
            VIM:SendMouseButtonEvent(500, 500, 0, false, game, 1)
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(500, 500))

            local net = game:GetService("ReplicatedStorage"):FindFirstChild("Modules") 
                        and game.ReplicatedStorage.Modules:FindFirstChild("Net")
            if net then
                local regAttack = net:FindFirstChild("RE/RegisterAttack")
                if regAttack then regAttack:FireServer() end
            end
        end
    end)
end

MainTab:CreateToggle({
   Name = "Bật Auto Farm bằng Võ (An Toàn Trên Cao)",
   CurrentValue = false,
   Flag = "ToggleFarmMelee",
   Callback = function(Value)
      _G.AutoFarm = Value

      task.spawn(function()
          while _G.AutoFarm do
              task.wait(0.2)
              pcall(function()
                  EquipMeleeWeapon()
                  if game.Players.LocalPlayer.Character then
                      for _, part in pairs(game.Players.LocalPlayer.Character:GetChildren()) do
                          if part:IsA("BasePart") then
                              part.CanCollide = false
                          end
                      end
                  end
              end)
          end
      end)

      task.spawn(function()
          while _G.AutoFarm do
              if _G.FastAttack then
                  task.wait(0.01)
              else
                  task.wait(0.15)
              end
              ExecuteAttack()
          end
      end)

      task.spawn(function()
          while _G.AutoFarm do
              task.wait()
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character or player.CharacterAdded:Wait()
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  if not hrp then return end

                  local nearestMob = nil
                  local minDistance = math.huge
                  
                  if workspace:FindFirstChild("Enemies") then
                      for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                          if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                              local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                              if dist < minDistance then
                                  minDistance = dist
                                  nearestMob = enemy
                              end
                          end
                      end
                  end

                  if nearestMob then
                      local mobPos = nearestMob.HumanoidRootPart.Position
                      local height = _G.FarmDistance or 11
                      hrp.CFrame = CFrame.new(mobPos + Vector3.new(0, height, 0)) * CFrame.Angles(math.rad(-90), 0, 0)
                  end
              end)
          end
      end)
   end,
})

MainTab:CreateSection("Tự Động Nhặt Rương (Từng Cái)")

_G.AutoChest = false

-- Hàm lấy danh sách tất cả rương hiện có
local function GetChests()
    local chests = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
            table.insert(chests, v)
        end
    end
    return chests
end

MainTab:CreateToggle({
   Name = "Bật Auto Chest (Nhặt Từng Rương Mộ)",
   CurrentValue = false,
   Flag = "ToggleChest",
   Callback = function(Value)
      _G.AutoChest = Value
      
      task.spawn(function()
          while _G.AutoChest do
              task.wait(0.1)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character or player.CharacterAdded:Wait()
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  
                  if not hrp then return end

                  -- Bật Noclip khi đi gom rương
                  for _, part in pairs(character:GetChildren()) do
                      if part:IsA("BasePart") then
                          part.CanCollide = false
                      end
                  end

                  local chests = GetChests()

                  if #chests > 0 then
                      -- Sắp xếp rương theo vị trí từ GẦN NHẤT đến XA NHẤT
                      table.sort(chests, function(a, b)
                          return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
                      end)

                      -- Lấy chiếc rương gần nhất
                      local targetChest = chests[1]

                      if targetChest and targetChest:FindFirstChild("TouchInterest") then
                          local timeout = 0
                          
                          -- Dịch chuyển và giữ ở rương cho đến khi rương biến mất (đã nhặt xong)
                          repeat
                              task.wait(0.05)
                              timeout = timeout + 0.05
                              if not _G.AutoChest or not targetChest or not targetChest.Parent or not targetChest:FindFirstChild("TouchInterest") then break end

                              hrp.CFrame = targetChest.CFrame

                              if firetouchinterest then
                                  firetouchinterest(hrp, targetChest, 0)
                                  task.wait(0.02)
                                  firetouchinterest(hrp, targetChest, 1)
                              end
                          until not targetChest or not targetChest.Parent or not targetChest:FindFirstChild("TouchInterest") or timeout > 2 or not _G.AutoChest
                          
                          -- Khoảng nghỉ ngắn 0.1s trước khi nhảy sang rương tiếp theo
                          task.wait(0.1)
                      end
                  else
                      -- Hết rương trên map, chờ 2 giây trước khi quét lại
                      task.wait(2)
                  end
              end)
          end
      end)
   end,
})

