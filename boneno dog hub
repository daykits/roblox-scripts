Tabs.Fish:AddSection("Auto Fishing")

Tabs.Fish:AddToggle("AutoFishToggle", {
    Title = "Auto Fishing",
    Default = false,
    Callback = function(Value) _G.AutoFishing = Value end,
})

task.spawn(function()
    while task.wait(0.5) do
        if _G.AutoFishing then
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool")
                if _G.SelectedRod and (not tool or tool.Name ~= _G.SelectedRod) then
                    local bp = LocalPlayer.Backpack:FindFirstChild(_G.SelectedRod)
                    if bp then
                        char.Humanoid:EquipTool(bp)
                        tool = bp
                    end
                end
                if not tool then return end
                local FishRep = ReplicatedStorage:FindFirstChild("FishReplicated")
                if not FishRep then return end
                local FishingRequest = FishRep:FindFirstChild("FishingRequest")
                if not FishingRequest then return end
                local state = tool:GetAttribute("ServerState")
                if state == "ReeledIn" then
                    FishingRequest:InvokeServer("StartCasting")
                    task.wait(0.1)
                    local pos = char.Head.Position + char.HumanoidRootPart.CFrame.LookVector * 100
                    FishingRequest:InvokeServer("CastLineAtLocation", pos, 100, true)
                elseif state == "Biting" then
                    FishingRequest:InvokeServer("Catching", true)
                    task.wait(0.1)
                    FishingRequest:InvokeServer("Catch", 1)
                end
            end)
        end
    end
end)

