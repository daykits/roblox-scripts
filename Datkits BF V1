-- QUEST DETECTION
-- =========================
local function GetQuestGui()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end

    return pg:FindFirstChild("Main")
end

local function GetQuestState()
    -- Trả về:
    -- active, questName, progressText
    --
    -- Ưu tiên kiểm tra nội dung Quest thay vì chỉ dùng Visible,
    -- vì một số thời điểm UI chưa cập nhật Visible ngay.

    local main = GetQuestGui()
    if not main then
        return false, nil, nil
    end

    local quest = main:FindFirstChild("Quest")
    if not quest then
        return false, nil, nil
    end

    local active = false
    local questName = nil
    local progress = nil

    pcall(function()
        if quest:IsA("GuiObject") and quest.Visible then
            active = true
        end
    end)

    local function scan(obj)
        for _, child in ipairs(obj:GetDescendants()) do
            if child:IsA("TextLabel") or child:IsA("TextButton") then
                local text = tostring(child.Text or "")
                if text ~= "" then
                    local lower = string.lower(text)

                    -- Tên quest thường nằm trong các TextLabel.
                    if not questName and (
                        string.find(lower, "quest", 1, true) or
                        string.find(lower, "defeat", 1, true) or
                        string.find(lower, "kill", 1, true)
                    ) then
                        questName = text
                    end

                    -- Nếu có dạng x/y thì coi như quest đang active.
                    if string.match(text, "%d+/%d+") then
                        progress = text
                        active = true
                    end
                end
            end
        end
    end

    pcall(function()
        scan(quest)
    end)

    return active, questName, progress
end

local function HasQuest()
    local active = GetQuestState()
    return active == true
end

