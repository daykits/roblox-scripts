            local areaData = Sea3Enemies[Sea3State.CurrentIndex]
            if areaData then
                local targetPos = areaData.pos + Vector3.new(0, Config.FarmDistance, 0)
                SetMoveTarget(CFrame.new(targetPos), 3)
                Sea3State.LastTargetPos = areaData.pos
            end
        end)
