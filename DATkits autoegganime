-- Vòng lặp chính xử lý Auto Farm (Có bọc pcall chống dừng luồng)
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.3)
        
        if getgenv().AutoFarm then
            local success, err = pcall(function()
                local character = player.Character
                local rootPart = character and character:FindFirstChild("HumanoidRootPart")
                
                if rootPart then
                    -- 1. Lưu điểm Nhà
                    local homeCFrame = rootPart.CFrame
                    
                    -- 2. Tìm trứng xa nhà
                    local prompt, eggCF = getTargetPrompt(homeCFrame.Position)
                    
                    if prompt and eggCF then
                        -- 3. Teleport tới trứng (nhấp 3 lần để ghim tọa độ)
                        for i = 1, 3 do
                            safeTeleport(eggCF * CFrame.new(0, 3, 0))
                            task.wait(0.05)
                        end
                        task.wait(0.3)
                        
                        -- 4. Kích hoạt nút nhặt trứng
                        if fireproximityprompt then
                            fireproximityprompt(prompt, 0, true)
                            fireproximityprompt(prompt)
                        else
                            prompt:InputHoldBegin()
                            task.wait(prompt.HoldDuration + 0.1)
                            prompt:InputHoldEnd()
                        end
                        task.wait(0.8)
                        
                        -- 5. Cầm trứng lên tay
                        equipTool()
                        task.wait(0.2)
                        
                        -- 6. Teleport trở về Nhà
                        for i = 1, 3 do
                            safeTeleport(homeCFrame)
                            task.wait(0.05)
                        end
                        
                        task.wait(3) -- Chờ trước khi đi quả tiếp theo
                    else
                        Rayfield:Notify({
                            Title = "Đang tìm trứng...",
                            Content = "Không tìm thấy nút nhặt trứng nào ở xa nhà!",
                            Duration = 2,
                            Image = 4483362458
                        })
                        task.wait(2)
                    end
                end
            end)
            
            if not success then
                warn("[AutoFarm Error]: " .. tostring(err))
            end
        end
    end
end)
