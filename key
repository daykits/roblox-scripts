    hint.Text = "💡 Key demo: DATKITS-VIP"
    hint.TextColor3 = Color3.fromRGB(120, 126, 145)
    hint.TextSize = 10; hint.Font = Enum.Font.Gotham
    hint.TextWrapped = true
    hint.TextXAlignment = Enum.TextXAlignment.Left
    hint.ZIndex = 6; hint.Parent = card

    local credits = Instance.new("TextLabel")
    credits.Size = UDim2.new(1, 0, 0, 16)
    credits.Position = UDim2.new(0, 0, 1, -22)
    credits.BackgroundTransparency = 1
    credits.Text = "OnyxHub © 2025"
    credits.TextColor3 = Color3.fromRGB(60, 60, 80)
    credits.TextSize = 9; credits.Font = Enum.Font.Gotham
    credits.ZIndex = 6; credits.Parent = card

    local function TryVerify()
        local input = keyInput.Text
        if input == "" then
            status.Text = "❌ Vui lòng nhập key!"
            status.TextColor3 = Color3.fromRGB(237, 66, 69)
            for _, off in ipairs({8, -8, 4, -4, 0}) do
                Tween(inputBox, {Position = UDim2.new(0.075, off, 0, 105)}, 0.04)
                task.wait(0.04)
            end
            return
        end

        if input == VALID_KEY then
            status.Text = "✅ Key hợp lệ! Đang mở menu..."
            status.TextColor3 = Color3.fromRGB(87, 242, 135)
            verifyText.Text = "✅ THÀNH CÔNG"
            Tween(verifyBtn, {BackgroundColor3 = Color3.fromRGB(87, 242, 135)}, 0.3)
            task.wait(0.8)

            local flash = Instance.new("Frame")
            flash.Size = UDim2.new(1, 0, 1, 0)
            flash.BackgroundColor3 = Color3.fromRGB(88, 101, 242)
            flash.BackgroundTransparency = 1
            flash.BorderSizePixel = 0; flash.ZIndex = 50
            flash.Parent = bg
            Tween(flash, {BackgroundTransparency = 0.4}, 0.2)
            task.wait(0.2)
            Tween(flash, {BackgroundTransparency = 1}, 0.3)

            Tween(card, {Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1}, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
            Tween(bg, {BackgroundTransparency = 1}, 0.5)
            task.wait(0.5)
            gui:Destroy()

            -- 🔥 GỌI MENU CỦA BẠN Ở ĐÂY
            if onSuccess then onSuccess() end
        else
            status.Text = "❌ Key không đúng! Thử lại."
            status.TextColor3 = Color3.fromRGB(237, 66, 69)
            verifyText.Text = "❌ SAI KEY"
            Tween(verifyBtn, {BackgroundColor3 = Color3.fromRGB(180, 40, 40)}, 0.3)
            for _, off in ipairs({10, -10, 6, -6, 3, -3, 0}) do
                Tween(inputBox, {Position = UDim2.new(0.075, off, 0, 105)}, 0.04)
                task.wait(0.04)
            end
            task.wait(1.2)
            verifyText.Text = "🔓 XÁC NHẬN KEY"
            Tween(verifyBtn, {BackgroundColor3 = Color3.fromRGB(88, 101, 242)}, 0.3)
            status.Text = ""
        end
    end

    verifyBtn.MouseButton1Click:Connect(TryVerify)
    keyInput.FocusLost:Connect(function(enter)
        if enter then TryVerify() end
    end)
end

