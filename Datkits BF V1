local function GetQuestData()
    local level = GetLevel()
    local sea   = GetCurrentSea()
    local list  = QuestData[sea] or QuestData[1]

    for _, entry in ipairs(list) do
        if level <= entry.maxLv then
            return entry.quest, entry.lv, entry.mob, entry.npc, entry.spawn
        end
    end
    return nil
end

-------------------------------------------------
-- ENEMY HELPERS
-------------------------------------------------
local function GetClosestEnemies(maxRange, nameFilter)
    local result = {}
    local hrp = GetHRP()
    if not hrp then return result end

    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return result end

    for _, enemy in ipairs(enemiesFolder:GetChildren()) do
        local eHum = enemy:FindFirstChildOfClass("Humanoid")
        local eHrp = enemy:FindFirstChild("HumanoidRootPart")
        if eHum and eHrp and eHum.Health > 0 then
            if not nameFilter or enemy.Name:find(nameFilter, 1, true) then
                local dist = (hrp.Position - eHrp.Position).Magnitude
                if dist <= maxRange then
                    table.insert(result, { enemy = enemy, hrp = eHrp, dist = dist })
                end
            end
        end
    end

    table.sort(result, function(a, b) return a.dist < b.dist end)
    return result
end

local function FreezeEnemy(enemy)
    local hrp = enemy:FindFirstChild("HumanoidRootPart")
    if hrp then
        pcall(function()
            hrp.CanCollide = false
            hrp.Velocity   = Vector3.zero
        end)
    end
end

-------------------------------------------------
-- FAST ATTACK (REDZ STYLE) - OPTIMIZED
-------------------------------------------------
local function GetNet()
    local modules = ReplicatedStorage:FindFirstChild("Modules")
    if not modules then return nil end
    local net = modules:FindFirstChild("Net")
    if not net then return nil end
    return net:FindFirstChild("RE/RegisterAttack"), net:FindFirstChild("RE/RegisterHit")
end

local function DoFastAttack()
    local char = GetCharacter()
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    pcall(function() tool:Activate() end)

    local regAttack, regHit = GetNet()
    if not regAttack then return end

    pcall(function() regAttack:FireServer(0.1) end)

    -- LeftClickRemote (Redz style)
    local lcRemote = tool:FindFirstChild("LeftClickRemote")
    local hits = GetClosestEnemies(Config.HitboxRange)
    local hrp = char.HumanoidRootPart

    if lcRemote then
        local dir = #hits > 0
            and (hits[1].hrp.Position - hrp.Position).Unit
            or Vector3.new(0, -1, 0)
        pcall(function() lcRemote:FireServer(dir, 1) end)
    end

    -- RegisterHit
    if regHit and #hits > 0 then
        for _, data in ipairs(hits) do
            pcall(function()
                regHit:FireServer(data.hrp, { data.enemy })
            end)
        end
    end
end

