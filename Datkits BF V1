-- ==================== CHARACTER ====================
local function GetCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp or hum.Health <= 0 then return nil end
    return char, hum, hrp
end

local function GetLevel()
    local level = 1
    pcall(function()
        local data = LocalPlayer:FindFirstChild("Data")
        local lv = data and data:FindFirstChild("Level")
        if lv then level = tonumber(lv.Value) or 1 end
    end)
    return level
end

local function GetSea()
    local id = game.PlaceId
    if id == 2753915549 then return 1 end
    if id == 4442272183 then return 2 end
    if id == 7449423635 then return 3 end
    return 0
end

local function EquipTool()
    local char, hum = GetCharacter()
    if not char or not hum then return end
    if char:FindFirstChildOfClass("Tool") then return end
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then return end
    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function() hum:EquipTool(tool) end)
            return
        end
    end
end

-- ==================== Noclip ====================
local noclipWanted = false
local collisionCache = setmetatable({}, {__mode = "k"})

local function SetNoclip(enabled)
    if noclipWanted == enabled then return end
    noclipWanted = enabled

    local char = LocalPlayer.Character
    if not char then return end

    if enabled then
        for _, obj in ipairs(char:GetDescendants()) do
            if obj:IsA("BasePart") then
                collisionCache[obj] = obj.CanCollide
                obj.CanCollide = false
            end
        end
    else
        for part, oldValue in pairs(collisionCache) do
            if part and part.Parent then
                pcall(function() part.CanCollide = oldValue end)
            end
            collisionCache[part] = nil
        end
    end
end

-- ==================== ONE MOVEMENT CONTROLLER ====================
local movement = {
    enabled = false,
    target = nil,
    speed = 0,
    tolerance = 5,
    mode = "none",
    lastTargetUpdate = 0,
    sequence = 0,
    savedAutoRotate = nil,
    physicsState = false
}

local function StopMovement()
    movement.sequence += 1
    movement.enabled = false
    movement.target = nil
    movement.speed = 0
    movement.mode = "none"
    movement.lastTargetUpdate = 0

    local char, hum, hrp = GetCharacter()
    if hum then
        if movement.savedAutoRotate ~= nil then
            hum.AutoRotate = movement.savedAutoRotate
            movement.savedAutoRotate = nil
        end
        if movement.physicsState then
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            movement.physicsState = false
        end
    end
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    SetNoclip(false)
end

local function MoveTo(targetCF, tolerance, speed, mode)
    local char, hum, hrp = GetCharacter()
    if not char or not hum or not hrp or not targetCF then return false end

    tolerance = tonumber(tolerance) or 5
    speed = tonumber(speed) or 140

    local shouldRefresh = false
    if not movement.enabled or movement.target == nil then
        shouldRefresh = true
    elseif (movement.target.Position - targetCF.Position).Magnitude >= 2.5 then
        shouldRefresh = true
    elseif movement.mode ~= (mode or "farm") then
        shouldRefresh = true
    end

    if shouldRefresh then
        movement.sequence += 1
        movement.target = targetCF
        movement.speed = speed
        movement.tolerance = tolerance
        movement.mode = mode or "farm"
        movement.enabled = true
        movement.lastTargetUpdate = os.clock()
    else
        movement.speed = speed
        movement.tolerance = tolerance
    end

    if movement.savedAutoRotate == nil then
        movement.savedAutoRotate = hum.AutoRotate
    end
    hum.AutoRotate = false
    SetNoclip(true)

    if not movement.physicsState then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
        movement.physicsState = true
    end

    return true
end

RunService.Heartbeat:Connect(function(dt)
    if not movement.enabled then return end

    local char, hum, hrp = GetCharacter()
    if not char or not hum or not hrp or not movement.target then
        StopMovement()
        return
    end

    local target = movement.target
    local delta = target.Position - hrp.Position
    local distance = delta.Magnitude

    if distance <= movement.tolerance then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        movement.enabled = false
        return
    end

    local direction = delta.Unit
    local maxStep = math.max(0.5, movement.speed * math.min(dt, 0.05))
    local velocity = direction * movement.speed

    -- Physics-driven movement; never recreate a tween and never snap to the target.
    hrp.AssemblyLinearVelocity = velocity

    -- Keep a stable facing direction without changing position.
    pcall(function()
        local flat = Vector3.new(direction.X, 0, direction.Z)
        if flat.Magnitude > 0.01 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat)
        end
    end)

    -- Safety: if the velocity is blocked for a long time, briefly re-issue it.
    if maxStep < 0 then
        movement.enabled = false
    end
end)

