-- DI CHUYỂN ỔN ĐỊNH
-- Không dùng BodyVelocity cùng lúc với TweenService vì hai cơ chế này tranh quyền điều khiển HRP,
-- gây khựng/giật và thường làm vòng farm mất mục tiêu.
local function TweenTo(targetCF)
    local char = GetChar()
    if not char then return false end

    local hrp = char.HumanoidRootPart
    local distance = (hrp.Position - targetCF.Position).Magnitude

    if distance <= 5 then
        StopTween()
        hrp.CFrame = targetCF
        return true
    end

    if currentTargetPos and (currentTargetPos - targetCF.Position).Magnitude < 5 then
        return false
    end

    currentTargetPos = targetCF.Position

    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end

    local speed = math.max(100, getgenv().TweenSpeed or 300)
    local duration = math.max(0.08, distance / speed)

    currentTween = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        {CFrame = targetCF}
    )

    currentTween:Play()

    currentTween.Completed:Connect(function()
        currentTween = nil
        currentTargetPos = nil
    end)

    return false
end

local function EquipTool()
    local char = GetChar()
    if not char then return end
    if char:FindFirstChildOfClass("Tool") then return end

    for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") and (tool.ToolTip == "Melee" or tool.ToolTip == "Sword" or tool.ToolTip == "Blox Fruit") then
            pcall(function()
                char.Humanoid:EquipTool(tool)
            end)
            break
        end
    end
end

local function HasQuest()
    local hasQ = false
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local main = pg and pg:FindFirstChild("Main")
        local quest = main and main:FindFirstChild("Quest")
        if quest then
            if quest.Visible then
                hasQ = true
            end
            -- Some UI versions keep the quest frame mounted while changing its contents.
            if not hasQ then
                for _, obj in ipairs(quest:GetDescendants()) do
                    if obj:IsA("TextLabel") and obj.Visible and obj.Text ~= "" then
                        local s = string.lower(obj.Text)
                        if string.find(s, "defeat", 1, true)
                           or string.find(s, "kill", 1, true)
                           or string.find(s, "0/", 1, true) then
                            hasQ = true
                            break
                        end
                    end
                end
            end
        end
    end)
    return hasQ
end

