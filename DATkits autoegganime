-- Hàm Dịch chuyển an toàn
local function safeTeleport(cframe)
    local player = game.Players.LocalPlayer
    local character = player.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        local root = character.HumanoidRootPart
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(cframe)
    end
end

-- Hàm thực hiện giữ nút E nhặt trứng
local function holdEPickup()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local parent = prompt.Parent
            if parent then
                local promptPos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position or nil)
                if promptPos and (promptPos - root.Position).Magnitude < 30 then
                    pcall(function()
                        if fireproximityprompt then
                            fireproximityprompt(prompt, 0, true)
                        end
                        prompt:InputHoldBegin()
                    end)
                    
                    -- Đứng giữ nút E khoảng 3.5 giây
                    task.wait(3.5)
                    
                    pcall(function()
                        prompt:InputHoldEnd()
                        if fireproximityprompt then
                            fireproximityprompt(prompt)
                        end
                    end)
                    break
                end
            end
        end
    end
end

-- Hàm kiểm tra và cầm trứng lên tay
local function equipEggTool()
    local player = game.Players.LocalPlayer
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = player:FindFirstChild("Backpack")

    -- Kiểm tra xem trên tay đã cầm vật phẩm chưa
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                return true
            end
        end
    end

    -- Nếu chưa cầm, tự động lấy vật phẩm từ Backpack ra tay
    if humanoid and backpack then
        local tool = backpack:FindFirstChildOfClass("Tool")
        if tool then
            humanoid:EquipTool(tool)
            return true
        end
    end

    return false
end

