local function FindBoss(bossName)
    local found = {}
    local seen = {}

    local function tryAdd(obj)
        if not obj or seen[obj] then return end
        local hum = obj:FindFirstChildOfClass("Humanoid")
        local hrp = obj:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then
            seen[obj] = true
            table.insert(found, { boss = obj, hum = hum, hrp = hrp })
        end
    end

    local function cleanName(objName)
        local cleaned = objName
        cleaned = cleaned:gsub("%[Lv%.?%s*%d+%]", "")
        cleaned = cleaned:gsub("%[Boss%d*%]", "")
        cleaned = cleaned:gsub("%[Raid%d*%]", "")
        cleaned = cleaned:gsub("%[Elite%d*%]", "")
        cleaned = cleaned:gsub("%[Event%d*%]", "")
        cleaned = cleaned:gsub("^%s+", ""):gsub("%s+$", "")
        cleaned = cleaned:gsub("%s+", " ")
        return cleaned
    end

    local function isNameMatch(objName)
        if objName == bossName then return true end
        local cleaned = cleanName(objName)
        if cleaned == bossName then return true end
        if cleaned:lower() == bossName:lower() then return true end
        if #bossName >= 4 and cleaned:lower():find(bossName:lower(), 1, true) then
            return true
        end
        return false
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if isNameMatch(obj.Name) then tryAdd(obj) end
    end

    local foldersToSearch = { "Enemies", "Bosses", "Characters", "NPCs", "Mobs", "SpawnedBosses" }
    for _, folderName in ipairs(foldersToSearch) do
        local folder = workspace:FindFirstChild(folderName)
        if folder then
            for _, obj in ipairs(folder:GetChildren()) do
                if isNameMatch(obj.Name) then tryAdd(obj) end
                if obj:IsA("Folder") or obj:IsA("Model") then
                    for _, sub in ipairs(obj:GetChildren()) do
                        if isNameMatch(sub.Name) then tryAdd(sub) end
                    end
                end
            end
        end
    end

    return found
end

local function FindAllBossesInRange(maxRange, filterBossName)
    local result = {}
    local hrp = GetHRP()
    if not hrp then return result end
    local sea = GetCurrentSea()
    local bossList = GetBossListBySea(sea)
    for _, bossInfo in ipairs(bossList) do
        if not filterBossName or bossInfo.name == filterBossName then
            local bosses = FindBoss(bossInfo.name)
            for _, b in ipairs(bosses) do
                local dist = (hrp.Position - b.hrp.Position).Magnitude
                if dist <= maxRange then
                    table.insert(result, {
                        boss = b.boss, hum = b.hum, hrp = b.hrp,
                        dist = dist, info = bossInfo,
                    })
                end
            end
        end
    end
    table.sort(result, function(a, b) return a.dist < b.dist end)
    return result
end

