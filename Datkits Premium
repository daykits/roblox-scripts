local lastScanTime = 0
local cachedTarget = nil
local cachedMobName = nil

local function FindBestMob(mobName, maxDistance)
    maxDistance = maxDistance or 350
    local char = GetCharacter()
    if not char then return nil end

    local hrp = char.HumanoidRootPart
    local currentTime = tick()

    -- Cache 0.35s giảm lag
    if cachedTarget and cachedTarget.Parent and cachedTarget:FindFirstChild("Humanoid")
       and cachedTarget.Humanoid.Health > 0
       and cachedMobName == mobName
       and (currentTime - lastScanTime) < 0.35 then

        local dist = (hrp.Position - cachedTarget.HumanoidRootPart.Position).Magnitude
        if dist <= maxDistance then
            return cachedTarget
        end
    end

    local bestMob = nil
    local shortestDistance = maxDistance
    local enemiesFolder = workspace:FindFirstChild("Enemies")
    if not enemiesFolder then return nil end

    local lowerMobName = mobName:lower()

    for _, enemy in pairs(enemiesFolder:GetChildren()) do
        if enemy:IsA("Model")
        and enemy:FindFirstChild("Humanoid")
        and enemy.Humanoid.Health > 0
        and enemy:FindFirstChild("HumanoidRootPart") then

            local enemyName = enemy.Name:lower()

            local isCorrectMob =
                enemyName:find(lowerMobName)
                or (lowerMobName == "raider" and (enemyName:find("raider") or enemyName:find("kẻ tập kích")))
                or (lowerMobName == "mercenary" and (enemyName:find("mercenary") or enemyName:find("lính đánh thuê")))
                or (lowerMobName == "swan pirate" and enemyName:find("swan"))
                or (lowerMobName == "factory staff" and enemyName:find("factory"))
                or (lowerMobName == "marine lieutenant" and enemyName:find("lieutenant"))
                or (lowerMobName == "marine captain" and enemyName:find("captain"))
                or (lowerMobName == "zombie" and enemyName:find("zombie"))
                or (lowerMobName == "vampire" and enemyName:find("vampire"))

            if isCorrectMob then
                local distance = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                if distance < shortestDistance then
                    shortestDistance = distance
                    bestMob = enemy
                end
            end
        end
    end

    cachedTarget = bestMob
    cachedMobName = mobName
    lastScanTime = currentTime

    return bestMob
end

