Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Quest (Spatial Grid + Finder Engine)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        ToggleNoclip(Value)

        if not Value then
            isGoingToFarmArea = false
            ResetCharacterState()
            return
        end

        getgenv().AutoFarm = false
        getgenv().AutoChest = false

        -- Equip vũ khí
        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(0.8)
            end
        end)

        -- Vòng lặp Auto Quest đã sửa
        task.spawn(function()
            while getgenv().AutoQuest do
                task.wait(0.12)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart

                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()
                    local currentQuestObj = QuestClass.new(questName, mobName)

                    if not HasQuest() then
                        -- Chưa có nhiệm vụ → đi nhận
                        isGoingToFarmArea = false
                        if npcCFrame then
                            local dist = (hrp.Position - npcCFrame.Position).Magnitude
                            if dist > 9 then
                                TweenTo(npcCFrame * CFrame.new(0, 0, 2.5), 260)
                            else
                                StopTween()
                                for i = 1, 4 do
                                    pcall(function()
                                        ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                    end)
                                    task.wait(0.15)
                                end
                                task.wait(1.2)
                            end
                        end
                    else
                        -- Đã có nhiệm vụ
                        local target = globalMonsterFinder:FindBestTarget(hrp.Position, currentQuestObj, 6000, getgenv().TargetPrioritize)

                        if target and target:IsAlive() then
                            -- Có quái → bay đến đầu quái
                            isGoingToFarmArea = false
                            local pos = target.hrp.Position
                            local farmCF = CFrame.new(pos + Vector3.new(0, getgenv().FarmDistance or 6, 0), pos)
                            TweenTo(farmCF, 260)

                            pcall(function()
                                target.hrp.CanCollide = false
                                target.hrp.AssemblyLinearVelocity = Vector3.zero
                            end)
                        else
                            -- Không thấy quái → BẮT BUỘC bay đến bãi farm
                            if mobCFrame then
                                isGoingToFarmArea = true
                                TweenTo(mobCFrame, 260)
                            end
                        end
                    end
                end)
            end
            isGoingToFarmArea = false
            ResetCharacterState()
        end)
    end
})

