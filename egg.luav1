local KavoLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/xHeptc/Kavo-UI-Library/main/source.lua"))()
local Window = KavoLib.CreateLib("datdaykits Premium Hub", "DarkTheme")

local MainTab = Window:NewTab("Main")
local MainSection = MainTab:NewSection("Auto Steal Eggs")

getgenv().AutoSteal = false
getgenv().TweenSpeed = 70
local LocalPlayer = game:GetService("Players").LocalPlayer

local function startEggStealer()
    local TweenService = game:GetService("TweenService")
    
    task.spawn(function()
        while getgenv().AutoSteal do
            local Character = LocalPlayer.Character
            local HumanoidRootPart = Character and Character:FindFirstChild("HumanoidRootPart")

            if HumanoidRootPart then
                -- Quét toàn bộ workspace để tìm bất kỳ vật thể nào có tên chứa chữ "Egg"
                for _, obj in pairs(workspace:GetDescendants()) do
                    if not getgenv().AutoSteal then break end

                    -- Kiểm tra xem tên vật thể có chữ Egg (không phân biệt hoa thường)
                    if string.find(string.lower(obj.Name), "egg") then
                        local targetPart = nil

                        if obj:IsA("BasePart") then
                            targetPart = obj
                        elseif obj:IsA("Model") and obj.PrimaryPart then
                            targetPart = obj.PrimaryPart
                        elseif obj:IsA("Model") then
                            targetPart = obj:FindFirstChildWhichIsA("BasePart")
                        end

                        if targetPart then
                            local distance = (HumanoidRootPart.Position - targetPart.Position).Magnitude
                            
                            -- Giới hạn khoảng cách hợp lý để tránh bị lỗi nhảy vị trí quá xa
                            if distance > 2 and distance < 2000 then
                                local tweenInfo = TweenInfo.new(distance / getgenv().TweenSpeed, Enum.EasingStyle.Linear)
                                local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = targetPart.CFrame})

                                tween:Play()
                                tween.Completed:Wait()
                                task.wait(0.2) -- Thời gian dừng lại 0.2s để game nhận diện đã nhặt trứng
                            end
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end)
end

MainSection:NewToggle("Auto Steal", "Tự động nhặt trứng", function(state)
    getgenv().AutoSteal = state
    if state then
        startEggStealer()
    end
end)

MainSection:NewKeybind("e", "g", Enum.KeyCode.RightControl, function()
    KavoLib:ToggleUI()
end)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")

-- Tạo RemoteEvent nếu chưa có
local stealEvent = ReplicatedStorage:FindFirstChild("AutoStealEvent") or Instance.new("RemoteEvent", ReplicatedStorage)
stealEvent.Name = "AutoStealEvent"

local GAME_PASS_ID = 123456789 -- Thay ID Game Pass của bạn vào đây

stealEvent.OnServerEvent:Connect(function(player, egg)
    -- 1. Kiểm tra điều kiện
    if not egg or not egg:IsA("BasePart") and not (egg:IsA("Model") and egg.PrimaryPart) then return end
    
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- 2. Kiểm tra Game Pass (Mất Robux)
    local hasPass = false
    pcall(function()
        hasPass = MarketplaceService:UserOwnsGamePassAsync(player.UserId, GAME_PASS_ID)
    end)

    if not hasPass then
        MarketplaceService:PromptGamePassPurchase(player, GAME_PASS_ID)
        return
    end

    -- 3. Tốc độ dịch chuyển TỨC THỜI (Lưu vị trí cũ -> Teleport -> Trở về)
    local savedCFrame = hrp.CFrame
    local targetCFrame = egg:IsA("BasePart") and egg.CFrame or egg.PrimaryPart.CFrame

    -- Dịch chuyển tới trứng ngay lập tức (0 giây)
    hrp.CFrame = targetCFrame + Vector3.new(0, 2, 0)

    -- 4. Ép kích hoạt cơ chế nhặt trứng
    -- Cách A: Nếu trứng dùng ProximityPrompt (Phím E)
    local prompt = egg:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        fireproximityprompt(prompt)
    end

    -- Cách B: Gọi thẳng RemoteEvent nhặt trứng của game (nếu game bạn có Event riêng)
    local giveEggEvent = ReplicatedStorage:FindFirstChild("GiveEgg") or ReplicatedStorage:FindFirstChild("ClaimEgg")
    if giveEggEvent and giveEggEvent:IsA("RemoteEvent") then
        giveEggEvent:FireServer(egg)
    end

    -- Dừng 0.1s ngắn để Server nhận thông tin
    task.wait(0.1)

    -- Quay về vị trí ban đầu tức thời
    hrp.CFrame = savedCFrame
end)
