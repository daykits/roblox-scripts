    subtitle.TextSize = 11; subtitle.Font = Enum.Font.GothamBold
    subtitle.ZIndex = 6; subtitle.Parent = card

    local inputBox = Instance.new("Frame")
    inputBox.Size = UDim2.new(0.85, 0, 0, 42)
    inputBox.Position = UDim2.new(0.075, 0, 0, 105)
    inputBox.BackgroundColor3 = Color3.fromRGB(12, 12, 22)
    inputBox.ZIndex = 6; inputBox.Parent = card
    Corner(inputBox, 10)
    Stroke(inputBox, Color3.fromRGB(52, 52, 78), 1, 0.3)

    local keyInput = Instance.new("TextBox")
    keyInput.Size = UDim2.new(1, -20, 1, 0)
    keyInput.Position = UDim2.new(0, 10, 0, 0)
    keyInput.BackgroundTransparency = 1
    keyInput.Text = ""
    keyInput.PlaceholderText = "Nhập key tại đây..."
    keyInput.TextColor3 = Color3.fromRGB(245, 245, 255)
