    local function fmtVal(it)
        local v = it.rec.Value
        if it.type == "Toggle" then
            return v == true and "on" or "off"
        elseif it.type == "Dropdown" then
            if type(v) == "table" then
                local o = { }
                for _, x in ipairs(v) do
                    o[#o + 1] = valueText(x)
                end
                return table.concat(o, ",")
            end
            return tostring(v)
        elseif it.type == "Button" then
            return "-"
        end
        return tostring(v)
    end
    local function lookup(arg, want)
        local it, list = resolve(norm(arg), want)
        if it then
            return it
        end
        if #list == 0 then
            LX.Out("err", "not found: " .. asc(arg))
        else
            LX.Out("warn", "ambiguous, try one of:")
            for i = 1, math.min(#list, 4) do
                LX.Out("out", "  " .. short(list[i].it))
            end
        end
        return nil
    end
    local HELP = {
        "help               this list",
        "ls [tab]           list controls (auto registry)",
        "ps                 toggles that are on",
        "find <text>        search controls",
        "get <name>         show a value",
        "on|off <name>      toggle   (on|off all)",
        "set <name> <n>     slider / input",
        "sel <name> <val>   dropdown",
        "press <name>       button",
        "timer <min>  watch [lap|reset]",
        "theme [name]  face [name]  jump  spin",
        "open <tab>  tab <tab>  music [play|pause|next|prev|stop]",
        "perm [name on|off]  fps  ping  time  clear",
    }
    function LX.Exec(line)
        if not need("Shell", "shell") then
            LX.Say("Shell đang bị khóa. Bật lại trong Setting.", "annoyed")
            return
        end
        line = tostring(line or "")
        line = string.gsub(line, "^%s+", "")
        line = string.gsub(line, "%s+$", "")
        LX.Out("cmd", "$ " .. line)
        local w = words(line)
        local cmd = string.lower(asc(w[1] or ""))
        local rest = table.concat(w, " ", 2)
        if cmd == "help" or cmd == "" then
            for _, l in ipairs(HELP) do
                LX.Out("out", l)
            end
        elseif cmd == "open" or cmd == "tab" then
            LX.DoOpenTab(rest)
        elseif cmd == "music" or cmd == "nhac" then
            local args = words(rest)
            local act = norm(args[1] or "play")
            local query = table.concat(args, " ", 2)
            if act == "next" then
                act = "next"
            elseif act == "prev" or act == "previous" then
                act = "prev"
            elseif act == "pause" or act == "stop" or act == "resume" or act == "play" or act == "random"
                or act == "shuffle" or act == "find" or act == "search" or act == "select" then
            else
                query = rest
                act = "find"
            end
            LX.DoMusic(act, query)
        elseif cmd == "clear" then
            LX.Lines = { }
            LX.Ver = LX.Ver + 1
        elseif cmd == "ls" then
            local want = norm(rest)
            local n = 0
            for _, it in ipairs(buildReg()) do
                if want == "" or string.find(norm(it.tab or ""), want, 1, true) or string.find(it.nt, want, 1, true) then
                    n = n + 1
                    if n <= 14 then
                        LX.Out("out", string.format("%-9s %s = %s", string.sub(string.lower(it.type), 1, 8), string.sub(short(it), 1, 26), string.sub(fmtVal(it), 1, 14)))
                    end
                end
            end
            LX.Out("dim", n .. " controls" .. (n > 14 and " (showing 14, narrow with ls <tab>)" or ""))
        elseif cmd == "ps" then
            local n = 0
            for _, it in ipairs(buildReg()) do
                if it.type == "Toggle" and it.rec.Value == true then
                    n = n + 1
                    if n <= 14 then
                        LX.Out("out", "  on  " .. short(it))
                    end
                end
            end
            LX.Out("dim", n .. " running")
        elseif cmd == "find" then
            local _, list = resolve(norm(rest), nil)
            for i = 1, math.min(#list, 8) do
                LX.Out("out", string.format("%-9s %s", string.lower(list[i].it.type), short(list[i].it)))
            end
            LX.Out("dim", #list .. " match")
        elseif cmd == "get" then
            local it = lookup(rest, nil)
            if it then
                LX.Out("out", short(it) .. " = " .. fmtVal(it))
            end
        elseif cmd == "on" or cmd == "off" then
            local on = cmd == "on"
            if norm(rest) == "all" or norm(rest) == "het" then
                LX.DoAll(on)
            else
                local it = lookup(rest, { Toggle = true })
                if it then
                    LX.DoToggle(it, on)
                end
            end
        elseif cmd == "set" then
            local num = string.match(rest, "(%-?%d+%.?%d*)%s*$")
            local name = num and string.gsub(rest, "%-?%d+%.?%d*%s*$", "") or rest
            name = string.gsub(name, "=", " ")
            local it = lookup(name, { Slider = true, Input = true })
            if it then
                if it.type == "Slider" then
                    if num then
                        LX.DoSlider(it, tonumber(num))
                    else
                        LX.Out("err", "need a number")
                    end
                else
                    LX.DoInput(it, num or string.match(rest, "=%s*(.+)$") or "")
                end
            end
        elseif cmd == "sel" then
            local it, list = resolve(norm(rest), { Dropdown = true })
            if not it then
                lookup(rest, { Dropdown = true })
            else
                local val = rest
                for _, tk in ipairs(it.toks) do
                    val = string.gsub(val, "%f[%w]" .. esc(tk) .. "%f[%W]", "", 1)
                end
                val = norm(val)
                if val == "" then
                    LX.Out("out", short(it) .. " = " .. fmtVal(it))
                    local o = { }
                    for _, v in ipairs(it.rec.Values or { }) do
                        o[#o + 1] = string.lower(asc(valueText(v)))
                    end
                    LX.Out("dim", "options: " .. string.sub(table.concat(o, ", "), 1, 90))
                else
                    LX.DoDropdown(it, val)
                end
            end
        elseif cmd == "press" then
            local it = lookup(rest, { Button = true })
            if it then
                LX.DoPress(it)
            end
        elseif cmd == "timer" then
            local n = tonumber(string.match(rest, "%d+%.?%d*"))
            if n then
                LX.DoTimer(n)
            else
                LX.DoWatch("stoptimer")
            end
        elseif cmd == "watch" then
            LX.DoWatch(norm(rest) ~= "" and norm(rest) or "toggle")
        elseif cmd == "theme" then
            if rest == "" then
                LX.Out("out", string.lower(table.concat(LX.ThemeList(), ", ")))
            else
                LX.DoTheme(rest)
            end
        elseif cmd == "face" then
            local f = norm(rest)
            local map = { cold = "cold", lanh = "cold", bored = "bored", chan = "bored", deadpan = "deadpan" }
            if map[f] then
                LX.Face = map[f]
                LX.SetMood(LX.Face)
                LX.Out("ok", "face = " .. LX.Face)
            else
                LX.Out("out", "face = " .. LX.Face .. "   (cold | bored | deadpan)")
            end
        elseif cmd == "jump" then
            LX.DoJump()
        elseif cmd == "spin" then
            LX.DoSpin()
        elseif cmd == "perm" then
            local k = permKey(norm(rest))
            local on = has(norm(rest), "on")
            local off = has(norm(rest), "off")
            if k and (on or off) then
                LX.SetPerm(k, on)
            else
                LX.Out("out", LX.PermText())
            end
        elseif cmd == "fps" then
            local dt = game:GetService("RunService").RenderStepped:Wait()
            LX.Out("out", string.format("%d fps", math.floor(1 / math.max(dt, 0.001) + 0.5)))
        elseif cmd == "ping" then
            local p = 0
            pcall(function()
                p = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
            end)
            LX.Out("out", p .. " ms")
        elseif cmd == "time" then
            LX.Out("out", os.date("%H:%M:%S  %d/%m/%Y"))
        elseif cmd == "history" then
            local n = 0
            for i = math.max(1, #LX.Chat - 6), #LX.Chat do
                local m = LX.Chat[i]
                n = n + 1
                LX.Out("out", (m.role == "user" and "> " or "< ") .. string.sub(asc(m.text), 1, 40))
            end
            LX.Out("dim", n .. " lines")
        elseif cmd == "echo" or cmd == "say" then
            LX.Out("out", rest)
            if cmd == "say" then
                LX.Say(rest)
            end
        elseif cmd == "whoami" then
            LX.Out("out", "longxgen")
        elseif cmd == "uname" then
            LX.Out("out", "longxgen 1.0 deadpan #" .. #buildReg() .. " controls")
        else
            LX.Out("err", "command not found: " .. cmd .. "  (help)")
        end
    end

