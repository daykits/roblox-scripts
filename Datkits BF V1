    Description = "Chuyển sang khu vực Sea 3 kế tiếp",
    Callback    = function()
        Sea3State.CurrentIndex = Sea3State.CurrentIndex + 1
        if Sea3State.CurrentIndex > #Sea3Enemies then
            Sea3State.CurrentIndex = 1
        end

        local areaData = Sea3Enemies[Sea3State.CurrentIndex]
        if areaData and Config.AutoSea3Farm then
            local targetPos = areaData.pos + Vector3.new(0, Config.FarmDistance, 0)
            SetMoveTarget(CFrame.new(targetPos))
        end

        Fluent:Notify({
            Title    = "Sea 3",
            Content  = "Chuyển tới: " .. (areaData and areaData.name or "?"),
            Duration = 3,
        })
    end,
})

Tabs.Sea3:AddButton({
    Title       = "Reset về khu vực 1",
    Description = "Quay lại khu vực đầu tiên của Sea 3",
    Callback    = function()
        Sea3State.CurrentIndex = 1
        Sea3State.StuckCounter = 0
        Sea3State.LastTargetPos = nil

        Fluent:Notify({
            Title    = "Sea 3",
            Content  = "Đã reset về khu vực 1",
            Duration = 3,
        })
    end,
})

