-- Hàm kiểm tra xem đã có Quest chưa
local function HasQuest()
    local player = game.Players.LocalPlayer
    if player and player:FindFirstChild("PlayerGui") and player.PlayerGui:FindFirstChild("Main") then
        local questGui = player.PlayerGui.Main:FindFirstChild("Quest")
        if questGui and questGui.Visible then
            return true
        end
    end
    return false
end

-- Hàm trang bị Vũ Khí / Võ an toàn
local function EquipMeleeWeapon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char or not char:FindFirstChild("Humanoid") then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        return currentTool
    end

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == "Melee" 
            or tool:FindFirstChild("Combat") 
            or tool.Name:find("Combat") 
            or tool.Name:find("Step") 
            or tool.Name:find("Karate") 
            or tool.Name:find("Dragon") 
            or tool.Name:find("Electric") 
            or tool.Name:find("God") 
            or tool.Name:find("Claw") then
                char.Humanoid:EquipTool(tool)
                task.wait(0.1)
                return tool
            end
        end
    end

    local anyTool = player.Backpack:FindFirstChildOfClass("Tool")
    if anyTool then
        char.Humanoid:EquipTool(anyTool)
        task.wait(0.1)
        return anyTool
    end
end

-- HỆ THỐNG DI CHUYỂN BAY MƯỢT (TWEEN SERVICE)
local TweenService = game:GetService("TweenService")
local currentTween = nil
local lastTargetPos = nil

local function StopTween()
    if currentTween then
        currentTween:Cancel()
        currentTween = nil
    end
    lastTargetPos = nil
end

-- Hàm dọn dẹp thuộc tính nhân vật khi tắt tính năng (Khôi phục di chuyển bình thường)
local function ResetCharacterState()
    StopTween()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if char then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, v in pairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") or v.Name == "FarmFlyBV" or v.Name == "ChestFlyBV" then
                    v:Destroy()
                end
            end
        end
    end
end

local function TweenTo(targetCFrame, speed)
    speed = speed or 250
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Noclip
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    -- Tạo lực nâng giữ vị trí
    local bv = hrp:FindFirstChild("FarmFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmFlyBV"
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp
    end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    if distance <= 2 then
        StopTween()
        hrp.CFrame = targetCFrame
        return
    end

    if not currentTween or not lastTargetPos or (lastTargetPos - targetCFrame.Position).Magnitude > 2 then
        lastTargetPos = targetCFrame.Position
        if currentTween then currentTween:Cancel() end
        
        local duration = distance / speed
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        currentTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        currentTween:Play()
    end
end

