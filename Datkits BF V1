local function GetQuestInfo()
    local sea = GetSea()
    local level = GetLevel()
    for _, q in ipairs(QuestData) do
        if q[3] == sea and level >= q[1] and level <= q[2] then
            return {
                MinLevel=q[1], MaxLevel=q[2], Sea=q[3],
                QuestName=q[4], QuestNumber=q[5], Mob=q[6],
                QuestCFrame=q[7], MobCFrame=q[8]
            }
        end
    end
    return nil
end

-- ==================== QUEST CHECK ====================
local function HasQuest()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    local main = gui and gui:FindFirstChild("Main")
    local quest = main and main:FindFirstChild("Quest")
    if not quest then return false end

    local visible = false
    pcall(function() visible = quest.Visible end)
    if visible then return true end

    local foundProgress = false
    for _, obj in ipairs(quest:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text or ""
            if text:find("%d+/%d+") then
                foundProgress = true
                break
            end
        end
    end
    return foundProgress
end

local lastQuestStart = 0
local function StartQuest(info)
    if not info then return false end
    if os.clock() - lastQuestStart < 1.4 then return false end
    lastQuestStart = os.clock()

    local ok = false
    pcall(function()
        CommF:InvokeServer("StartQuest", info.QuestName, info.QuestNumber)
        ok = true
    end)
    return ok
end

local function EnsureQuest(info)
    local char, _, hrp = GetCharacter()
    if not char or not hrp or not info then return end

    if HasQuest() then return end

    local target = info.QuestCFrame * CFrame.new(0, 0, 5)
    local distance = (hrp.Position - target.Position).Magnitude
    if distance > 9 then
        MoveTo(target, 7, getgenv().MoveSpeed, "quest")
        return
    end

    StopMovement()
    StartQuest(info)
end

-- ==================== MOB SEARCH ====================
local function FindBestMob(info)
    if not info then return nil end
    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local char, _, hrp = GetCharacter()
    if not char or not hrp then return nil end

    local expected = info.MobCFrame.Position
    local nameLower = string.lower(info.Mob)
    local best, bestScore = nil, math.huge

    for _, enemy in ipairs(enemies:GetChildren()) do
        local hum = enemy:FindFirstChildOfClass("Humanoid")
        local root = enemy:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            local enemyName = string.lower(enemy.Name)
            if enemyName == nameLower or enemyName:find(nameLower, 1, true) then
                local fromFarm = (root.Position - expected).Magnitude
                if fromFarm <= 900 then
                    local fromPlayer = (root.Position - hrp.Position).Magnitude
                    local score = fromFarm * 1.15 + fromPlayer * 0.08
                    if score < bestScore then
                        bestScore = score
                        best = enemy
                    end
                end
            end
        end
    end
    return best
end

local function GetFarmTarget(mob)
    local root = mob and mob:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local height = tonumber(getgenv().FarmHeight) or 8
    local pos = root.Position + Vector3.new(0, height, 0)
    return CFrame.lookAt(pos, root.Position)
end

