local function EquipWeapon(category)
    local char = LocalPlayer.Character
    if not char then return end

    category = category or "Melee"
    local toolInHand = char:FindFirstChildOfClass("Tool")

    if toolInHand then
        if category == "Melee" and toolInHand.ToolTip == "Melee" then return end
        if category == "Sword" and toolInHand.ToolTip == "Sword" then return end
        if category == "Blox Fruit" and toolInHand.ToolTip == "Blox Fruit" then return end
    end

    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if (category == "Melee" and tool.ToolTip == "Melee") or
               (category == "Sword" and tool.ToolTip == "Sword") or
               (category == "Blox Fruit" and tool.ToolTip == "Blox Fruit") then
                char.Humanoid:EquipTool(tool)
                break
            end
        end
    end
end

