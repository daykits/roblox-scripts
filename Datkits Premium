Tabs.Main:AddToggle("AutoQuestToggle", {
    Title = "Auto Quest (Sea 1 + Sea 2)",
    Default = false,
    Callback = function(Value)
        getgenv().AutoQuest = Value
        ToggleNoclip(Value)
        
        if not Value then
            ResetCharacterState()
            return
        end
        
        getgenv().AutoFarm = false
        getgenv().AutoChest = false

        task.spawn(function()
            while getgenv().AutoQuest do
                pcall(EquipWeapon)
                task.wait(1)
            end
        end)

        task.spawn(function()
            while getgenv().AutoQuest do
                task.wait(0.05)
                pcall(function()
                    local char = GetCharacter()
                    if not char then return end
                    local hrp = char.HumanoidRootPart
                    local questName, questLevel, mobName, npcCFrame, mobCFrame = GetQuestData()
                    
                    -- Khởi tạo đối tượng QuestClass
                    local currentQuestObj = QuestClass.new(questName, mobName, "normal", 1, 3000, 8)

                    if not HasQuest() then
                        if npcCFrame then
                            local dist = (hrp.Position - npcCFrame.Position).Magnitude
                            if dist > 8 then
                                TweenTo(npcCFrame * CFrame.new(0, 0, 2.5), 260)
                            else
                                StopTween()
                                ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest", questName, questLevel)
                                task.wait(0.5)
                            end
                        end
                    else
                        local target = nil
                        local minDist = math.huge
                        local enemies = workspace:FindFirstChild("Enemies")
                        
                        if enemies then
                            for _, enemy in ipairs(enemies:GetChildren()) do
                                local monster = MonsterClass.new(enemy)
                                -- Sử dụng hàm QuestClass:Matches(monster) để lọc đúng quái
                                if monster and currentQuestObj:Matches(monster) then
                                    local d = (hrp.Position - monster.hrp.Position).Magnitude
                                    if d < minDist then
                                        minDist = d
                                        target = monster
                                    end
                                end
                            end
                        end

                        if target then
                            local pos = target.hrp.Position
                            local cf = CFrame.new(pos + Vector3.new(0, getgenv().FarmDistance, 0), pos)
                            TweenTo(cf, 260)
                            
                            target.hrp.CanCollide = false
                            target.hrp.AssemblyLinearVelocity = Vector3.zero
                        elseif mobCFrame then
                            TweenTo(mobCFrame, 260)
                        end
                    end
                end)
            end
            ResetCharacterState()
        end)
    end
})

