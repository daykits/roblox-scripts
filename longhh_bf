                                threshold = radius * (1 - math.cos(f * math.pi)) / H
                                after = true
                            elseif i == 3 then
                                threshold = (W - radius - f * straight) / W
                                after = false
                            elseif i == 4 then
                                threshold = radius * (1 + math.cos(f * math.pi)) / H
                                after = false
                            else
                                threshold = (radius + f * half) / W
                                after = true
                            end
                            if fill then
                                after = not after
                            end
                            seg.mask.Transparency = ringMaskSeq(threshold, after)
                        end
