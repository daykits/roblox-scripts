-- Vòng lặp duy trì Tốc độ 300 liên tục
task.spawn(function()
    local player = game.Players.LocalPlayer
    while true do
        task.wait(0.1)
        if getgenv().FastSpeed then
            local character = player.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.WalkSpeed ~= 300 then
                humanoid.WalkSpeed = 300
            end
        end
    end
end)

-- Vòng lặp chính xử lý Auto Farm theo tọa độ XYZ
task.spawn(function()
    local player = game.Players.LocalPlayer
    
    while true do
        task.wait(0.3)
        
        if getgenv().AutoFarm then
            local character = player.Character
            local rootPart = character and character:FindFirstChild("HumanoidRootPart")
            
            if rootPart then
                local homeCFrame = rootPart.CFrame
                
                for _, targetPos in ipairs(eggPositions) do
                    if not getgenv().AutoFarm then break end
                    
                    pcall(function()
                        -- 1. Teleport đến vị trí trứng
                        for i = 1, 3 do
                            safeTeleport(CFrame.new(targetPos))
                            task.wait(0.05)
                        end
                        
                        -- 2. Đứng im tại chỗ 3 giây và phát lệnh nhặt trứng liên tục
                        local startTime = tick()
                        while (tick() - startTime) < 3 do
                            triggerPromptAt(targetPos)
                            task.wait(0.2)
                        end
                        
                        -- 3. Cầm trứng trên tay
                        equipTool()
                        task.wait(0.3)
                        
                        -- 4. Teleport mang trứng trở về Nhà
                        for i = 1, 3 do
                            safeTeleport(homeCFrame)
                            task.wait(0.05)
                        end
                        
                        -- 5. Nghỉ ngắn 1 giây trước khi sang bệ tiếp theo
                        task.wait(1)
                    end)
                end
            end
        end
    end
end)
