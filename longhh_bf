                        pcall(_tp, CFrame.new(cf.Position))
                        task.wait(0.1)
                    end
                end
            end
        end
        local function djResetPlayer(valid)
            local oldChar = lp.Character
            local hum = oldChar and oldChar:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function() hum.Health = 0 end)
            end
            if oldChar then
                pcall(function() oldChar:BreakJoints() end)
            end
            local t0 = tick()
            while valid() and tick() - t0 < 20 do
                task.wait(0.2)
                local c = lp.Character
                if c and c ~= oldChar and getRoot() then break end
            end
            if valid() then
                task.wait(1)
            end
        end
        local function djInArena()
            local h = getRoot()
            local map = workspace:FindFirstChild("Map")
            local arena = map and map:FindFirstChild("DapperJackArena")
            if not h or not arena then return false end
            local ok, inside = pcall(function()
                local cf, size
                if arena:IsA("Model") then
                    cf, size = arena:GetBoundingBox()
                else
                    local mn, mx
                    for _, d in ipairs(arena:GetDescendants()) do
                        if d:IsA("BasePart") then
                            local lo, hi = d.Position - d.Size / 2, d.Position + d.Size / 2
                            mn = mn and Vector3.new(math.min(mn.X, lo.X), math.min(mn.Y, lo.Y), math.min(mn.Z, lo.Z)) or lo
                            mx = mx and Vector3.new(math.max(mx.X, hi.X), math.max(mx.Y, hi.Y), math.max(mx.Z, hi.Z)) or hi
                        end
                    end
                    if not mn then return false end
                    cf, size = CFrame.new((mn + mx) / 2), mx - mn
                end
                local rel = cf:PointToObjectSpace(h.Position)
                return math.abs(rel.X) <= size.X / 2 + DJ_ARENA_PAD_XZ and math.abs(rel.Y) <= size.Y / 2 + DJ_ARENA_PAD_Y and math.abs(rel.Z) <= size.Z / 2 + DJ_ARENA_PAD_XZ
            end)
            return ok and inside == true
        end
        local function djWaitArenaBoss(valid, maxSec)
            local t0 = tick()
            while valid() and tick() - t0 < (maxSec or 90) do
                local g = djFindGate()
                if g then return g end
                if djInArena() then
                    local b = djFindBoss()
                    if b then return b end
                end
                djHold()
                task.wait(0.1)
            end
            return nil
        end
        local function djKill(boss, valid)
            local isGate = boss.Name == DJ_GATE
            djFarmBoss(boss, valid)
            if isGate then return end
            if valid() and not alive(boss) then
                djCollectCandy(valid)
                djResetPlayer(valid)
            end
        end
        local function djRound(valid)
            local gate = djFindGate()
            if gate then
                djKill(gate, valid)
                return
            end
            local inArena = djInArena()
            local boss = djFindBoss()
            if inArena then
                if boss then
                    djKill(boss, valid)
                    return
                end
                if #djCandyItems() > 0 then
                    djCollectCandy(valid)
                    djResetPlayer(valid)
                    return
                end
                boss = djWaitArenaBoss(valid, 15)
                if not boss then
                    if valid() and djInArena() then
                        djResetPlayer(valid)
                    end
                    return
                end
            else
                local hasCompass = djFindNested(workspace, "GreatPumpkinCompass", DJ_SEARCH_RADIUS, false) ~= nil
                if not (boss and not hasCompass) then
                    if not hasCompass then
                        if not djReachWitch(valid) then return end
                        djSummon()
                        if not djWait(15, valid) then return end
                    end
                    local compass = djReachCompass(valid)
                    if not compass then
                        task.wait(3)
                        return
                    end
                    if not djWait(0.5, valid) then return end
                    djHoldE(compass, valid)
                end
                boss = djWaitArenaBoss(valid)
                if not boss then
                    if valid() and djInArena() then
                        djResetPlayer(valid)
                    end
                    return
                end
            end
            djKill(boss, valid)
        end
