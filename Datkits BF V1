local function FindBestTarget(charPos, questMobName, prioritize, maxDist)
    prioritize = prioritize or getgenv().TargetPrioritize or "nearest"
    maxDist = maxDist or 5000

    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local questList, normalList = {}, {}

    for _, enemy in ipairs(enemies:GetChildren()) do
        local hum = enemy:FindFirstChild("Humanoid")
        local hrp = enemy:FindFirstChild("HumanoidRootPart")
        if hum and hrp and hum.Health > 0 then
            local dist = (hrp.Position - charPos).Magnitude
            if dist <= maxDist then
                local data = {
                    model = enemy,
                    hrp = hrp,
                    hp = hum.Health,
                    level = enemy:GetAttribute("Level") or 1,
                    name = enemy.Name
                }
                if questMobName and string.find(string.lower(enemy.Name), string.lower(questMobName), 1, true) then
                    table.insert(questList, data)
                else
                    table.insert(normalList, data)
                end
            end
        end
    end

    local list = #questList > 0 and questList or normalList
    if #list == 0 then return nil end

    table.sort(list, function(a, b)
        if prioritize == "weakest" then
            return a.hp < b.hp
        elseif prioritize == "highest_level" then
            return a.level > b.level
        else
            return (a.hrp.Position - charPos).Magnitude < (b.hrp.Position - charPos).Magnitude
        end
    end)

    return list[1]
end

