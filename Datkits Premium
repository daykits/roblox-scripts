local function GetClosestHits()
    local hits = {}
    local char = GetCharacter()
    if not char or not workspace:FindFirstChild("Enemies") then return hits end

    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        local hum = enemy:FindFirstChild("Humanoid")
        local ehrp = enemy:FindFirstChild("HumanoidRootPart")
        if hum and hum.Health > 0 and ehrp then
            local dist = (char.HumanoidRootPart.Position - ehrp.Position).Magnitude
            if dist <= 55 then
                table.insert(hits, {enemy, ehrp})
            end
        end
    end
    return hits
end

task.spawn(function()
    while true do
        task.wait(getgenv().FastAttack and 0.05 or 0.2)
        if (getgenv().AutoQuest or getgenv().AutoFarm) and getgenv().FastAttack then
            pcall(function()
                local char = GetCharacter()
                if not char then return end
                local tool = char:FindFirstChildOfClass("Tool")
                if not tool then return end

                tool:Activate()

                local net = ReplicatedStorage:FindFirstChild("Modules") and ReplicatedStorage.Modules:FindFirstChild("Net")
                if net then
                    local regAttack = net:FindFirstChild("RE/RegisterAttack")
                    local regHit = net:FindFirstChild("RE/RegisterHit")

                    if regAttack then regAttack:FireServer(0.1) end

                    local hits = GetClosestHits()
                    if #hits > 0 then
                        if tool:FindFirstChild("LeftClickRemote") then
                            tool.LeftClickRemote:FireServer((hits[1][2].Position - char.HumanoidRootPart.Position).Unit, 1)
                        end
                        if regHit then
                            for _, data in ipairs(hits) do
                                regHit:FireServer(data[2], {data})
                            end
                        end
                    end
                end
            end)
        end
    end
end)

