-- Hàm trang bị Võ an toàn
local function EquipMeleeWeapon()
    local player = game.Players.LocalPlayer
    local char = player.Character
    if not char then return nil end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        if currentTool.ToolTip == "Melee" 
        or currentTool:FindFirstChild("Combat") 
        or currentTool.Name:find("Combat") 
        or currentTool.Name:find("Step") 
        or currentTool.Name:find("Karate") 
        or currentTool.Name:find("Dragon") 
        or currentTool.Name:find("Electric") 
        or currentTool.Name:find("God") 
        or currentTool.Name:find("Claw") then
            return currentTool
        end
    end

    for _, tool in pairs(player.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            if tool.ToolTip == "Melee" 
            or tool:FindFirstChild("Combat") 
            or tool.Name:find("Combat") 
            or tool.Name:find("Step") 
            or tool.Name:find("Karate") 
            or tool.Name:find("Dragon") 
            or tool.Name:find("Electric") 
            or tool.Name:find("God") 
            or tool.Name:find("Claw") then
                char.Humanoid:EquipTool(tool)
                task.wait(0.1)
                return tool
            end
        end
    end
end

-- LUỒNG TẤN CÔNG ĐỘC LẬP (KHÔNG DÙNG VIRTUAL INPUT -> KHÔNG KHÓA CHUỘT)
task.spawn(function()
    while true do
        task.wait(_G.FastAttack and 0.05 or 0.2)
        if _G.AutoFarm then
            pcall(function()
                local player = game.Players.LocalPlayer
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end

                local tool = char:FindFirstChildOfClass("Tool")
                if tool and tool:IsA("Tool") then
                    -- Kích hoạt đòn đánh bằng vũ khí
                    tool:Activate()

                    -- Gửi tín hiệu Remote Server an toàn (chỉ gửi khi có quái)
                    local rep = game:GetService("ReplicatedStorage")
                    local net = rep:FindFirstChild("Modules") and rep.Modules:FindFirstChild("Net")
                    if net then
                        local regAttack = net:FindFirstChild("RE/RegisterAttack")
                        local regHit = net:FindFirstChild("RE/RegisterHit")
                        
                        if regAttack then 
                            regAttack:FireServer(0) 
                        end
                        
                        if regHit and workspace:FindFirstChild("Enemies") then
                            for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                                if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                                    local dist = (char.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                                    if dist <= 30 then
                                        regHit:FireServer(enemy.HumanoidRootPart, {enemy})
                                    end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
end)

MainTab:CreateToggle({
   Name = "Bật Auto Farm bằng Võ (Tự Đánh + Có Dame)",
   CurrentValue = false,
   Flag = "ToggleFarmMelee",
   Callback = function(Value)
      _G.AutoFarm = Value

      -- Luồng 1: Trang bị Võ & Bật Noclip
      task.spawn(function()
          while _G.AutoFarm do
              task.wait(0.3)
              pcall(function()
                  EquipMeleeWeapon()
                  local char = game.Players.LocalPlayer.Character
                  if char then
                      for _, part in pairs(char:GetChildren()) do
                          if part:IsA("BasePart") then
                              part.CanCollide = false
                          end
                      end
                  end
              end)
          end
      end)

      -- Luồng 2: Tìm quái & Dịch chuyển lơ lửng trên đầu
      task.spawn(function()
          while _G.AutoFarm do
              task.wait()
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character
                  if not character then return end
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  if not hrp then return end

                  local nearestMob = nil
                  local minDistance = math.huge
                  
                  if workspace:FindFirstChild("Enemies") then
                      for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                          if enemy and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
                              local dist = (hrp.Position - enemy.HumanoidRootPart.Position).Magnitude
                              if dist < minDistance then
                                  minDistance = dist
                                  nearestMob = enemy
                              end
                          end
                      end
                  end

                  if nearestMob and nearestMob:FindFirstChild("HumanoidRootPart") then
                      local mobPos = nearestMob.HumanoidRootPart.Position
                      local height = _G.FarmDistance or 5
                      
                      -- Đặt vị trí lơ lửng 5 studs và xoay mặt hướng xuống quái
                      hrp.CFrame = CFrame.new(mobPos + Vector3.new(0, height, 0), mobPos)
                      
                      -- Tắt va chạm của quái tránh đẩy nhân vật
                      nearestMob.HumanoidRootPart.CanCollide = false
                  end
              end)
          end
      end)
   end,
})

MainTab:CreateSection("Tự Động Nhặt Rương (Di Chuyển Mượt)")

_G.AutoChest = false

local function GetChests()
    local chests = {}
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Part") and v.Name:find("Chest") and v:FindFirstChild("TouchInterest") then
            table.insert(chests, v)
        end
    end
    return chests
end

MainTab:CreateToggle({
   Name = "Bật Auto Chest (Di Chuyển Bay Gom Rương)",
   CurrentValue = false,
   Flag = "ToggleChest",
   Callback = function(Value)
      _G.AutoChest = Value
      
      task.spawn(function()
          while _G.AutoChest do
              task.wait(0.1)
              pcall(function()
                  local player = game.Players.LocalPlayer
                  local character = player.Character
                  if not character then return end
                  local hrp = character:FindFirstChild("HumanoidRootPart")
                  if not hrp then return end

                  local chests = GetChests()

                  if #chests > 0 then
                      table.sort(chests, function(a, b)
                          return (hrp.Position - a.Position).Magnitude < (hrp.Position - b.Position).Magnitude
                      end)

                      local targetChest = chests[1]

                      if targetChest and targetChest:FindFirstChild("TouchInterest") then
                          local speed = 300
                          local distance = (hrp.Position - targetChest.Position).Magnitude
                          local duration = distance / speed

                          local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
                          local tween = game:GetService("TweenService"):Create(hrp, tweenInfo, {CFrame = targetChest.CFrame})
                          
                          local bv = Instance.new("BodyVelocity")
                          bv.Name = "ChestFlyBV"
                          bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                          bv.Velocity = Vector3.new(0, 0, 0)
                          bv.Parent = hrp

                          tween:Play()

                          local elapsed = 0
                          repeat
                              task.wait(0.05)
                              elapsed = elapsed + 0.05
                              
                              if character then
                                  for _, part in pairs(character:GetChildren()) do
                                      if part:IsA("BasePart") then
                                          part.CanCollide = false
                                      end
                                  end
                              end
                          until elapsed >= duration or not _G.AutoChest or not targetChest or not targetChest.Parent or not targetChest:FindFirstChild("TouchInterest")

                          if tween then tween:Cancel() end
                          if bv then bv:Destroy() end

                          if _G.AutoChest and targetChest and targetChest:FindFirstChild("TouchInterest") then
                              hrp.CFrame = targetChest.CFrame
                              if firetouchinterest then
                                  firetouchinterest(hrp, targetChest, 0)
                                  task.wait(0.02)
                                  firetouchinterest(hrp, targetChest, 1)
                              end
                              task.wait(0.1)
                          end
                      end
                  else
                      task.wait(2)
                  end
              end)
          end

          if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
              local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
              for _, v in pairs(hrp:GetChildren()) do
                  if v.Name == "ChestFlyBV" then
                      v:Destroy()
                  end
              end
          end
      end)
   end,
})

