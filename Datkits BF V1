-- ==================== HÀM CƠ BẢN ====================
local function GetChar()
    local c = LocalPlayer.Character
    if c and c:FindFirstChild("HumanoidRootPart") and c:FindFirstChild("Humanoid") and c.Humanoid.Health > 0 then
        return c
    end
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    currentTarget = nil
end

-- HÀM BAY ỔN ĐỊNH (không khựng, không bị kéo về)
local function TweenTo(targetCF)
    local char = GetChar()
    if not char then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char.Humanoid

    -- Noclip
    for _, part in pairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    -- Zero velocity
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    -- BodyVelocity
    local bv = hrp:FindFirstChild("FlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FlyBV"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local distance = (hrp.Position - targetCF.Position).Magnitude

    if distance < 4.5 then
        StopTween()
        hrp.CFrame = targetCF
        return
    end

    -- Chỉ tạo tween mới nếu target thay đổi đáng kể
    if currentTarget and (currentTarget.Position - targetCF.Position).Magnitude < 3 then
        return
    end

    currentTarget = targetCF

    local speed = getgenv().TweenSpeed or 300
    local time = math.clamp(distance / speed, 0.08, 4)

    if currentTween then
        pcall(function() currentTween:Cancel() end)
    end

    currentTween = TweenService:Create(hrp, TweenInfo.new(time, Enum.EasingStyle.Linear), {
        CFrame = targetCF
    })
    currentTween:Play()
end

local function EquipTool()
    local char = GetChar()
    if not char then return end
    if char:FindFirstChildOfClass("Tool") then return end

    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            pcall(function()
                char.Humanoid:EquipTool(tool)
            end)
            break
        end
    end
end

local function HasQuest()
    local success, result = pcall(function()
        local main = LocalPlayer.PlayerGui:FindFirstChild("Main")
        if main and main:FindFirstChild("Quest") then
            return main.Quest.Visible
        end
        return false
    end)
    return success and result
end

