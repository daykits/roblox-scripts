-- TÌM QUÁI
local function FindMob(mobName)
    local char = GetChar()
    if not char then return nil end
    local closest = nil
    local shortest = 9999
    local folder = workspace:FindFirstChild("Enemies")
    if not folder then return nil end

    for _, enemy in pairs(folder:GetChildren()) do
        if enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 and enemy:FindFirstChild("HumanoidRootPart") then
            local name = enemy.Name:lower()
            if name:find(mobName:lower())
            or (mobName == "Raider" and (name:find("raider") or name:find("tập kích") or name:find("tap kich")))
            or (mobName == "Mercenary" and (name:find("mercenary") or name:find("đánh thuê"))) then
                local dist = (char.HumanoidRootPart.Position - enemy.HumanoidRootPart.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    closest = enemy
                end
            end
        end
    end
    return closest
end

-- ==================== FAST ATTACK REDZ STYLE ====================
task.spawn(function()
    pcall(function()
        local CameraShaker = require(game.ReplicatedStorage.Util.CameraShaker)
        CameraShaker:Stop()
    end)

    local CombatController
    for _, v in pairs(getreg()) do
        if typeof(v) == "function" then
            local env = getfenv(v)
            if env and env.script == LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework") then
                for _, up in pairs(debug.getupvalues(v)) do
                    if typeof(up) == "table" and up.activeController then
                        CombatController = up
                        break
                    end
                end
            end
        end
        if CombatController then break end
    end

    RunService.RenderStepped:Connect(function()
        if not getgenv().FastAttack then return end
        pcall(function()
            if CombatController and CombatController.activeController then
                local ac = CombatController.activeController
                ac.timeToNextAttack = -math.huge
                ac.attacking = false
                ac.increment = 4
                ac.blocking = false
                ac.hitboxMagnitude = 120
                if ac.humanoid then
                    ac.humanoid.AutoRotate = true
                end
                ac.focusStart = 0
            end

            -- Click hỗ trợ
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new())
        end)
    end)
end)

