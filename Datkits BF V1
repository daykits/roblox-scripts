local function FindAllChests()
    local chests = {}
    local found = {}

    local function scanContainer(container, depth)
        if depth > 3 then return end
        for _, obj in ipairs(container:GetChildren()) do
            if obj:IsA("Model") and (obj.Name:find("Chest") or obj.Name == "Chest") then
                local part = obj.PrimaryPart
                    or obj:FindFirstChildWhichIsA("BasePart", true)
                if part and part:FindFirstChild("TouchInterest") then
                    if not found[part] then
                        found[part] = true
                        table.insert(chests, part)
                    end
                end
            elseif obj:IsA("Part") and obj.Name:find("Chest") then
                if obj:FindFirstChild("TouchInterest") then
                    if not found[obj] then
                        found[obj] = true
                        table.insert(chests, obj)
                    end
                end
            elseif obj:IsA("MeshPart") and obj.Name:find("Chest") then
                if obj:FindFirstChild("TouchInterest") then
                    if not found[obj] then
                        found[obj] = true
                        table.insert(chests, obj)
                    end
                end
            end

            if obj:IsA("Folder") or obj:IsA("Model") then
                if obj.Name:find("Chest") or obj.Name:find("chest")
                    or obj.Name == "ChestFolder" or obj.Name == "Chests"
                    or depth < 2
                then
                    scanContainer(obj, depth + 1)
                end
            end
        end
    end

    scanContainer(workspace, 0)
    return chests
end

local function AutoChestLoop()
    while task.wait(0.2) do
        if not Config.AutoChest then continue end
        pcall(function()
            local char = GetCharacter()
            if not char then return end
            local hrp = char.HumanoidRootPart
            if not hrp then return end

            local chests = FindAllChests()
            if #chests == 0 then return end

            local validChests = {}
            for _, chest in ipairs(chests) do
                local dist = (hrp.Position - chest.Position).Magnitude
                if dist <= Config.ChestRange then
                    table.insert(validChests, { chest = chest, dist = dist })
                end
            end

            if #validChests == 0 then return end

            table.sort(validChests, function(a, b) return a.dist < b.dist end)
            local target = validChests[1].chest
            local targetDist = validChests[1].dist

            if targetDist > 8 then
                SetMoveTarget(target.CFrame)
            else
                SetMoveTarget(target.CFrame)
                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(hrp, target, 0)
                        task.wait(0.03)
                        firetouchinterest(hrp, target, 1)
                    end)
                end
            end
        end)
    end
end

