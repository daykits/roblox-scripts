-- ============================================
-- HÀM TẢI SCRIPT TỪ RAW LINK
-- ============================================
local function loadScriptFromURL(url)
    local success, source = pcall(function()
        return game:HttpGet(url, true)
    end)

    if not success or not source or #source < 10 then
        return false, "Không tải được script từ link"
    end

    local func, err = loadstring(source)
    if not func then
        return false, "Lỗi compile: " .. tostring(err)
    end

    local runOk, runErr = pcall(func)
    if not runOk then
        return false, "Lỗi runtime: " .. tostring(runErr)
    end

    return true
end

-- ============================================
-- XỬ LÝ NHẬP KEY
-- ============================================
local isProcessing = false

local function checkKey()
    if isProcessing then return end
    isProcessing = true

    local input = KeyBox.Text

    if input == SECRET_KEY then
        StatusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)
        StatusLabel.Text = "✅ Key hợp lệ! Đang tải script..."

        KeyBox.TextEditable = false
        ConfirmBtn.Text = "⏳ ĐANG TẢI..."

        task.wait(0.3)

        -- Ẩn GUI key
        KeyFrame.Visible = false

        -- Thông báo loading
        local loadingGui = Instance.new("ScreenGui")
        loadingGui.Name = "DatKitsLoading"
        loadingGui.ResetOnSpawn = false
        loadingGui.Parent = player:WaitForChild("PlayerGui")

        local loadingLabel = Instance.new("TextLabel")
        loadingLabel.Size = UDim2.new(1, 0, 0, 40)
        loadingLabel.Position = UDim2.new(0, 0, 0.5, -20)
        loadingLabel.BackgroundTransparency = 1
        loadingLabel.Text = "⏳ Đang tải script..."
        loadingLabel.TextColor3 = Color3.fromRGB(180, 140, 255)
        loadingLabel.Font = Enum.Font.GothamBold
        loadingLabel.TextSize = 24
        loadingLabel.TextStrokeTransparency = 0.5
        loadingLabel.Parent = loadingGui

        task.wait(0.3)

        -- ✅ Tải và chạy raw script
        local ok, err = loadScriptFromURL(SCRIPT_URL)

        -- Xoá loading
        loadingGui:Destroy()

        if ok then
            -- Thành công → xoá luôn GUI key
            ScreenGui:Destroy()
        else
            -- Lỗi → hiện lại GUI key
            ScreenGui.Parent = player:WaitForChild("PlayerGui")
            KeyFrame.Visible = true
            KeyBox.TextEditable = true
            ConfirmBtn.Text = "✅ XÁC NHẬN"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
            StatusLabel.Text = "❌ " .. tostring(err)
            isProcessing = false
        end
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "❌ Key không đúng! Vui lòng thử lại."
        KeyBox.Text = ""
        isProcessing = false
    end
end

ConfirmBtn.MouseButton1Click:Connect(checkKey)

KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        checkKey()
