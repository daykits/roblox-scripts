--====================================================================
-- UTILITIES
--====================================================================
local function createMaid()
	local tasks = {}
	local maid = {}
	function maid.give(item)
		table.insert(tasks, item)
		return item
	end
	function maid.clean()
		local pending = tasks
		tasks = {}
		for _, item in ipairs(pending) do
			local kind = typeof(item)
			if kind == "RBXScriptConnection" then
				item:Disconnect()
			elseif kind == "Instance" then
				item:Destroy()
			elseif kind == "function" then
				item()
			elseif kind == "thread" then
				if item ~= coroutine.running() and coroutine.status(item) ~= "dead" then
					task.cancel(item)
				end
			end
		end
	end
	return maid
end

runtime.maid = createMaid()

local function weakTable()
	return setmetatable({}, { __mode = "k" })
end

local function findByPath(root, path)
	local current = root
	for _, name in ipairs(path) do
		current = current and current:FindFirstChild(name)
	end
	return current
end

local function trySet(instance, property, value)
	local ok, err = pcall(function()
		instance[property] = value
	end)
	if not ok then
		warn(string.format("[UtilityMenu] Cannot set %s.%s: %s", instance.Name, property, tostring(err)))
	end
	return ok
end

local throttleTimes = {}
local function notifyThrottled(key, text, kind, cooldown)
	local now = os.clock()
	if throttleTimes[key] and now - throttleTimes[key] < cooldown then
		return
	end
	throttleTimes[key] = now
	notify(text, kind)
end

-- Property store: remembers the first (original) value of every property we override.
local function overrideProperty(store, instance, property, value)
	local readable, current = pcall(function()
		return instance[property]
	end)
	if not readable then
		warn(string.format("[UtilityMenu] Cannot read %s.%s", instance.Name, property))
		return
	end
	local saved = store[instance]
	if not saved then
		saved = {}
		store[instance] = saved
	end
	if saved[property] == nil then
		saved[property] = current
	end
	if current ~= value then
		trySet(instance, property, value)
	end
end

local function restoreStore(store)
	for instance, saved in pairs(store) do
		if instance.Parent then
			for property, original in pairs(saved) do
				trySet(instance, property, original)
			end
		end
		store[instance] = nil
	end
end

-- Character helpers
local function getHumanoid()
	local character = localPlayer.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
	local character = localPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(humanoid)
	return humanoid ~= nil and humanoid.Health > 0
end

-- Calls user-provided hooks with explicit error reporting.
local function invokeHook(label, hook, argument)
	local ok, result = pcall(hook, argument)
	if not ok then
		warn(string.format("[UtilityMenu] %s failed: %s", label, tostring(result)))
		notifyThrottled(label, label .. " error (see output)", "error", 5)
		return false
	end
	return result == true
end

--====================================================================
-- LIGHTING LAYERS (lets Fix Lag and Full Bright coexist safely)
--====================================================================
local LIGHTING_PRIORITY = { "FixLag", "FullBright" } -- later entries win on conflicts
local lightingOverrides = {}
local lightingOriginals = {}

local function refreshLighting()
	local desired = {}
	for _, owner in ipairs(LIGHTING_PRIORITY) do
		for property, value in pairs(lightingOverrides[owner] or {}) do
			desired[property] = value
		end
	end
	for property, value in pairs(desired) do
		if lightingOriginals[property] == nil then
			lightingOriginals[property] = Lighting[property]
		end
		if Lighting[property] ~= value then
			trySet(Lighting, property, value)
		end
	end
	for property, original in pairs(lightingOriginals) do
		if desired[property] == nil then
			trySet(Lighting, property, original)
			lightingOriginals[property] = nil
		end
	end
end

local function setLightingOverride(owner, properties)
	lightingOverrides[owner] = properties
	refreshLighting()
end

