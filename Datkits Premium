local function GetCharacter()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
        return char
    end
    return nil
end

local function GetLevel()
    local lv = 1
    pcall(function() lv = LocalPlayer.Data.Level.Value end)
    return lv
end

local function GetCurrentSea()
    local lv = GetLevel()
    if lv >= 1500 then return 3
    elseif lv >= 700 then return 2
    else return 1 end
end

local function StopTween()
    if currentTween then
        pcall(function() currentTween:Cancel() end)
        currentTween = nil
    end
    lastTargetPos = nil
end

local function ResetCharacterState()
    StopTween()
    local char = GetCharacter()
    if not char then return end
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = true end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") or v.Name == "FarmFlyBV" then
                v:Destroy()
            end
        end
    end
end

local function TweenTo(cf, speed)
    speed = speed or getgenv().TweenSpeed
    local char = GetCharacter()
    if not char then return end
    local hrp = char.HumanoidRootPart

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    local bv = hrp:FindFirstChild("FarmFlyBV")
    if not bv then
        bv = Instance.new("BodyVelocity")
        bv.Name = "FarmFlyBV"
        bv.MaxForce = Vector3.new(400000, 400000, 400000)
        bv.Velocity = Vector3.zero
        bv.Parent = hrp
    end

    local dist = (hrp.Position - cf.Position).Magnitude
    if dist <= 3.5 then
        StopTween()
        hrp.CFrame = cf
        return
    end

    if not currentTween or not lastTargetPos or (lastTargetPos - cf.Position).Magnitude > 4 then
        lastTargetPos = cf.Position
        if currentTween then pcall(function() currentTween:Cancel() end) end
        local duration = math.clamp(dist / speed, 0.12, 7)
        currentTween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = cf})
        currentTween:Play()
    end
end

local function EquipWeapon()
    local char = GetCharacter()
    if not char or char:FindFirstChildOfClass("Tool") then return end
    for _, tool in pairs(LocalPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local n = tool.Name:lower()
            if tool.ToolTip == "Melee" or n:find("combat") or n:find("step") or n:find("karate")
            or n:find("dragon") or n:find("electric") or n:find("god") or n:find("claw")
            or n:find("superhuman") or n:find("death") or n:find("shark") then
                char.Humanoid:EquipTool(tool)
                return
            end
        end
    end
    local any = LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
    if any then char.Humanoid:EquipTool(any) end
end

local function HasQuest()
    local ok, res = pcall(function()
        local gui = LocalPlayer.PlayerGui:FindFirstChild("Main")
        return gui and gui:FindFirstChild("Quest") and gui.Quest.Visible
    end)
    return ok and res
end

